---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";

const pageTitle = "همه مطالب";
const pageDescription = "فهرست مطالب منتشرشده در مجله هنری ماهون";
---

<BaseLayout
  title="همه مطالب ماهون | آرشیو روایت‌های هنری و فرهنگی"
  description="آرشیو همه مطالب مجله هنری ماهون؛ تازه‌ترین متن‌ها، شعرها، دیالوگ‌ها، پست‌های صوتی، کتاب‌ها و روایت‌های هنری منتشرشده."
  canonical="https://mahoonartmagazine.ir/posts">
  <main class="page-section posts-page" data-worker-url={SITE.workerUrl}>
    <div class="container">
      <div class="breadcrumb">
        <a href="/">خانه</a>
        <span> / </span>
        <span>همه مطالب</span>
      </div>

      <section class="page-card" style="margin-bottom: 28px;">
        <span class="tag">آرشیو ماهون</span>
        <h1>همه مطالب</h1>
        <p class="page-card__note">
          مجموعه روایت‌های منتشرشده در مجله هنری ماهون؛ از نوشتار و تصویر تا صدا و نگاه‌های کوتاه.
        </p>

        <label class="public-search" for="postsSearch">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6" />
            <path d="m16 16 4 4" />
          </svg>
          <input id="postsSearch" type="search" placeholder="جست‌وجو در مطالب..." autocomplete="off" />
        </label>
      </section>

      <div id="postsStatus" class="client-status client-status-loading" aria-live="polite">
        <div class="client-skeleton-card"></div>
        <div class="client-skeleton-lines">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>

      <section id="postsList" class="public-list" aria-label="فهرست مطالب"></section>
      <nav id="postsPagination" class="public-pagination" aria-label="صفحه‌بندی مطالب"></nav>
    </div>
  </main>

  <script is:inline>
    (() => {
      const root = document.querySelector(".posts-page");
      const API_BASE = (
        root?.dataset?.workerUrl ||
        "https://tg-cms-api.morentoofficial.workers.dev"
      ).replace(/\/+$/, "");

      const listEl = document.getElementById("postsList");
      const statusEl = document.getElementById("postsStatus");
      const paginationEl = document.getElementById("postsPagination");
      const searchEl = document.getElementById("postsSearch");
      const PAGE_SIZE = 12;

      let allPosts = [];
      let filteredPosts = [];
      let currentPage = 1;

      function escapeHtml(value) {
        return String(value || "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      function escapeAttr(value) {
        return escapeHtml(value).replace(/`/g, "&#096;");
      }

      function normalizeDigits(value) {
        return String(value || "")
          .replace(/۰/g, "0")
          .replace(/۱/g, "1")
          .replace(/۲/g, "2")
          .replace(/۳/g, "3")
          .replace(/۴/g, "4")
          .replace(/۵/g, "5")
          .replace(/۶/g, "6")
          .replace(/۷/g, "7")
          .replace(/۸/g, "8")
          .replace(/۹/g, "9")
          .replace(/٠/g, "0")
          .replace(/١/g, "1")
          .replace(/٢/g, "2")
          .replace(/٣/g, "3")
          .replace(/٤/g, "4")
          .replace(/٥/g, "5")
          .replace(/٦/g, "6")
          .replace(/٧/g, "7")
          .replace(/٨/g, "8")
          .replace(/٩/g, "9");
      }

      function toPersianNumber(value) {
        return String(value || "")
          .replace(/0/g, "۰")
          .replace(/1/g, "۱")
          .replace(/2/g, "۲")
          .replace(/3/g, "۳")
          .replace(/4/g, "۴")
          .replace(/5/g, "۵")
          .replace(/6/g, "۶")
          .replace(/7/g, "۷")
          .replace(/8/g, "۸")
          .replace(/9/g, "۹");
      }

      function cleanPublicText(value) {
        return String(value || "")
          .replace(/\u{1F539}?\s*@mahoonartmagazine/giu, "")
          .replace(/\u{1F539}/gu, "")
          .replace(/https?:\/\/(?:t\.me|telegram\.me|telegram\.dog)\/[^\s]+/giu, "")
          .replace(/https?:\/\/[^\s]+/giu, "")
          .replace(/@[a-zA-Z0-9_]+/g, "")
          .replace(/(^|\s)#([^\s#]+)/gu, " ")
          .replace(/[•●▪▫◦]/g, "")
          .replace(/\n{3,}/g, "\n\n")
          .replace(/[ \t]{2,}/g, " ")
          .trim();
      }

      function cleanText(value) {
        return cleanPublicText(value);
      }

      function truncateText(value, maxLength) {
        const source = String(value || "").replace(/\s+/g, " ").trim();
        if (!source) return "";
        return source.length <= maxLength ? source : `${source.slice(0, maxLength).trim()}…`;
      }

      function titleRules(mode) {
        if (mode === "post") return { maxChars: 52, maxWords: 8 };
        if (mode === "suggestion") return { maxChars: 34, maxWords: 6 };
        return { maxChars: 38, maxWords: 6 };
      }

      function firstWords(value, maxWords) {
        return String(value || "")
          .replace(/\s+/g, " ")
          .trim()
          .split(" ")
          .filter(Boolean)
          .slice(0, maxWords)
          .join(" ");
      }

      function buildShortTitle(value, mode = "card") {
        const { maxChars, maxWords } = titleRules(mode);
        const source = cleanPublicText(value).replace(/\s+/g, " ").trim();
        if (!source) return "";
        const phrase = firstWords(source.split(/\n|[.!؟?؛]/).find(Boolean) || source, maxWords);
        const limited = truncateText(phrase, maxChars);
        const wasShortened = phrase.length > maxChars || source.split(/\s+/).filter(Boolean).length > maxWords;
        return wasShortened && !limited.endsWith("…") ? `${limited}…` : limited;
      }

      function isSeoTitleUsable(post, seoTitle) {
        const cleanTitle = cleanPublicText(seoTitle).replace(/\s+/g, " ").trim();
        if (!cleanTitle || cleanTitle.length > 65) return false;
        const cleanBody = cleanPublicText(post?.text).replace(/\s+/g, " ").trim();
        if (cleanBody && cleanBody.length > 90 && cleanBody.startsWith(cleanTitle)) return false;
        return cleanTitle.split(/\s+/).filter(Boolean).length <= 10;
      }

      function makeTitle(text) {
        return buildShortTitle(text, "card") || "مطلبی از ماهون";
      }

      function makeDisplayTitle(post, mode = "card") {
        const seoTitle = cleanPublicText(post?.seo_title).replace(/\s+/g, " ").trim();
        if (isSeoTitleUsable(post, seoTitle)) {
          return buildShortTitle(seoTitle, mode) || "مطلبی از ماهون";
        }

        return buildShortTitle(post?.text, mode) || "مطلبی از ماهون";
      }

      function makeExcerpt(input) {
        const value = typeof input === "object" && input !== null
          ? input.seo_description || input.text
          : input;
        const source = cleanPublicText(value).replace(/\s+/g, " ").trim();
        if (!source) return "روایتی تازه از مجله هنری ماهون";
        return truncateText(source, 145);
      }

      function validMediaValue(value) {
        const source = String(value || "").trim();
        if (!source || source.toLowerCase() === "about:blank" || /^javascript:/i.test(source)) return null;
        return source;
      }

      function looksLikeImageUrl(value) {
        return /\.(avif|webp|png|jpe?g|gif|bmp|svg)(\?|#|$)/i.test(String(value || ""));
      }

      function getPostHref(post) {
        const slug = String(post?.slug || "").trim();
        if (slug && slug !== "#" && !/^javascript:/i.test(slug)) {
          return `/post/${encodeURIComponent(slug)}`;
        }

        const id = String(post?.id || "").trim();
        if (id) return `/post/${encodeURIComponent(id)}`;

        return "#";
      }

      function getMediaSrc(post) {
        const directImage = [
          post?.photo_url,
          post?.image_url,
          post?.thumbnail_url,
          post?.media?.url,
          post?.file_url
        ].map(validMediaValue).find(Boolean);
        if (directImage) return directImage;

        const mediaUrl = validMediaValue(post?.media_url);
        if (mediaUrl && (post?.media_type === "photo" || post?.media_type === "image" || looksLikeImageUrl(mediaUrl))) {
          return mediaUrl;
        }

        const fileId = String(post?.photo_file_id || post?.telegram_file_id || post?.file_id || "").trim();
        if (fileId) return `${API_BASE}/media/${encodeURIComponent(fileId)}`;

        const mediaFileId = String(post?.media_file_id || "").trim();
        if (mediaFileId && (post?.media_type === "photo" || post?.media_type === "image")) {
          return `${API_BASE}/media/${encodeURIComponent(mediaFileId)}`;
        }

        return null;
      }

      function formatDate(value) {
        if (!value) return "";
        try {
          return new Intl.DateTimeFormat("fa-IR", {
            year: "numeric",
            month: "long",
            day: "numeric"
          }).format(new Date(String(value).replace(" ", "T")));
        } catch {
          return String(value);
        }
      }

      function normalizePost(raw) {
        const mediaFileId = raw?.media_file_id || raw?.photo_file_id || raw?.file_id || raw?.telegram_file_id || null;
        const mediaType = raw?.media_type || (raw?.photo_file_id ? "photo" : null);
        const mediaUrl =
          raw?.media_url ||
          (mediaFileId ? `${API_BASE}/media/${encodeURIComponent(mediaFileId)}` : null);
        const photoUrl = getMediaSrc({ ...raw, media_url: mediaUrl, media_type: mediaType });

        return {
          id: Number(raw?.id || 0),
          text: String(raw?.text || ""),
          slug: String(raw?.slug || ""),
          created_at: String(raw?.created_at || ""),
          media_url: mediaUrl,
          media_file_id: mediaFileId,
          photo_file_id: raw?.photo_file_id || null,
          file_id: raw?.file_id || null,
          telegram_file_id: raw?.telegram_file_id || null,
          image_url: raw?.image_url || null,
          thumbnail_url: raw?.thumbnail_url || null,
          file_url: raw?.file_url || null,
          media: raw?.media || null,
          photo_url: photoUrl,
          seo_title: raw?.seo_title || null,
          seo_description: raw?.seo_description || null,
          media_type: mediaType
        };
      }

      function extractPosts(payload) {
        const rows = Array.isArray(payload)
          ? payload
          : Array.isArray(payload?.posts)
            ? payload.posts
            : Array.isArray(payload?.data)
              ? payload.data
              : [];

        return rows.map(normalizePost).filter((post) => post.id);
      }

      function renderStatus(message, error) {
        statusEl.style.display = "block";
        statusEl.classList.remove("client-status-loading");
        statusEl.classList.toggle("client-status-error", Boolean(error));
        statusEl.innerHTML = `<strong>${escapeHtml(message)}</strong>`;
      }

      function renderList() {
        const totalPages = Math.max(1, Math.ceil(filteredPosts.length / PAGE_SIZE));
        currentPage = Math.min(Math.max(currentPage, 1), totalPages);
        const start = (currentPage - 1) * PAGE_SIZE;
        const pagePosts = filteredPosts.slice(start, start + PAGE_SIZE);

        statusEl.style.display = filteredPosts.length ? "none" : "block";
        if (!filteredPosts.length) {
          renderStatus("مطلبی برای نمایش پیدا نشد.", false);
        }

        listEl.innerHTML = pagePosts
          .map((post) => {
            const title = makeDisplayTitle(post);
            const excerpt = makeExcerpt(post);
            const href = getPostHref(post);
            const imageSrc = getMediaSrc(post);
            const thumb = imageSrc
              ? `<span data-media-wrap><img class="public-list-row__thumb" src="${escapeAttr(imageSrc)}" alt="${escapeAttr(title)}" width="72" height="72" loading="lazy" decoding="async" onerror="this.closest('[data-media-wrap]')?.classList.add('is-hidden')" /></span>`
              : "";

            return `
              <a class="public-list-row" href="${escapeAttr(href)}">
                <div class="public-list-row__text">
                  <strong class="public-list-row__title public-card-title">${escapeHtml(title)}</strong>
                  <span class="public-list-row__excerpt">${escapeHtml(excerpt)}</span>
                  <span class="public-list-row__meta">${escapeHtml(formatDate(post.created_at))}</span>
                </div>
                ${thumb}
                <span class="public-list-row__arrow" aria-hidden="true">‹</span>
              </a>
            `;
          })
          .join("");

        paginationEl.innerHTML =
          totalPages > 1
            ? `
              <button type="button" data-page="prev" ${currentPage === 1 ? "disabled" : ""}>‹</button>
              <span>${toPersianNumber(currentPage)} از ${toPersianNumber(totalPages)}</span>
              <button type="button" data-page="next" ${currentPage === totalPages ? "disabled" : ""}>›</button>
            `
            : "";
      }

      function applySearch() {
        const q = normalizeDigits(String(searchEl.value || "").trim()).toLowerCase().replace(/^#/, "");
        currentPage = 1;

        filteredPosts = q
          ? allPosts.filter((post) =>
              normalizeDigits([
                post.id,
                `#${post.id}`,
                post.text,
                post.slug,
                post.seo_title,
                post.seo_description,
                post.media_type
              ].join(" "))
                .toLowerCase()
                .includes(q)
            )
          : allPosts;

        renderList();
      }

      async function loadPosts() {
        const controller = new AbortController();
        const timer = window.setTimeout(() => controller.abort(), 2000);

        try {
          const response = await fetch(`${API_BASE}/`, {
            method: "GET",
            signal: controller.signal,
            headers: { Accept: "application/json" }
          });

          if (!response.ok) throw new Error(`API error ${response.status}`);

          allPosts = extractPosts(await response.json()).sort((a, b) => {
            const aTime = new Date(String(a.created_at).replace(" ", "T")).getTime();
            const bTime = new Date(String(b.created_at).replace(" ", "T")).getTime();
            return bTime !== aTime ? bTime - aTime : Number(b.id || 0) - Number(a.id || 0);
          });
          filteredPosts = allPosts;
          renderList();
        } catch (error) {
          console.error("Mahoon posts page error:", error);
          listEl.innerHTML = "";
          paginationEl.innerHTML = "";
          renderStatus("خطا در دریافت مطالب. لطفاً کمی بعد دوباره صفحه را باز کنید.", true);
        } finally {
          window.clearTimeout(timer);
        }
      }

      searchEl?.addEventListener("input", applySearch);
      paginationEl?.addEventListener("click", (event) => {
        const button = event.target.closest("button[data-page]");
        if (!button || button.disabled) return;

        currentPage += button.dataset.page === "next" ? 1 : -1;
        renderList();
        window.scrollTo({ top: 0, behavior: "smooth" });
      });

      loadPosts();
    })();
  </script>
</BaseLayout>
