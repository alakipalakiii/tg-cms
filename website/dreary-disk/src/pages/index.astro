---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";

async function fetchJsonWithTimeout(url: string, timeoutMs = 1500) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeoutMs);

  try {
    const res = await fetch(url, { signal: controller.signal });
    if (!res.ok) return null;
    return await res.json();
  } catch (error) {
    console.warn("home settings fallback", error);
    return null;
  } finally {
    clearTimeout(timer);
  }
}

async function loadSiteSettings() {
  const payload = await fetchJsonWithTimeout(`${SITE.workerUrl.replace(/\/+$/, "")}/site-settings`);
  return payload?.settings || {};
}

const siteSettings = await loadSiteSettings();
const pageTitle = siteSettings.site_name || SITE.name;
const pageDescription = siteSettings.header_description || SITE.description;
const heroLineOne = siteSettings.home_hero_line_one || "درخت هنر، زمانی میوه خواهد داد";
const heroLineTwo = siteSettings.home_hero_line_two || "که ریشه آن خشکیده نشده باشد!";
const heroLabel = `${heroLineOne} ${heroLineTwo}`.trim();
const latestTitle = siteSettings.home_latest_title || "تازه‌ترین روایت منتشرشده در ماهون";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="home-page" data-worker-url={SITE.workerUrl}>
    <section class="home-hero" aria-label="شعار مجله هنری ماهون">
      <div class="home-hero__panel">
        <h1
          class="home-hero__slogan"
          data-line-one={heroLineOne}
          data-line-two={heroLineTwo}
          aria-label={heroLabel}
        >
          <span></span>
          <span></span>
        </h1>
      </div>
    </section>

    <section class="latest-intro">
      <div class="section-title section-title--lined">
        <span>{latestTitle}</span>
      </div>
    </section>

    <section class="latest-featured-section">
      <div id="featuredPost" class="latest-featured"></div>

      <div id="postsStatus" class="client-status client-status-loading" aria-live="polite">
        <div class="client-skeleton-card"></div>
        <div class="client-skeleton-lines">
          <span></span>
          <span></span>
          <span></span>
        </div>
        در حال دریافت پست‌ها...
      </div>
    </section>

    <section class="home-stats" id="homeStats" aria-label="آمار مطالب ماهون"></section>

    <section class="home-search-section">
      <label class="home-search" for="postSearch">
        <span class="home-search__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="6" />
            <path d="m16 16 4 4" />
          </svg>
        </span>
        <input
          id="postSearch"
          type="search"
          placeholder="جست‌وجو در مطالب..."
          autocomplete="off"
        />
      </label>
    </section>

    <section class="all-posts-section" aria-labelledby="allPostsTitle">
      <div class="section-heading-row">
        <h2 id="allPostsTitle">همه مطالب</h2>
      </div>
      <div id="postsGrid" class="all-posts-list" tabindex="0"></div>
      <a class="all-posts-more" href="/posts">مشاهده همه مطالب</a>
    </section>

    <section class="category-rails" id="categoryRails"></section>
  </main>

  <script is:inline>
    (function () {
      const root = document.querySelector(".home-page");
      const API_BASE = (
        root?.dataset?.workerUrl ||
        "https://tg-cms-api.morentoofficial.workers.dev"
      ).replace(/\/+$/, "");

      const statusEl = document.getElementById("postsStatus");
      const gridEl = document.getElementById("postsGrid");
      const featuredEl = document.getElementById("featuredPost");
      const statsEl = document.getElementById("homeStats");
      const categoryRailsEl = document.getElementById("categoryRails");
      const searchEl = document.getElementById("postSearch");

      const CATEGORY_DEFINITIONS = [
        { title: "کتاب", tags: ["کتاب"] },
        { title: "دیالوگ ها", tags: ["دیالوگ", "دیالوگ‌ها", "دیالوگ_ها"] },
        { title: "صوتی", tags: ["صوتی", "صدا", "موسیقی"] },
        { title: "شعر و متن", tags: ["متن", "متن‌ها", "متن_ها", "شعر", "اشعار", "شعرها", "شعر_ها"] },
        { title: "نقاشی", tags: ["نقاشی"] }
      ];
      const POETRY_TEXT_CATEGORY_TITLE = "شعر و متن";
      const CATEGORY_TAGS = new Set(
        CATEGORY_DEFINITIONS.flatMap((category) => category.tags.map(normalizeTag))
      );

      let allPosts = [];
      const sharedAudio = new Audio();
      let activeAudioButton = null;

      function typeHeroQuote() {
        const quote = document.querySelector(".home-hero__slogan");
        const targets = quote ? Array.from(quote.querySelectorAll("span")) : [];
        const text = [quote?.dataset?.lineOne, quote?.dataset?.lineTwo].filter(Boolean).join("\n");

        if (!quote || targets.length < 2 || !text) return;

        let index = 0;
        targets[0].textContent = "";
        targets[1].textContent = "";
        quote.classList.add("is-typing");

        const tick = () => {
          index += 1;
          const visible = text.slice(0, index);
          const [lineOne = "", lineTwo = ""] = visible.split("\n");
          targets[0].textContent = lineOne;
          targets[1].textContent = lineTwo;

          if (index < text.length) {
            window.setTimeout(tick, 38);
            return;
          }

          quote.classList.remove("is-typing");
          quote.classList.add("is-typed");
        };

        window.setTimeout(tick, 260);
      }

      function toPersianNumber(value) {
        return String(value || "")
          .replace(/0/g, "۰")
          .replace(/1/g, "۱")
          .replace(/2/g, "۲")
          .replace(/3/g, "۳")
          .replace(/4/g, "۴")
          .replace(/5/g, "۵")
          .replace(/6/g, "۶")
          .replace(/7/g, "۷")
          .replace(/8/g, "۸")
          .replace(/9/g, "۹");
      }

      function normalizeDigits(value) {
        return String(value || "")
          .replace(/۰/g, "0")
          .replace(/۱/g, "1")
          .replace(/۲/g, "2")
          .replace(/۳/g, "3")
          .replace(/۴/g, "4")
          .replace(/۵/g, "5")
          .replace(/۶/g, "6")
          .replace(/۷/g, "7")
          .replace(/۸/g, "8")
          .replace(/۹/g, "9")
          .replace(/٠/g, "0")
          .replace(/١/g, "1")
          .replace(/٢/g, "2")
          .replace(/٣/g, "3")
          .replace(/٤/g, "4")
          .replace(/٥/g, "5")
          .replace(/٦/g, "6")
          .replace(/٧/g, "7")
          .replace(/٨/g, "8")
          .replace(/٩/g, "9");
      }

      function escapeHtml(value) {
        return String(value || "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      function escapeAttr(value) {
        return escapeHtml(value).replace(/`/g, "&#096;");
      }

      function cleanText(value) {
        return String(value || "")
          .replace(/\u{1F539}?\s*@mahoonartmagazine/giu, "")
          .replace(/\u{1F539}/gu, "")
          .replace(/https?:\/\/[^\s]+/giu, "")
          .replace(/@[a-zA-Z0-9_]+/g, "")
          .replace(/(^|\s)#([^\s#]+)/gu, " ")
          .replace(/[•●▪▫◦]/g, "")
          .replace(/\n{3,}/g, "\n\n")
          .replace(/[ \t]{2,}/g, " ")
          .trim();
      }

      function normalizeTag(tag) {
        return String(tag || "")
          .replace(/^#/, "")
          .replace(/[يى]/g, "ی")
          .replace(/ك/g, "ک")
          .replace(/\u200c/g, "")
          .replace(/\s+/g, " ")
          .trim()
          .toLowerCase();
      }

      function makeTitle(text) {
        const source = cleanText(text) || "روایت ماهون";
        const firstLine =
          source
            .split("\n")
            .map((line) => line.trim())
            .find(Boolean) || "روایت ماهون";

        if (firstLine.length <= 70) return firstLine;
        return firstLine.slice(0, 70).trim() + "...";
      }

      function makeExcerpt(text) {
        const source = cleanText(text).replace(/\s+/g, " ").trim();
        if (!source) return "روایتی تازه از مجله هنری ماهون";
        if (source.length <= 160) return source;
        return source.slice(0, 160).trim() + "...";
      }

      function getTags(text) {
        return Array.from(
          new Set(
            Array.from(String(text || "").matchAll(/(^|\s)#([^\s#]+)/gu))
              .map((match) => match[2])
              .filter(Boolean)
          )
        );
      }

      function getPublicTags(text) {
        return getTags(text).filter((tag) => !CATEGORY_TAGS.has(normalizeTag(tag)));
      }

      function getTagHref(tag) {
        const cleanTag = String(tag || "").replace(/^#/, "").trim();
        return `/tag/${encodeURIComponent(cleanTag)}`;
      }

      function formatDate(value) {
        if (!value) return "";
        try {
          const date = new Date(String(value).replace(" ", "T"));
          return new Intl.DateTimeFormat("fa-IR", {
            year: "numeric",
            month: "long",
            day: "numeric"
          }).format(date);
        } catch {
          return String(value);
        }
      }

      function normalizePost(raw) {
        const mediaFileId = raw?.media_file_id || raw?.photo_file_id || null;
        const mediaType = raw?.media_type || (raw?.photo_file_id ? "photo" : null);
        const mediaUrl =
          raw?.media_url ||
          (mediaFileId ? `${API_BASE}/media/${encodeURIComponent(mediaFileId)}` : null);
        const photoUrl =
          raw?.photo_url ||
          (mediaType === "photo" ? mediaUrl : null) ||
          null;

        return {
          id: Number(raw?.id || 0),
          text: String(raw?.text || ""),
          slug: String(raw?.slug || `post-${raw?.id || Date.now()}`),
          created_at: String(raw?.created_at || ""),
          media_type: mediaType,
          media_file_id: mediaFileId,
          media_mime_type: raw?.media_mime_type || null,
          media_file_name: raw?.media_file_name || null,
          media_duration: raw?.media_duration || null,
          media_size: raw?.media_size || null,
          media_url: mediaUrl,
          photo_url: photoUrl,
          seo_title: raw?.seo_title || null,
          seo_description: raw?.seo_description || null
        };
      }

      function extractPosts(payload) {
        if (Array.isArray(payload)) return payload.map(normalizePost).filter((post) => post.id);
        if (Array.isArray(payload?.posts)) return payload.posts.map(normalizePost).filter((post) => post.id);
        if (Array.isArray(payload?.data)) return payload.data.map(normalizePost).filter((post) => post.id);
        return [];
      }

      function mediaLabel(type) {
        switch (type) {
          case "photo":
            return "";
          case "video":
            return "ویدیو";
          case "audio":
            return "صوت";
          case "voice":
            return "صدا";
          case "document":
            return "فایل";
          case "animation":
            return "انیمیشن";
          default:
            return "یادداشت";
        }
      }

      function mediaIcon(type) {
        switch (type) {
          case "photo":
            return "◎";
          case "video":
            return "▶";
          case "audio":
          case "voice":
            return "♪";
          case "document":
            return "□";
          case "animation":
            return "◆";
          default:
            return "•";
        }
      }

      function isAudioPost(post) {
        return post.media_type === "audio" || post.media_type === "voice";
      }

      function isVisualPost(post) {
        return ["photo", "video", "animation"].includes(post.media_type);
      }

      function isTextOnlyPost(post) {
        return !post.photo_url && !post.media_type;
      }

      function postHasCategory(post, category) {
        if (!category.tags.length) return true;

        const postTags = new Set(getTags(post.text).map(normalizeTag));
        return category.tags.some((tag) => postTags.has(normalizeTag(tag)));
      }

      function formatDuration(seconds) {
        const total = Number(seconds || 0);
        if (!total) return "";
        const minutes = Math.floor(total / 60);
        const rest = Math.floor(total % 60);
        return toPersianNumber(`${minutes}:${String(rest).padStart(2, "0")}`);
      }

      function renderLoadingStatus() {
        statusEl.classList.add("client-status-loading");
        statusEl.classList.remove("client-status-error");
        statusEl.innerHTML = `
          <div class="client-skeleton-card"></div>
          <div class="client-skeleton-lines">
            <span></span>
            <span></span>
            <span></span>
          </div>
        `;
      }

      function renderMessageStatus(message, type) {
        statusEl.classList.remove("client-status-loading");
        statusEl.classList.toggle("client-status-error", type === "error");
        statusEl.innerHTML = `<strong>${escapeHtml(message)}</strong>`;
      }

      function renderMedia(post, featured) {
        const className = featured ? "client-card-media client-card-media-featured" : "client-card-media";

        if (isAudioPost(post)) {
          const duration = formatDuration(post.media_duration);
          const disabledAttr = post.media_url ? "" : " disabled";

          return `
            <div class="${className} client-audio-card-media">
              <div class="client-audio-cover">
                <span>♪</span>
              </div>
              <div class="client-audio-panel">
                <small>${escapeHtml(mediaLabel(post.media_type))}</small>
                <button
                  class="client-audio-play"
                  type="button"
                  data-audio-src="${escapeAttr(post.media_url || "")}"
                  aria-label="پخش صوت"
                  ${disabledAttr}
                >
                  پخش
                </button>
                <div class="client-audio-progress" aria-hidden="true">
                  <span></span>
                </div>
                <em>${duration || "آماده شنیدن"}</em>
              </div>
            </div>
          `;
        }

        if (post.photo_url) {
          return `
            <div class="${className}">
              <img src="${escapeAttr(post.photo_url)}" alt="${escapeAttr(makeTitle(post.text))}" loading="lazy" />
            </div>
          `;
        }

        if (post.media_type) {
          return `
            <div class="${className} client-media-placeholder">
              <span>${escapeHtml(mediaIcon(post.media_type))}</span>
            </div>
          `;
        }

        return "";
      }

      function renderTags(post) {
        const tags = getPublicTags(post.text);
        if (!tags.length) return "";

        return `
          <div class="post-tags">
            ${tags
              .slice(0, 3)
              .map(
                (tag) =>
                  `<a href="${escapeAttr(getTagHref(tag))}">#${escapeHtml(tag)}</a>`
              )
              .join("")}
          </div>
        `;
      }

      function getPostCategory(post) {
        const category = CATEGORY_DEFINITIONS.find((item) => postHasCategory(post, item));
        return category?.title || "";
      }

      function renderFeaturedPost(post) {
        const title = post.seo_title || makeTitle(post.text);
        const excerpt = post.seo_description || makeExcerpt(post.text);
        const href = `/post/${encodeURIComponent(post.slug)}`;
        const category = getPostCategory(post);
        const media =
          post.photo_url
            ? `
              <a class="featured-card__media" href="${escapeAttr(href)}" aria-label="${escapeAttr(title)}">
                <img src="${escapeAttr(post.photo_url)}" alt="${escapeAttr(title)}" loading="lazy" />
              </a>
            `
            : "";

        return `
          <article class="featured-card ${!post.photo_url ? "featured-card--text-only" : ""}">
            <div class="featured-card__content">
              <div class="featured-card__meta">
                <span class="featured-card__date">${escapeHtml(formatDate(post.created_at))}</span>
                ${category ? `<span class="featured-card__category">${escapeHtml(category)}</span>` : ""}
              </div>
              <h2 class="featured-card__title">${escapeHtml(title)}</h2>
              <p class="featured-card__excerpt">${escapeHtml(excerpt)}</p>
              ${renderTags(post)}
              <a class="featured-card__cta" href="${escapeAttr(href)}" aria-label="${escapeAttr(title)}">ادامه مطلب</a>
            </div>
            ${media}
          </article>
        `;
      }

      function renderStats(posts) {
        if (!posts.length) {
          statsEl.innerHTML = "";
          return;
        }

        const activeCategories = CATEGORY_DEFINITIONS.filter((category) =>
          posts.some((post) => postHasCategory(post, category))
        ).length;
        const latestCode = posts[0]?.id || 0;
        const textOnlyCount = posts.filter(isTextOnlyPost).length;

        statsEl.innerHTML = `
          <div class="home-stat-card">
            <strong>${toPersianNumber(posts.length)}</strong>
            <span>مطالب منتشرشده</span>
          </div>
          <div class="home-stat-card">
            <strong>${toPersianNumber(activeCategories)}</strong>
            <span>دسته‌بندی فعال</span>
          </div>
          <div class="home-stat-card">
            <strong>${toPersianNumber(latestCode)}</strong>
            <span>آخرین کد مطلب</span>
          </div>
          <div class="home-stat-card">
            <strong>${toPersianNumber(textOnlyCount)}</strong>
            <span>مطالب متنی</span>
          </div>
        `;
      }

      function renderAllPostsList(posts) {
        gridEl.innerHTML = posts
          .slice(0, 20)
          .map((post) => {
            const title = post.seo_title || makeTitle(post.text);
            const href = `/post/${encodeURIComponent(post.slug)}`;
            const thumb = post.photo_url
              ? `<img class="all-post-row__thumb" src="${escapeAttr(post.photo_url)}" alt="${escapeAttr(title)}" loading="lazy" />`
              : "";

            return `
              <a class="all-post-row" href="${escapeAttr(href)}">
                <div class="all-post-row__text">
                  <strong class="all-post-row__title">${escapeHtml(title)}</strong>
                  <span class="all-post-row__date">${escapeHtml(formatDate(post.created_at))}</span>
                </div>
                ${thumb}
                <span class="all-post-row__arrow" aria-hidden="true">‹</span>
              </a>
            `;
          })
          .join("");
      }

      function renderRailMedia(post, forceTextOnly) {
        if (forceTextOnly) return "";

        const title = post.seo_title || makeTitle(post.text);

        if (post.photo_url) {
          return `
            <div class="client-card-media">
              <img src="${escapeAttr(post.photo_url)}" alt="${escapeAttr(title)}" loading="lazy" />
            </div>
          `;
        }

        if (isAudioPost(post)) {
          return `
            <div class="client-card-media client-media-placeholder category-card__media-placeholder">
              <span>♪</span>
              <small>${escapeHtml(mediaLabel(post.media_type))}</small>
            </div>
          `;
        }

        if (post.media_type) {
          return `
            <div class="client-card-media client-media-placeholder category-card__media-placeholder">
              <span>${escapeHtml(mediaIcon(post.media_type))}</span>
              <small>${escapeHtml(mediaLabel(post.media_type))}</small>
            </div>
          `;
        }

        return "";
      }

      function renderRailPostCard(post, forceTextOnly = false) {
        const title = post.seo_title || makeTitle(post.text);
        const excerpt = post.seo_description || makeExcerpt(post.text);
        const href = `/post/${encodeURIComponent(post.slug)}`;
        const textOnly = forceTextOnly || isTextOnlyPost(post);

        return `
          <article class="category-card ${isAudioPost(post) && !forceTextOnly ? "category-card--audio" : ""} ${textOnly ? "category-card--text-only" : ""}" data-href="${escapeAttr(href)}" aria-label="${escapeAttr(title)}">
            ${renderRailMedia(post, forceTextOnly)}
            <div class="category-card__body">
              <div class="category-card__meta">
                <span>${escapeHtml(formatDate(post.created_at))}</span>
              </div>
              <h3><a href="${escapeAttr(href)}">${escapeHtml(title)}</a></h3>
              <p>${escapeHtml(excerpt)}</p>
              <a class="category-card__cta" href="${escapeAttr(href)}" aria-label="${escapeAttr(title)}">ادامه مطلب</a>
            </div>
          </article>
        `;
      }

      function renderCategorySection(group, index) {
        const { title, posts, forceTextOnlyRail } = group;
        if (!posts.length) return "";

        return `
          <section class="category-rail" aria-labelledby="post-row-${index}">
            <header class="category-rail__header">
              <h2 id="post-row-${index}">${escapeHtml(title)}</h2>
              <div class="category-rail__controls">
                <button type="button" class="category-rail__button" data-scroll-dir="-1" aria-label="قبلی">‹</button>
                <button type="button" class="category-rail__button" data-scroll-dir="1" aria-label="بعدی">›</button>
              </div>
            </header>
            <div class="category-rail__viewport">
              ${posts.map((post) => renderRailPostCard(post, forceTextOnlyRail)).join("")}
            </div>
          </section>
        `;
      }

      function buildPostGroups(posts) {
        const rest = posts.slice(1);
        const groups = CATEGORY_DEFINITIONS.map((category) => ({
          title: category.title,
          posts: rest.filter((post) => postHasCategory(post, category)),
          forceTextOnlyRail: category.title === POETRY_TEXT_CATEGORY_TITLE
        }));

        return groups.filter((group) => group.posts.length);
      }

      function renderPosts(posts) {
        if (!posts.length) {
          featuredEl.innerHTML = "";
          statsEl.innerHTML = "";
          gridEl.innerHTML = "";
          categoryRailsEl.innerHTML = "";
          statusEl.style.display = "block";
          renderMessageStatus("هنوز پستی برای نمایش وجود ندارد.", "empty");
          return;
        }

        statusEl.style.display = "none";
        statusEl.classList.remove("client-status-loading", "client-status-error");

        const featured = posts[0];
        const groups = buildPostGroups(posts);

        featuredEl.innerHTML = renderFeaturedPost(featured);
        renderStats(posts);
        renderAllPostsList(posts);
        categoryRailsEl.innerHTML = groups
          .map((group, index) => renderCategorySection(group, index))
          .join("");
        setupRowDragging();
      }

      function applySearch() {
        const rawQuery = String(searchEl.value || "").trim();
        const q = normalizeDigits(rawQuery).toLowerCase().replace(/^#/, "");

        if (!q) {
          renderPosts(allPosts);
          return;
        }

        const filtered = allPosts.filter((post) => {
          const id = String(post.id || "");
          const haystack = normalizeDigits([
            post.id,
            `#${post.id}`,
            `کد ${post.id}`,
            `کد مطلب ${post.id}`,
            post.text,
            post.slug,
            post.media_type,
            post.media_file_name,
            getTags(post.text).join(" ")
          ].join(" ")).toLowerCase();

          return id === q || haystack.includes(q);
        });

        renderPosts(filtered);

        if (!filtered.length) {
          statusEl.style.display = "block";
          renderMessageStatus("نتیجه‌ای برای جستجوی شما پیدا نشد.", "empty");
        }
      }

      async function loadPosts() {
        const controller = new AbortController();
        const timer = window.setTimeout(() => controller.abort(), 2500);

        try {
          statusEl.style.display = "block";
          renderLoadingStatus();

          const response = await fetch(`${API_BASE}/`, {
            method: "GET",
            signal: controller.signal,
            headers: {
              Accept: "application/json"
            }
          });

          if (!response.ok) {
            throw new Error(`API error ${response.status}`);
          }

          const payload = await response.json();

          allPosts = extractPosts(payload).sort((a, b) => {
            const aTime = new Date(String(a.created_at).replace(" ", "T")).getTime();
            const bTime = new Date(String(b.created_at).replace(" ", "T")).getTime();

            if (bTime !== aTime) return bTime - aTime;

            return Number(b.id || 0) - Number(a.id || 0);
          });

          renderPosts(allPosts);
        } catch (error) {
          console.debug("Mahoon client posts fallback:", error);
          featuredEl.innerHTML = "";
          statsEl.innerHTML = "";
          gridEl.innerHTML = "";
          categoryRailsEl.innerHTML = "";
          statusEl.style.display = "none";
        } finally {
          window.clearTimeout(timer);
        }
      }

      function resetAudioButton(button) {
        if (!button) return;
        button.textContent = "پخش";
        button.classList.remove("is-playing");
        const progress = button
          .closest(".client-audio-card-media")
          ?.querySelector(".client-audio-progress span");
        if (progress) progress.style.transform = "scaleX(0)";
      }

      function updateAudioProgress() {
        if (!activeAudioButton || !sharedAudio.duration) return;

        const progress = activeAudioButton
          .closest(".client-audio-card-media")
          ?.querySelector(".client-audio-progress span");
        if (!progress) return;

        progress.style.transform = `scaleX(${Math.min(
          sharedAudio.currentTime / sharedAudio.duration,
          1
        )})`;
      }

      document.addEventListener("click", (event) => {
        const audioButton = event.target.closest(".client-audio-play");
        const rowButton = event.target.closest(".category-rail__button");

        if (audioButton) {
          event.preventDefault();
          event.stopPropagation();

          const src = audioButton.dataset.audioSrc;
          if (!src || audioButton.disabled) return;

          if (activeAudioButton === audioButton && !sharedAudio.paused) {
            sharedAudio.pause();
            resetAudioButton(audioButton);
            activeAudioButton = null;
            return;
          }

          resetAudioButton(activeAudioButton);
          activeAudioButton = audioButton;
          sharedAudio.src = src;
          sharedAudio.play().catch(() => {
            resetAudioButton(audioButton);
            activeAudioButton = null;
          });
          audioButton.textContent = "توقف";
          audioButton.classList.add("is-playing");
        }

        if (rowButton) {
          const row = rowButton
            .closest(".category-rail")
            ?.querySelector(".category-rail__viewport");
          if (!row) return;

          row.scrollBy({
            left: Number(rowButton.dataset.scrollDir || 1) * row.clientWidth * 0.85,
            behavior: "smooth"
          });
        }

        const categoryCard = event.target.closest(".category-card[data-href]");
        if (categoryCard && !event.target.closest("a, button")) {
          const href = categoryCard.dataset.href;
          if (href) window.location.href = href;
        }
      });

      function setupRowDragging() {
        document.querySelectorAll(".category-rail__viewport").forEach((row) => {
          if (row.dataset.dragReady === "true") return;

          row.dataset.dragReady = "true";
          const dragClickThreshold = 6;
          let activePointerId = null;
          let startX = 0;
          let startY = 0;
          let scrollLeft = 0;
          let didDrag = false;
          let suppressClick = false;

          const finishDrag = (event) => {
            if (activePointerId !== event.pointerId) return;

            activePointerId = null;
            row.classList.remove("is-dragging");
            row.releasePointerCapture?.(event.pointerId);
            suppressClick = didDrag;
          };

          row.addEventListener("pointerdown", (event) => {
            if (event.button !== undefined && event.button !== 0) return;

            activePointerId = event.pointerId;
            row.classList.add("is-dragging");
            row.setPointerCapture?.(event.pointerId);
            startX = event.clientX;
            startY = event.clientY;
            scrollLeft = row.scrollLeft;
            didDrag = false;
            suppressClick = false;
          });

          row.addEventListener("pointerleave", () => {
            if (activePointerId === null) row.classList.remove("is-dragging");
          });

          row.addEventListener("pointerup", finishDrag);
          row.addEventListener("pointercancel", finishDrag);

          row.addEventListener("pointermove", (event) => {
            if (activePointerId !== event.pointerId) return;
            const deltaX = event.clientX - startX;
            const deltaY = event.clientY - startY;

            if (!didDrag && Math.hypot(deltaX, deltaY) > dragClickThreshold) {
              didDrag = true;
            }

            if (didDrag) {
              event.preventDefault();
              row.scrollLeft = scrollLeft - deltaX;
            }
          });

          row.addEventListener(
            "click",
            (event) => {
              if (!suppressClick) return;
              event.preventDefault();
              event.stopPropagation();
              suppressClick = false;
            },
            true
          );
        });
      }

      sharedAudio.addEventListener("timeupdate", updateAudioProgress);
      sharedAudio.addEventListener("ended", () => {
        resetAudioButton(activeAudioButton);
        activeAudioButton = null;
      });

      typeHeroQuote();
      searchEl.addEventListener("input", applySearch);
      loadPosts();
    })();
  </script>

