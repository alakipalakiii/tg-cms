---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";

export const prerender = false;

async function fetchJsonWithTimeout(url: string, timeoutMs = 1200) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeoutMs);

  try {
    const res = await fetch(url, { signal: controller.signal });
    if (!res.ok) return null;
    return await res.json();
  } catch {
    return null;
  } finally {
    clearTimeout(timer);
  }
}

async function loadSiteSettings() {
  const settingsUrl = SITE.workerUrl.replace(/\/+$/, "") + "/site-settings";
  const payload = await fetchJsonWithTimeout(settingsUrl);
  return payload?.settings || {};
}

const siteSettings = await loadSiteSettings();

const pageTitle = siteSettings.site_name || SITE.name;
const pageDescription = siteSettings.header_description || SITE.description;
const heroLineOne = siteSettings.home_hero_line_one || "درخت هنر، زمانی میوه خواهد داد";
const heroLineTwo = siteSettings.home_hero_line_two || "که ریشه آن خشکیده نشده باشد!";
const latestTitle = siteSettings.home_latest_title || "تازه‌ترین روایت منتشرشده در ماهون";

const homeConfig = {
  apiBase: SITE.workerUrl || "https://api.mahoonartmagazine.ir",
  heroLineOne,
  heroLineTwo,
  categories: [
    { title: "کتاب", tags: ["کتاب"] },
    { title: "دیالوگ ها", tags: ["دیالوگ", "دیالوگ‌ها", "دیالوگ_ها"] },
    { title: "صوتی", tags: ["صوتی", "صدا", "موسیقی"] },
    { title: "شعر و متن", tags: ["متن", "متن‌ها", "متن_ها", "شعر", "اشعار", "شعرها", "شعر_ها"] },
    { title: "نقاشی", tags: ["نقاشی"] }
  ],
  ads: {
    rightTitle: siteSettings.home_ad_right_title || "جایگاه تبلیغات",
    rightText: siteSettings.home_ad_right_text || "معرفی رویداد، کتاب، نمایشگاه یا همکاری فرهنگی",
    rightUrl: siteSettings.home_ad_right_url || "",
    leftTitle: siteSettings.home_ad_left_title || "جایگاه تبلیغات",
    leftText: siteSettings.home_ad_left_text || "معرفی برندها و پروژه‌های همسو با فضای هنری ماهون",
    leftUrl: siteSettings.home_ad_left_url || ""
  }
};

function safeJson(value: any) {
  return JSON.stringify(value).replace(/</g, "\\u003c");
}
---

<BaseLayout title={pageTitle} description={pageDescription} siteSettings={siteSettings}>
  <main class="m-home m-home-clean-v2">
    <section class="m-hero" aria-label="شعار مجله هنری ماهون">
      <div class="m-hero__panel">
        <h1 class="m-typewriter" aria-label={heroLineOne + " " + heroLineTwo}>
          <span class="m-type-line" data-type-text={heroLineOne}>{heroLineOne}</span>
          <span class="m-type-line" data-type-text={heroLineTwo}>{heroLineTwo}</span>
        </h1>
      </div>
    </section>

    <section class="m-section-title">
      <span>{latestTitle}</span>
    </section>

    <section class="m-featured-wrap">
      <div id="mFeatured"></div>
      <div id="mStatus" class="m-status">در حال دریافت مطالب...</div>
    </section>

    <section id="mStats" class="m-stats" aria-label="آمار مطالب ماهون"></section>

    <section class="m-search-wrap">
      <label class="m-search">
        <span aria-hidden="true">⌕</span>
        <input id="mSearch" type="search" placeholder="جست‌وجو در مطالب..." autocomplete="off" />
      </label>
    </section>

    <section class="m-all">
      <div class="m-heading">
        <h2 id="mAllTitle">همه مطالب</h2>
        <a href="/posts">مشاهده همه مطالب</a>
      </div>
      <div class="m-all-scroll">
        <div id="mAllGrid" class="m-all-grid"></div>
      </div>
    </section>

    <section class="m-ads" aria-label="تبلیغات">
      <article class="m-ad-card">
        <strong>{homeConfig.ads.rightTitle}</strong>
        <p>{homeConfig.ads.rightText}</p>
        {homeConfig.ads.rightUrl ? <a href={homeConfig.ads.rightUrl} target="_blank" rel="noopener">مشاهده</a> : <span>جایگاه قابل مدیریت</span>}
      </article>

      <article class="m-ad-card">
        <strong>{homeConfig.ads.leftTitle}</strong>
        <p>{homeConfig.ads.leftText}</p>
        {homeConfig.ads.leftUrl ? <a href={homeConfig.ads.leftUrl} target="_blank" rel="noopener">مشاهده</a> : <span>جایگاه قابل مدیریت</span>}
      </article>
    </section>

    <section id="mCategories" class="m-categories" aria-label="دسته‌بندی مطالب ماهون"></section>

    <script id="mHomeConfig" type="application/json" set:html={safeJson(homeConfig)}></script>
  </main>

  <script is:inline>
    (() => {
      const config = JSON.parse(document.getElementById("mHomeConfig")?.textContent || "{}");
      const API_BASE = String(config.apiBase || "https://api.mahoonartmagazine.ir").replace(/\/+$/, "");
      const categories = Array.isArray(config.categories) ? config.categories : [];

      const featuredEl = document.getElementById("mFeatured");
      const statusEl = document.getElementById("mStatus");
      const statsEl = document.getElementById("mStats");
      const searchEl = document.getElementById("mSearch");
      const allGridEl = document.getElementById("mAllGrid");
      const allTitleEl = document.getElementById("mAllTitle");
      const categoriesEl = document.getElementById("mCategories");

      let latestPosts = [];
      let stats = null;
      let categoryPayloads = [];

      function startTypewriter() {
        const lines = Array.from(document.querySelectorAll(".m-type-line"));

        lines.forEach((line) => {
          line.textContent = "";
        });

        let lineIndex = 0;
        let charIndex = 0;

        function type() {
          const line = lines[lineIndex];
          if (!line) return;

          const text = line.getAttribute("data-type-text") || "";

          if (charIndex <= text.length) {
            line.textContent = text.slice(0, charIndex);
            charIndex += 1;
            window.setTimeout(type, 34);
            return;
          }

          lineIndex += 1;
          charIndex = 0;

          if (lineIndex < lines.length) {
            window.setTimeout(type, 220);
          }
        }

        window.setTimeout(type, 260);
      }

      function escapeHtml(value) {
        return String(value || "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      function escapeAttr(value) {
        return escapeHtml(value);
      }

      function toPersianNumber(value) {
        return String(value ?? "")
          .replace(/0/g, "۰")
          .replace(/1/g, "۱")
          .replace(/2/g, "۲")
          .replace(/3/g, "۳")
          .replace(/4/g, "۴")
          .replace(/5/g, "۵")
          .replace(/6/g, "۶")
          .replace(/7/g, "۷")
          .replace(/8/g, "۸")
          .replace(/9/g, "۹");
      }

      function normalizeTag(tag) {
        return String(tag || "")
          .replace(/^#/, "")
          .replace(/[يى]/g, "ی")
          .replace(/ك/g, "ک")
          .replace(/\u200c/g, "")
          .replace(/\s+/g, " ")
          .trim()
          .toLowerCase();
      }

      const categoryTags = new Set(categories.flatMap((category) => category.tags.map(normalizeTag)));

      function getTags(text) {
        return Array.from(new Set(
          Array.from(String(text || "").matchAll(/(^|\s)#([^\s#]+)/gu))
            .map((match) => match[2])
            .filter(Boolean)
        ));
      }

      function stripMovieCreditLines(value) {
        return String(value || "")
          .split(/\r?\n/)
          .filter((line) => {
            const trimmed = line.trim();
            if (!trimmed) return true;
            if (/^(?:🎥|🎬|فیلم\s*:?)\s*#?\s*.+$/iu.test(trimmed)) return false;
            return true;
          })
          .join("\n");
      }

      function cleanPublicText(value) {
        return String(stripMovieCreditLines(value) || "")
          .replace(/\u{1F539}?\s*@mahoonartmagazine/giu, "")
          .replace(/https?:\/\/[^\s]+/giu, "")
          .replace(/@[a-zA-Z0-9_]+/g, "")
          .replace(/(^|\s)#([^\n#]+)/gu, " ")
          .replace(/[🎥🎬]/gu, "")
          .replace(/[؟?]/g, "")
          .replace(/[•●▪▫◦]/g, "")
          .replace(/\s+/g, " ")
          .trim();
      }

      function truncateText(value, max) {
        const source = String(value || "").replace(/\s+/g, " ").trim();
        if (!source) return "";
        return source.length <= max ? source : source.slice(0, max).trim() + "…";
      }

      function firstWords(value, maxWords) {
        return String(value || "")
          .replace(/\s+/g, " ")
          .trim()
          .split(" ")
          .filter(Boolean)
          .slice(0, maxWords)
          .join(" ");
      }

      function extractMovieTitle(value) {
        const lines = String(value || "").split(/\r?\n/);

        for (const line of lines) {
          const match = line.trim().match(/^(?:🎥|🎬|فیلم\s*:?)\s*#?\s*(.+)$/iu);
          if (match?.[1]) return match[1].replace(/^#/, "").trim();
        }

        return "";
      }

      function isDialoguePost(post) {
        return /#(?:دیالوگ|دیالوگ‌ها|دیالوگ_ها)/u.test(String(post.text || ""));
      }

      function makeTitle(post) {
        const movie = extractMovieTitle(post.text);

        if (movie && isDialoguePost(post)) {
          return "دیالوگی از فیلم ‎" + movie + "‎";
        }

        const seoTitle = cleanPublicText(post.seo_title);
        if (seoTitle && seoTitle.length <= 70) return truncateText(seoTitle, 70);

        const source = cleanPublicText(post.text);
        return truncateText(firstWords(source, 9), 72) || "مطلبی از ماهون";
      }

      function makeExcerpt(post) {
        const source = cleanPublicText(post.seo_description) || cleanPublicText(post.text);
        return truncateText(source || "روایتی تازه از مجله هنری ماهون", 145);
      }

      function formatDate(value) {
        if (!value) return "";

        try {
          return new Intl.DateTimeFormat("fa-IR", {
            year: "numeric",
            month: "long",
            day: "numeric"
          }).format(new Date(String(value).replace(" ", "T")));
        } catch {
          return "";
        }
      }

      function href(post) {
        const slug = String(post.slug || post.id || "").trim();
        return "/post/" + encodeURIComponent(slug);
      }

      function mediaSrc(post, forceTextOnly = false) {
        if (forceTextOnly) return "";

        const type = String(post.media_type || "").toLowerCase();
        if (type && !["photo", "image"].includes(type)) return "";

        const direct = post.photo_url || post.image_url || post.thumbnail_url || post.media_url;
        if (direct && /\.(avif|webp|png|jpe?g|gif|bmp|svg)(\?|#|$)/i.test(String(direct))) {
          return direct;
        }

        const fileId = post.photo_file_id || post.media_file_id;
        return fileId ? API_BASE + "/media/" + encodeURIComponent(fileId) : "";
      }

      function pencilIcon() {
        return '<svg viewBox="0 0 64 64" aria-hidden="true"><path d="M43.6 8.8a6.5 6.5 0 0 1 9.2 9.2L25.1 45.7l-12.3 3.5 3.5-12.3L43.6 8.8Z"></path><path d="M38.8 13.6 48 22.8"></path><path d="M12 55h40"></path></svg>';
      }

      function normalizePost(raw) {
        const id = raw?.id ?? raw?.telegram_message_id ?? "";

        return {
          ...raw,
          id,
          text: raw?.text || raw?.caption || "",
          slug: raw?.slug || id,
          created_at: raw?.created_at || raw?.date || raw?.updated_at || "",
          media_type: raw?.media_type || "",
          photo_file_id: raw?.photo_file_id || "",
          media_file_id: raw?.media_file_id || "",
          seo_title: raw?.seo_title || "",
          seo_description: raw?.seo_description || ""
        };
      }

      function extractPosts(payload) {
        const source = Array.isArray(payload)
          ? payload
          : Array.isArray(payload?.posts)
            ? payload.posts
            : Array.isArray(payload?.data)
              ? payload.data
              : [];

        return source.map(normalizePost).filter((post) => post.id);
      }

      function publicTags(post) {
        return getTags(post.text)
          .filter((tag) => !categoryTags.has(normalizeTag(tag)))
          .filter((tag) => !/^the\s+walking\s+dead$/i.test(String(tag).trim()))
          .slice(0, 3);
      }

      function renderTags(post) {
        const tags = publicTags(post);
        if (!tags.length) return "";

        return '<div class="m-tags">' + tags.map((tag) =>
          '<a href="/tag/' + encodeURIComponent(tag) + '">#' + escapeHtml(tag) + '</a>'
        ).join("") + '</div>';
      }

      function renderFeatured(post) {
        if (!post) {
          featuredEl.innerHTML = "";
          return;
        }

        const title = makeTitle(post);
        const image = mediaSrc(post);
        const imageHtml = image
          ? '<a class="m-featured__media" href="' + escapeAttr(href(post)) + '"><img src="' + escapeAttr(image) + '" alt="' + escapeAttr(title) + '" loading="lazy" decoding="async"></a>'
          : '<a class="m-featured__media m-featured__media--text" href="' + escapeAttr(href(post)) + '">' + pencilIcon() + '</a>';

        featuredEl.innerHTML =
          '<article class="m-featured">' +
            imageHtml +
            '<div class="m-featured__body">' +
              '<div class="m-meta"><span>' + escapeHtml(formatDate(post.created_at)) + '</span></div>' +
              '<h2>' + escapeHtml(title) + '</h2>' +
              '<p>' + escapeHtml(makeExcerpt(post)) + '</p>' +
              renderTags(post) +
              '<a class="m-btn" href="' + escapeAttr(href(post)) + '">ادامه مطلب</a>' +
            '</div>' +
          '</article>';
      }

      function renderStats() {
        const visible = Number(stats?.visible_posts || latestPosts.length || 0);
        const active = Number(stats?.active_categories || 0);
        const latestId = Number(stats?.latest_id || latestPosts[0]?.id || 0);
        const textPosts = Number(stats?.text_posts || 0);

        statsEl.innerHTML =
          '<article><strong>' + toPersianNumber(visible) + '</strong><span>مطالب منتشرشده</span></article>' +
          '<article><strong>' + toPersianNumber(active) + '</strong><span>دسته‌بندی فعال</span></article>' +
          '<article><strong>' + toPersianNumber(latestId) + '</strong><span>آخرین کد مطلب</span></article>' +
          '<article><strong>' + toPersianNumber(textPosts) + '</strong><span>مطالب متنی</span></article>';
      }

      function renderList(posts) {
        allGridEl.innerHTML = posts.slice(0, 20).map((post) => {
          const title = makeTitle(post);
          const image = mediaSrc(post);
          const thumb = image
            ? '<img src="' + escapeAttr(image) + '" alt="' + escapeAttr(title) + '" loading="lazy" decoding="async">'
            : pencilIcon();

          return '<a class="m-list-row" href="' + escapeAttr(href(post)) + '">' +
            '<span class="m-list-row__thumb ' + (!image ? "m-list-row__thumb--icon" : "") + '">' + thumb + '</span>' +
            '<span class="m-list-row__copy">' +
              '<strong>' + escapeHtml(title) + '</strong>' +
              '<small>' + escapeHtml(formatDate(post.created_at)) + '</small>' +
            '</span>' +
          '</a>';
        }).join("");
      }

      function renderCard(post, forceTextOnly = false) {
        const title = makeTitle(post);
        const image = mediaSrc(post, forceTextOnly);
        const imageHtml = image
          ? '<a class="m-card__media" href="' + escapeAttr(href(post)) + '"><img src="' + escapeAttr(image) + '" alt="' + escapeAttr(title) + '" loading="lazy" decoding="async"></a>'
          : '<a class="m-card__media m-card__media--icon" href="' + escapeAttr(href(post)) + '">' + pencilIcon() + '</a>';

        return '<article class="m-card">' +
          imageHtml +
          '<div class="m-card__body">' +
            '<span class="m-card__date">' + escapeHtml(formatDate(post.created_at)) + '</span>' +
            '<h3>' + escapeHtml(title) + '</h3>' +
            '<p>' + escapeHtml(makeExcerpt(post)) + '</p>' +
            '<a class="m-card__cta" href="' + escapeAttr(href(post)) + '">ادامه مطلب</a>' +
          '</div>' +
        '</article>';
      }

      function bindRailButtons() {
        document.querySelectorAll("[data-rail-btn]").forEach((button) => {
          button.addEventListener("click", () => {
            const rail = button.closest(".m-rail");
            const scroller = rail?.querySelector(".m-card-strip");
            const dir = Number(button.getAttribute("data-dir") || "1");
            if (!scroller) return;

            scroller.scrollBy({
              left: dir * 330,
              behavior: "smooth"
            });
          });
        });
      }

      function renderCategories() {
        const categoryMap = stats?.category_map || {};

        categoriesEl.innerHTML = categoryPayloads.map((item, index) => {
          const category = item.category;
          const posts = item.posts || [];
          const total = Number(item.total ?? categoryMap[category.title] ?? posts.length);

          if (!posts.length && !total) return "";

          const tone = index % 2 === 0 ? "m-rail--light" : "m-rail--dark";
          const forceTextOnly = category.title === "شعر و متن";
          const allHref = "/category/" + encodeURIComponent(category.title);

          return '<section class="m-rail ' + tone + '">' +
            '<header class="m-rail__head">' +
              '<div><span>دسته‌بندی ماهون</span><h2>' + escapeHtml(category.title) + '</h2></div>' +
              '<div class="m-rail__actions">' +
                '<a href="' + escapeAttr(allHref) + '">مشاهده همه ' + toPersianNumber(total) + ' مطلب</a>' +
                '<button type="button" data-rail-btn data-dir="-1" aria-label="قبلی">‹</button>' +
                '<button type="button" data-rail-btn data-dir="1" aria-label="بعدی">›</button>' +
              '</div>' +
            '</header>' +
            '<div class="m-card-strip">' +
              posts.slice(0, 10).map((post) => renderCard(post, forceTextOnly)).join("") +
            '</div>' +
          '</section>';
        }).join("");

        bindRailButtons();
      }

      async function api(path, params = {}) {
        const url = new URL(API_BASE + path);
        Object.entries(params).forEach(([key, value]) => {
          if (value !== undefined && value !== null && value !== "") {
            url.searchParams.set(key, String(value));
          }
        });

        const res = await fetch(url.toString(), {
          headers: { Accept: "application/json" },
          cache: "no-store"
        });

        if (!res.ok) throw new Error("HTTP " + res.status);
        return res.json();
      }

      async function loadHome() {
        try {
          startTypewriter();

          statusEl.hidden = false;
          statusEl.textContent = "در حال دریافت مطالب...";

          const [postsPayload, statsPayload, ...categoryResults] = await Promise.all([
            api("/public/posts-v1", { limit: 20, offset: 0 }),
            api("/public/stats-v1"),
            ...categories.map((category) =>
              api("/public/posts-v1", { category: category.title, limit: 10, offset: 0 })
                .then((payload) => ({ category, posts: extractPosts(payload), total: payload.total }))
                .catch(() => ({ category, posts: [], total: 0 }))
            )
          ]);

          latestPosts = extractPosts(postsPayload);
          stats = statsPayload?.stats || null;
          categoryPayloads = categoryResults;

          if (!latestPosts.length) throw new Error("No posts");

          renderFeatured(latestPosts[0]);
          renderStats();
          renderList(latestPosts);
          renderCategories();

          statusEl.hidden = true;
        } catch (error) {
          console.error(error);
          statusEl.hidden = false;
          statusEl.textContent = "دریافت مطالب انجام نشد. لطفاً صفحه را دوباره Refresh کنید.";
        }
      }

      let searchTimer = null;

      searchEl?.addEventListener("input", () => {
        clearTimeout(searchTimer);

        searchTimer = setTimeout(async () => {
          const q = String(searchEl.value || "").trim();

          if (!q) {
            allTitleEl.textContent = "همه مطالب";
            categoriesEl.hidden = false;
            renderFeatured(latestPosts[0]);
            renderList(latestPosts);
            return;
          }

          try {
            allTitleEl.textContent = "نتایج جستجو";
            categoriesEl.hidden = true;

            const payload = await api("/public/posts-v1", { q, limit: 20, offset: 0 });
            const results = extractPosts(payload);

            renderFeatured(results[0] || null);
            renderList(results);

            if (!results.length) {
              allGridEl.innerHTML = '<div class="m-empty">نتیجه‌ای برای جستجوی شما پیدا نشد.</div>';
            }
          } catch {
            allGridEl.innerHTML = '<div class="m-empty">جستجو انجام نشد.</div>';
          }
        }, 300);
      });

      loadHome();
    })();
  </script>


  <style is:global>
    .m-home {
      direction: rtl;
      width: min(1180px, calc(100% - 28px));
      margin: 0 auto;
      padding: 26px 0 76px;
    }

    .m-hero {
      margin-bottom: 30px;
    }

    .m-hero__panel {
      min-height: 210px;
      display: grid;
      place-items: center;
      border-radius: 30px;
      padding: 34px 24px;
      background:
        linear-gradient(rgba(255, 253, 248, 0.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 253, 248, 0.04) 1px, transparent 1px),
        #4b0d0d;
      background-size: 42px 42px, 42px 42px, auto;
      color: #fff8ef;
      text-align: center;
      box-shadow: 0 18px 44px rgba(75, 13, 13, 0.14);
    }

    .m-hero h1 {
      margin: 0;
      display: grid;
      gap: 5px;
      font-size: clamp(24px, 3.45vw, 40px);
      line-height: 1.8;
      font-weight: 900;
    }

    .m-type-line {
      min-height: 1.8em;
      display: block;
      white-space: normal;
    }

    .m-section-title {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      margin: 0 0 20px;
      color: #5a0f0f;
      font-size: 25px;
      font-weight: 900;
      text-align: center;
    }

    .m-section-title::before,
    .m-section-title::after {
      content: "";
      height: 1px;
      flex: 1;
      max-width: 290px;
      background: rgba(75, 13, 13, 0.18);
    }

    .m-status {
      margin: 16px 0;
      border-radius: 22px;
      background: rgba(255, 253, 248, 0.82);
      border: 1px solid rgba(75, 13, 13, 0.12);
      padding: 22px;
      text-align: center;
      color: rgba(75, 13, 13, 0.68);
      font-weight: 900;
    }

    .m-status[hidden],
    [hidden] {
      display: none !important;
    }

    .m-featured {
      direction: ltr;
      display: grid;
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      grid-template-areas: "media body";
      overflow: hidden;
      border: 1px solid rgba(75, 13, 13, 0.13);
      border-radius: 30px;
      background:
        radial-gradient(circle at 15% 0%, rgba(184, 135, 70, 0.12), transparent 30%),
        rgba(255, 253, 248, 0.88);
