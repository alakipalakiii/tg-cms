---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";
import { MAHOON_CATEGORIES } from "../lib/taxonomy";
import {
  fetchHomeSnapshot,
  renderHomeAdsHtml,
  renderHomeCategoriesHtml,
  renderHomeFeaturedHtml,
  renderHomeListHtml,
  renderHomeStatsHtml
} from "../lib/home";

export const prerender = false;

async function fetchJsonWithTimeout(url: string, timeoutMs = 1200) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeoutMs);

  try {
    const res = await fetch(url, { signal: controller.signal });
    if (!res.ok) return null;
    return await res.json();
  } catch {
    return null;
  } finally {
    clearTimeout(timer);
  }
}

async function loadSiteSettings() {
  const settingsUrl = SITE.workerUrl.replace(/\/+$/, "") + "/site-settings";
  const payload = await fetchJsonWithTimeout(settingsUrl);
  return payload?.settings || {};
}

// MAHOON_STAGE18C_R4_TIMING settings
const __mahoonStage18CR4SettingsStartedAt = Date.now();
const siteSettings = await loadSiteSettings();
const __mahoonStage18CR4SettingsDuration = Date.now() - __mahoonStage18CR4SettingsStartedAt;

const pageTitle = siteSettings.site_name || SITE.name;
const pageDescription = siteSettings.header_description || SITE.description;
const heroLineOne = siteSettings.home_hero_line_one || "درخت هنر، زمانی میوه خواهد داد";
const heroLineTwo = siteSettings.home_hero_line_two || "که ریشه آن خشکیده نشده باشد!";
const latestTitle = siteSettings.home_latest_title || "تازه‌ترین روایت منتشرشده در ماهون";

const homeConfig = {
  apiBase: SITE.workerUrl || "https://api.mahoonartmagazine.ir",
  heroLineOne,
  heroLineTwo,
  categories: MAHOON_CATEGORIES,
  ads: {
    rightEnabled: siteSettings.home_ad_right_enabled ?? "1",
    rightTitle: siteSettings.home_ad_right_title || "جایگاه تبلیغات",
    rightText: siteSettings.home_ad_right_text || "معرفی رویداد، کتاب، نمایشگاه یا همکاری فرهنگی",
    rightUrl: siteSettings.home_ad_right_url || "",
    rightButton: siteSettings.home_ad_right_button || "مشاهده",
    rightPosition: siteSettings.home_ad_right_position || "before_categories",
    rightImage: siteSettings.home_ad_right_image || "",
    leftEnabled: siteSettings.home_ad_left_enabled ?? "1",
    leftTitle: siteSettings.home_ad_left_title || "جایگاه تبلیغات",
    leftText: siteSettings.home_ad_left_text || "معرفی برندها و پروژه‌های همسو با فضای هنری ماهون",
    leftUrl: siteSettings.home_ad_left_url || "",
    leftButton: siteSettings.home_ad_left_button || "مشاهده",
    leftPosition: siteSettings.home_ad_left_position || "before_categories",
    leftImage: siteSettings.home_ad_left_image || ""
  }
};

// mahoon-home-ssr-v1
// MAHOON_STAGE18C_R4_TIMING home
const __mahoonStage18CR4HomeStartedAt = Date.now();
const homeSnapshot = await fetchHomeSnapshot({
  apiBase: homeConfig.apiBase,
  categories: homeConfig.categories,
  timeoutMs: 6000
});
const __mahoonStage18CR4HomeDuration = Date.now() - __mahoonStage18CR4HomeStartedAt;
// MAHOON_STAGE18E_R5_R4_AUTHORITATIVE_TIMING
const __mahoonStage18ER5R4Internal = (homeSnapshot as any).__stage18eR5R4Timing;
if (__mahoonStage18ER5R4Internal) {
  const __mahoonStage18ER5R4Header = `primary;dur=${__mahoonStage18ER5R4Internal.primaryMs},categories;dur=${__mahoonStage18ER5R4Internal.categoryGroupMs},snapshot;dur=${__mahoonStage18ER5R4Internal.snapshotMs},assembly;dur=${__mahoonStage18ER5R4Internal.assemblyMs}`;
  Astro.response.headers.set("X-Mahoon-Stage18E-R5-R4-Internal-Timing", __mahoonStage18ER5R4Header);
  Astro.response.headers.append("Server-Timing", `mahoonPrimary;dur=${__mahoonStage18ER5R4Internal.primaryMs},mahoonCategories;dur=${__mahoonStage18ER5R4Internal.categoryGroupMs},mahoonSnapshot;dur=${__mahoonStage18ER5R4Internal.snapshotMs},mahoonAssembly;dur=${__mahoonStage18ER5R4Internal.assemblyMs}`);
}
const __mahoonStage18CR4Timing = `settings;dur=${__mahoonStage18CR4SettingsDuration},home;dur=${__mahoonStage18CR4HomeDuration}`;
Astro.response.headers.set("X-Mahoon-Stage18C-R4-Timing", __mahoonStage18CR4Timing);
Astro.response.headers.append("Server-Timing", `mahoonSettings;dur=${__mahoonStage18CR4SettingsDuration},mahoonHome;dur=${__mahoonStage18CR4HomeDuration}`);

if (!homeSnapshot.ok) {
  Astro.response.status = 503;
  Astro.response.statusText = "Service Unavailable";
  Astro.response.headers.set("Retry-After", "60");
}

const initialFeaturedHtml = renderHomeFeaturedHtml({
  post: homeSnapshot.posts[0] || null,
  apiBase: homeConfig.apiBase,
  categories: homeConfig.categories
});
const initialStatsHtml = renderHomeStatsHtml(homeSnapshot.stats, homeSnapshot.posts);
const initialListHtml = renderHomeListHtml(homeSnapshot.posts, homeConfig.apiBase);
const initialCategoriesHtml = renderHomeCategoriesHtml({
  categories: homeSnapshot.categories,
  stats: homeSnapshot.stats,
  apiBase: homeConfig.apiBase,
  ads: homeConfig.ads
});
const adsAfterLatest = renderHomeAdsHtml(homeConfig.ads, "after_latest");
const adsAfterAllPosts = renderHomeAdsHtml(homeConfig.ads, "after_all_posts");
const adsBeforeCategories = renderHomeAdsHtml(homeConfig.ads, "before_categories");
const adsAfterCategories = renderHomeAdsHtml(homeConfig.ads, "after_categories");
const clientHomeConfig = {
  ...homeConfig,
  initialPosts: homeSnapshot.posts
};

function safeJson(value: unknown) {
  return JSON.stringify(value).replace(/</g, "\\u003c");
}
---

<BaseLayout
  preloadMahoorExtraBold={true} title={pageTitle} description={pageDescription} siteSettings={siteSettings}>
  <main class="m-home m-home-clean-v4">
    <section class="m-hero" aria-label="شعار مجله هنری ماهون">
      <div class="m-hero__panel">
        <h1 class="m-typewriter" aria-label={heroLineOne + " " + heroLineTwo}>
          <span class="m-type-line" data-type-text={heroLineOne}>{heroLineOne}</span>
          <span class="m-type-line" data-type-text={heroLineTwo}>{heroLineTwo}</span>
        </h1>
      </div>
    </section>

    <section class="m-section-title">
      <span>{latestTitle}</span>
    </section>

    <section class="m-featured-wrap">
      <div id="mFeatured" set:html={initialFeaturedHtml}></div>
      <div id="mStatus" class="m-status" hidden={homeSnapshot.ok}>
        {homeSnapshot.ok ? "" : "دریافت مطالب موقتاً امکان‌پذیر نیست. لطفاً کمی بعد دوباره تلاش کنید."}
      </div>
    </section>

    <section
      id="mAdsAfterLatest"
      class:list={["m-ads", "m-ads-slot", adsAfterLatest.count === 1 && "m-ads--single"]}
      aria-label="تبلیغات بعد از تازه‌ترین مطلب"
      hidden={adsAfterLatest.count === 0}
      set:html={adsAfterLatest.html}
    ></section>

    <section id="mStats" class="m-stats" aria-label="آمار مطالب ماهون" set:html={initialStatsHtml}></section>

    <section class="m-search-wrap">
      <label class="m-search">
        <span aria-hidden="true">⌕</span>
        <input id="mSearch" type="search" placeholder="جست‌وجو در مطالب..." autocomplete="off" />
      </label>
    </section>

    <section class="m-all">
      <div class="m-heading">
        <h2 id="mAllTitle">همه مطالب</h2>
        <a href="/posts">مشاهده همه مطالب</a>
      </div>

      <div class="m-all-scroll">
        <div id="mAllGrid" class="m-all-grid" set:html={initialListHtml}></div>
      </div>
    </section>


    <section
      id="mAdsAfterAllPosts"
      class:list={["m-ads", "m-ads-slot", adsAfterAllPosts.count === 1 && "m-ads--single"]}
      aria-label="تبلیغات بعد از همه مطالب"
      hidden={adsAfterAllPosts.count === 0}
      set:html={adsAfterAllPosts.html}
    ></section>

    <section
      id="mAdsBeforeCategories"
      class:list={["m-ads", "m-ads-slot", adsBeforeCategories.count === 1 && "m-ads--single"]}
      aria-label="تبلیغات بالای دسته‌بندی‌ها"
      hidden={adsBeforeCategories.count === 0}
      set:html={adsBeforeCategories.html}
    ></section>

    <section id="mCategories" class="m-categories" aria-label="دسته‌بندی مطالب ماهون" set:html={initialCategoriesHtml}></section>

    <section
      id="mAdsAfterCategories"
      class:list={["m-ads", "m-ads-slot", adsAfterCategories.count === 1 && "m-ads--single"]}
      aria-label="تبلیغات زیر دسته‌بندی‌ها"
      hidden={adsAfterCategories.count === 0}
      set:html={adsAfterCategories.html}
    ></section>

    <script id="mHomeConfig" type="application/json" set:html={safeJson(clientHomeConfig)}></script>
  </main>

  <script is:inline>
    (() => {
      const configEl = document.getElementById("mHomeConfig");
      const config = JSON.parse(configEl?.textContent || "{}");
      const API_BASE = String(config.apiBase || "https://api.mahoonartmagazine.ir").replace(/\/+$/, "");
      const categories = Array.isArray(config.categories) ? config.categories : [];

      const featuredEl = document.getElementById("mFeatured");
      const statusEl = document.getElementById("mStatus");
      const statsEl = document.getElementById("mStats");
      const searchEl = document.getElementById("mSearch");
      const allGridEl = document.getElementById("mAllGrid");
      const allTitleEl = document.getElementById("mAllTitle");
      const categoriesEl = document.getElementById("mCategories");
      const adsAfterLatestEl = document.getElementById("mAdsAfterLatest");
      const adsAfterAllPostsEl = document.getElementById("mAdsAfterAllPosts");
      const adsBeforeCategoriesEl = document.getElementById("mAdsBeforeCategories");
      const adsAfterCategoriesEl = document.getElementById("mAdsAfterCategories");

      // mahoon-home-ssr-client-seed-v1
      let latestPosts = extractPosts(config.initialPosts || []);
      let stats = null;
      let categoryPayloads = [];

      function startTypewriter() {
        const lines = Array.from(document.querySelectorAll(".m-type-line"));
        lines.forEach((line) => {
          line.textContent = "";
        });

        let lineIndex = 0;
        let charIndex = 0;

        function type() {
          const line = lines[lineIndex];
          if (!line) return;

          const text = line.getAttribute("data-type-text") || "";

          if (charIndex <= text.length) {
            line.textContent = text.slice(0, charIndex);
            charIndex += 1;
            window.setTimeout(type, 34);
            return;
          }

          lineIndex += 1;
          charIndex = 0;

          if (lineIndex < lines.length) {
            window.setTimeout(type, 220);
          }
        }

        window.setTimeout(type, 260);
      }

      function escapeHtml(value) {
        return String(value || "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      function escapeAttr(value) {
        return escapeHtml(value);
      }

      function escapeRegex(value) {
        return String(value || "")
          .replace(/[.*+?^$()|[\]\\]/g, "\\$&")
          .replace(/[{}]/g, "\\$&");
      }

      function toPersianNumber(value) {
        return String(value ?? "")
          .replace(/0/g, "۰")
          .replace(/1/g, "۱")
          .replace(/2/g, "۲")
          .replace(/3/g, "۳")
          .replace(/4/g, "۴")
          .replace(/5/g, "۵")
          .replace(/6/g, "۶")
          .replace(/7/g, "۷")
          .replace(/8/g, "۸")
          .replace(/9/g, "۹");
      }

      function normalizeTag(tag) {
        return String(tag || "")
          .replace(/^#/, "")
          .replace(/[يى]/g, "ی")
          .replace(/ك/g, "ک")
          .replace(/\u200c/g, "")
          .replace(/\s+/g, " ")
          .trim()
          .toLowerCase();
      }

      const categoryTags = new Set(
        categories.flatMap((category) => category.tags.map(normalizeTag))
      );

      function getTags(text) {
        return Array.from(new Set(
          Array.from(String(text || "").matchAll(/(^|\s)#([^\s#]+)/gu))
            .map((match) => match[2])
            .filter(Boolean)
        ));
      }

      function stripMovieCreditLines(value) {
        return String(value || "")
          .split(/\r?\n/)
          .filter((line) => {
            const trimmed = line.trim();
            if (!trimmed) return true;
            return !/^(?:🎥|🎬|فیلم\s*:?)\s*#?\s*.+$/iu.test(trimmed);
          })
          .join("\n");
      }

      function extractMovieTitle(value) {
        const lines = String(value || "").split(/\r?\n/);

        for (const line of lines) {
          const match = line.trim().match(/^(?:🎥|🎬|فیلم\s*:?)\s*#?\s*(.+)$/iu);
          if (match?.[1]) {
            return match[1].replace(/^#/, "").trim();
          }
        }

        return "";
      }

      function removeMovieNames(value, post) {
        let text = String(value || "");
        const movieTitle = extractMovieTitle(post?.text || "");

        const names = [
          movieTitle,
          "The Walking Dead",
          "House M.D",
          "House MD",
          "Indecent Proposal",
          "Funny Face"
        ].filter(Boolean);

        names.forEach((name) => {
          text = text.replace(new RegExp(escapeRegex(name), "giu"), " ");
        });

        return text
          .replace(/🎥|🎬/g, " ")
          .replace(/\s+([،؛,.!])/g, "$1")
          .replace(/\s{2,}/g, " ")
          .trim();
      }

      function cleanPublicText(value) {
        return String(stripMovieCreditLines(value) || "")
          .replace(/\u{1F539}?\s*@mahoonartmagazine/giu, "")
          .replace(/https?:\/\/[^\s]+/giu, "")
          .replace(/@[a-zA-Z0-9_]+/g, "")
          .replace(/(^|\s)#([^\n#]+)/gu, " ")
          .replace(/[🎥🎬]/gu, "")
          .replace(/[؟?]/g, "")
          .replace(/[•●▪▫◦]/g, "")
          .replace(/\s+/g, " ")
          .trim();
      }

      function cleanPostText(post, value) {
        return cleanPublicText(removeMovieNames(value, post));
      }

      function truncateText(value, max) {
        const source = String(value || "").replace(/\s+/g, " ").trim();
        if (!source) return "";
        return source.length <= max ? source : source.slice(0, max).trim() + "…";
      }

      function firstWords(value, maxWords) {
        return String(value || "")
          .replace(/\s+/g, " ")
          .trim()
          .split(" ")
          .filter(Boolean)
          .slice(0, maxWords)
          .join(" ");
      }

      function isDialoguePost(post) {
        return /#(?:دیالوگ|دیالوگ‌ها|دیالوگ_ها)/u.test(String(post.text || ""));
      }

      function makeTitle(post) {
        const seoTitle = cleanPostText(post, post.seo_title);
        if (seoTitle && seoTitle.length <= 70) return truncateText(seoTitle, 70);

        const source = cleanPostText(post, post.text);
        const title = truncateText(firstWords(source, 8), 64);

        if (title) return title;
        if (isDialoguePost(post)) return "دیالوگی از فیلم";
        return "مطلبی از ماهون";
      }

      function makeExcerpt(post, max = 72) {
        const source = cleanPostText(post, post.seo_description) || cleanPostText(post, post.text);
        return truncateText(source || "روایتی تازه از مجله هنری ماهون", max);
      }

      function formatDate(value) {
        if (!value) return "";

        try {
          return new Intl.DateTimeFormat("fa-IR", {
            year: "numeric",
            month: "long",
            day: "numeric"
          }).format(new Date(String(value).replace(" ", "T")));
        } catch {
          return "";
        }
      }

      function href(post) {
        const slug = String(post.slug || post.id || "").trim();
        return "/post/" + encodeURIComponent(slug);
      }

      function isAudioPost(post) {
        return ["audio", "voice", "music"].includes(String(post.media_type || "").toLowerCase());
      }

      function isVideoPost(post) {
        return ["video", "animation"].includes(String(post.media_type || "").toLowerCase());
      }

      function mediaSrc(post, forceTextOnly = false) {
        if (forceTextOnly) return "";

        const type = String(post.media_type || "").toLowerCase();

        const direct = post.photo_url || post.image_url || post.thumbnail_url;
        if (direct) return direct;

        if (post.photo_file_id) {
          return API_BASE + "/media/" + encodeURIComponent(post.photo_file_id);
        }

        if ((type === "photo" || type === "image") && post.media_file_id) {
          return API_BASE + "/media/" + encodeURIComponent(post.media_file_id);
        }

        return "";
      }

      function pencilIcon() {
        return '<svg viewBox="0 0 64 64" aria-hidden="true"><path d="M43.6 8.8a6.5 6.5 0 0 1 9.2 9.2L25.1 45.7l-12.3 3.5 3.5-12.3L43.6 8.8Z"></path><path d="M38.8 13.6 48 22.8"></path><path d="M12 55h40"></path></svg>';
      }

      function audioIcon() {
        return '<svg viewBox="0 0 64 64" aria-hidden="true"><path d="M22 44H12a4 4 0 0 1-4-4V24a4 4 0 0 1 4-4h10l18-12v48L22 44Z"></path><path d="M47 23a12 12 0 0 1 0 18"></path><path d="M52 16a22 22 0 0 1 0 32"></path></svg>';
      }

      function videoIcon() {
        return '<svg viewBox="0 0 64 64" aria-hidden="true"><rect x="8" y="14" width="36" height="36" rx="7"></rect><path d="M44 27l12-8v26l-12-8V27Z"></path></svg>';
      }

      function normalizePost(raw) {
        const id = raw?.id ?? raw?.telegram_message_id ?? "";

        return {
          ...raw,
          id,
          text: raw?.text || raw?.caption || "",
          slug: raw?.slug || id,
          created_at: raw?.created_at || raw?.date || raw?.updated_at || "",
          media_type: raw?.media_type || "",
          photo_file_id: raw?.photo_file_id || "",
          media_file_id: raw?.media_file_id || "",
          seo_title: raw?.seo_title || "",
          seo_description: raw?.seo_description || ""
        };
      }

      function extractPosts(payload) {
        const source = Array.isArray(payload)
          ? payload
          : Array.isArray(payload?.posts)
            ? payload.posts
            : Array.isArray(payload?.data)
              ? payload.data
              : [];

        return source.map(normalizePost).filter((post) => post.id);
      }

      function publicTags(post) {
        const movieTitle = normalizeTag(extractMovieTitle(post.text));

        return getTags(post.text)
          .filter((tag) => !categoryTags.has(normalizeTag(tag)))
          .filter((tag) => normalizeTag(tag) !== movieTitle)
          .filter((tag) => !/^the\s+walking\s+dead$/i.test(String(tag).trim()))
          .filter((tag) => !/^house\s*m\.?d$/i.test(String(tag).trim()))
          .filter((tag) => !/^indecent\s+proposal$/i.test(String(tag).trim()))
          .filter((tag) => !/^funny\s+face$/i.test(String(tag).trim()))
          .slice(0, 3);
      }

      function renderTags(post) {
        const tags = publicTags(post);
        if (!tags.length) return "";

        return '<div class="m-tags">' + tags.map((tag) =>
          '<a href="/tag/' + encodeURIComponent(tag) + '">#' + escapeHtml(tag) + '</a>'
        ).join("") + '</div>';
      }

      function renderFeatured(post) {
        if (!post) {
          featuredEl.innerHTML = "";
          return;
        }

        const title = makeTitle(post);
        const image = mediaSrc(post);
        let media = "";

        if (image) {
          media = '<a class="m-featured__media" href="' + escapeAttr(href(post)) + '"><img src="' + escapeAttr(image) + '" alt="' + escapeAttr(title) + '" loading="lazy" decoding="async"></a>';
        } else if (isAudioPost(post)) {
          media = '<a class="m-featured__media m-featured__media--icon" href="' + escapeAttr(href(post)) + '">' + audioIcon() + '</a>';
        } else if (isVideoPost(post)) {
          media = '<a class="m-featured__media m-featured__media--icon" href="' + escapeAttr(href(post)) + '">' + videoIcon() + '</a>';
        }

        featuredEl.innerHTML =
          '<article class="m-featured ' + (!media ? "m-featured--text" : "") + '">' +
            media +
            '<div class="m-featured__body">' +
              '<div class="m-meta"><span>' + escapeHtml(formatDate(post.created_at)) + '</span></div>' +
              '<h2>' + escapeHtml(title) + '</h2>' +
              '<p>' + escapeHtml(makeExcerpt(post, 86)) + '</p>' +
              renderTags(post) +
              '<a class="m-btn" href="' + escapeAttr(href(post)) + '">ادامه مطلب</a>' +
            '</div>' +
          '</article>';
      }

      function renderStats() {
        const visible = Number(stats?.visible_posts || latestPosts.length || 0);
        const active = Number(stats?.active_categories || 0);
        const latestId = Number(stats?.latest_id || latestPosts[0]?.id || 0);
        const textPosts = Number(stats?.text_posts || 0);

        statsEl.innerHTML =
          '<article><strong>' + toPersianNumber(visible) + '</strong><span>مطالب منتشرشده</span></article>' +
          '<article><strong>' + toPersianNumber(active) + '</strong><span>دسته‌بندی فعال</span></article>' +
          '<article><strong>' + toPersianNumber(latestId) + '</strong><span>آخرین کد مطلب</span></article>' +
          '<article><strong>' + toPersianNumber(textPosts) + '</strong><span>مطالب متنی</span></article>';
      }

      function renderList(posts) {
        allGridEl.innerHTML = posts.slice(0, 20).map((post) => {
          const title = makeTitle(post);
          const image = mediaSrc(post);

          let thumb = "";
          let thumbClass = "";

          if (image) {
            thumb = '<img src="' + escapeAttr(image) + '" alt="' + escapeAttr(title) + '" loading="lazy" decoding="async">';
          } else if (isAudioPost(post)) {
            thumb = audioIcon();
            thumbClass = "m-list-row__thumb--icon";
          } else if (isVideoPost(post)) {
            thumb = videoIcon();
            thumbClass = "m-list-row__thumb--icon";
          } else {
            thumb = pencilIcon();
            thumbClass = "m-list-row__thumb--icon";
          }

          return '<a class="m-list-row" href="' + escapeAttr(href(post)) + '">' +
            '<span class="m-list-row__thumb ' + thumbClass + '">' + thumb + '</span>' +
            '<span class="m-list-row__copy">' +
              '<strong>' + escapeHtml(title) + '</strong>' +
              '<small>' + escapeHtml(formatDate(post.created_at)) + '</small>' +
            '</span>' +
          '</a>';
        }).join("");
      }

      function renderCard(post, forceTextOnly = false) {
        const title = makeTitle(post);
        const image = mediaSrc(post, forceTextOnly);

        let media = "";

        if (image) {
          media = '<a class="m-card__media" href="' + escapeAttr(href(post)) + '"><img src="' + escapeAttr(image) + '" alt="' + escapeAttr(title) + '" loading="lazy" decoding="async"></a>';
        } else if (!forceTextOnly && isAudioPost(post)) {
          media = '<a class="m-card__media m-card__media--icon" href="' + escapeAttr(href(post)) + '">' + audioIcon() + '</a>';
        } else if (!forceTextOnly && isVideoPost(post)) {
          media = '<a class="m-card__media m-card__media--icon" href="' + escapeAttr(href(post)) + '">' + videoIcon() + '</a>';
        }

        return '<article class="m-card ' + (!media ? "m-card--no-media" : "") + '" data-post-href="' + escapeAttr(href(post)) + '">' +
          media +
          '<div class="m-card__body">' +
            '<span class="m-card__date">' + escapeHtml(formatDate(post.created_at)) + '</span>' +
            '<h3>' + escapeHtml(title) + '</h3>' +
            '<p>' + escapeHtml(makeExcerpt(post, 68)) + '</p>' +
            '<a class="m-card__cta" href="' + escapeAttr(href(post)) + '">ادامه مطلب</a>' +
          '</div>' +
        '</article>';
      }

      function bindRailButtonsAndDrag() {
        document.querySelectorAll("[data-rail-btn]").forEach((button) => {
          button.addEventListener("click", () => {
            const rail = button.closest(".m-rail");
            const scroller = rail?.querySelector(".m-card-strip");
            const dir = Number(button.getAttribute("data-dir") || "1");

            if (!scroller) return;

            scroller.scrollBy({
              left: dir * 330,
              behavior: "smooth"
            });
          });
        });

        document.querySelectorAll(".m-card-strip").forEach((scroller) => {
          let isDown = false;
          let startX = 0;
          let startScroll = 0;
          let moved = false;

          scroller.addEventListener("pointerdown", (event) => {
            if (event.pointerType !== "mouse") return;

            if (event.target?.closest?.("a, button")) return;

            isDown = true;
            moved = false;
            startX = event.pageX;
            startScroll = scroller.scrollLeft;
            scroller.classList.add("is-dragging");

            try {
              scroller.setPointerCapture(event.pointerId);
            } catch {}
          });

          scroller.addEventListener("pointermove", (event) => {
            if (!isDown || event.pointerType !== "mouse") return;

            const dx = event.pageX - startX;
            if (Math.abs(dx) > 5) moved = true;

            scroller.scrollLeft = startScroll - dx;
          });

          function stopDrag(event) {
            if (!isDown) return;

            isDown = false;
            scroller.classList.remove("is-dragging");
            scroller.dataset.dragged = moved ? "1" : "0";

            window.setTimeout(() => {
              scroller.dataset.dragged = "0";
            }, 100);

            try {
              scroller.releasePointerCapture(event.pointerId);
            } catch {}
          }

          scroller.addEventListener("pointerup", stopDrag);
          scroller.addEventListener("pointercancel", stopDrag);
          scroller.addEventListener("pointerleave", stopDrag);

          scroller.addEventListener("click", (event) => {
            if (scroller.dataset.dragged === "1") {
              event.preventDefault();
              event.stopPropagation();
            }
          }, true);
        });
      }


      function normalizeAdPosition(value) {
        const allowed = new Set([
          "after_latest",
          "after_all_posts",
          "before_categories",
          "after_category_1",
          "after_category_2",
          "after_category_3",
          "after_category_4",
          "after_category_5",
          "after_categories"
        ]);

        const position = String(value || "").trim();
        return allowed.has(position) ? position : "before_categories";
      }

      function isAdEnabled(value) {
        const text = String(value ?? "").trim().toLowerCase();

        if (!text) return false;

        return !["0", "false", "off", "no", "خاموش", "غیرفعال"].includes(text);
      }

      function homeAds() {
        const ads = config.ads || {};

        return [
          {
            key: "right",
            enabled: isAdEnabled(ads.rightEnabled ?? "1"),
            title: ads.rightTitle || "",
            text: ads.rightText || "",
            url: ads.rightUrl || "",
            button: ads.rightButton || "مشاهده",
            position: normalizeAdPosition(ads.rightPosition),
            image: ads.rightImage || ""
          },
          {
            key: "left",
            enabled: isAdEnabled(ads.leftEnabled ?? "1"),
            title: ads.leftTitle || "",
            text: ads.leftText || "",
            url: ads.leftUrl || "",
            button: ads.leftButton || "مشاهده",
            position: normalizeAdPosition(ads.leftPosition),
            image: ads.leftImage || ""
          }
        ].filter((ad) => ad.enabled && (ad.title || ad.text || ad.image));
      }

      function adsForPosition(position) {
        return homeAds().filter((ad) => ad.position === position);
      }

      function renderAdCard(ad) {
        const title = ad.title || "جایگاه تبلیغات";
        const text = ad.text || "";
        const button = ad.button || "مشاهده";
        const image = ad.image || "";

        const imageHtml = image
          ? '<div class="m-ad-card__image"><img src="' + escapeAttr(image) + '" alt="' + escapeAttr(title) + '" loading="lazy" decoding="async"></div>'
          : "";

        const actionHtml = ad.url
          ? '<a href="' + escapeAttr(ad.url) + '" target="_blank" rel="noopener">' + escapeHtml(button) + '</a>'
          : '<span>' + escapeHtml(button) + '</span>';

        return '<article class="m-ad-card ' + (image ? "m-ad-card--with-image" : "") + '">' +
          imageHtml +
          '<strong>' + escapeHtml(title) + '</strong>' +
          (text ? '<p>' + escapeHtml(text) + '</p>' : '') +
          actionHtml +
        '</article>';
      }

      function renderAdCards(items) {
        return items.map(renderAdCard).join("");
      }

      function setAdSlot(element, position) {
        if (!element) return;

        const items = adsForPosition(position);
        element.innerHTML = renderAdCards(items);
        element.hidden = items.length === 0;
        element.classList.toggle("m-ads--single", items.length === 1);
      }

      function renderAdsSection(position) {
        const items = adsForPosition(position);

        if (!items.length) return "";

        return '<section class="m-ads m-ads--dynamic ' + (items.length === 1 ? "m-ads--single" : "") + '" aria-label="تبلیغات">' +
          renderAdCards(items) +
        '</section>';
      }

      function renderAdSlots() {
        setAdSlot(adsAfterLatestEl, "after_latest");
        setAdSlot(adsAfterAllPostsEl, "after_all_posts");
        setAdSlot(adsBeforeCategoriesEl, "before_categories");
        setAdSlot(adsAfterCategoriesEl, "after_categories");
      }

      function renderCategories() {
        const categoryMap = stats?.category_map || {};

        categoriesEl.innerHTML = categoryPayloads.map((item, index) => {
          const category = item.category;
          const posts = item.posts || [];
          const total = Number(item.total ?? categoryMap[category.title] ?? posts.length);

          if (!posts.length && !total) return "";

          const tone = index % 2 === 0 ? "m-rail--light" : "m-rail--dark";
          const forceTextOnly = category.title === "شعر و متن";
          const allHref = "/category/" + encodeURIComponent(category.title);

          return '<section class="m-rail ' + tone + '">' +
            '<header class="m-rail__head">' +
              '<div><span>دسته‌بندی ماهون</span><h2>' + escapeHtml(category.title) + '</h2></div>' +
              '<div class="m-rail__actions">' +
                '<a href="' + escapeAttr(allHref) + '">مشاهده همه ' + toPersianNumber(total) + ' مطلب</a>' +
                '<button type="button" data-rail-btn data-dir="-1" aria-label="قبلی">‹</button>' +
                '<button type="button" data-rail-btn data-dir="1" aria-label="بعدی">›</button>' +
              '</div>' +
            '</header>' +
            '<div class="m-card-strip">' +
              posts.slice(0, 10).map((post) => renderCard(post, forceTextOnly)).join("") +
            '</div>' +
          '</section>' +
          renderAdsSection("after_category_" + (index + 1));
        }).join("");

        bindRailButtonsAndDrag();
      }

      async function api(path, params = {}) {
        const url = new URL(API_BASE + path);

        Object.entries(params).forEach(([key, value]) => {
          if (value !== undefined && value !== null && value !== "") {
            url.searchParams.set(key, String(value));
          }
        });

        const res = await fetch(url.toString(), {
          headers: { Accept: "application/json" },
          cache: "no-store"
        });

        if (!res.ok) throw new Error("HTTP " + res.status);
        return res.json();
      }

      function initializeHome() {
        startTypewriter();
        bindRailButtonsAndDrag();

        if (statusEl && latestPosts.length) {
          statusEl.hidden = true;
        }
      }

      let searchTimer = null;

      searchEl?.addEventListener("input", () => {
        clearTimeout(searchTimer);

        searchTimer = setTimeout(async () => {
          const q = String(searchEl.value || "").trim();

          if (!q) {
            allTitleEl.textContent = "همه مطالب";
            categoriesEl.hidden = false;
            renderFeatured(latestPosts[0]);
            renderList(latestPosts);
            return;
          }

          try {
            allTitleEl.textContent = "نتایج جستجو";
            categoriesEl.hidden = true;

            const payload = await api("/public/posts-v1", { q, limit: 20, offset: 0 });
            const results = extractPosts(payload);

            renderFeatured(results[0] || null);
            renderList(results);

            if (!results.length) {
              allGridEl.innerHTML = '<div class="m-empty">نتیجه‌ای برای جستجوی شما پیدا نشد.</div>';
            }
          } catch {
            allGridEl.innerHTML = '<div class="m-empty">جستجو انجام نشد.</div>';
          }
        }, 300);
      });

      initializeHome();
    })();
  </script>
  <script is:inline>
    /* mahoon-category-card-link-fix-v1 */
    (() => {
      if (window.__mahoonCategoryCardLinkFixV1) return;
      window.__mahoonCategoryCardLinkFixV1 = true;

      function getSafeHref(target) {
        const link = target?.closest?.(".m-categories .m-card__cta, .m-categories .m-card__media");
        if (!link) return "";

        const strip = link.closest(".m-card-strip");
        if (strip?.dataset?.dragged === "1") return "";

        const card = link.closest(".m-card");
        const href =
          link.getAttribute("href") ||
          card?.getAttribute("data-post-href") ||
          card?.querySelector("a[href]")?.getAttribute("href") ||
          "";

        if (!href || href === "#" || /undefined|null/i.test(href)) return "";
        return href;
      }

      document.addEventListener("pointerdown", (event) => {
        const link = event.target?.closest?.(".m-categories .m-card__cta, .m-categories .m-card__media");
        if (!link) return;

        event.stopPropagation();
      }, true);

      document.addEventListener("click", (event) => {
        const href = getSafeHref(event.target);
        if (!href) return;

        event.preventDefault();
        event.stopPropagation();

        const url = new URL(href, window.location.origin);
        window.location.assign(url.href);
      }, true);
    })();
    /* end-mahoon-category-card-link-fix-v1 */
  </script>

