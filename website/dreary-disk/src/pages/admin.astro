      async function togglePublishPost(id, button) {
        const post = posts.find(item => Number(item.id) === Number(id));
        if (!post || button?.disabled) return;

        const nextStatus = Number(post.is_published) === 1 ? 0 : 1;
        const actionText = nextStatus === 1 ? "منتشر" : "پیش‌نویس";
        const confirmed = await confirmAction({
          title: "تغییر وضعیت انتشار",
          message: `مطلب با کد ثابت #${id} ${actionText} شود؟`,
          confirmText: actionText
        });

        if (!confirmed) return;

        setButtonLoading(button, true, "در حال انجام...");

        try {
          await api(`/admin/posts/${id}`, {
            method: "PATCH",
            body: JSON.stringify(postPatchPayload(post, { is_published: nextStatus }))
          });

          showMessage(editorMessage, `وضعیت مطلب #${id} بروزرسانی شد.`, "ok");
          await loadPosts();
        } catch (error) {
          showMessage(editorMessage, userFriendlyError(error, "تغییر وضعیت انجام نشد."), "error");
        } finally {
          setButtonLoading(button, false);
        }
      }

      async function softDeletePostById(id, button) {
        if (!id || button?.disabled) return;

        const confirmed = await confirmAction({
          title: "حذف نرم مطلب",
          message: `مطلب با کد ثابت #${id} حذف نرم شود؟ برای تأیید، همین کد را وارد کنید.`,
          confirmText: "حذف نرم",
          requireValue: id
        });

        if (!confirmed) return;

        setButtonLoading(button, true, "در حال حذف...");

        try {
          await api(`/admin/posts/${id}`, {
            method: "DELETE"
          });

          showMessage(editorMessage, `مطلب #${id} به‌صورت نرم حذف شد.`, "ok");
          if (Number(postId.value) === Number(id)) clearEditor();
          await loadPosts();
        } catch (error) {
          showMessage(editorMessage, userFriendlyError(error, "حذف نرم انجام نشد."), "error");
        } finally {
          setButtonLoading(button, false);
        }
      }

      async function exportJson() {
        const buttons = Array.from(
          new Set(
            [
              exportBtn,
              document.querySelector(
                "[data-export-json]"
              )
            ].filter(Boolean)
          )
        );

        if (
          buttons.some(button =>
            button.disabled
          )
        ) {
          return;
        }

        const labels = buttons.map(
          button => button.textContent
        );

        buttons.forEach(button => {
          button.disabled = true;
          button.textContent =
            "در حال آماده‌سازی خروجی...";
        });

        try {
          const allPosts = [];
          const seenIds = new Set();

          let offset = 0;
          let total = null;

          while (
            total === null ||
            offset < total
          ) {
            const data = await api(
              buildAdminPostsPath({
                limit: EXPORT_PAGE_SIZE,
                offset,
                sort: "newest"
              }),
              {
                timeoutMs: 30000
              }
            );

            const batch =
              Array.isArray(data?.posts)
                ? data.posts
                : [];

            if (total === null) {
              total = Number(
                data?.total ??
                batch.length
              );
            }

            batch.forEach(post => {
              const id = Number(post.id);

              if (!seenIds.has(id)) {
                seenIds.add(id);
                allPosts.push(post);
              }
            });

            buttons.forEach(button => {
              button.textContent =
                `دریافت ${allPosts.length} از ${total}`;
            });

            const nextOffset = Number(
              data?.next_offset ??
              offset + batch.length
            );

            if (
              batch.length === 0 &&
              offset < total
            ) {
              throw new Error(
                "دریافت خروجی کامل پیش از پایان داده‌ها متوقف شد."
              );
            }

            if (
              nextOffset <= offset &&
              offset < total
            ) {
              throw new Error(
                "پیشروی صفحه‌بندی خروجی متوقف شد."
              );
            }

            offset = nextOffset;
          }

          if (
            total !== null &&
            allPosts.length !== total
          ) {
            throw new Error(
              `تعداد خروجی کامل نیست؛ ${allPosts.length} از ${total} مطلب دریافت شد.`
            );
          }

          const json = JSON.stringify(
            allPosts,
            null,
            2
          );

          const blob = new Blob(
            [json],
            {
              type:
                "application/json;charset=utf-8"
            }
          );

          const url =
            URL.createObjectURL(blob);

          const anchor =
            document.createElement("a");

          anchor.href = url;

          anchor.download =
            `mahoon-posts-all-${Date.now()}.json`;

          anchor.click();

          URL.revokeObjectURL(url);

          showToast(
            `${allPosts.length} مطلب در خروجی کامل JSON ذخیره شد.`,
            "ok"
          );
        } catch (error) {
          showToast(
            userFriendlyError(
              error,
              "ساخت خروجی کامل انجام نشد."
            ),
            "error"
          );
        } finally {
          buttons.forEach(
            (button, index) => {
              button.disabled = false;
              button.textContent =
                labels[index] ||
                "خروجی JSON";
            }
          );
        }
      }

      postsList.addEventListener("click", event => {
        const editButton = event.target.closest("[data-edit-id]");
        if (editButton) {
          event.stopPropagation();
          const id = Number(editButton.getAttribute("data-edit-id"));
          const post = posts.find(item => Number(item.id) === id);
          if (post) {
            selectPost(post);
            showAdminSection("create", { skipModeChange: true });
          }
          return;
        }

        const copyButton = event.target.closest("[data-copy-value]");
        if (copyButton) {
          event.stopPropagation();
          copyValue(copyButton.getAttribute("data-copy-value"), "مقدار کپی شد.");
          return;
        }

        const toggleButton = event.target.closest("[data-toggle-publish]");
        if (toggleButton) {
          event.stopPropagation();
          togglePublishPost(Number(toggleButton.getAttribute("data-toggle-publish")), toggleButton);
          return;
        }

        const softDeleteButton = event.target.closest("[data-soft-delete-id]");
        if (softDeleteButton) {
          event.stopPropagation();
          softDeletePostById(Number(softDeleteButton.getAttribute("data-soft-delete-id")), softDeleteButton);
          return;
        }

        if (event.target.closest("[data-row-action]")) {
          event.stopPropagation();
          return;
        }

        const checkbox = event.target.closest("[data-check-id]");

        if (checkbox) {
          const id = Number(checkbox.getAttribute("data-check-id"));

          if (checkbox.checked) {
            selectedIds.add(id);
          } else {
            selectedIds.delete(id);
          }

          updateSelectedCount();
          return;
        }

        const row = event.target.closest("[data-row-id]");
        if (!row) return;

        const id = Number(row.getAttribute("data-row-id"));
        const post = posts.find(item => Number(item.id) === id);

        if (post) {
          selectPost(post);
        }
      });

      postsPagination.addEventListener("click", async event => {
        const pageButton =
          event.target.closest("[data-page]");

        const prevButton =
          event.target.closest("[data-page-prev]");

        const nextButton =
          event.target.closest("[data-page-next]");

        const totalPages =
          pageCount(
            postsTotal,
            POSTS_PER_PAGE
          );

        let nextPage = currentPage;

        if (pageButton) {
          nextPage = Number(
            pageButton.getAttribute("data-page")
          );
        } else if (prevButton) {
          nextPage = Math.max(
            currentPage - 1,
            1
          );
        } else if (nextButton) {
          nextPage = Math.min(
            currentPage + 1,
            totalPages
          );
        } else {
          return;
        }

        if (
          !Number.isInteger(nextPage) ||
          nextPage === currentPage
        ) {
          return;
        }

        currentPage = nextPage;

        await loadPosts({
          refreshStats: false
        });

        postsList.scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
      });

      deletedPostsPagination.addEventListener("click", async event => {
        const pageButton =
          event.target.closest("[data-deleted-page]");

        const prevButton =
          event.target.closest("[data-deleted-page-prev]");

        const nextButton =
          event.target.closest("[data-deleted-page-next]");

        const totalPages =
          pageCount(
            deletedPostsTotal,
            DELETED_POSTS_PER_PAGE
          );

        let nextPage =
          deletedCurrentPage;

        if (pageButton) {
          nextPage = Number(
            pageButton.getAttribute(
              "data-deleted-page"
            )
          );
        } else if (prevButton) {
          nextPage = Math.max(
            deletedCurrentPage - 1,
            1
          );
        } else if (nextButton) {
          nextPage = Math.min(
            deletedCurrentPage + 1,
            totalPages
          );
        } else {
          return;
        }

        if (
          !Number.isInteger(nextPage) ||
          nextPage === deletedCurrentPage
        ) {
          return;
        }

        deletedCurrentPage = nextPage;
        await loadDeletedPosts();

        deletedPostsList.scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
      });

      mediaPagination.addEventListener("click", async event => {
        const pageButton =
