          section.classList.toggle("is-active", active);
        });

        setActiveNav(key);
        activeSectionTitle.textContent = meta.title;
        activeSectionKicker.textContent = meta.kicker;

        if (!options.skipModeChange) {
          if (key === "deleted") {
            await showDeletedPostsView();
