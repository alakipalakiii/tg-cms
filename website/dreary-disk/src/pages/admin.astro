        const index = tabs.indexOf(document.activeElement);
        if (index < 0 || !["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : (index + (event.key === "ArrowLeft" ? 1 : -1) + tabs.length) % tabs.length;
        setEditorTab(tabs[next].dataset.editorTab);
        tabs[next].focus();
      });
      const mobileSidebar = matchMedia("(max-width: 900px)");
      function closeDrawer() {
        adminSidebar.classList.remove("is-open");
        adminDrawerBackdrop.classList.remove("is-open");
        sidebarToggle.setAttribute("aria-expanded", "false");
        adminSidebar.inert = mobileSidebar.matches;
        document.querySelector('.admin-workspace').inert = false;
      }
      mobileSidebar.addEventListener("change", closeDrawer);
      sidebarToggle.addEventListener("click", () => {
        const open = sidebarToggle.getAttribute("aria-expanded") !== "true";
        sidebarToggle.setAttribute('aria-expanded', String(open));
        adminSidebar.classList.toggle('is-open', open);
        adminDrawerBackdrop.classList.toggle('is-open', open);
        adminSidebar.inert = !open && mobileSidebar.matches;
        document.querySelector('.admin-workspace').inert = open && mobileSidebar.matches;
        if (open) adminSidebar.querySelector("a").focus();
      });
      adminDrawerBackdrop.addEventListener("click", () => { closeDrawer(); sidebarToggle.focus(); });
      adminSidebar.addEventListener("keydown", event => {
        if (!mobileSidebar.matches || !adminSidebar.classList.contains("is-open")) return;
        if (event.key === "Escape") { closeDrawer(); sidebarToggle.focus(); }
        if (event.key === "Tab") {
          const items = [...adminSidebar.querySelectorAll("a,button")];
          if (event.shiftKey && document.activeElement === items[0]) { event.preventDefault(); items.at(-1).focus(); }
          else if (!event.shiftKey && document.activeElement === items.at(-1)) { event.preventDefault(); items[0].focus(); }
        }
      });
      closeDrawer();
      document.getElementById('workspaceDate').textContent = new Intl.DateTimeFormat('fa-IR', { dateStyle: 'long' }).format(new Date());
      document.getElementById('savePolicy').addEventListener('click', savePublicationSettings);
      document.getElementById('reloadPolicy').addEventListener('click', async () => {
        if (publicationPolicyDirty && !await confirmAction({ title: 'دریافت مجدد قانون', message: 'تغییرات ذخیره‌نشده این فرم کنار گذاشته می‌شوند.', confirmText: 'دریافت مجدد' })) return;
        publicationPolicyDirty = false;
        await loadPublicationSettings(true);
      });
      ['publicationTags', 'autoPublishTelegram'].forEach(id => document.getElementById(id).addEventListener('input', () => { publicationPolicyDirty = true; renderPolicyTest(); }));
      document.getElementById('policyTestText').addEventListener('input', renderPolicyTest);
      document.querySelectorAll('[data-policy-tag]').forEach(button => button.addEventListener('click', () => {
        const field = document.getElementById('publicationTags');
        const tag = button.dataset.policyTag;
        if (!collectPublicationPolicy().allowed_tags.some(value => normalizePolicyTag(value) === normalizePolicyTag(tag))) field.value += (field.value.trim() ? '، ' : '') + '#' + tag;
        publicationPolicyDirty = true;
        renderPolicyTest();
      }));
      document.getElementById('checkTelegramConnection').addEventListener('click', async event => {
        const button = event.currentTarget;
        setButtonLoading(button, true, 'در حال بررسی…');
        try {
          const data = await api('/admin/telegram/webhook-info');
          document.getElementById('telegramConnectionState').textContent = data.readiness?.ready ? 'اتصال ربات و کانال تأیید شد.' : 'اتصال نیازمند بررسی است؛ پاسخ سرور آماده‌بودن کامل را تأیید نکرد.';
          renderChannelDeleteStatus((await api('/admin/publication-policy')).channel_deletion);
        } catch (error) { document.getElementById('telegramConnectionState').textContent = userFriendlyError(error, 'بررسی اتصال انجام نشد.'); }
        finally { setButtonLoading(button, false); }
      });
      document.getElementById('restoreLocalDraft').addEventListener('click', restoreLocalDraft);
      document.getElementById('discardLocalDraft').addEventListener('click', async () => {
        if (await confirmAction({ title: 'کنار گذاشتن نسخه موقت', message: 'نسخه موقت این تب پاک می‌شود. مطالب ذخیره‌شده روی سایت تغییری نمی‌کنند.', confirmText: 'کنار گذاشتن' })) discardLocalDraft();
      });
      const themeToggle = document.getElementById('themeToggle');
      function setAdminTheme(dark) {
        document.documentElement.dataset.adminTheme = dark ? 'dark' : 'light';
        themeToggle.textContent = dark ? 'نمای روشن' : 'نمای تیره';
        themeToggle.setAttribute('aria-pressed', String(dark));
        try { localStorage.setItem('mahoon_admin_theme', dark ? 'dark' : 'light'); } catch {}
      }
      let savedAdminTheme = 'light';
      try { savedAdminTheme = localStorage.getItem('mahoon_admin_theme') || 'light'; } catch {}
      setAdminTheme(savedAdminTheme === 'dark');
      themeToggle.addEventListener('click', () => setAdminTheme(document.documentElement.dataset.adminTheme !== 'dark'));
      document.addEventListener('keydown', event => {
        if (!(event.ctrlKey || event.metaKey) || !dashboardView.classList.contains('active') || confirmDialog.open) return;
        if (event.key.toLowerCase() === 'k') { event.preventDefault(); document.querySelector('[data-focus-search]').click(); }
        if (event.key.toLowerCase() === 's' && !document.getElementById('createSection').hidden) { event.preventDefault(); savePost(); }
      });
      clearEditor();
      setEditorTab("content");

      if (getToken()) {
        testLogin();
      } else {
        showLogin();
      }
    </script>
  </body>
</html>
