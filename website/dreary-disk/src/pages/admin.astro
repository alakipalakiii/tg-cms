      document.querySelector("[data-copy-selected-id]")?.addEventListener("click", () => copyValue(postId.value, "ID انتخاب‌شده کپی شد."));
      document.querySelector("[data-copy-selected-slug]")?.addEventListener("click", () => copyValue(postSlug.value, "slug انتخاب‌شده کپی شد."));
      document.querySelector("[data-refresh-local]")?.addEventListener("click", loadPosts);
      document.querySelector("[data-clear-token]")?.addEventListener("click", () => {
        clearToken();
        updateLocalState();
        showLogin();
        showToast("Token از مرورگر حذف شد.", "ok");
