          const data = await api("/admin/site-settings", { method: "GET", timeoutMs: SITE_COPY_TIMEOUT_MS });
          if (requestId !== siteCopyRequestSerial) return;
          fillSiteCopyForm(data.settings || {});
          Object.values(siteCopyFields).forEach(field => { if (field) field.disabled = false; });
