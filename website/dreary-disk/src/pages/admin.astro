      function normalizeText(value) {
        return String(value || "")
          .replace(/\r\n/g, "\n")
          .replace(/\r/g, "\n")
          .trim();
      }

      function parseContent(text) {
        const original = normalizeText(text);
        const hashtags = Array.from(new Set((original.match(/#[\p{L}\p{N}_]+/gu) || []).map(tag => tag.replace("#", ""))));
        const urls = Array.from(new Set(original.match(/(https?:\/\/[^\s]+)/g) || []));
        const cleanLines = [];

        original.split("\n").forEach(rawLine => {
          const line = rawLine.trim();

          if (!line) {
            if (cleanLines.length && cleanLines[cleanLines.length - 1] !== "") cleanLines.push("");
            return;
          }

          const cleaned = line
            .replace(/(https?:\/\/[^\s]+)/g, "")
            .replace(/#[\p{L}\p{N}_]+/gu, "")
            .replace(/@[\w.]+/g, "")
            .replace(/[\u25c6\u25c7\u{1F539}\u{1F538}\u25aa\ufe0f•]+/gu, "")
            .replace(/\s+/g, " ")
            .trim();

          if (cleaned) cleanLines.push(cleaned);
        });

        while (cleanLines[cleanLines.length - 1] === "") cleanLines.pop();

        const content = cleanLines.join("\n").trim();
        const rawTitle = cleanLines.find(Boolean) || "پست بدون عنوان";
        const rawExcerpt = content.replace(/\n/g, " ").replace(/\s+/g, " ");
        const title = rawTitle.length > 80 ? `${rawTitle.slice(0, 79).trim()}…` : rawTitle;
        const excerpt = rawExcerpt.length > 120 ? `${rawExcerpt.slice(0, 119).trim()}…` : rawExcerpt;

        return { title, content, excerpt, hashtags, urls };
      }

      function makeSlugFromText(text) {
        const parsed = parseContent(text);
        const base = parsed.title
          .toLowerCase()
          .replace(/[^a-z0-9\u0600-\u06FF\s-]/g, "")
          .replace(/\s+/g, "-")
          .replace(/-+/g, "-")
          .replace(/^-|-$/g, "")
          .slice(0, 70);

        return `${base || "post"}-${Date.now()}`;
      }

      function makeTitle(text) {
        return parseContent(text).title || "پست بدون عنوان";
      }

      function makeExcerpt(text) {
        return parseContent(text).excerpt || "";
      }

      function cleanTextForSeo(text) {
        return normalizeText(text)
          .replace(/\u{1F539}?\s*@mahoonartmagazine/giu, "")
          .replace(/@mahoonartmagazine/giu, "")
          .replace(/https?:\/\/(?:t\.me|telegram\.me|telegram\.dog)\/[^\s]+/giu, "")
          .replace(/https?:\/\/[^\s]+/giu, "")
          .replace(/#[\p{L}\p{N}_]+/gu, " ")
          .replace(/[\u25c6\u25c7\u{1F539}\u{1F538}\u25aa\ufe0f•]+/gu, " ")
          .replace(/\s+/g, " ")
          .trim();
      }

      function trimSeoText(value, limit) {
        const text = String(value || "").replace(/\s+/g, " ").trim();
        if (text.length <= limit) return text;
        return `${text.slice(0, Math.max(limit - 1, 0)).trim()}…`;
      }

      function makePostTitle(post) {
        if (post?.seo_title) return trimSeoText(post.seo_title, 70);

        const clean = cleanTextForSeo(post?.text || "");
        const firstLine = clean.split(/[.!؟\n]/).find(Boolean) || clean;

        return trimSeoText(firstLine, 70) || "مطلب ماهون";
      }

      function makeSeoDescription(post) {
        if (post?.seo_description) return trimSeoText(post.seo_description, 160);

        const clean = cleanTextForSeo(post?.text || "");

        return trimSeoText(clean, 155) || "روایتی از مجله هنری ماهون درباره هنر، تصویر، صدا و نوشتار.";
      }

      function ensureSeoForPost(post) {
        return {
          seo_title: makePostTitle(post),
          seo_description: makeSeoDescription(post)
        };
      }

      function formatDate(value) {
        if (!value) return "";

        try {
          const date = new Date(value.replace(" ", "T") + "Z");

          return new Intl.DateTimeFormat("fa-IR", {
            year: "numeric",
            month: "short",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit"
          }).format(date);
        } catch {
          return value;
        }
      }

      function escapeHtml(value) {
        return String(value || "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      function escapeAttr(value) {
        return escapeHtml(value).replaceAll("`", "&#096;");
      }

      function mediaLabel(type) {
        if (type === "photo") return "عکس";
        if (type === "video") return "ویدیو";
        if (type === "audio") return "صوت";
        if (type === "voice") return "ویس";
        if (type === "document") return "فایل";
        return "فایل";
      }

      function mediaFromPost(post) {
        if (!post) return null;

        const fileId = post.media_file_id || post.photo_file_id || null;
        const mediaType = post.media_type || (post.photo_file_id ? "photo" : null);

        if (!fileId || !mediaType) return null;

        return {
          media_type: mediaType,
          media_file_id: fileId,
          media_unique_id: post.media_unique_id || post.photo_unique_id || null,
          media_mime_type: post.media_mime_type || null,
          media_file_name: post.media_file_name || null,
          media_duration: post.media_duration || null,
          media_width: post.media_width || post.photo_width || null,
          media_height: post.media_height || post.photo_height || null,
          media_size: post.media_size || null,
          media_url: post.media_url || post.photo_url || null,
          photo_url: mediaType === "photo" ? post.media_url || post.photo_url : null
        };
      }

      function editorStateSnapshot() {
        const media = currentMedia || {};

        return JSON.stringify({
          id: postId.value || "",
          slug: postSlug.value || "",
          isPublished: Boolean(isPublished.checked),
          text: postText.value || "",
          seoTitle: seoTitle.value || "",
          seoDescription: seoDescription.value || "",
          adminNote: adminNote.value || "",
          mediaFileId: media.media_file_id || "",
          mediaType: media.media_type || ""
        });
      }

      function resetEditorDirty() {
        editorBaseline = editorStateSnapshot();
        editorDirty = false;
      }

      function markEditorDirty() {
        editorDirty = editorStateSnapshot() !== editorBaseline;
      }

      function updateStableIdDisplay(id) {
        const value = id ? `#${id}` : "-";
        stablePostId.textContent = value;
        stableIdNote.innerHTML = id
          ? `<strong>کد ثابت پست ${value}:</strong> این ID همان کدی است که در ربات استفاده می‌شود و بعد از حذف پست‌های دیگر تغییر نمی‌کند.`
          : `<strong>کد ثابت پست:</strong> بعد از ساخت پست، ID ثابت اینجا نمایش داده می‌شود. این ID همان کد ربات است.`;
      }

      function renderMediaPreview() {
        if (!currentMedia || !currentMedia.media_file_id) {
          mediaPreview.innerHTML = "هنوز فایلی برای این پست انتخاب نشده است.";
          return;
        }

        const url = currentMedia.media_url;
        const type = currentMedia.media_type;

        if (type === "photo" && url) {
          mediaPreview.innerHTML = `<img src="${escapeAttr(url)}" alt="">`;
          return;
        }

        if (type === "video" && url) {
          mediaPreview.innerHTML = `<video src="${escapeAttr(url)}" controls playsinline preload="metadata"></video>`;
          return;
        }

        if ((type === "audio" || type === "voice") && url) {
          mediaPreview.innerHTML = `
            <div class="file-preview">
              <strong>${mediaLabel(type)}</strong>
              <audio src="${escapeAttr(url)}" controls preload="metadata"></audio>
            </div>
          `;
          return;
        }

        if (url) {
          mediaPreview.innerHTML = `
            <div class="file-preview">
              <strong>${escapeHtml(currentMedia.media_file_name || "فایل پیوست")}</strong>
              <span>${escapeHtml(currentMedia.media_mime_type || mediaLabel(type))}</span>
              <a class="admin-btn btn btn-primary" href="${escapeAttr(url)}" target="_blank" rel="noopener">مشاهده فایل</a>
            </div>
          `;
          return;
        }

        mediaPreview.innerHTML = `${mediaLabel(type)} انتخاب شده است.`;
      }

