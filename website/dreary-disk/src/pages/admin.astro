      function activeAdminSectionKey() {
        const activeSection = adminSections.find(
          section =>
            !section.hidden &&
            section.classList.contains("is-active")
        );

        return activeSection?.getAttribute("data-admin-section") || "";
      }

      function buildAdminPostsPath({
        limit = POSTS_PER_PAGE,
        offset = 0,
        q = "",
        status = "all",
        media = "all",
        sort = "newest"
      } = {}) {
        const params = new URLSearchParams();

        params.set("limit", String(limit));
        params.set("offset", String(Math.max(0, offset)));
        params.set("status", status || "all");
        params.set("media", media || "all");
        params.set("sort", sort || "newest");

        const query = String(q || "").trim();

        if (query) {
          params.set("q", query);
        }

        return `/admin/posts?${params.toString()}`;
      }

      function pageCount(totalItems, perPage) {
        return Math.max(
          Math.ceil(Math.max(Number(totalItems) || 0, 0) / perPage),
          1
        );
      }

      function compactPaginationPages(current, total) {
        const pages = new Set([1, total]);

        for (let offset = -2; offset <= 2; offset += 1) {
          const page = current + offset;

          if (page >= 1 && page <= total) {
            pages.add(page);
          }
        }

        const sorted = Array.from(pages).sort((a, b) => a - b);
        const tokens = [];

        sorted.forEach((page, index) => {
          const previous = sorted[index - 1];

          if (index > 0 && page - previous > 1) {
            tokens.push(null);
          }

          tokens.push(page);
        });

        return tokens;
      }

      function paginationMarkup({
        current,
        totalPages,
        totalItems,
        pageAttribute,
        previousAttribute,
        nextAttribute
      }) {
        if (totalPages <= 1) {
          return `<span>${totalItems} مطلب</span>`;
        }

        const buttons = compactPaginationPages(
          current,
          totalPages
        ).map(token => {
          if (token === null) {
            return `<span class="pagination-ellipsis" aria-hidden="true">…</span>`;
          }

          return `
            <button
              class="admin-btn admin-glass-btn page-btn ${token === current ? "active" : ""}"
              type="button"
              ${pageAttribute}="${token}"
              ${token === current ? 'aria-current="page"' : ""}
            >${token}</button>
          `;
        }).join("");

        return `
          <button
            class="admin-btn admin-glass-btn page-btn"
            type="button"
            ${previousAttribute}
            ${current === 1 ? "disabled" : ""}
          >قبلی</button>

          ${buttons}

          <button
            class="admin-btn admin-glass-btn page-btn"
            type="button"
            ${nextAttribute}
            ${current === totalPages ? "disabled" : ""}
          >بعدی</button>

          <span>${totalItems} مطلب</span>
        `;
      }

      function findLoadedPostById(id) {
        const targetId = Number(id);

        return [
          ...posts,
          ...mediaPosts,
          ...seoPosts
        ].find(item => Number(item.id) === targetId) || null;
      }

      async function fetchAdminPostById(id) {
        const data = await api(`/admin/posts/${id}`);

        const post =
          data?.post ||
          data?.item ||
          (Array.isArray(data?.posts) ? data.posts[0] : null) ||
          data;

        if (!post || Number(post.id) !== Number(id)) {
          return null;
        }

        return post;
      }

      async function loadPosts(options = {}) {
        const {
          refreshStats = true
        } = options;

        const requestId = ++postsRequestSerial;

        postsList.innerHTML =
          `<div class="empty">در حال دریافت پست‌ها...</div>`;

        apiStatus.textContent = "در حال اتصال...";

        const offset =
          (Math.max(currentPage, 1) - 1) *
          POSTS_PER_PAGE;

        const path = buildAdminPostsPath({
          limit: POSTS_PER_PAGE,
          offset,
          q: searchInput.value,
          status: statusFilter.value,
          media: mediaFilter.value,
          sort: sortFilter.value
        });

        try {
          const postsPromise = api(path);

          const statsPromise =
            refreshStats || !adminStats
              ? api("/admin/stats-v1").catch(() => null)
              : Promise.resolve(null);

          const [data, statsData] = await Promise.all([
            postsPromise,
            statsPromise
          ]);

          if (requestId !== postsRequestSerial) {
            return;
          }

          if (statsData?.stats) {
            adminStats = statsData.stats;
          }

          const nextPosts = Array.isArray(data?.posts)
            ? data.posts
            : [];

          const nextTotal = Number(
            data?.total ?? nextPosts.length
          );

          const totalPages = pageCount(
            nextTotal,
            POSTS_PER_PAGE
          );

          if (currentPage > totalPages) {
            currentPage = totalPages;

            await loadPosts({
              refreshStats: false
            });

            return;
          }

          posts = nextPosts;
          postsTotal = nextTotal;
          selectedIds = new Set();

          renderStats();
          renderPosts();
          updateSelectedCount();

          apiStatus.textContent = "API متصل است";
          apiDetailText.textContent =
            `اتصال برقرار است؛ صفحه ${currentPage} از ${totalPages} و ${postsTotal} مطلب قابل مدیریت است.`;

          updateLocalState();
        } catch (error) {
          if (requestId !== postsRequestSerial) {
            return;
          }

          postsList.innerHTML =
            `<div class="empty">${escapeHtml(error.message)}</div>`;

          postsPagination.innerHTML = "";
          apiStatus.textContent = "خطا در اتصال API";
          apiDetailText.textContent =
            userFriendlyError(error, "اتصال برقرار نشد.");
        }
      }

      async function loadDeletedPosts() {
        const requestId = ++deletedRequestSerial;

        deletedPostsList.hidden = false;
        deletedPostsList.innerHTML =
          `<div class="empty">در حال دریافت پست‌های حذف‌شده...</div>`;

        const offset =
          (Math.max(deletedCurrentPage, 1) - 1) *
          DELETED_POSTS_PER_PAGE;

        try {
          const data = await api(
            `/admin/posts/deleted?limit=${DELETED_POSTS_PER_PAGE}&offset=${offset}`
          );

          if (requestId !== deletedRequestSerial) {
            return;
          }

          const nextPosts = Array.isArray(data?.posts)
            ? data.posts
            : [];

          const nextTotal = Number(
            data?.total ?? nextPosts.length
          );

          const totalPages = pageCount(
            nextTotal,
            DELETED_POSTS_PER_PAGE
          );

          if (deletedCurrentPage > totalPages) {
            deletedCurrentPage = totalPages;
            await loadDeletedPosts();
            return;
          }

          deletedPosts = nextPosts;
          deletedPostsTotal = nextTotal;

          renderDeletedPosts();
          renderStats();
        } catch (error) {
          if (requestId !== deletedRequestSerial) {
            return;
          }

          const message = error.status === 404
            ? "این قابلیت هنوز روی API آنلاین فعال نشده است."
            : userFriendlyError(
                error,
                "دریافت پست‌های حذف‌شده انجام نشد."
              );

          deletedPostsList.innerHTML =
            `<div class="empty">${escapeHtml(message)}</div>`;

          deletedPostsPagination.innerHTML = "";
        }
      }

