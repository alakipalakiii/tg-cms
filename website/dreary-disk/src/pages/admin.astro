      function siteCopyIsEnabledValue(value) {
        const text = String(value ?? "").trim().toLowerCase();

        if (!text) return false;

        return !["0", "false", "off", "no", "خاموش", "غیرفعال"].includes(text);
      }

      function fillSiteCopyForm(settings = {}) {
        const values = { ...SITE_COPY_DEFAULTS, ...(settings || {}) };

        Object.entries(siteCopyFields).forEach(([key, field]) => {
          if (!field) return;

          const value = values[key] ?? "";

          if (field.type === "checkbox") {
            field.checked = siteCopyIsEnabledValue(value);
            return;
          }

          field.value = value;
        });
        siteCopyBaseline = JSON.stringify(collectSiteCopyForm());
      }

      function siteCopyHasChanges() {
        return siteCopyBaseline !== null && JSON.stringify(collectSiteCopyForm()) !== siteCopyBaseline;
      }

      async function allowAdminExit() {
        if (!editorDirty && !siteCopyHasChanges() && !publicationPolicyDirty) return true;
        const discard = await confirmAction({ title: "تغییرات ذخیره نشده", message: "تغییرات فرم‌های مدیریت ذخیره نشده است. از پنل خارج شوید؟", confirmText: "خروج بدون ذخیره" });
        if (discard) { resetEditorDirty(); discardLocalDraft(); siteCopyBaseline = null; publicationPolicyDirty = false; }
        return discard;
      }

      function collectSiteCopyForm() {
        const result = {};

        Object.entries(siteCopyFields).forEach(([key, field]) => {
          if (!field) return;

          if (field.type === "checkbox") {
            result[key] = field.checked ? "1" : "0";
            return;
          }

          result[key] = normalizeText(field.value || "");
        });

        return result;
      }

      async function uploadSiteAdImage(targetKey, button) {
        if (!getToken()) {
          showMessage(siteCopyMessage, "برای آپلود عکس ابتدا وارد پنل شو.", "error");
          return;
        }

        const fileInput = document.querySelector('[data-site-ad-file="' + targetKey + '"]');
        const urlInput = siteCopyFields[targetKey];
        const file = fileInput?.files?.[0];

        if (!file) {
          showMessage(siteCopyMessage, "ابتدا یک عکس انتخاب کن.", "error");
          return;
        }

        const oldText = button?.textContent || "آپلود";
        const base = String(typeof API_BASE !== "undefined" ? API_BASE : "https://api.mahoonartmagazine.ir").replace(/\/+$/, "");
        const endpoint = base + "/admin/upload";

        if (button) {
          button.disabled = true;
          button.textContent = "در حال آپلود...";
        }

        const controller = new AbortController();
        const timer = window.setTimeout(() => controller.abort(), 60000);

        try {
          const formData = new FormData();
          formData.append("file", file);

          const headers = { ...authHeaders() };

          delete headers["Content-Type"];
          delete headers["content-type"];

          const res = await fetch(endpoint, {
            method: "POST",
            headers,
            body: formData,
            signal: controller.signal
          });

          const data = await res.json().catch(() => null);

          if (!res.ok || !data?.ok) {
            const error = new Error(
              data?.error ||
              "آپلود عکس تبلیغ انجام نشد."
            );

            error.status = res.status;
            throw error;
          }

          const media = data.media || {};
          const fileId = media.photo_file_id || media.media_file_id || media.file_id || "";
          const mediaUrl =
            media.photo_url ||
            media.media_url ||
            media.url ||
            media.src ||
            (fileId ? base + "/media/" + encodeURIComponent(fileId) : "");

          if (!mediaUrl) {
            throw new Error("عکس آپلود شد اما آدرس قابل نمایش برنگشت.");
          }

          if (urlInput) {
            urlInput.value = mediaUrl;
          }

          if (fileInput) {
            fileInput.value = "";
          }

          showMessage(siteCopyMessage, "عکس تبلیغ آپلود شد. برای اعمال در سایت، دکمه ذخیره تنظیمات را بزن.", "ok");
        } catch (error) {
          if (recoverAdminSession(error)) {
            return;
          }

          showMessage(
            siteCopyMessage,
            userFriendlyError(
              error,
              "آپلود عکس تبلیغ انجام نشد."
            ),
            "error"
          );
        } finally {
          window.clearTimeout(timer);

          if (button) {
            button.disabled = false;
            button.textContent = oldText;
          }
        }
      }

      function clearSiteAdImage(targetKey) {
        const input = siteCopyFields[targetKey];

        if (input) {
          input.value = "";
        }

        showMessage(siteCopyMessage, "آدرس عکس حذف شد. برای اعمال در سایت، ذخیره تنظیمات را بزن.", "ok");
