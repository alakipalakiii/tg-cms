      /* mahoon-admin-auth-recovery-v1 */
      function isAuthFailure(error) {
        const status = Number(error?.status || 0);
        const message = String(error?.message || "");

        return (
          status === 401 ||
          status === 403 ||
          /unauthorized|forbidden|invalid token|expired token|\b401\b|\b403\b/i.test(message)
        );
      }

      function recoverAdminSession(error) {
        if (!isAuthFailure(error)) {
          return false;
        }

        clearToken();
        tokenInput.value = "";
        updateLocalState();
        showLogin();

        if (!authRecoveryShown) {
          authRecoveryShown = true;
          clearTimeout(messageTimer);

          loginMessage.textContent =
            "نشست مدیریت منقضی شده یا دسترسی تغییر کرده است. دوباره وارد پنل شو.";

          loginMessage.className =
            "message show error";
        }

        return true;
      }

