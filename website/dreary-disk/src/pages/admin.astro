      saveBtn.addEventListener("click", savePost);
      deleteBtn.addEventListener("click", deletePost);
      duplicateBtn.addEventListener("click", duplicatePost);
      completeSeoBtn.addEventListener("click", completeMissingSeo);
      saveSiteCopyBtn.addEventListener("click", saveSiteCopy);
      reloadSiteCopyBtn.addEventListener("click", loadSiteCopy);

