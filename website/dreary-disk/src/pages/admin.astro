        currentView = "active";
        activePostsTabBtn.classList.add("active");
        deletedPostsTabBtn.classList.remove("active");
        filtersBar.hidden = false;
        bulkbar.hidden = false;
        postsList.hidden = false;
        deletedPostsList.hidden = true;
      }

      async function showDeletedPostsView() {
        currentView = "deleted";
        deletedPostsTabBtn.classList.add("active");
        activePostsTabBtn.classList.remove("active");
        filtersBar.hidden = true;
        bulkbar.hidden = true;
        postsList.hidden = true;
        deletedPostsList.hidden = false;
        selectedIds = new Set();
        updateSelectedCount();
        await loadDeletedPosts();
      }

