          }

          seoChecklist.innerHTML =
            `<div class="empty">${escapeHtml(userFriendlyError(error, "دریافت اطلاعات SEO انجام نشد."))}</div>`;

          seoPagination.innerHTML = "";
        }
      }

      function renderSeoChecklist() {
        const missingCount =
          seoPosts.filter(post =>
            !post.seo_title ||
            !post.seo_description
          ).length;

        const totalPages = pageCount(
          seoPostsTotal,
          SEO_POSTS_PER_PAGE
        );

        seoPanelCount.textContent =
          `${seoPostsTotal} مطلب؛ ${missingCount} مورد ناقص در این صفحه`;

        completeSeoBtn.disabled =
          missingCount === 0;

        if (!seoPosts.length) {
          seoChecklist.innerHTML =
            `<div class="empty">مطلبی برای بررسی SEO وجود ندارد.</div>`;

          renderSeoPagination(
            totalPages,
            seoPostsTotal
          );

          return;
        }

        seoChecklist.innerHTML = `
          <div class="admin-data-list">
          ${seoPosts.map(post => {
            const publicHref = post.slug
              ? `/post/${encodeURIComponent(post.slug)}`
              : "";

            const publicUrl = publicHref
              ? `${window.location.origin}${publicHref}`
              : "";

            const generatedSeo =
              ensureSeoForPost(post);

            const titleStatus = post.seo_title
              ? "عنوان ثبت‌شده"
              : "عنوان پیشنهادی";

            const descStatus = post.seo_description
              ? "توضیح ثبت‌شده"
              : "توضیح پیشنهادی";

            return `
              <article class="admin-data-row admin-seo-row">
                <div class="admin-row-check">
                  <span class="admin-row-badge blue">SEO</span>
                </div>

                <div class="admin-row-thumb">
                  ${renderThumb(post)}
                </div>

                <div class="admin-row-main">
                  <h3 class="admin-row-title">${escapeHtml(makeTitle(post.text))}</h3>

                  <div class="admin-seo-preview">
                    <strong>${escapeHtml(generatedSeo.seo_title)}</strong>
                    <p>${escapeHtml(generatedSeo.seo_description)}</p>
                  </div>
                </div>

                <div class="admin-row-meta">
                  <span class="admin-row-badge blue">ID ${escapeHtml(post.id)}</span>
                  <span class="admin-row-badge ${post.seo_title ? "green" : "gray"}">${escapeHtml(titleStatus)}</span>
                  <span class="admin-row-badge ${post.seo_description ? "green" : "gray"}">${escapeHtml(descStatus)}</span>
                </div>

                <div class="admin-row-actions">
                  ${adminRowButton("ویرایش SEO", `data-edit-id="${post.id}" data-editor-target="seo"`, "warning")}
                  ${publicHref ? adminRowLink("مشاهده", publicHref, "data-row-action") : ""}
                  ${publicUrl ? adminRowButton("کپی لینک", `data-copy-value="${escapeAttr(publicUrl)}"`) : ""}
                </div>
              </article>
            `;
          }).join("")}
          </div>
        `;

        renderSeoPagination(
          totalPages,
          seoPostsTotal
        );
      }

      function updateLocalState() {
        tokenState.textContent = getToken() ? "در مرورگر ذخیره شده است" : "ذخیره نشده است";
      }

      function getFilteredPosts() {
        return [...posts];
      }

      function contentKind(post) {
        const media = mediaFromPost(post);
        const tags = parseContent(post.text).hashtags.map(tag => tag.trim());
        const hasTag = (...names) => tags.some(tag => names.includes(tag));

        if (media?.media_type === "photo") return "تصویر";
        if (media?.media_type === "video" || media?.media_type === "animation") return "ویدیو";
        if (media?.media_type === "audio" || media?.media_type === "voice") return "صوت";
        if (media?.media_type === "document") return "فایل";
        if (hasTag("شعر", "اشعار", "متن", "متن‌ها", "متن_ها")) return "شعر و متن";
        if (hasTag("کتاب")) return "کتاب";
        if (hasTag("نقاشی")) return "نقاشی";
        if (hasTag("دیالوگ", "دیالوگ‌ها", "دیالوگ_ها")) return "دیالوگ";
        return "متن";
      }

      function renderAdminTags(post, limit = 3) {
        const tags = parseContent(post.text).hashtags.slice(0, limit);
        if (!tags.length) return "";

        return `
          <div class="admin-row-tags">
            ${tags.map(tag => `<span class="admin-row-badge gray">#${escapeHtml(tag)}</span>`).join("")}
          </div>
        `;
      }

      function renderThumb(post) {
        const media = mediaFromPost(post);

        if (!media) return `<span class="admin-row-placeholder">متن</span>`;

        if (media.media_type === "photo" && media.media_url) {
          return `<img src="${escapeAttr(media.media_url)}" alt="" loading="lazy" decoding="async" width="76" height="76">`;
        }

        if (media.media_type === "video" && media.media_url) {
          return `<video src="${escapeAttr(media.media_url)}" muted preload="metadata" width="76" height="76"></video>`;
        }

        return `<span class="admin-row-placeholder">${escapeHtml(mediaLabel(media.media_type))}</span>`;
      }

      function adminRowButton(label, attrs = "", tone = "") {
        return `<button class="admin-btn admin-row-action admin-glass-btn ${tone}" type="button" ${attrs}>${escapeHtml(label)}</button>`;
      }

      function adminRowLink(label, href, attrs = "") {
        return `<a class="admin-btn admin-row-action admin-glass-btn" href="${escapeAttr(href)}" target="_blank" rel="noopener" ${attrs}>${escapeHtml(label)}</a>`;
      }

      function renderPosts() {
        const totalPages = pageCount(
          postsTotal,
          POSTS_PER_PAGE
        );

        if (posts.length === 0) {
          postsList.innerHTML =
            `<div class="empty">پستی پیدا نشد.</div>`;

          renderPagination(
            totalPages,
            postsTotal
          );

          return;
        }

        postsList.innerHTML = `
          <div class="admin-data-list">
            ${posts.map(post => {
          const active =
            selectedPost &&
            Number(selectedPost.id) === Number(post.id)
              ? "active"
              : "";

          const checked =
            selectedIds.has(Number(post.id))
              ? "checked"
              : "";

          const statusClass =
            Number(post.is_published) === 1
              ? "green"
              : "red";

          const statusText =
            Number(post.is_published) === 1
              ? "منتشر شده"
              : "منتشر نشده";

          const title = makeTitle(post.text);
          const excerpt = makeExcerpt(post.text);
          const media = mediaFromPost(post);
          const kind = contentKind(post);

          const publicHref = post.slug
            ? `/post/${encodeURIComponent(post.slug)}`
            : "";

          return `
            <article class="admin-data-row admin-post-row ${active}" data-row-id="${post.id}">
              <div class="admin-row-check">
                <input
                  class="admin-checkbox switch-input"
                  type="checkbox"
                  data-check-id="${post.id}"
                  ${checked}
                />
              </div>

              <div class="admin-row-thumb">
                ${renderThumb(post)}
              </div>

              <div class="admin-row-main">
                <h3 class="admin-row-title">${escapeHtml(title)}</h3>
                <p class="admin-row-excerpt">${escapeHtml(excerpt)}</p>
                ${renderAdminTags(post)}
              </div>

              <div class="admin-row-meta">
                <span class="admin-row-badge blue">ID ${escapeHtml(post.id)}</span>
                <span class="admin-row-badge ${statusClass}">${escapeHtml(statusText)}</span>
                <span class="admin-row-badge">${escapeHtml(kind)}</span>
                ${media ? `<span class="admin-row-badge gray">${escapeHtml(mediaLabel(media.media_type))}</span>` : ""}
                <span class="admin-row-badge gray">${escapeHtml(formatDate(post.created_at))}</span>
              </div>

              <div class="admin-row-actions">
                ${adminRowButton("ویرایش", `data-edit-id="${post.id}"`)}
                ${publicHref ? adminRowLink("مشاهده", publicHref, "data-row-action") : ""}
                ${publicHref ? adminRowButton("کپی لینک", `data-copy-value="${escapeAttr(window.location.origin + publicHref)}"`) : ""}
                ${adminRowButton("کپی ID", `data-copy-value="${post.id}"`)}
                ${adminRowButton(Number(post.is_published) === 1 ? "عدم انتشار" : "انتشار", `data-toggle-publish="${post.id}"`, Number(post.is_published) === 1 ? "warning" : "success")}
                ${adminRowButton("حذف نرم", `data-soft-delete-id="${post.id}"`, "danger")}
              </div>
            </article>
          `;
        }).join("")}
          </div>
        `;

        renderPagination(
          totalPages,
          postsTotal
        );
      }

      function renderPagination(totalPages, totalItems) {
        postsPagination.innerHTML =
          paginationMarkup({
            current: currentPage,
            totalPages,
            totalItems,
            pageAttribute: "data-page",
            previousAttribute: "data-page-prev",
            nextAttribute: "data-page-next"
          });
      }

      function renderDeletedPagination(totalPages, totalItems) {
        deletedPostsPagination.innerHTML =
          paginationMarkup({
            current: deletedCurrentPage,
            totalPages,
            totalItems,
            pageAttribute: "data-deleted-page",
            previousAttribute: "data-deleted-page-prev",
            nextAttribute: "data-deleted-page-next"
          });
      }

      function renderMediaPagination(totalPages, totalItems) {
        mediaPagination.innerHTML =
          paginationMarkup({
            current: mediaCurrentPage,
            totalPages,
            totalItems,
            pageAttribute: "data-media-page",
            previousAttribute: "data-media-page-prev",
            nextAttribute: "data-media-page-next"
          });
      }

      function renderSeoPagination(totalPages, totalItems) {
        seoPagination.innerHTML =
          paginationMarkup({
            current: seoCurrentPage,
            totalPages,
            totalItems,
            pageAttribute: "data-seo-page",
            previousAttribute: "data-seo-page-prev",
            nextAttribute: "data-seo-page-next"
          });
      }

      function updateSelectedCount() {
        const pageIds =
          posts.map(post => Number(post.id));

        const allPageSelected =
          pageIds.length > 0 &&
          pageIds.every(id =>
            selectedIds.has(id)
          );

        selectedCount.textContent =
          `${selectedIds.size} پست از این صفحه انتخاب شده`;

        selectAllBtn.textContent =
          allPageSelected
            ? "لغو انتخاب این صفحه"
            : "انتخاب همه این صفحه";
      }

      function setEditorTab(name) {
        document.querySelectorAll("[data-editor-tab]").forEach(tab => {
          const active = tab.getAttribute("data-editor-tab") === name;
          const key = tab.getAttribute("data-editor-tab");
          tab.classList.toggle("active", active);
          tab.id = `editor-tab-${key}`;
          tab.setAttribute("role", "tab");
          tab.setAttribute("aria-selected", String(active));
          tab.setAttribute("aria-controls", `editor-panel-${key}`);
          tab.tabIndex = active ? 0 : -1;
        });

        document.querySelectorAll("[data-editor-panel]").forEach(panel => {
          const key = panel.getAttribute("data-editor-panel");
          const active = key === name;
          panel.classList.toggle("active", active);
          panel.id = `editor-panel-${key}`;
          panel.setAttribute("role", "tabpanel");
          panel.setAttribute("aria-labelledby", `editor-tab-${key}`);
          panel.hidden = !active;
        });
      }

      function selectPost(post) {
        selectedPost = post;
        currentMedia = mediaFromPost(post);

        editorTitle.textContent = `ویرایش پست با کد ثابت #${post.id}`;
        postId.value = post.id;
        updateStableIdDisplay(post.id);
        postSlug.value = post.slug || "";
        isPublished.checked = Number(post.is_published) === 1;
        postText.value = post.text || "";
        seoTitle.value = post.seo_title || "";
        seoDescription.value = post.seo_description || "";
        adminNote.value = post.admin_note || "";
        viewCount.textContent = currentMedia ? mediaLabel(currentMedia.media_type) : "بدون";

        renderMediaPreview();
        updateEditorStats();
        updatePreview();
        resetEditorDirty();
        renderPosts();
      }

      function clearEditor() {
        selectedPost = null;
        currentMedia = null;

        editorTitle.textContent = "ساخت پست جدید";
        postId.value = "";
        updateStableIdDisplay("");
        postSlug.value = "";
        isPublished.checked = true;
        postText.value = "";
        seoTitle.value = "";
        seoDescription.value = "";
        adminNote.value = "";
        viewCount.textContent = "-";
        mediaFile.value = "";

        renderMediaPreview();
        updateEditorStats();
        updatePreview();
        resetEditorDirty();
        renderPosts();
      }

      function updateEditorStats() {
        const text = postText.value || "";
        const parsed = parseContent(text);
        const words = text.trim() ? text.trim().split(/\s+/).length : 0;

        charCount.textContent = text.length;
        wordCount.textContent = words;
        tagCount.textContent = parsed.hashtags.length;
      }

      function updatePreview() {
        const parsed = parseContent(postText.value || "");

        const seo = ensureSeoForPost({ text: postText.value, seo_title: seoTitle.value.trim(), seo_description: seoDescription.value.trim() });
        document.getElementById("editorSeoTitle").textContent = seo.seo_title;
        document.getElementById("editorSeoDescription").textContent = seo.seo_description;
        document.getElementById("editorSeoUrl").textContent = window.location.origin + "/post/" + (postSlug.value.trim() || makeSlugFromText(postText.value));
        previewTitle.textContent = parsed.title || "عنوان پست";
        previewContent.textContent = parsed.content || "متن پست اینجا نمایش داده می‌شود.";
        previewStatus.textContent = isPublished.checked ? "منتشر شده" : "منتشر نشده";
        previewStatus.className = isPublished.checked ? "badge green" : "badge red";
        document.getElementById('editorPublicationState').textContent = !isPublished.checked ? 'این مطلب به‌صورت پیش‌نویس ذخیره می‌شود.'
          : !activePublicationPolicy ? 'برای بررسی شرط انتشار، قانون هشتگ باید دریافت شود.'
          : textPassesPublicationPolicy(postText.value, activePublicationPolicy) ? 'هشتگ مجاز دارد؛ پس از ذخیره و چرخه انتشار روی سایت نمایش داده می‌شود.' : 'انتشار متوقف است: حداقل یک هشتگ مجاز اضافه کنید یا مطلب را پیش‌نویس نگه دارید.';

        previewTags.innerHTML = parsed.hashtags.length
          ? parsed.hashtags.map(tag => `<span class="badge">#${escapeHtml(tag)}</span>`).join("")
          : `<span class="badge gray">بدون هشتگ</span>`;
      }

      function editorPayload() {
        const media = currentMedia || {};

        return {
          text: postText.value.trim(),
          slug: postSlug.value.trim(),
          is_published: isPublished.checked ? 1 : 0,
          seo_title: seoTitle.value.trim(),
          seo_description: seoDescription.value.trim(),
          admin_note: adminNote.value.trim(),

          media_type: media.media_type || null,
          media_file_id: media.media_file_id || null,
          media_unique_id: media.media_unique_id || null,
          media_mime_type: media.media_mime_type || null,
          media_file_name: media.media_file_name || null,
          media_duration: media.media_duration || null,
          media_width: media.media_width || null,
          media_height: media.media_height || null,
          media_size: media.media_size || null
        };
      }

      function postPatchPayload(post, overrides = {}) {
        return {
          text: post.text || "",
          slug: post.slug || "",
          is_published: Number(post.is_published) === 1 ? 1 : 0,
          seo_title: post.seo_title || "",
          seo_description: post.seo_description || "",
          admin_note: post.admin_note || "",
          media_type: post.media_type || (post.photo_file_id ? "photo" : null),
          media_file_id: post.media_file_id || post.photo_file_id || null,
          media_unique_id: post.media_unique_id || post.photo_unique_id || null,
          media_mime_type: post.media_mime_type || null,
          media_file_name: post.media_file_name || null,
          media_duration: post.media_duration || null,
          media_width: post.media_width || post.photo_width || null,
          media_height: post.media_height || post.photo_height || null,
          media_size: post.media_size || null,
          ...overrides
        };
      }

      async function uploadMedia() {
        const file = mediaFile.files && mediaFile.files[0];

        if (!file) {
          showMessage(editorMessage, "اول یک فایل انتخاب کن.", "error");
          return;
        }

        if (uploadMediaBtn.disabled) return;

        const formData = new FormData();
        formData.append("file", file);

        setButtonLoading(uploadMediaBtn, true, "در حال آپلود...");

        try {
          const res = await fetch(`${WORKER_URL}/admin/upload`, {
            method: "POST",
            headers: authOnlyHeaders(),
            body: formData
          });

          const data = await res.json().catch(() => null);

          if (!res.ok || !data?.ok) {
            const error = new Error(
              data?.error ||
              "آپلود فایل ناموفق بود."
            );

            error.status = res.status;
            throw error;
          }

          currentMedia = data.media;
          renderMediaPreview();
          markEditorDirty();
          showMessage(editorMessage, "فایل با موفقیت ذخیره شد. برای اتصال آن به پست، ذخیره را بزن.", "ok");
        } catch (error) {
          if (recoverAdminSession(error)) {
            return;
          }

          showMessage(
            editorMessage,
            userFriendlyError(
              error,
              "آپلود فایل انجام نشد."
            ),
            "error"
          );
        } finally {
          setButtonLoading(uploadMediaBtn, false);
        }
      }

      function removeMedia() {
        currentMedia = null;
        mediaFile.value = "";
        renderMediaPreview();
        markEditorDirty();
        showMessage(editorMessage, "فایل از این پست حذف شد. برای اعمال تغییر، ذخیره را بزن.", "ok");
      }

      async function savePost() {
        if (saveBtn.disabled) return;

        const id = postId.value;
        const payload = editorPayload();

        if (payload.is_published) {
          await loadPublicationSettings();
          if (!activePublicationPolicy || !textPassesPublicationPolicy(payload.text, activePublicationPolicy)) {
            showMessage(editorMessage, 'انتشار به هشتگ مجاز نیاز دارد. هشتگ را اضافه کنید یا گزینه انتشار را خاموش کنید.', 'error');
            return;
          }
        }

        if (!payload.text) {
          showMessage(
            editorMessage,
            "متن پست نمی‌تواند خالی باشد.",
            "error"
          );

          return;
        }

        setButtonLoading(
          saveBtn,
          true,
          id ? "در حال ذخیره..." : "در حال ساخت..."
        );

        try {
          let savedId = id;

          if (id) {
            await api(`/admin/posts/${id}`, {
              method: "PATCH",
              body: JSON.stringify(payload)
            });

            showMessage(
              editorMessage,
              `پست با کد ثابت #${id} با موفقیت ذخیره شد.`,
              "ok"
            );
          } else {
            const data = await api("/admin/posts", {
              method: "POST",
              body: JSON.stringify(payload)
            });

            savedId = data.id || "";

            showMessage(
              editorMessage,
              `پست جدید ساخته شد. کد ثابت آن #${savedId || "-"} است.`,
              "ok"
            );

            postId.value = savedId;
            updateStableIdDisplay(savedId);
            postSlug.value =
              data.slug || payload.slug;
          }

          await loadPosts();

          let fresh =
            findLoadedPostById(savedId);

          if (!fresh && savedId) {
            fresh =
              await fetchAdminPostById(savedId)
                .catch(() => null);
          }

          if (fresh) {
            selectPost(fresh);
          } else {
            resetEditorDirty();
          }
          discardLocalDraft();
          document.getElementById('localDraftState').textContent = 'ذخیره نهایی انجام شد.';
        } catch (error) {
          showMessage(
            editorMessage,
            userFriendlyError(
              error,
              "ذخیره پست انجام نشد."
            ),
            "error"
          );
        } finally {
          setButtonLoading(saveBtn, false);
        }
      }

      async function deletePost() {
        if (deleteBtn.disabled) return;

        const id = postId.value;

        if (!id) {
          showMessage(editorMessage, "برای حذف، اول یک پست را انتخاب کن.", "error");
          return;
        }

        const confirmed = await confirmAction({
          title: "حذف نرم مطلب",
          message: `این مطلب از سایت حذف می‌شود، اما شماره ثابت آن تغییر نمی‌کند و hard delete انجام نمی‌شود. برای تأیید، کد ${id} را وارد کنید.`,
          confirmText: "حذف نرم",
          requireValue: id
        });

        if (!confirmed) return;

        setButtonLoading(deleteBtn, true, "در حال حذف...");

        try {
          await api(`/admin/posts/${id}`, {
            method: "DELETE"
          });

          showMessage(editorMessage, `پست #${id} به‌صورت نرم حذف شد. شماره ثابت آن تغییر نکرد.`, "ok");
          discardLocalDraft();
          clearEditor();
          await loadPosts();
        } catch (error) {
          showMessage(editorMessage, userFriendlyError(error, "حذف پست انجام نشد."), "error");
        } finally {
          setButtonLoading(deleteBtn, false);
        }
      }

      async function duplicatePost() {
        if (duplicateBtn.disabled) return;

        const payload = editorPayload();

        if (!payload.text) {
          showMessage(
            editorMessage,
            "متن پست خالی است.",
            "error"
          );

          return;
        }

        payload.slug = "";
        payload.is_published = 0;

        payload.admin_note =
          payload.admin_note
            ? payload.admin_note +
              "\nکپی شده از پست قبلی"
            : "کپی شده از پست قبلی";

        setButtonLoading(
          duplicateBtn,
          true,
          "در حال کپی..."
        );

        try {
          const data = await api("/admin/posts", {
            method: "POST",
            body: JSON.stringify(payload)
          });

          const createdId = data.id || "";

          showMessage(
            editorMessage,
            `کپی پست ساخته شد و با کد ثابت #${createdId || "-"} در حالت منتشر نشده قرار گرفت.`,
            "ok"
          );

          await loadPosts();

          let fresh =
            findLoadedPostById(createdId);

          if (!fresh && createdId) {
            fresh =
              await fetchAdminPostById(createdId)
                .catch(() => null);
          }

          if (fresh) {
            selectPost(fresh);
          }
        } catch (error) {
          showMessage(
            editorMessage,
            userFriendlyError(
              error,
              "کپی پست انجام نشد."
            ),
            "error"
          );
        } finally {
          setButtonLoading(
            duplicateBtn,
            false
          );
        }
      }

      async function completeMissingSeo() {
        const targets =
          seoPosts.filter(post =>
            !post.seo_title ||
            !post.seo_description
          );

        if (!targets.length) {
          showToast(
            "همه مطالب این صفحه سئوی کامل دارند.",
            "ok"
          );

          return;
        }

        const confirmed = await confirmAction({
