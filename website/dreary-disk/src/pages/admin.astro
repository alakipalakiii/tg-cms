      }

      function normalizeText(value) {
        return String(value || "")
          .replace(/\r\n/g, "\n")
          .replace(/\r/g, "\n")
          .trim();
      }

      function parseContent(text) {
        const original = normalizeText(text);
        const hashtags = Array.from(new Set([...original.replace(/https?:\/\/\S+/giu, ' ').matchAll(/(?:^|[^\p{L}\p{N}_\u200c])#([\p{L}\p{N}_\u200c]+)/gu)].map(match => match[1])));
        const urls = Array.from(new Set(original.match(/(https?:\/\/[^\s]+)/g) || []));
        const cleanLines = [];

        original.split("\n").forEach(rawLine => {
          const line = rawLine.trim();

          if (!line) {
            if (cleanLines.length && cleanLines[cleanLines.length - 1] !== "") cleanLines.push("");
            return;
          }

          const cleaned = line
            .replace(/(https?:\/\/[^\s]+)/g, "")
            .replace(/#[\p{L}\p{N}_\u200c]+/gu, "")
            .replace(/@[\w.]+/g, "")
            .replace(/[\u25c6\u25c7\u{1F539}\u{1F538}\u25aa\ufe0f•]+/gu, "")
            .replace(/\s+/g, " ")
            .trim();

          if (cleaned) cleanLines.push(cleaned);
        });

        while (cleanLines[cleanLines.length - 1] === "") cleanLines.pop();

        const content = cleanLines.join("\n").trim();
        const rawTitle = cleanLines.find(Boolean) || "پست بدون عنوان";
        const rawExcerpt = content.replace(/\n/g, " ").replace(/\s+/g, " ");
        const title = rawTitle.length > 80 ? `${rawTitle.slice(0, 79).trim()}…` : rawTitle;
        const excerpt = rawExcerpt.length > 120 ? `${rawExcerpt.slice(0, 119).trim()}…` : rawExcerpt;

        return { title, content, excerpt, hashtags, urls };
      }

      function makeSlugFromText(text) {
        const parsed = parseContent(text);
        const base = parsed.title
          .toLowerCase()
          .replace(/[^a-z0-9\u0600-\u06FF\s-]/g, "")
          .replace(/\s+/g, "-")
          .replace(/-+/g, "-")
          .replace(/^-|-$/g, "")
          .slice(0, 70);

        return `${base || "post"}-${Date.now()}`;
      }

      function makeTitle(text) {
        return parseContent(text).title || "پست بدون عنوان";
      }

      function makeExcerpt(text) {
        return parseContent(text).excerpt || "";
      }

      function cleanTextForSeo(text) {
        return normalizeText(text)
          .replace(/\u{1F539}?\s*@mahoonartmagazine/giu, "")
          .replace(/@mahoonartmagazine/giu, "")
          .replace(/https?:\/\/(?:t\.me|telegram\.me|telegram\.dog)\/[^\s]+/giu, "")
          .replace(/https?:\/\/[^\s]+/giu, "")
          .replace(/#[\p{L}\p{N}_\u200c]+/gu, " ")
          .replace(/[\u25c6\u25c7\u{1F539}\u{1F538}\u25aa\ufe0f•]+/gu, " ")
          .replace(/\s+/g, " ")
          .trim();
      }

      function trimSeoText(value, limit) {
        const text = String(value || "").replace(/\s+/g, " ").trim();
        if (text.length <= limit) return text;
        return `${text.slice(0, Math.max(limit - 1, 0)).trim()}…`;
      }

      function makePostTitle(post) {
        if (post?.seo_title) return trimSeoText(post.seo_title, 70);

        const clean = cleanTextForSeo(post?.text || "");
        const firstLine = clean.split(/[.!؟\n]/).find(Boolean) || clean;

        return trimSeoText(firstLine, 70) || "مطلب ماهون";
      }

      function makeSeoDescription(post) {
        if (post?.seo_description) return trimSeoText(post.seo_description, 160);

        const clean = cleanTextForSeo(post?.text || "");

        return trimSeoText(clean, 155) || "روایتی از مجله هنری ماهون درباره هنر، تصویر، صدا و نوشتار.";
      }

      function ensureSeoForPost(post) {
        return {
          seo_title: makePostTitle(post),
          seo_description: makeSeoDescription(post)
        };
      }

      function formatDate(value) {
        if (!value) return "";

        try {
          const date = new Date(/(?:Z|[+-]\d{2}:?\d{2})$/i.test(value) ? value.replace(" ", "T") : value.replace(" ", "T") + "Z");

          return new Intl.DateTimeFormat("fa-IR", {
            year: "numeric",
            month: "short",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit"
          }).format(date);
        } catch {
          return value;
        }
      }

      function escapeHtml(value) {
        return String(value || "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      function escapeAttr(value) {
        return escapeHtml(value).replaceAll("`", "&#096;");
      }

      function mediaLabel(type) {
        if (type === "photo") return "عکس";
        if (type === "video") return "ویدیو";
        if (type === "audio") return "صوت";
        if (type === "voice") return "ویس";
        if (type === "document") return "فایل";
        return "فایل";
      }

      function mediaFromPost(post) {
        if (!post) return null;

        const fileId = post.media_file_id || post.photo_file_id || null;
        const mediaType = post.media_type || (post.photo_file_id ? "photo" : null);

        if (!fileId || !mediaType) return null;

        return {
          media_type: mediaType,
          media_file_id: fileId,
          media_unique_id: post.media_unique_id || post.photo_unique_id || null,
          media_mime_type: post.media_mime_type || null,
          media_file_name: post.media_file_name || null,
          media_duration: post.media_duration || null,
          media_width: post.media_width || post.photo_width || null,
          media_height: post.media_height || post.photo_height || null,
          media_size: post.media_size || null,
          media_url: post.media_url || post.photo_url || null,
          photo_url: mediaType === "photo" ? post.media_url || post.photo_url : null
        };
      }

      function normalizePolicyTag(value) {
        return value.normalize('NFKC').replace(/^#/, '').replace(/ي/g, 'ی').replace(/ك/g, 'ک').replace(/[_\u200c]/g, '').toLowerCase();
      }

      function textPassesPublicationPolicy(text, policy) {
        const allowed = new Set(policy.allowed_tags.map(normalizePolicyTag));
        return [...String(text).replace(/https?:\/\/\S+/giu, ' ').matchAll(/(?:^|[^\p{L}\p{N}_\u200c])#([\p{L}\p{N}_\u200c]+)/gu)]
          .some(match => allowed.has(normalizePolicyTag(match[1])));
      }

      function collectPublicationPolicy() {
        return { allowed_tags: document.getElementById('publicationTags').value.split(/[\s,،]+/u).filter(Boolean).map(tag => tag.replace(/^#/, '')),
          auto_publish: document.getElementById('autoPublishTelegram').checked };
      }

      function renderPolicyTest() {
        const text = document.getElementById('policyTestText').value;
        document.getElementById('policyTestResult').textContent = !text.trim() ? 'یک متن نمونه وارد کنید.'
          : textPassesPublicationPolicy(text, collectPublicationPolicy()) ? 'مجاز: حداقل یک هشتگ مورد قبول دارد.' : 'متوقف: هشتگ مجاز ندارد و در سایت منتشر نمی‌شود.';
      }

      function renderChannelDeleteStatus(status) {
        const state = document.getElementById('channelDeleteState');
        const help = document.getElementById('channelDeleteHelp');
        const active = status?.available === true;
        state.textContent = active ? 'همگام‌سازی فعال' : 'نیازمند اتصال منبع‌خوان';
        state.className = active ? 'badge green' : 'badge gray';
        help.textContent = active ? 'حذف کانال به‌صورت دوره‌ای بررسی و به حذف قابل بازگردانی در سایت تبدیل می‌شود. نمایش عمومی پس از چرخه انتشار به‌روز می‌شود.'
          : 'همگام‌سازی حذف کانال فعال نیست یا اتصال نیاز به بررسی دارد. تا فعال‌شدن اتصال، حذف مطلب را از همین پنل انجام دهید.';
        const checkedAt = new Date(status?.checked_at || '');
        if (Number.isFinite(checkedAt.getTime())) help.textContent += ' آخرین بررسی: ' + new Intl.DateTimeFormat('fa-IR', { dateStyle: 'medium', timeStyle: 'short' }).format(checkedAt);
      }

      async function loadPublicationSettings(force = false) {
        if (!getToken() || publicationPolicyDirty || (activePublicationPolicy && !force)) return;
        if (publicationPolicyRequest) return publicationPolicyRequest;
        const fields = document.getElementById('policyFields');
        fields.disabled = true;
        document.getElementById('policyState').textContent = 'در حال دریافت';
        publicationPolicyRequest = (async () => {
          try {
            const data = await api('/admin/publication-policy');
            if (!data.policy || !Array.isArray(data.policy.allowed_tags) || !Number.isSafeInteger(data.policy.revision)) throw new Error('قانون انتشار دریافت نشد.');
            activePublicationPolicy = data.policy;
            renderChannelDeleteStatus(data.channel_deletion);
            document.getElementById('publicationTags').value = data.policy.allowed_tags.map(tag => '#' + tag).join('، ');
            document.getElementById('autoPublishTelegram').checked = data.policy.auto_publish;
            fields.disabled = false;
            document.getElementById('policyState').textContent = 'قانون فعال دریافت شد';
            document.getElementById('policyMessage').textContent = '';
            document.getElementById('policyMessage').classList.remove('show');
            renderPolicyTest();
            updatePreview();
          } catch (error) {
            document.getElementById('policyState').textContent = 'دریافت ناموفق';
            showMessage(document.getElementById('policyMessage'), userFriendlyError(error, 'قانون انتشار دریافت نشد؛ دوباره تلاش کنید.'), 'error');
          } finally { publicationPolicyRequest = null; }
        })();
        return publicationPolicyRequest;
      }

