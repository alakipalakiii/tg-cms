      async function restoreDeletedPost(id, button) {
        if (!id || button?.disabled) return;

        const confirmed = await confirmAction({
          title: "بازگردانی مطلب",
          message: `پست حذف‌شده با کد ثابت #${id} بازگردانی شود؟ این عملیات پست را دوباره منتشر می‌کند و ID ثابت تغییر نمی‌کند.`,
          confirmText: "بازگردانی"
        });

        if (!confirmed) return;

        setButtonLoading(button, true, "در حال بازگردانی...");

        try {
          await api(`/admin/posts/${id}/restore`, {
            method: "POST",
            body: JSON.stringify({})
          });

          showMessage(editorMessage, `پست #${id} با موفقیت بازگردانی شد.`, "ok");
          await loadDeletedPosts();
          await loadPosts();
        } catch (error) {
          const message = error.status === 404
            ? "این قابلیت هنوز روی API آنلاین فعال نشده است یا پست قبلاً بازگردانی شده است."
            : userFriendlyError(error, "بازگردانی پست انجام نشد.");

          showMessage(editorMessage, message, "error");
        } finally {
          setButtonLoading(button, false);
        }
      }


      function formatAdminNumber(value) {
        return String(Number(value || 0).toLocaleString("fa-IR"));
      }

      function analyticsRows(payload, ...keys) {
        for (const key of keys) {
          if (Array.isArray(payload?.[key])) return payload[key];
        }

        return [];
      }

      function analyticsTotal(payload, key) {
        const totals = payload?.totals || {};
        return totals[key] ?? payload?.[key] ?? 0;
      }

      function analyticsLabel(row, ...keys) {
        for (const key of keys) {
          const value = row?.[key];
          if (value !== undefined && value !== null && String(value).trim()) return String(value);
        }

        return "نامشخص";
      }

      function analyticsValue(row, ...keys) {
        for (const key of keys) {
          const value = row?.[key];
          if (value !== undefined && value !== null && value !== "") return Number(value || 0);
        }

        return 0;
      }

      function setAnalyticsStatus(text, type = "ok") {
        if (!analyticsStatus) return;
        analyticsStatus.textContent = text;
        analyticsStatus.className = `message analytics-message show ${type === "error" ? "error" : "ok"}`;
      }

      async function loadAnalyticsReport(force = false) {
        if (!analyticsStatus) return;

        if (analyticsLoaded && !force) return;

        const days = analyticsRangeSelect?.value || "30";

        setAnalyticsStatus("در حال دریافت آمار بازدید...");

        try {
          const data = await api(`/analytics/report-v5?days=${encodeURIComponent(days)}`, {
            method: "GET",
            timeoutMs: 15000
          });

          if (!data?.ok) {
            throw new Error(data?.error || "Analytics report failed");
          }

          analyticsLoaded = true;
          renderAnalyticsReport(data);
          setAnalyticsStatus(`آمار بازدید بروزرسانی شد. بازه انتخابی: ${formatAdminNumber(days)} روز اخیر`);
        } catch (error) {
          console.error(error);
          setAnalyticsStatus(userFriendlyError(error, "دریافت آمار بازدید انجام نشد."), "error");
        }
      }

      function renderAnalyticsReport(data) {
        if (analyticsPageviews) analyticsPageviews.textContent = formatAdminNumber(analyticsTotal(data, "pageviews"));
        if (analyticsVisitors) analyticsVisitors.textContent = formatAdminNumber(analyticsTotal(data, "unique_visitors"));
        if (analyticsSessions) analyticsSessions.textContent = formatAdminNumber(analyticsTotal(data, "sessions"));
        if (analyticsToday) analyticsToday.textContent = formatAdminNumber(analyticsTotal(data, "today"));
        if (analyticsYesterday) analyticsYesterday.textContent = formatAdminNumber(analyticsTotal(data, "yesterday"));

        renderAnalyticsDaily(analyticsRows(data, "byDay", "daily", "days", "timeline"));
        renderAnalyticsList(analyticsTopPages, analyticsRows(data, "topPages", "top_pages", "pages"), {
          titleKeys: ["title", "path", "url"],
          subtitleKeys: ["path", "url"],
          valueKeys: ["views", "pageviews", "count"]
        });
        renderAnalyticsList(analyticsReferrers, analyticsRows(data, "referrers", "sources", "topReferrers"), {
          titleKeys: ["referrer_host", "source", "host", "referrer"],
          subtitleKeys: ["referrer", "url"],
          valueKeys: ["views", "pageviews", "count"]
        });
        renderAnalyticsList(analyticsDevices, analyticsRows(data, "devices", "byDevice"), {
          titleKeys: ["device", "name", "label"],
          subtitleKeys: ["device"],
          valueKeys: ["views", "pageviews", "count"]
        });
        renderAnalyticsList(analyticsCountries, analyticsRows(data, "countries", "byCountry"), {
          titleKeys: ["country", "name", "label"],
          subtitleKeys: ["city", "country"],
          valueKeys: ["views", "pageviews", "count"]
        });
        renderAnalyticsRecent(analyticsRows(data, "recent", "recentEvents", "latest"));
      }

      function renderAnalyticsDaily(rows) {
        if (!analyticsDailyChart) return;

        if (analyticsDailyCount) {
          analyticsDailyCount.textContent = rows.length ? `${formatAdminNumber(rows.length)} روز` : "بدون داده";
        }

        if (!rows.length) {
          analyticsDailyChart.innerHTML = '<div class="empty">هنوز داده‌ای برای نمایش وجود ندارد.</div>';
          return;
        }

        const normalized = rows.slice(-31).map((row) => ({
          label: analyticsLabel(row, "day", "date", "created_at"),
          value: analyticsValue(row, "views", "pageviews", "count")
        }));

        const max = Math.max(...normalized.map((row) => row.value), 1);

        analyticsDailyChart.innerHTML = normalized.map((row) => {
          const width = Math.max(4, Math.round((row.value / max) * 100));

          return `
            <div class="analytics-bar-row">
              <span>${escapeHtml(row.label)}</span>
              <div class="analytics-bar-track"><i style="width:${width}%"></i></div>
              <strong>${formatAdminNumber(row.value)}</strong>
            </div>
          `;
        }).join("");
      }

      function renderAnalyticsList(container, rows, config) {
        if (!container) return;

        if (!rows.length) {
          container.innerHTML = '<div class="empty">داده‌ای ثبت نشده است.</div>';
          return;
        }

        container.innerHTML = rows.slice(0, 10).map((row) => {
          const title = analyticsLabel(row, ...config.titleKeys);
          const subtitle = analyticsLabel(row, ...config.subtitleKeys);
          const value = analyticsValue(row, ...config.valueKeys);

          return `
            <div class="analytics-list-row">
              <div>
                <strong>${escapeHtml(title)}</strong>
                ${subtitle && subtitle !== title ? `<small>${escapeHtml(subtitle)}</small>` : ""}
              </div>
              <b>${formatAdminNumber(value)}</b>
            </div>
          `;
        }).join("");
      }

      function renderAnalyticsRecent(rows) {
        if (!analyticsRecent) return;

        if (!rows.length) {
          analyticsRecent.innerHTML = '<div class="empty">هنوز بازدیدی ثبت نشده است.</div>';
          return;
        }

        analyticsRecent.innerHTML = rows.slice(0, 12).map((row) => {
          const title = analyticsLabel(row, "title", "path", "url");
          const path = analyticsLabel(row, "path", "url");
          const meta = [
            analyticsLabel(row, "device"),
            analyticsLabel(row, "country"),
            analyticsLabel(row, "created_at")
          ].filter(Boolean).join(" · ");
          const referrer = analyticsLabel(row, "referrer_host", "source", "referrer");

          return `
            <div class="analytics-list-row">
              <div>
                <strong>${escapeHtml(title)}</strong>
                <small>${escapeHtml(path)}${meta ? " · " + escapeHtml(meta) : ""}</small>
              </div>
              <b>${escapeHtml(referrer || "Direct")}</b>
            </div>
          `;
        }).join("");
      }


      function renderStats() {
        const loadedPublished =
          posts.filter(post =>
            Number(post.is_published) === 1
          ).length;

        const loadedDrafts =
          posts.filter(post =>
            Number(post.is_published) !== 1
          ).length;

        const loadedWithMedia =
          posts.filter(post =>
            post.media_file_id ||
            post.photo_file_id
          ).length;

        const loadedWithoutMedia =
          Math.max(
            posts.length - loadedWithMedia,
            0
          );

        const loadedLatestId =
          posts.reduce(
            (max, post) =>
              Math.max(
                max,
                Number(post.id || 0)
              ),
            0
          );

        const uniqueTags = new Set(
          posts.flatMap(post =>
            parseContent(post.text).hashtags
          )
        );

        const total = Number(
          adminStats?.total_posts ??
          postsTotal ??
          posts.length
        );

        const published = Number(
          adminStats?.published_posts ??
          loadedPublished
        );

        const drafts = Number(
          adminStats?.draft_posts ??
          loadedDrafts
        );

        const deleted = Number(
          adminStats?.deleted_posts ??
          deletedPostsTotal ??
          deletedPosts.length
        );

        const withMedia = Number(
          adminStats?.media_posts ??
          loadedWithMedia
        );

        const withoutMedia = Number(
          adminStats?.text_posts ??
          loadedWithoutMedia
        );

        const latestId = Number(
          adminStats?.latest_id ??
          loadedLatestId
        );

        totalCount.textContent = total;
        topbarTotalCount.textContent = total;
        publishedCount.textContent = published;
        draftCount.textContent = drafts;
        deletedCount.textContent = deleted;
        mediaCount.textContent = withMedia;
        textCount.textContent = withoutMedia;
        latestIdCount.textContent = latestId || "-";

        tagsCount.textContent =
          `${uniqueTags.size} / صفحه`;

        tagsCount.title =
          "تعداد هشتگ‌های یکتای صفحه جاری";

        exportCount.textContent =
          total + " مطلب آماده خروجی کامل";

        const rate = total
          ? Math.round((published / total) * 100)
          : 0;

        publishRate.textContent = rate + "%";
        publishProgress.style.width = rate + "%";

        lastRefresh.textContent =
          "آخرین بروزرسانی: " +
          new Intl.DateTimeFormat("fa-IR", {
            hour: "2-digit",
            minute: "2-digit"
          }).format(new Date());

        renderActivity();

        mediaPanelCount.textContent =
          withMedia + " مورد";

        updateLocalState();
      }

      function renderActiveAuxiliarySection() {
        const activeSection = adminSections.find(section => !section.hidden && section.classList.contains("is-active"));
        const key = activeSection?.getAttribute("data-admin-section");

        if (key === "media") renderMediaLibrary();
        if (key === "seo") renderSeoChecklist();
      }

      function renderActivity() {
        const latest = [...posts]
          .sort((a, b) => Number(b.id || 0) - Number(a.id || 0))
          .slice(0, 5);

        if (!latest.length) {
          activityList.innerHTML = `<div class="empty">هنوز مطلبی لود نشده است.</div>`;
          return;
        }

        activityList.innerHTML = latest.map(post => `
          <div class="activity-item">
            <div>
              <strong>${escapeHtml(makeTitle(post.text))}</strong>
              <span>کد ثابت #${post.id} · ${escapeHtml(formatDate(post.created_at))}</span>
            </div>
            <span class="badge ${Number(post.is_published) === 1 ? "green" : "red"}">
              ${Number(post.is_published) === 1 ? "منتشرشده" : "پیش‌نویس"}
            </span>
          </div>
        `).join("");
      }

      async function loadMediaLibrary() {
        const requestId = ++mediaRequestSerial;

        mediaLibrary.innerHTML =
          `<div class="empty">در حال دریافت رسانه‌ها...</div>`;

        const offset =
          (Math.max(mediaCurrentPage, 1) - 1) *
          MEDIA_POSTS_PER_PAGE;

        try {
          const data = await api(
            buildAdminPostsPath({
              limit: MEDIA_POSTS_PER_PAGE,
              offset,
              media: "media",
              sort: "newest"
            })
          );

          if (requestId !== mediaRequestSerial) {
            return;
          }

          const nextPosts = Array.isArray(data?.posts)
            ? data.posts
            : [];

          const nextTotal = Number(
            data?.total ?? nextPosts.length
          );

          const totalPages = pageCount(
            nextTotal,
            MEDIA_POSTS_PER_PAGE
          );

          if (mediaCurrentPage > totalPages) {
            mediaCurrentPage = totalPages;
            await loadMediaLibrary();
            return;
          }

          mediaPosts = nextPosts;
          mediaPostsTotal = nextTotal;

          renderMediaLibrary();
        } catch (error) {
          if (requestId !== mediaRequestSerial) {
            return;
          }

          mediaLibrary.innerHTML =
            `<div class="empty">${escapeHtml(userFriendlyError(error, "دریافت رسانه‌ها انجام نشد."))}</div>`;

          mediaPagination.innerHTML = "";
        }
      }

      function renderMediaLibrary() {
        const totalPages = pageCount(
          mediaPostsTotal,
          MEDIA_POSTS_PER_PAGE
        );

        mediaPanelCount.textContent =
          `${mediaPostsTotal} مورد`;

        if (!mediaPosts.length) {
          mediaLibrary.innerHTML =
            `<div class="empty">مطلب دارای رسانه پیدا نشد.</div>`;

          renderMediaPagination(
            totalPages,
            mediaPostsTotal
          );

          return;
        }

        mediaLibrary.innerHTML = `
          <div class="admin-data-list">
          ${mediaPosts.map(post => {
            const media = mediaFromPost(post);
            const url =
              media?.media_url ||
              media?.photo_url ||
              "";

            const publicHref = post.slug
              ? `/post/${encodeURIComponent(post.slug)}`
              : "";

            const title = makeTitle(post.text);

            return `
              <article class="admin-data-row admin-media-row">
                <div class="admin-row-check">
                  <span class="admin-row-badge blue">رسانه</span>
                </div>

                <div class="admin-row-thumb">
                  ${renderThumb(post)}
                </div>

                <div class="admin-row-main">
                  <h3 class="admin-row-title">${escapeHtml(title)}</h3>
                  <p class="admin-row-excerpt">${escapeHtml(makeExcerpt(post.text))}</p>
                  ${renderAdminTags(post)}
                </div>

                <div class="admin-row-meta">
                  <span class="admin-row-badge blue">ID ${escapeHtml(post.id)}</span>
                  <span class="admin-row-badge">${escapeHtml(mediaLabel(media?.media_type))}</span>
                  <span class="admin-row-badge gray">${escapeHtml(formatDate(post.created_at))}</span>
                </div>

                <div class="admin-row-actions">
                  ${adminRowButton("ویرایش", `data-edit-id="${post.id}"`)}
                  ${publicHref ? adminRowLink("مشاهده", publicHref, "data-row-action") : ""}
                  ${url ? adminRowButton("کپی URL", `data-copy-value="${escapeAttr(url)}"`) : ""}
                </div>
              </article>
            `;
          }).join("")}
          </div>
        `;

        renderMediaPagination(
          totalPages,
          mediaPostsTotal
        );
      }

      async function loadSeoChecklist() {
        const requestId = ++seoRequestSerial;

        seoChecklist.innerHTML =
          `<div class="empty">در حال دریافت اطلاعات SEO...</div>`;

        const offset =
          (Math.max(seoCurrentPage, 1) - 1) *
          SEO_POSTS_PER_PAGE;

        try {
          const data = await api(
            buildAdminPostsPath({
              limit: SEO_POSTS_PER_PAGE,
              offset,
              sort: "id"
            })
          );

          if (requestId !== seoRequestSerial) {
            return;
          }

          const nextPosts = Array.isArray(data?.posts)
            ? data.posts
            : [];

          const nextTotal = Number(
            data?.total ?? nextPosts.length
          );

          const totalPages = pageCount(
            nextTotal,
            SEO_POSTS_PER_PAGE
          );

          if (seoCurrentPage > totalPages) {
            seoCurrentPage = totalPages;
            await loadSeoChecklist();
            return;
          }

          seoPosts = nextPosts;
          seoPostsTotal = nextTotal;

          renderSeoChecklist();
        } catch (error) {
          if (requestId !== seoRequestSerial) {
            return;
          }

          seoChecklist.innerHTML =
            `<div class="empty">${escapeHtml(userFriendlyError(error, "دریافت اطلاعات SEO انجام نشد."))}</div>`;

          seoPagination.innerHTML = "";
        }
      }

      function renderSeoChecklist() {
        const missingCount =
          seoPosts.filter(post =>
            !post.seo_title ||
            !post.seo_description
          ).length;

        const totalPages = pageCount(
          seoPostsTotal,
          SEO_POSTS_PER_PAGE
        );

        seoPanelCount.textContent =
          `${seoPostsTotal} مطلب؛ ${missingCount} مورد ناقص در این صفحه`;

        completeSeoBtn.disabled =
          missingCount === 0;

        if (!seoPosts.length) {
          seoChecklist.innerHTML =
            `<div class="empty">مطلبی برای بررسی SEO وجود ندارد.</div>`;

          renderSeoPagination(
            totalPages,
            seoPostsTotal
          );

          return;
        }

        seoChecklist.innerHTML = `
          <div class="admin-data-list">
          ${seoPosts.map(post => {
            const publicHref = post.slug
              ? `/post/${encodeURIComponent(post.slug)}`
              : "";

            const publicUrl = publicHref
              ? `${window.location.origin}${publicHref}`
              : "";

            const generatedSeo =
              ensureSeoForPost(post);

            const titleStatus = post.seo_title
              ? "عنوان ثبت‌شده"
              : "عنوان پیشنهادی";

            const descStatus = post.seo_description
              ? "توضیح ثبت‌شده"
              : "توضیح پیشنهادی";

            return `
              <article class="admin-data-row admin-seo-row">
                <div class="admin-row-check">
                  <span class="admin-row-badge blue">SEO</span>
                </div>

                <div class="admin-row-thumb">
                  ${renderThumb(post)}
                </div>

                <div class="admin-row-main">
                  <h3 class="admin-row-title">${escapeHtml(makeTitle(post.text))}</h3>

                  <div class="admin-seo-preview">
                    <strong>${escapeHtml(generatedSeo.seo_title)}</strong>
                    <p>${escapeHtml(generatedSeo.seo_description)}</p>
                  </div>
                </div>

                <div class="admin-row-meta">
                  <span class="admin-row-badge blue">ID ${escapeHtml(post.id)}</span>
                  <span class="admin-row-badge ${post.seo_title ? "green" : "gray"}">${escapeHtml(titleStatus)}</span>
                  <span class="admin-row-badge ${post.seo_description ? "green" : "gray"}">${escapeHtml(descStatus)}</span>
                </div>

                <div class="admin-row-actions">
                  ${adminRowButton("ویرایش SEO", `data-edit-id="${post.id}" data-editor-target="seo"`, "warning")}
                  ${publicHref ? adminRowLink("مشاهده", publicHref, "data-row-action") : ""}
                  ${publicUrl ? adminRowButton("کپی لینک", `data-copy-value="${escapeAttr(publicUrl)}"`) : ""}
                </div>
              </article>
            `;
          }).join("")}
          </div>
        `;

        renderSeoPagination(
          totalPages,
          seoPostsTotal
        );
      }

      function updateLocalState() {
        tokenState.textContent = getToken() ? "در مرورگر ذخیره شده است" : "ذخیره نشده است";
      }

      function getFilteredPosts() {
        return [...posts];
      }

      function contentKind(post) {
        const media = mediaFromPost(post);
        const tags = parseContent(post.text).hashtags.map(tag => tag.trim());
        const hasTag = (...names) => tags.some(tag => names.includes(tag));

        if (media?.media_type === "photo") return "تصویر";
        if (media?.media_type === "video" || media?.media_type === "animation") return "ویدیو";
        if (media?.media_type === "audio" || media?.media_type === "voice") return "صوت";
        if (media?.media_type === "document") return "فایل";
        if (hasTag("شعر", "اشعار", "متن", "متن‌ها", "متن_ها")) return "شعر و متن";
        if (hasTag("کتاب")) return "کتاب";
        if (hasTag("نقاشی")) return "نقاشی";
        if (hasTag("دیالوگ", "دیالوگ‌ها", "دیالوگ_ها")) return "دیالوگ";
        return "متن";
      }

      function renderAdminTags(post, limit = 3) {
        const tags = parseContent(post.text).hashtags.slice(0, limit);
        if (!tags.length) return "";

        return `
          <div class="admin-row-tags">
            ${tags.map(tag => `<span class="admin-row-badge gray">#${escapeHtml(tag)}</span>`).join("")}
          </div>
        `;
      }

      function renderThumb(post) {
        const media = mediaFromPost(post);

        if (!media) return `<span class="admin-row-placeholder">متن</span>`;

        if (media.media_type === "photo" && media.media_url) {
          return `<img src="${escapeAttr(media.media_url)}" alt="" loading="lazy" decoding="async" width="76" height="76">`;
        }

        if (media.media_type === "video" && media.media_url) {
          return `<video src="${escapeAttr(media.media_url)}" muted preload="metadata" width="76" height="76"></video>`;
        }

        return `<span class="admin-row-placeholder">${escapeHtml(mediaLabel(media.media_type))}</span>`;
      }

      function adminRowButton(label, attrs = "", tone = "") {
        return `<button class="admin-btn admin-row-action admin-glass-btn ${tone}" type="button" ${attrs}>${escapeHtml(label)}</button>`;
      }

      function adminRowLink(label, href, attrs = "") {
        return `<a class="admin-btn admin-row-action admin-glass-btn" href="${escapeAttr(href)}" target="_blank" rel="noopener" ${attrs}>${escapeHtml(label)}</a>`;
      }

      function renderPosts() {
        const totalPages = pageCount(
          postsTotal,
          POSTS_PER_PAGE
        );

        if (posts.length === 0) {
          postsList.innerHTML =
            `<div class="empty">پستی پیدا نشد.</div>`;

          renderPagination(
            totalPages,
            postsTotal
          );

          return;
        }

        postsList.innerHTML = `
          <div class="admin-data-list">
            ${posts.map(post => {
          const active =
            selectedPost &&
            Number(selectedPost.id) === Number(post.id)
              ? "active"
              : "";

          const checked =
            selectedIds.has(Number(post.id))
              ? "checked"
              : "";

          const statusClass =
            Number(post.is_published) === 1
              ? "green"
              : "red";

          const statusText =
            Number(post.is_published) === 1
              ? "منتشر شده"
              : "منتشر نشده";

          const title = makeTitle(post.text);
          const excerpt = makeExcerpt(post.text);
          const media = mediaFromPost(post);
          const kind = contentKind(post);

          const publicHref = post.slug
            ? `/post/${encodeURIComponent(post.slug)}`
            : "";

          return `
            <article class="admin-data-row admin-post-row ${active}" data-row-id="${post.id}">
              <div class="admin-row-check">
                <input
                  class="admin-checkbox switch-input"
                  type="checkbox"
                  data-check-id="${post.id}"
                  ${checked}
                />
              </div>

              <div class="admin-row-thumb">
                ${renderThumb(post)}
              </div>

              <div class="admin-row-main">
                <h3 class="admin-row-title">${escapeHtml(title)}</h3>
                <p class="admin-row-excerpt">${escapeHtml(excerpt)}</p>
                ${renderAdminTags(post)}
              </div>

              <div class="admin-row-meta">
                <span class="admin-row-badge blue">ID ${escapeHtml(post.id)}</span>
                <span class="admin-row-badge ${statusClass}">${escapeHtml(statusText)}</span>
                <span class="admin-row-badge">${escapeHtml(kind)}</span>
                ${media ? `<span class="admin-row-badge gray">${escapeHtml(mediaLabel(media.media_type))}</span>` : ""}
                <span class="admin-row-badge gray">${escapeHtml(formatDate(post.created_at))}</span>
              </div>

              <div class="admin-row-actions">
                ${adminRowButton("ویرایش", `data-edit-id="${post.id}"`)}
                ${publicHref ? adminRowLink("مشاهده", publicHref, "data-row-action") : ""}
                ${publicHref ? adminRowButton("کپی لینک", `data-copy-value="${escapeAttr(window.location.origin + publicHref)}"`) : ""}
                ${adminRowButton("کپی ID", `data-copy-value="${post.id}"`)}
                ${adminRowButton(Number(post.is_published) === 1 ? "عدم انتشار" : "انتشار", `data-toggle-publish="${post.id}"`, Number(post.is_published) === 1 ? "warning" : "success")}
                ${adminRowButton("حذف نرم", `data-soft-delete-id="${post.id}"`, "danger")}
              </div>
            </article>
          `;
        }).join("")}
          </div>
        `;

        renderPagination(
          totalPages,
          postsTotal
        );
      }

      function renderPagination(totalPages, totalItems) {
        postsPagination.innerHTML =
          paginationMarkup({
            current: currentPage,
            totalPages,
            totalItems,
            pageAttribute: "data-page",
            previousAttribute: "data-page-prev",
            nextAttribute: "data-page-next"
          });
      }

      function renderDeletedPagination(totalPages, totalItems) {
        deletedPostsPagination.innerHTML =
          paginationMarkup({
            current: deletedCurrentPage,
            totalPages,
            totalItems,
            pageAttribute: "data-deleted-page",
            previousAttribute: "data-deleted-page-prev",
            nextAttribute: "data-deleted-page-next"
          });
      }

      function renderMediaPagination(totalPages, totalItems) {
        mediaPagination.innerHTML =
          paginationMarkup({
            current: mediaCurrentPage,
            totalPages,
            totalItems,
            pageAttribute: "data-media-page",
            previousAttribute: "data-media-page-prev",
            nextAttribute: "data-media-page-next"
          });
      }

      function renderSeoPagination(totalPages, totalItems) {
        seoPagination.innerHTML =
          paginationMarkup({
            current: seoCurrentPage,
            totalPages,
            totalItems,
            pageAttribute: "data-seo-page",
            previousAttribute: "data-seo-page-prev",
            nextAttribute: "data-seo-page-next"
          });
      }

      function updateSelectedCount() {
        const pageIds =
          posts.map(post => Number(post.id));

        const allPageSelected =
          pageIds.length > 0 &&
          pageIds.every(id =>
            selectedIds.has(id)
          );

        selectedCount.textContent =
          `${selectedIds.size} پست از این صفحه انتخاب شده`;

        selectAllBtn.textContent =
          allPageSelected
            ? "لغو انتخاب این صفحه"
            : "انتخاب همه این صفحه";
      }

      function setEditorTab(name) {
        document.querySelectorAll("[data-editor-tab]").forEach(tab => {
          tab.classList.toggle("active", tab.getAttribute("data-editor-tab") === name);
        });

        document.querySelectorAll("[data-editor-panel]").forEach(panel => {
          panel.classList.toggle("active", panel.getAttribute("data-editor-panel") === name);
        });
      }

      function selectPost(post) {
        selectedPost = post;
        currentMedia = mediaFromPost(post);

        editorTitle.textContent = `ویرایش پست با کد ثابت #${post.id}`;
        postId.value = post.id;
        updateStableIdDisplay(post.id);
        postSlug.value = post.slug || "";
        isPublished.checked = Number(post.is_published) === 1;
        postText.value = post.text || "";
        seoTitle.value = post.seo_title || "";
        seoDescription.value = post.seo_description || "";
        adminNote.value = post.admin_note || "";
        viewCount.textContent = currentMedia ? mediaLabel(currentMedia.media_type) : "بدون";

        renderMediaPreview();
        updateEditorStats();
        updatePreview();
        resetEditorDirty();
        renderPosts();
      }

      function clearEditor() {
        selectedPost = null;
        currentMedia = null;

        editorTitle.textContent = "ساخت پست جدید";
        postId.value = "";
        updateStableIdDisplay("");
        postSlug.value = "";
        isPublished.checked = true;
        postText.value = "";
        seoTitle.value = "";
        seoDescription.value = "";
        adminNote.value = "";
        viewCount.textContent = "-";
        mediaFile.value = "";

        renderMediaPreview();
        updateEditorStats();
        updatePreview();
        resetEditorDirty();
        renderPosts();
      }

      function updateEditorStats() {
        const text = postText.value || "";
        const parsed = parseContent(text);
        const words = text.trim() ? text.trim().split(/\s+/).length : 0;

        charCount.textContent = text.length;
        wordCount.textContent = words;
        tagCount.textContent = parsed.hashtags.length;
      }

      function updatePreview() {
        const parsed = parseContent(postText.value || "");

        previewTitle.textContent = parsed.title || "عنوان پست";
        previewContent.textContent = parsed.content || "متن پست اینجا نمایش داده می‌شود.";
        previewStatus.textContent = isPublished.checked ? "منتشر شده" : "منتشر نشده";
        previewStatus.className = isPublished.checked ? "badge green" : "badge red";

        previewTags.innerHTML = parsed.hashtags.length
          ? parsed.hashtags.map(tag => `<span class="badge">#${escapeHtml(tag)}</span>`).join("")
          : `<span class="badge gray">بدون هشتگ</span>`;
      }

      function editorPayload() {
        const media = currentMedia || {};

        return {
          text: postText.value.trim(),
          slug: postSlug.value.trim(),
          is_published: isPublished.checked ? 1 : 0,
          seo_title: seoTitle.value.trim(),
          seo_description: seoDescription.value.trim(),
          admin_note: adminNote.value.trim(),

          media_type: media.media_type || null,
          media_file_id: media.media_file_id || null,
          media_unique_id: media.media_unique_id || null,
          media_mime_type: media.media_mime_type || null,
          media_file_name: media.media_file_name || null,
          media_duration: media.media_duration || null,
          media_width: media.media_width || null,
          media_height: media.media_height || null,
          media_size: media.media_size || null
        };
      }

      function postPatchPayload(post, overrides = {}) {
        return {
          text: post.text || "",
          slug: post.slug || "",
          is_published: Number(post.is_published) === 1 ? 1 : 0,
          seo_title: post.seo_title || "",
          seo_description: post.seo_description || "",
          admin_note: post.admin_note || "",
          media_type: post.media_type || (post.photo_file_id ? "photo" : null),
          media_file_id: post.media_file_id || post.photo_file_id || null,
          media_unique_id: post.media_unique_id || post.photo_unique_id || null,
          media_mime_type: post.media_mime_type || null,
          media_file_name: post.media_file_name || null,
          media_duration: post.media_duration || null,
          media_width: post.media_width || post.photo_width || null,
          media_height: post.media_height || post.photo_height || null,
          media_size: post.media_size || null,
          ...overrides
        };
      }

      async function uploadMedia() {
        const file = mediaFile.files && mediaFile.files[0];

        if (!file) {
          showMessage(editorMessage, "اول یک فایل انتخاب کن.", "error");
          return;
        }

        if (uploadMediaBtn.disabled) return;

        const formData = new FormData();
        formData.append("file", file);

        setButtonLoading(uploadMediaBtn, true, "در حال آپلود...");

        try {
          const res = await fetch(`${WORKER_URL}/admin/upload`, {
            method: "POST",
            headers: authOnlyHeaders(),
            body: formData
          });

          const data = await res.json().catch(() => null);

          if (!res.ok || !data?.ok) {
            const error = new Error(
              data?.error ||
              "آپلود فایل ناموفق بود."
            );

            error.status = res.status;
            throw error;
          }

          currentMedia = data.media;
          renderMediaPreview();
          markEditorDirty();
          showMessage(editorMessage, "فایل با موفقیت ذخیره شد. برای اتصال آن به پست، ذخیره را بزن.", "ok");
        } catch (error) {
          if (recoverAdminSession(error)) {
            return;
          }

          showMessage(
            editorMessage,
            userFriendlyError(
              error,
              "آپلود فایل انجام نشد."
            ),
            "error"
          );
        } finally {
          setButtonLoading(uploadMediaBtn, false);
        }
      }

      function removeMedia() {
        currentMedia = null;
        mediaFile.value = "";
        renderMediaPreview();
        markEditorDirty();
        showMessage(editorMessage, "فایل از این پست حذف شد. برای اعمال تغییر، ذخیره را بزن.", "ok");
      }

      async function savePost() {
        if (saveBtn.disabled) return;

        const id = postId.value;
        const payload = editorPayload();

        if (!payload.text) {
          showMessage(
            editorMessage,
            "متن پست نمی‌تواند خالی باشد.",
            "error"
          );

          return;
        }

        setButtonLoading(
          saveBtn,
          true,
          id ? "در حال ذخیره..." : "در حال ساخت..."
        );

        try {
          let savedId = id;

          if (id) {
            await api(`/admin/posts/${id}`, {
              method: "PATCH",
              body: JSON.stringify(payload)
            });

            showMessage(
              editorMessage,
              `پست با کد ثابت #${id} با موفقیت ذخیره شد.`,
              "ok"
            );
          } else {
            const data = await api("/admin/posts", {
              method: "POST",
              body: JSON.stringify(payload)
            });

            savedId = data.id || "";

            showMessage(
              editorMessage,
              `پست جدید ساخته شد. کد ثابت آن #${savedId || "-"} است.`,
              "ok"
            );

            postId.value = savedId;
            updateStableIdDisplay(savedId);
            postSlug.value =
              data.slug || payload.slug;
          }

          await loadPosts();

          let fresh =
            findLoadedPostById(savedId);

          if (!fresh && savedId) {
            fresh =
              await fetchAdminPostById(savedId)
                .catch(() => null);
          }

          if (fresh) {
            selectPost(fresh);
          } else {
            resetEditorDirty();
          }
        } catch (error) {
          showMessage(
            editorMessage,
            userFriendlyError(
              error,
              "ذخیره پست انجام نشد."
            ),
            "error"
          );
        } finally {
          setButtonLoading(saveBtn, false);
        }
      }

      async function deletePost() {
        if (deleteBtn.disabled) return;

        const id = postId.value;

        if (!id) {
          showMessage(editorMessage, "برای حذف، اول یک پست را انتخاب کن.", "error");
          return;
        }

        const confirmed = await confirmAction({
          title: "حذف نرم مطلب",
          message: `این مطلب از سایت حذف می‌شود، اما شماره ثابت آن تغییر نمی‌کند و hard delete انجام نمی‌شود. برای تأیید، کد ${id} را وارد کنید.`,
          confirmText: "حذف نرم",
          requireValue: id
        });

        if (!confirmed) return;

        setButtonLoading(deleteBtn, true, "در حال حذف...");

        try {
          await api(`/admin/posts/${id}`, {
            method: "DELETE"
          });

          showMessage(editorMessage, `پست #${id} به‌صورت نرم حذف شد. شماره ثابت آن تغییر نکرد.`, "ok");
          clearEditor();
          await loadPosts();
        } catch (error) {
          showMessage(editorMessage, userFriendlyError(error, "حذف پست انجام نشد."), "error");
        } finally {
          setButtonLoading(deleteBtn, false);
        }
      }

      async function duplicatePost() {
        if (duplicateBtn.disabled) return;

        const payload = editorPayload();

        if (!payload.text) {
          showMessage(
            editorMessage,
            "متن پست خالی است.",
            "error"
          );

          return;
        }

        payload.slug = "";
        payload.is_published = 0;

        payload.admin_note =
          payload.admin_note
            ? payload.admin_note +
              "\nکپی شده از پست قبلی"
            : "کپی شده از پست قبلی";

        setButtonLoading(
          duplicateBtn,
          true,
          "در حال کپی..."
        );

        try {
          const data = await api("/admin/posts", {
            method: "POST",
            body: JSON.stringify(payload)
          });

          const createdId = data.id || "";

          showMessage(
            editorMessage,
            `کپی پست ساخته شد و با کد ثابت #${createdId || "-"} در حالت منتشر نشده قرار گرفت.`,
            "ok"
          );

          await loadPosts();

          let fresh =
            findLoadedPostById(createdId);

          if (!fresh && createdId) {
            fresh =
              await fetchAdminPostById(createdId)
                .catch(() => null);
          }

          if (fresh) {
            selectPost(fresh);
          }
        } catch (error) {
          showMessage(
            editorMessage,
            userFriendlyError(
              error,
              "کپی پست انجام نشد."
            ),
            "error"
          );
        } finally {
          setButtonLoading(
            duplicateBtn,
            false
          );
        }
      }

      async function completeMissingSeo() {
        const targets =
          seoPosts.filter(post =>
            !post.seo_title ||
            !post.seo_description
          );

        if (!targets.length) {
          showToast(
            "همه مطالب این صفحه سئوی کامل دارند.",
            "ok"
          );

          return;
        }

        const confirmed = await confirmAction({
          title: "تکمیل سئوی خالی‌های این صفحه",
          message: `برای ${targets.length} مطلب ناقص در صفحه جاری، عنوان و توضیح SEO پیشنهادی ساخته و ذخیره شود؟`,
          confirmText: "تکمیل سئوی صفحه"
        });

        if (
          !confirmed ||
          completeSeoBtn.disabled
        ) {
          return;
        }

        setButtonLoading(
          completeSeoBtn,
          true,
          "در حال تکمیل..."
        );

        let completed = 0;

        try {
          for (const post of targets) {
            const generatedSeo =
              ensureSeoForPost(post);

            await api(
              `/admin/posts/${post.id}`,
              {
                method: "PATCH",
                body: JSON.stringify(
                  postPatchPayload(post, {
                    seo_title:
                      post.seo_title ||
                      generatedSeo.seo_title,

                    seo_description:
                      post.seo_description ||
                      generatedSeo.seo_description
                  })
                )
              }
            );

            completed += 1;
          }

          showToast(
            `${completed} مطلب این صفحه با سئوی خودکار تکمیل شد.`,
            "ok"
          );

          await loadSeoChecklist();
          await loadPosts({
            refreshStats: true
          });
        } catch (error) {
          showMessage(
            editorMessage,
            userFriendlyError(
              error,
              `تکمیل SEO بعد از ${completed} مطلب متوقف شد.`
            ),
            "error"
          );
        } finally {
          setButtonLoading(
            completeSeoBtn,
            false
          );
        }
      }

      async function bulkAction(action) {
        if (selectedIds.size === 0) {
          showMessage(editorMessage, "هیچ پستی انتخاب نشده است.", "error");
          return;
        }

        if (action === "delete") {
          const confirmed = await confirmAction({
            title: "حذف نرم گروهی",
            message: `حذف نرم ${selectedIds.size} پست انتخاب‌شده انجام شود؟ شماره ثابت پست‌ها تغییر نمی‌کند و hard delete انجام نمی‌شود.`,
            confirmText: "حذف نرم"
          });
          if (!confirmed) return;
        }

        const buttonByAction = {
          publish: bulkPublishBtn,
          unpublish: bulkUnpublishBtn,
          delete: bulkDeleteBtn
        };
        const loadingTextByAction = {
          publish: "در حال انتشار...",
          unpublish: "در حال عدم انتشار...",
          delete: "در حال حذف..."
        };
        const doneTextByAction = {
          publish: "پست‌های انتخاب‌شده منتشر شدند.",
          unpublish: "پست‌های انتخاب‌شده از انتشار خارج شدند.",
          delete: "پست‌های انتخاب‌شده به‌صورت نرم حذف شدند."
        };
        const actionButton = buttonByAction[action];

        if (actionButton?.disabled) return;
        setButtonLoading(actionButton, true, loadingTextByAction[action] || "در حال انجام...");

        try {
          await api("/admin/posts/bulk", {
            method: "POST",
            body: JSON.stringify({
              action,
              ids: Array.from(selectedIds)
            })
          });

          selectedIds = new Set();
          await loadPosts();
          showMessage(editorMessage, doneTextByAction[action] || "عملیات گروهی انجام شد.", "ok");
        } catch (error) {
          showMessage(editorMessage, userFriendlyError(error, "عملیات گروهی انجام نشد."), "error");
        } finally {
          setButtonLoading(actionButton, false);
        }
      }

      function openPost() {
        const slug = postSlug.value.trim();

        if (!slug) {
          showMessage(editorMessage, "این پست slug ندارد.", "error");
          return;
        }

        window.open(`/post/${encodeURIComponent(slug)}`, "_blank");
      }

      async function copyLink() {
        const slug = postSlug.value.trim();

        if (!slug) {
          showMessage(editorMessage, "این پست slug ندارد.", "error");
          return;
        }

        const link = `${window.location.origin}/post/${encodeURIComponent(slug)}`;

        try {
          await navigator.clipboard.writeText(link);
          showMessage(editorMessage, "لینک پست کپی شد.", "ok");
        } catch {
          showMessage(editorMessage, link, "ok");
        }
      }

      async function copyValue(value, successText = "کپی شد.") {
        const text = String(value || "");

        if (!text) {
          showMessage(editorMessage, "چیزی برای کپی وجود ندارد.", "error");
          return;
        }

        try {
          await navigator.clipboard.writeText(text);
          showToast(successText, "ok");
        } catch {
          showMessage(editorMessage, text, "ok");
