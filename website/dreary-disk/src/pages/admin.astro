        showAdminSection("posts").then(() => {
          activePostsTabBtn.click();
          searchInput.focus();
        });
      });

      sectionLinks.forEach(link => {
        link.addEventListener("click", event => {
          event.preventDefault();
          showAdminSection(link.getAttribute("data-section-link"));
        });
      });

      refreshBtn.addEventListener("click", () => {
        const activeKey =
          activeAdminSectionKey();

        if (
          currentView === "deleted" ||
          activeKey === "deleted"
        ) {
          loadDeletedPosts();
          return;
        }

        if (activeKey === "media") {
          loadMediaLibrary();
          return;
        }

        if (activeKey === "seo") {
          loadSeoChecklist();
          return;
        }

        loadPosts();
      });
      activePostsTabBtn.addEventListener("click", () => showAdminSection("posts"));
      deletedPostsTabBtn.addEventListener("click", () => showAdminSection("deleted"));
      searchInput.addEventListener("input", () => {
        currentPage = 1;
        selectedIds = new Set();
        updateSelectedCount();

        clearTimeout(searchDebounceTimer);

        searchDebounceTimer =
          window.setTimeout(() => {
            loadPosts({
              refreshStats: false
            });
          }, 320);
      });

      [
        statusFilter,
        mediaFilter,
        sortFilter
      ].forEach(control => {
        control.addEventListener("change", () => {
          currentPage = 1;
          selectedIds = new Set();
          updateSelectedCount();

          loadPosts({
            refreshStats: false
          });
        });
      });

      document.querySelectorAll("[data-editor-tab]").forEach(tab => {
        tab.addEventListener("click", () => setEditorTab(tab.getAttribute("data-editor-tab")));
      });

      newPostBtn.addEventListener("click", () => showAdminSection("create"));
