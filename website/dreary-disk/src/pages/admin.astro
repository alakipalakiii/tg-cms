      const sectionMeta = {
        dashboard: { title: "داشبورد مدیریت", kicker: "نمای کلی ماهون", visible: "dashboard" },
        posts: { title: "مدیریت مطالب", kicker: "لیست، جستجو و عملیات گروهی", visible: "posts" },
        create: { title: "ایجاد مطلب", kicker: "فرم ساخت و ویرایش محتوا", visible: "create" },
        media: { title: "رسانه‌ها", kicker: "مطالب دارای فایل و پیش‌نمایش", visible: "media" },
        seo: { title: "سئو", kicker: "وضعیت عنوان، توضیح و پیش‌نمایش", visible: "seo" },
        "site-copy": { title: "متن‌ها و تنظیمات سایت", kicker: "ویرایش متن‌های عمومی سایت", visible: "site-copy" },
        deleted: { title: "حذف‌شده‌ها", kicker: "بازگردانی امن با ID ثابت", visible: "deleted" },
        analytics: { title: "آمار بازدید", kicker: "تحلیل رفتار مخاطبان و بازدیدهای سایت", visible: "analytics" },
        export: { title: "خروجی و ابزارها", kicker: "JSON، کپی لینک و ابزارهای سریع", visible: "export" },
        settings: { title: "تنظیمات محلی", kicker: "Token و داده‌های سمت مرورگر", visible: "settings" }
      };

      function sectionFromHash() {
        const key = (window.location.hash || "").replace("#", "");
        return sectionMeta[key] ? key : "dashboard";
      }

      function setActiveNav(sectionKey) {
        sectionLinks.forEach(link => {
          const active = link.getAttribute("data-section-link") === sectionKey;
          link.classList.toggle("active", active);
          link.setAttribute("aria-current", active ? "page" : "false");
        });
      }

      async function showAdminSection(sectionKey = "dashboard", options = {}) {
        const key = sectionMeta[sectionKey] ? sectionKey : "dashboard";
        const meta = sectionMeta[key];

        adminSections.forEach(section => {
          const active = section.getAttribute("data-admin-section") === meta.visible;
          section.hidden = !active;
          section.classList.toggle("is-active", active);
        });

        setActiveNav(key);
        activeSectionTitle.textContent = meta.title;
        activeSectionKicker.textContent = meta.kicker;

        if (!options.skipModeChange) {
          if (key === "deleted") {
            await showDeletedPostsView();
          } else if (meta.visible === "posts") {
            showActivePostsView();
          }

          if (key === "create") {
            clearEditor();
            setEditorTab("content");
          }

          if (key === "site-copy") {
            await loadSiteCopy();
          }

          if (key === "analytics") {
            await loadAnalyticsReport();
          }

          if (key === "media") {
            await loadMediaLibrary();
          }

          if (key === "seo") {
            await loadSeoChecklist();
          }
        }

        if (!options.skipHash) {
          history.replaceState(null, "", `#${key}`);
        }

        adminSidebar?.classList.remove("is-open");
        adminDrawerBackdrop?.classList.remove("is-open");
        sidebarToggle?.setAttribute("aria-expanded", "false");
      }

      function showMessage(element, text, type = "ok") {
        clearTimeout(messageTimer);
        element.textContent = text;
        element.className = `message show ${type}`;
        showToast(text, type);

        messageTimer = setTimeout(() => {
          element.className = "message";
          element.textContent = "";
        }, type === "error" ? 6200 : 4200);
      }

      function showToast(text, type = "ok") {
        if (!toastStack || !text) return;

        const toast = document.createElement("div");
        toast.className = `toast ${type === "error" ? "error" : ""}`;
        toast.textContent = text;
        toastStack.appendChild(toast);

        setTimeout(() => {
          toast.remove();
        }, type === "error" ? 6200 : 3600);
      }

      function confirmAction({ title, message, confirmText = "تأیید", requireValue = "" }) {
        if (!confirmDialog || typeof confirmDialog.showModal !== "function") {
          if (!window.confirm(`${title}\n\n${message}`)) return Promise.resolve(false);
          return Promise.resolve(true);
        }

        confirmTitle.textContent = title;
        confirmMessage.textContent = message;
        confirmOkBtn.textContent = confirmText;
        confirmInput.value = "";
        confirmInputWrap.hidden = !requireValue;

        return new Promise(resolve => {
          const onClose = () => {
            confirmDialog.removeEventListener("close", onClose);
            if (confirmDialog.returnValue !== "confirm") {
              resolve(false);
              return;
            }

            if (requireValue && confirmInput.value.trim() !== String(requireValue)) {
              showToast("کد واردشده با ID ثابت یکی نیست. عملیات انجام نشد.", "error");
              resolve(false);
              return;
            }

            resolve(true);
          };

          confirmDialog.addEventListener("close", onClose);
          confirmDialog.showModal();

          if (requireValue) {
            confirmInput.focus();
          }
        });
      }

      function userFriendlyError(error, fallback = "عملیات انجام نشد. دوباره تلاش کن.") {
        const message = error?.message || "";

        if (isAuthFailure(error)) {
          return "دسترسی مدیریت تأیید نشد. دوباره وارد پنل شو.";
        }

        if (/network|fetch|failed/i.test(message)) {
          return "ارتباط با API برقرار نشد. اتصال اینترنت یا سرویس مدیریت را بررسی کن.";
        }

        return message || fallback;
      }

      function setButtonLoading(button, isLoading, loadingText) {
        if (!button) return;

        if (isLoading) {
          button.dataset.originalText = button.textContent;
          button.textContent = loadingText;
          button.disabled = true;
          return;
        }

        button.textContent = button.dataset.originalText || button.textContent;
        button.disabled = false;
        delete button.dataset.originalText;
      }

      function authHeaders() {
        return {
          "Content-Type": "application/json",
          "Authorization": `Bearer ${getToken()}`,
          "X-Admin-Token": getToken()
        };
      }

      function authOnlyHeaders() {
        return {
          "Authorization": `Bearer ${getToken()}`,
          "X-Admin-Token": getToken()
        };
      }

      async function api(path, options = {}) {
        const controller = new AbortController();
        const timeoutMs = options.timeoutMs || API_TIMEOUT_MS;
        const timer = window.setTimeout(() => controller.abort(), timeoutMs);
        const { timeoutMs: _timeoutMs, skipAuthRecovery = false, ...fetchOptions } = options;

        const res = await fetch(`${WORKER_URL}${path}`, {
          ...fetchOptions,
          signal: controller.signal,
          headers: {
            ...authHeaders(),
            ...(fetchOptions.headers || {})
          }
        }).finally(() => window.clearTimeout(timer));

        const data = await res.json().catch(() => null);

        if (!res.ok) {
          const error = new Error(data?.error || "خطا در ارتباط با سرور");
          error.status = res.status;

          if (!skipAuthRecovery) {
            recoverAdminSession(error);
          }

          throw error;
        }

        return data;
      }

