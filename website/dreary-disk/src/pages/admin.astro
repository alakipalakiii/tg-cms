      function showMessage(element, text, type = "ok") {
        clearTimeout(messageTimer);
        element.textContent = text;
        element.className = `message show ${type}`;
        showToast(text, type);

        messageTimer = setTimeout(() => {
          element.className = "message";
          element.textContent = "";
        }, type === "error" ? 6200 : 4200);
      }

      function showToast(text, type = "ok") {
        if (!toastStack || !text) return;

        const toast = document.createElement("div");
        toast.className = `toast ${type === "error" ? "error" : ""}`;
        toast.textContent = text;
        toastStack.appendChild(toast);

        setTimeout(() => {
          toast.remove();
        }, type === "error" ? 6200 : 3600);
      }

      function confirmAction({ title, message, confirmText = "تأیید", requireValue = "" }) {
        if (!confirmDialog || typeof confirmDialog.showModal !== "function") {
          if (!window.confirm(`${title}\n\n${message}`)) return Promise.resolve(false);
          return Promise.resolve(true);
        }

        confirmTitle.textContent = title;
        confirmMessage.textContent = message;
        confirmOkBtn.textContent = confirmText;
        confirmInput.value = "";
        confirmInputWrap.hidden = !requireValue;

        return new Promise(resolve => {
          const onClose = () => {
            confirmDialog.removeEventListener("close", onClose);
            if (confirmDialog.returnValue !== "confirm") {
              resolve(false);
              return;
            }

            if (requireValue && confirmInput.value.trim() !== String(requireValue)) {
              showToast("کد واردشده با ID ثابت یکی نیست. عملیات انجام نشد.", "error");
              resolve(false);
              return;
            }

            resolve(true);
          };

          confirmDialog.addEventListener("close", onClose);
          confirmDialog.showModal();

          if (requireValue) {
            confirmInput.focus();
          }
        });
      }

      function userFriendlyError(error, fallback = "عملیات انجام نشد. دوباره تلاش کن.") {
        const message = error?.message || "";

        if (/unauthorized|forbidden|admin|token|401|403/i.test(message)) {
          return "دسترسی مدیریت تأیید نشد. دوباره وارد پنل شو.";
        }

        if (/network|fetch|failed/i.test(message)) {
          return "ارتباط با API برقرار نشد. اتصال اینترنت یا سرویس مدیریت را بررسی کن.";
        }

        return message || fallback;
      }

      function setButtonLoading(button, isLoading, loadingText) {
        if (!button) return;

        if (isLoading) {
          button.dataset.originalText = button.textContent;
          button.textContent = loadingText;
          button.disabled = true;
          return;
        }

        button.textContent = button.dataset.originalText || button.textContent;
        button.disabled = false;
        delete button.dataset.originalText;
      }

      function authHeaders() {
        return {
          "Content-Type": "application/json",
          "Authorization": `Bearer ${getToken()}`
        };
      }

      function authOnlyHeaders() {
        return {
          "Authorization": `Bearer ${getToken()}`
        };
      }

      async function api(path, options = {}) {
        const controller = new AbortController();
        const timeoutMs = options.timeoutMs || API_TIMEOUT_MS;
        const timer = window.setTimeout(() => controller.abort(), timeoutMs);
        const { timeoutMs: _timeoutMs, ...fetchOptions } = options;

        const res = await fetch(`${WORKER_URL}${path}`, {
          ...fetchOptions,
          signal: controller.signal,
          headers: {
            ...authHeaders(),
            ...(fetchOptions.headers || {})
          }
        }).finally(() => window.clearTimeout(timer));

        const data = await res.json().catch(() => null);

        if (!res.ok) {
          const error = new Error(data?.error || "خطا در ارتباط با سرور");
          error.status = res.status;
          throw error;
        }

        return data;
      }

