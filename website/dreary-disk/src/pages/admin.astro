      loginBtn.addEventListener("click", async () => {
        const token = tokenInput.value.trim();

        if (!token) {
          showMessage(loginMessage, "رمز مدیریت را وارد کن.", "error");
          return;
        }

        setToken(token);
        await testLogin();
      });

      tokenInput.addEventListener("keydown", event => {
        if (event.key === "Enter") {
          loginBtn.click();
        }
      });

      logoutBtn.addEventListener("click", () => {
        clearToken();
        showLogin();
      });

      document.querySelector("[data-sidebar-logout]")?.addEventListener("click", () => {
        logoutBtn.click();
      });

