                  ${renderThumb(post)}
                </div>

                <div class="admin-row-main">
                  <h3 class="admin-row-title">${escapeHtml(title)}</h3>
                  <p class="admin-row-excerpt">${escapeHtml(makeExcerpt(post.text))}</p>
