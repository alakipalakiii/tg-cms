      document.querySelectorAll(".section-list").forEach(list => {
        list.addEventListener("click", event => {
          const editButton = event.target.closest("[data-edit-id]");
          const copyButton = event.target.closest("[data-copy-value]");

          if (editButton) {
            const id = Number(editButton.getAttribute("data-edit-id"));
            const post = findLoadedPostById(id);
            if (post) {
              selectPost(post);
              const target = editButton.getAttribute("data-editor-target");
              if (target) setEditorTab(target);
              showAdminSection("create", { skipModeChange: true });
              document.getElementById("editorTitle")?.scrollIntoView({ behavior: "smooth", block: "start" });
            }
            return;
          }

          if (copyButton) {
            copyValue(copyButton.getAttribute("data-copy-value"), "مقدار کپی شد.");
