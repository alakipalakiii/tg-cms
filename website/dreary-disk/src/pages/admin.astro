---
export const prerender = false;

import "../styles/global.css";
import "../styles/admin.css";
import { SITE } from "../config";

const WORKER_URL = "https://api.mahoonartmagazine.ir";
const SITE_NAME = SITE.name;
const TELEGRAM_URL = SITE.telegramUrl;
const LOGO_URL = "/sources/mahoon-logo.jpg";
---

<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>پنل مدیریت حرفه‌ای | {SITE_NAME}</title>
  </head>

  <body class="admin-page">
    <main class="page">
      <div class="container">
        <section class="login-wrap" id="loginView">
          <form class="login-card" id="loginForm">
            <div class="login-brand"><img src={LOGO_URL} alt="نشان ماهون" width="44" height="44" /><div><strong>ماهون</strong><span>اتاق تحریریه</span></div></div>
            <h1>ورود به پنل مدیریت</h1>
            <p>مطالب، رسانه‌ها و انتشار مجله را از اینجا مدیریت کنید.</p>

            <div class="message" id="loginMessage" role="status" aria-live="polite"></div>

            <div class="field">
              <label for="tokenInput">رمز مدیریت</label>
              <input class="admin-input input" id="tokenInput" type="password" name="admin-token" autocomplete="current-password" required placeholder="رمز مدیریت را وارد کنید" />
            </div>

            <button class="admin-btn btn btn-primary" id="loginBtn" type="submit">ورود به پنل</button>
            <a class="admin-back-link" href="/">بازگشت به سایت ماهون</a>
          </form>
        </section>

        <section class="dashboard" id="dashboardView">
          <div class="admin-shell">
            <aside class="admin-sidebar" id="adminSidebar" aria-label="ناوبری مدیریت">
              <div class="admin-sidebar__brand">
                <img src={LOGO_URL} alt="" />
                <div>
                  <strong>ماهون</strong>
                  <span>پنل مدیریت محتوا</span>
                </div>
              </div>

              <nav class="admin-nav"><p class="nav-group-label">تحریریه</p>
                <a class="active" href="#dashboard" data-section-link="dashboard">داشبورد</a>
                <a href="#posts" data-section-link="posts">مطالب</a>
                <a href="#create" data-section-link="create">ایجاد مطلب</a>
                <p class="nav-group-label">مدیریت مجله</p><a href="#automation" data-section-link="automation">انتشار و خودکارسازی</a>
                <a href="#media" data-section-link="media">رسانه‌ها</a>
                <a href="#seo" data-section-link="seo">سئو</a>
                <a href="#site-copy" data-section-link="site-copy">متن‌های سایت</a>
                <a href="#deleted" data-section-link="deleted">حذف‌شده‌ها</a>
                <a href="#analytics" data-section-link="analytics">آمار بازدید</a>
                <a href="#export" data-section-link="export">خروجی</a>
                <a href="#settings" data-section-link="settings">دسترسی و دستگاه</a>
              </nav>

              <button class="admin-btn admin-sidebar__logout" type="button" data-sidebar-logout>خروج از پنل</button>
            </aside>
            <button class="admin-drawer-backdrop" id="adminDrawerBackdrop" type="button" aria-label="بستن منوی مدیریت"></button>

            <div class="admin-workspace admin-main">
              <div class="admin-topbar admin-topline">
                <div>
                  <span class="admin-kicker" id="activeSectionKicker">داشبورد مدیریتی ماهون</span>
                  <h1 id="activeSectionTitle">مدیریت مطالب و رسانه‌ها</h1>
                </div>

                <div class="admin-topline__tools">
                  <button class="admin-btn btn btn-gold sidebar-toggle" id="sidebarToggle" type="button" aria-controls="adminSidebar" aria-expanded="false">منو</button>
                  <span class="api-status" id="apiStatus">API آماده بررسی</span>
                  <span class="api-status api-status--count"><b id="topbarTotalCount">0</b> مطلب</span>
                  <button class="admin-btn btn btn-line" type="button" data-focus-search title="جستجوی مطالب (Ctrl+K)">جستجوی مطالب</button>
                  <button class="admin-btn btn btn-line" id="themeToggle" type="button" aria-pressed="false">نمای تیره</button>
                  <a class="admin-btn btn btn-line" href="/">مشاهده سایت</a>
                  <button class="admin-btn btn btn-blue" id="exportBtn" type="button">خروجی JSON</button>
                  <button class="admin-btn btn btn-danger" id="logoutBtn" type="button">خروج</button>
                </div>
              </div>

              <div class="admin-content">
              <div class="draft-recovery" id="draftRecovery" hidden role="status">
                <span>یک پیش‌نویس ذخیره‌نشده در این تب دارید. برای ادامه آن را بازیابی کنید.</span>
                <div class="actions"><button class="btn btn-line" id="restoreLocalDraft" type="button">بازیابی پیش‌نویس</button><button class="btn btn-line" id="discardLocalDraft" type="button">کنار گذاشتن</button></div>
              </div>
              <section class="admin-section is-active" id="dashboardPanel" data-section="dashboard" data-admin-section="dashboard">
              <div class="admin-intro"><div><span class="eyebrow">میزکار روزانه</span><h2>مجله را با خیال راحت مدیریت کنید.</h2><p>از نوشتن و بازبینی تا انتشار؛ همه‌چیز در یک مسیر روشن.</p></div><time id="workspaceDate" class="badge gray"></time></div>
              <div class="dashboard-actions"><a href="#create" data-start-new><strong>نوشتن مطلب جدید</strong><small>ویرایشگر با پیش‌نمایش و سئوی خودکار</small></a><a href="#automation"><strong>قانون انتشار از تلگرام</strong><small>تنظیم هشتگ‌ها و بازبینی خودکار محتوا</small></a><a href="#deleted"><strong>بازگردانی مطالب</strong><small>حذف قابل برگشت با حفظ کد ثابت</small></a></div>
              <div class="stats">
                <div class="stat-card stat-card-total"><i>▦</i><strong id="totalCount">0</strong><span>کل مطالب</span></div>
                <div class="stat-card stat-card-published"><i>✓</i><strong id="publishedCount">0</strong><span>منتشرشده</span></div>
                <div class="stat-card stat-card-draft"><i>◌</i><strong id="draftCount">0</strong><span>پیش‌نویس</span></div>
                <div class="stat-card stat-card-deleted"><i>×</i><strong id="deletedCount">0</strong><span>حذف‌شده‌ها</span></div>
                <div class="stat-card stat-card-media"><i>▣</i><strong id="mediaCount">0</strong><span>دارای رسانه</span></div>
                <div class="stat-card stat-card-text"><i>≡</i><strong id="textCount">0</strong><span>بدون رسانه</span></div>
                <div class="stat-card stat-card-latest"><i>#</i><strong id="latestIdCount">0</strong><span>آخرین کد مطلب</span></div>
                <div class="stat-card stat-card-tags"><i>⌁</i><strong id="tagsCount">0</strong><span>هشتگ‌ها</span></div>
              </div>

              <div class="dashboard-insights">
                <section class="panel compact-panel">
                  <div class="panel-head">
                    <h2>آخرین فعالیت</h2>
                    <span class="badge gray" id="lastRefresh">هنوز بروزرسانی نشده</span>
                  </div>
                  <div class="panel-body">
                    <div class="activity-list" id="activityList">
                      <div class="empty">بعد از ورود، آخرین مطالب اینجا نمایش داده می‌شود.</div>
                    </div>
                  </div>
                </section>

                <section class="panel compact-panel">
                  <div class="panel-head">
                    <h2>وضعیت انتشار</h2>
                  </div>
                  <div class="panel-body">
                    <div class="progress-card">
                      <div>
                        <strong id="publishRate">0%</strong>
                        <span>نسبت مطالب منتشرشده</span>
                      </div>
                      <div class="progress-track" aria-hidden="true">
                        <span id="publishProgress"></span>
                      </div>
                    </div>
                    <div class="api-card">
                      <strong>وضعیت اتصال</strong>
                      <span id="apiDetailText">برای بررسی، وارد پنل شوید.</span>
                    </div>
                  </div>
                </section>
              </div>
              </section>

          <section class="admin-section" id="postsSection" data-section="posts" data-admin-section="posts" hidden>
            <section class="panel" id="postsPanel">
              <div class="panel-head">
                <h2>مدیریت پست‌ها</h2>
                <div class="actions">
                  <button class="admin-btn btn btn-gold" id="newPostBtn" type="button">پست جدید</button>
                  <button class="admin-btn btn btn-line" id="refreshBtn" type="button">بروزرسانی</button>
                </div>
              </div>

              <div class="panel-body">
                <div class="view-tabs">
                  <button class="admin-btn btn btn-line active" id="activePostsTabBtn" type="button">پست‌های فعال</button>
                  <button class="admin-btn btn btn-line" id="deletedPostsTabBtn" type="button">حذف‌شده‌ها</button>
                </div>

                <div class="filters">
                  <input class="admin-input input" id="searchInput" aria-label="جستجو در مطالب" type="search" placeholder="جستجو در پست‌ها..." />

                  <select class="admin-select select" id="statusFilter" aria-label="وضعیت انتشار">
                    <option value="all">همه وضعیت‌ها</option>
                    <option value="published">منتشر شده</option>
                    <option value="draft">منتشر نشده</option>
                  </select>

                  <select class="admin-select select" id="mediaFilter" aria-label="نوع محتوا">
                    <option value="all">همه محتواها</option>
                    <option value="media">دارای فایل</option>
                    <option value="photo">عکس</option>
                    <option value="video">ویدیو</option>
                    <option value="audio">صوت</option>
                    <option value="text">بدون فایل</option>
                  </select>

                  <select class="admin-select select" id="sortFilter" aria-label="ترتیب مطالب">
                    <option value="newest">جدیدترین</option>
                    <option value="oldest">قدیمی‌ترین</option>
                    <option value="id">کد مطلب</option>
                    <option value="title">عنوان</option>
                  </select>
                </div>

                <div class="bulkbar">
                  <strong id="selectedCount">۰ پست انتخاب شده</strong>

                  <div class="actions">
                    <button class="admin-btn btn btn-line" id="selectAllBtn" type="button">انتخاب همه این صفحه</button>
                    <button class="admin-btn btn btn-green" id="bulkPublishBtn" type="button">انتشار</button>
                    <button class="admin-btn btn btn-gold" id="bulkUnpublishBtn" type="button">عدم انتشار</button>
                    <button class="admin-btn btn btn-danger" id="bulkDeleteBtn" type="button">حذف</button>
                  </div>
                </div>

                <div class="posts-list" id="postsList">
                  <div class="empty">در حال دریافت پست‌ها...</div>
                </div>

                <div class="pagination" id="postsPagination" aria-label="صفحه‌بندی مطالب"></div>
              </div>
            </section>
          </section>

          <section class="admin-section" id="createSection" data-section="create" data-admin-section="create" hidden>
            <aside class="panel" id="createPanel">
              <div class="panel-head">
                <h2 id="editorTitle">ویرایش پست</h2>
              </div>

              <div class="panel-body">
                <div class="message" id="editorMessage"></div>

                <input class="admin-input input sr-only-input" type="hidden" id="postId" />

                <div class="editor-meta">
                  <div class="mini-stat"><strong id="stablePostId">-</strong><span>کد ثابت</span></div>
                  <div class="mini-stat"><strong id="charCount">0</strong><span>کاراکتر</span></div>
                  <div class="mini-stat"><strong id="wordCount">0</strong><span>کلمه</span></div>
                  <div class="mini-stat"><strong id="tagCount">0</strong><span>هشتگ</span></div>
                  <div class="mini-stat"><strong id="viewCount">-</strong><span>رسانه</span></div>
                </div>

                <div class="editor-tabs" role="tablist" aria-label="بخش‌های فرم مطلب">
                  <button class="admin-btn editor-tab-btn active" type="button" data-editor-tab="content">محتوا</button>
                  <button class="admin-btn editor-tab-btn" type="button" data-editor-tab="media">رسانه</button>
                  <button class="admin-btn editor-tab-btn" type="button" data-editor-tab="seo">سئو</button>
                  <button class="admin-btn editor-tab-btn" type="button" data-editor-tab="note">یادداشت مدیریتی</button>
                  <button class="admin-btn editor-tab-btn" type="button" data-editor-tab="preview">پیش‌نمایش</button>
                </div>

                <div class="editor-tab-panel active" data-editor-panel="content">
                  <div class="id-note" id="stableIdNote">
                    <strong>کد ثابت پست:</strong>
                    این ID همان کدی است که در ربات استفاده می‌شود و بعد از حذف پست‌های دیگر تغییر نمی‌کند.
                  </div>

                  <div class="field">
                    <label for="postSlug">Slug / آدرس پست</label>
                    <div class="slug-row">
                      <input class="admin-input input" id="postSlug" type="text" placeholder="post-slug" />
                      <button class="admin-btn btn btn-line" id="generateSlugBtn" type="button">ساخت</button>
                    </div>
                  </div>

                  <div class="switch-line">
                    <span>انتشار در سایت</span>
                    <input class="admin-checkbox switch-input" id="isPublished" aria-label="انتشار در سایت" type="checkbox" checked />
                  </div>

                  <div class="field">
                    <p class="admin-help" id="editorPublicationState" role="status"></p>
                    <label for="postText">متن پست</label>
                    <textarea class="admin-textarea textarea" id="postText" placeholder="متن پست را وارد کن..."></textarea>
                  </div>
                </div>

                <div class="editor-tab-panel" data-editor-panel="media">
                  <h3 class="tab-title">فایل پست</h3>

                  <div class="media-uploader">
                    <div class="media-uploader-row">
                      <input class="admin-input input"
                        id="mediaFile" aria-label="انتخاب فایل مطلب"
                        type="file"
                        accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.rar"
                      />
                      <button class="admin-btn btn btn-blue" id="uploadMediaBtn" type="button">آپلود فایل</button>
                      <button class="admin-btn btn btn-danger" id="removeMediaBtn" type="button">حذف فایل</button>
                    </div>

                    <div class="media-preview" id="mediaPreview">
                      هنوز فایلی برای این پست انتخاب نشده است.
                    </div>
                  </div>
                </div>

                <div class="editor-tab-panel" data-editor-panel="seo">
                  <h3 class="tab-title">سئوی خودکار</h3>
                  <p class="admin-help">عنوان و توضیح از متن مطلب ساخته می‌شوند. برای به‌روزرسانی خودکار، فیلدها را خالی بگذارید؛ مقدار دلخواه شما اولویت دارد.</p>
                  <div class="seo-preview" aria-label="پیش‌نمایش نتیجه جستجو">
                    <b id="editorSeoTitle"></b><small id="editorSeoUrl"></small><p id="editorSeoDescription"></p>
                  </div>

                  <div class="field">
                    <label for="seoTitle">SEO Title</label>
                    <input class="admin-input input" id="seoTitle" type="text" placeholder="اگر خالی باشد، عنوان از متن ساخته می‌شود" />
                  </div>

                  <div class="field">
                    <label for="seoDescription">SEO Description</label>
                    <textarea class="admin-textarea textarea small" id="seoDescription" placeholder="توضیح کوتاه برای گوگل و شبکه‌های اجتماعی"></textarea>
                  </div>
                </div>

                <div class="editor-tab-panel" data-editor-panel="note">
                  <h3 class="tab-title">یادداشت داخلی</h3>

                  <div class="field">
                    <label for="adminNote">یادداشت فقط برای مدیر</label>
                    <textarea class="admin-textarea textarea small" id="adminNote" placeholder="مثلاً: نیاز به بازبینی، زمان انتشار، نکته داخلی..."></textarea>
                  </div>
                </div>

                <div class="editor-tab-panel" data-editor-panel="preview">
                  <div class="preview">
                    <div class="preview-head">
                      <strong>پیش‌نمایش زنده</strong>
                      <span class="badge" id="previewStatus">پیش‌نویس</span>
                    </div>

                    <div class="preview-body">
                      <h3 class="preview-title" id="previewTitle">عنوان پست</h3>
                      <div class="preview-content" id="previewContent">متن پست اینجا نمایش داده می‌شود.</div>
                      <div class="preview-tags" id="previewTags"></div>
                    </div>
                  </div>
                </div>

                <div class="editor-actions">
                  <button class="admin-btn btn btn-primary" id="saveBtn" type="button">ذخیره</button>
                  <button class="admin-btn btn btn-green" id="openPostBtn" type="button">مشاهده</button>
                  <button class="admin-btn btn btn-blue" id="copyLinkBtn" type="button">کپی لینک</button>
                  <button class="admin-btn btn btn-gold" id="duplicateBtn" type="button">کپی پست</button>
                  <button class="admin-btn btn btn-danger" id="deleteBtn" type="button">حذف</button>
                  <button class="admin-btn btn btn-line" id="clearBtn" type="button">پاک کردن</button>
                  <span class="editor-save-state" id="localDraftState" role="status">نسخه موقت در همین تب نگهداری می‌شود.</span>
                </div>
              </div>
            </aside>
          </section>

                            <section class="panel admin-section" id="deletedPanel" data-section="deleted" data-admin-section="deleted" hidden>
                <div class="panel-head">
                  <h2>حذف‌شده‌ها</h2>
                  <span class="badge red">بازگردانی امن</span>
                </div>

                <div class="panel-body">
                  <div class="posts-list" id="deletedPostsList">
                    <div class="id-note deleted-note">
                      <strong>پست‌های حذف‌شده:</strong>
                      بازگردانی فقط با ID ثابت دیتابیس انجام می‌شود؛ این ID همان کد ربات است و بعد از حذف تغییر نمی‌کند.
                    </div>

                    <div class="empty">برای دیدن پست‌های حذف‌شده، بخش حذف‌شده‌ها را باز کن.</div>
                  </div>

                  <div class="pagination" id="deletedPostsPagination" aria-label="صفحه‌بندی مطالب حذف‌شده"></div>
                </div>
              </section>

              <div class="admin-sections">
                                <section class="panel admin-section" id="mediaPanel" data-section="media" data-admin-section="media" hidden>
                  <div class="panel-head">
                    <h2>رسانه‌ها</h2>
                    <span class="badge blue" id="mediaPanelCount">0 مورد</span>
                  </div>

                  <div class="panel-body">
                    <div class="section-list" id="mediaLibrary">
                      <div class="empty">مطلب دارای رسانه پیدا نشد.</div>
                    </div>

                    <div class="pagination" id="mediaPagination" aria-label="صفحه‌بندی رسانه‌ها"></div>
                  </div>
                </section>

                                <section class="panel admin-section" id="seoPanel" data-section="seo" data-admin-section="seo" hidden>
                  <div class="panel-head">
                    <h2>سئو</h2>

                    <div class="actions">
                      <span class="badge" id="seoPanelCount">0 مورد نیازمند بررسی</span>
                      <button class="admin-btn btn btn-primary" id="completeSeoBtn" type="button">تکمیل سئوی خالی‌های این صفحه</button>
                    </div>
                  </div>

                  <div class="panel-body">
                    <div class="section-list" id="seoChecklist">
                      <div class="empty">داده‌ای برای بررسی SEO وجود ندارد.</div>
                    </div>

                    <div class="pagination" id="seoPagination" aria-label="صفحه‌بندی بررسی سئو"></div>
                  </div>
                </section>

                <section class="panel admin-section" id="siteCopyPanel" data-section="site-copy" data-admin-section="site-copy" hidden>
                  <div class="panel-head">
                    <h2>متن‌ها و تنظیمات سایت</h2>
                    <div class="actions">
                      <span class="badge gray" id="siteCopyState">آماده بارگذاری</span>
                      <button class="admin-btn btn btn-line" id="reloadSiteCopyBtn" type="button">بارگذاری دوباره</button>
                      <button class="admin-btn btn btn-primary" id="saveSiteCopyBtn" type="button">ذخیره متن‌ها</button>
                    </div>
                  </div>
                  <div class="panel-body">
                    <p class="admin-help">
                      این متن‌ها در سایت عمومی از مسیر امن تنظیمات خوانده می‌شوند و اگر API در دسترس نباشد، سایت از متن‌های پیش‌فرض استفاده می‌کند.
                    </p>
                    <div class="message" id="siteCopyMessage"></div>
                    <div class="site-copy-grid">
                      <div class="field">
                        <label for="siteNameInput">نام سایت</label>
                        <input class="admin-input input" id="siteNameInput" type="text" />
                      </div>
                      <div class="field">
                        <label for="headerDescriptionInput">توضیح کوتاه هدر</label>
                        <input class="admin-input input" id="headerDescriptionInput" type="text" />
                      </div>
                      <div class="field">
                        <label for="homeHeroLineOneInput">خط اول hero صفحه اصلی</label>
                        <input class="admin-input input" id="homeHeroLineOneInput" type="text" />
                      </div>
                      <div class="field">
                        <label for="homeHeroLineTwoInput">خط دوم hero صفحه اصلی</label>
                        <input class="admin-input input" id="homeHeroLineTwoInput" type="text" />
                      </div>
                      <div class="field">
                        <label for="homeLatestTitleInput">عنوان بخش تازه‌ترین روایت</label>
                        <input class="admin-input input" id="homeLatestTitleInput" type="text" />
                      </div>
                    <div class="field field-wide">
                      <div class="api-card">
                        <strong>تبلیغات صفحه اصلی</strong>
                        <span>این بخش، دو باکس تبلیغاتی بالای دسته‌بندی‌ها را کنترل می‌کند. اگر لینک را خالی بگذاری، دکمه تبلیغ به حالت «جایگاه قابل مدیریت» نمایش داده می‌شود.</span>
                      </div>
                    </div>

                    <div class="field">
