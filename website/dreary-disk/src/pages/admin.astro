          posts.map(post =>
            Number(post.id)
          );

        const allPageSelected =
          pageIds.length > 0 &&
          pageIds.every(id =>
            selectedIds.has(id)
          );

        selectedIds = allPageSelected
          ? new Set()
          : new Set(pageIds);

        updateSelectedCount();
        renderPosts();
      });

      generateSlugBtn.addEventListener("click", () => {
        postSlug.value = makeSlugFromText(postText.value);
        markEditorDirty();
      });

      postText.addEventListener("input", () => {
        markEditorDirty();
        updateEditorStats();
        updatePreview();
      });

      postSlug.addEventListener("input", markEditorDirty);
      isPublished.addEventListener("change", () => {
        markEditorDirty();
        updatePreview();
      });
      seoTitle.addEventListener("input", () => {
        markEditorDirty();
        updatePreview();
      });
      seoDescription.addEventListener("input", () => {
        markEditorDirty();
        updatePreview();
      });
      adminNote.addEventListener("input", markEditorDirty);
      mediaFile.addEventListener("change", markEditorDirty);

      window.addEventListener("beforeunload", event => {
        if (!editorDirty) return;

        event.preventDefault();
        event.returnValue = "";
      });

      window.addEventListener("hashchange", () => {
        if (!dashboardView.classList.contains("active")) return;
        showAdminSection(sectionFromHash(), { skipHash: true });
      });

      clearEditor();

      if (getToken()) {
        testLogin();
      } else {
        showLogin();
      }
    </script>
