---
export const prerender = false;

import "../styles/global.css";
import { SITE } from "../config";

const WORKER_URL = "https://api.mahoonartmagazine.ir";
const SITE_NAME = SITE.name;
const TELEGRAM_URL = SITE.telegramUrl;
const LOGO_URL = "/sources/mahoon-logo.jpg";
---

<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>پنل مدیریت حرفه‌ای | {SITE_NAME}</title>

    <style>
      @font-face {
        font-family: "MahoonFont";
        src: url("/fonts/Mahoor-FD-Regular.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --bg: #21110f;
        --surface: #fffaf2;
        --ink: #1b1712;
        --muted: #75645c;
        --line: rgba(74, 9, 13, 0.1);
        --accent: #6d0f14;
        --accent-deep: #4a090d;
        --sidebar: #2a1713;
        --sidebar-deep: #170c0a;
        --gold: #b88746;
        --gold-soft: #efe0c6;
        --cream: #f7efe6;
        --rose: #e8d3cc;
        --dark: #2a1713;
        --danger: #b84242;
        --green: #2f855a;
        --blue: #2b6cb0;
        --shadow: 0 22px 60px rgba(74, 9, 13, 0.1);
        --shadow-row: 0 14px 38px rgba(74, 9, 13, 0.07);
        --glass: rgba(255, 250, 242, 0.72);
        --radius-xl: 28px;
        --radius-lg: 20px;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: "MahoonFont", Tahoma, Arial, sans-serif;
        background:
          radial-gradient(circle at 100% 0%, rgba(109, 15, 20, 0.18), transparent 28%),
          radial-gradient(circle at 0% 100%, rgba(201, 166, 107, 0.18), transparent 30%),
          linear-gradient(135deg, #f4eadf 0%, #efe2d6 42%, #f8f1e9 100%);
        color: var(--ink);
        min-height: 100vh;
        overflow-x: hidden;
      }

      button, input, textarea, select {
        font-family: inherit;
      }

      button, input, textarea, select, a {
        max-width: 100%;
      }

      .container {
        width: min(1420px, calc(100% - 32px));
        margin: 0 auto;
      }

      .topbar {
        position: static;
        z-index: 50;
        border-bottom: 1px solid rgba(255, 248, 239, 0.1);
        background: rgba(17, 24, 39, 0.88);
        backdrop-filter: blur(18px);
      }

      .topbar-inner {
        min-height: 86px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .brand img {
        width: 58px;
        height: 58px;
        object-fit: contain;
        background: #fff;
        padding: 7px;
        border-radius: 18px;
        border: 1px solid var(--line);
        box-shadow: 0 12px 32px rgba(34, 24, 15, 0.12);
      }

      .brand strong {
        display: block;
        font-size: 19px;
        color: #fff8ef;
      }

      .brand span {
        display: block;
        margin-top: 5px;
        color: rgba(255, 248, 239, 0.62);
        font-size: 13px;
      }

      .actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
      }

      .btn {
        border: 1px solid rgba(74, 9, 13, 0.1);
        cursor: pointer;
        border-radius: 14px;
        padding: 10px 15px;
        font-size: 13px;
        font-weight: 800;
        transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease, border-color 0.18s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        white-space: nowrap;
        backdrop-filter: blur(14px);
        box-shadow: 0 10px 26px rgba(74, 9, 13, 0.06);
      }

      .btn:hover {
        transform: translateY(-2px);
      }

      .btn:disabled {
        cursor: not-allowed;
        opacity: 0.58;
        transform: none;
      }

      .btn-primary {
        background: linear-gradient(135deg, var(--accent), var(--accent-deep));
        color: #fff;
        border-color: rgba(109, 15, 20, 0.18);
      }

      .btn-gold {
        background: rgba(239, 224, 198, 0.68);
        color: #704915;
        border-color: rgba(184, 135, 70, 0.18);
      }

      .btn-danger {
        background: rgba(184, 66, 66, 0.1);
        color: var(--danger);
        border-color: rgba(184, 66, 66, 0.16);
      }

      .btn-green {
        background: rgba(47, 133, 90, 0.1);
        color: var(--green);
        border-color: rgba(47, 133, 90, 0.16);
      }

      .btn-blue {
        background: rgba(43, 108, 176, 0.1);
        color: var(--blue);
        border-color: rgba(43, 108, 176, 0.16);
      }

      .btn-line {
        background: rgba(255, 255, 255, 0.62);
        color: var(--ink);
        border-color: rgba(74, 9, 13, 0.1);
      }

      .page {
        padding: 32px 0 72px;
      }

      .login-wrap {
        min-height: calc(100vh - 120px);
        display: grid;
        place-items: center;
      }

      .login-card {
        width: min(540px, 100%);
        background:
          linear-gradient(180deg, rgba(255, 248, 239, 0.98), rgba(244, 234, 223, 0.96));
        border: 1px solid rgba(255, 248, 239, 0.16);
        border-radius: var(--radius-xl);
        padding: 36px;
        box-shadow: 0 34px 110px rgba(0, 0, 0, 0.28);
      }

      .login-card h1 {
        margin: 18px 0 10px;
        font-size: 32px;
      }

      .login-card p {
        margin: 0 0 24px;
        color: var(--muted);
        line-height: 2;
      }

      .dashboard {
        display: none;
      }

      .dashboard.active {
        display: block;
      }

      .login-wrap.active {
        display: grid;
      }

      .login-wrap:not(.active) {
        display: none;
      }

      .admin-shell {
        display: grid;
        grid-template-columns: minmax(260px, 292px) minmax(0, 1fr);
        gap: 20px;
        align-items: start;
      }

      .admin-sidebar {
        position: sticky;
        top: 24px;
        min-height: calc(100vh - 48px);
        display: flex;
        flex-direction: column;
        gap: 18px;
        padding: 16px;
        color: rgba(255, 248, 239, 0.78);
        border: 1px solid rgba(255, 248, 239, 0.1);
        border-radius: 26px;
        background:
          linear-gradient(180deg, rgba(74, 9, 13, 0.88), rgba(42, 23, 19, 0.98)),
          var(--sidebar);
        box-shadow: 0 24px 70px rgba(74, 9, 13, 0.2);
      }

      .admin-sidebar__brand {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-bottom: 16px;
        border-bottom: 1px solid rgba(255, 248, 239, 0.12);
      }

      .admin-sidebar__brand img {
        width: 48px;
        height: 48px;
        object-fit: contain;
        border-radius: 16px;
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.22);
      }

      .admin-sidebar__brand strong {
        display: block;
        color: #fff8ef;
        font-size: 18px;
      }

      .admin-sidebar__brand span {
        display: block;
        margin-top: 3px;
        color: rgba(255, 248, 239, 0.56);
        font-size: 12px;
      }

      .admin-nav {
        display: grid;
        gap: 5px;
      }

      .admin-nav a,
      .admin-sidebar__logout {
        min-height: 40px;
        display: flex;
        align-items: center;
        gap: 9px;
        border: 1px solid transparent;
        border-radius: 12px;
        padding: 9px 10px;
        color: rgba(255, 248, 239, 0.72);
        text-decoration: none;
        background: transparent;
        font: inherit;
        cursor: pointer;
      }

      .admin-nav a span {
        width: 24px;
        height: 24px;
        display: grid;
        place-items: center;
        border-radius: 9px;
        background: rgba(255, 248, 239, 0.08);
        color: var(--gold);
        flex: 0 0 auto;
      }

      .admin-nav a:hover,
      .admin-nav a.active {
        color: #fff8ef;
        border-color: rgba(201, 166, 107, 0.28);
        background: rgba(255, 248, 239, 0.08);
      }

      .admin-sidebar__logout {
        margin-top: auto;
        color: #ffd7d7;
        background: rgba(184, 66, 66, 0.12);
      }

      .admin-main {
        min-width: 0;
        overflow: hidden;
      }

      .admin-workspace,
      .admin-content {
        min-width: 0;
        max-width: 100%;
      }

      .admin-content {
        display: block;
      }

      .admin-topline {
        position: relative;
        top: auto;
        z-index: 30;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 16px;
        padding: 18px 20px;
        border: 1px solid rgba(74, 9, 13, 0.08);
        border-radius: 24px;
        background: rgba(255, 250, 242, 0.86);
        backdrop-filter: blur(16px);
        box-shadow: var(--shadow);
      }

      .admin-kicker {
        display: block;
        color: var(--gold);
        font-size: 12px;
        font-weight: 800;
      }

      .admin-topline h1 {
        margin: 4px 0 0;
        color: var(--dark);
        font-size: clamp(24px, 3vw, 36px);
        line-height: 1.5;
      }

      .admin-topline__tools {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .api-status {
        display: inline-flex;
        align-items: center;
        min-height: 38px;
        border-radius: 999px;
        padding: 8px 12px;
        color: #2f855a;
        background: rgba(47, 133, 90, 0.1);
        border: 1px solid rgba(47, 133, 90, 0.18);
        font-size: 12px;
        font-weight: 800;
      }

      .api-status--count {
        color: var(--dark);
        background: rgba(201, 166, 107, 0.14);
        border-color: rgba(201, 166, 107, 0.28);
      }

      .field {
        display: grid;
        gap: 8px;
        margin-bottom: 16px;
      }

      .field label {
        color: var(--muted);
        font-size: 13px;
      }

      .input,
      .textarea,
      .select {
        width: 100%;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: #fff;
        color: var(--ink);
        outline: 0;
        padding: 14px 15px;
        font-size: 15px;
      }

      .admin-btn,
      .btn {
        appearance: none;
      }

      .admin-input,
      .input,
      .admin-select,
      .select,
      .admin-textarea,
      .textarea {
        appearance: none;
      }

      .sr-only-input {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        opacity: 0;
        pointer-events: none;
      }

      .input:focus,
      .textarea:focus,
      .select:focus {
        border-color: rgba(184, 135, 70, 0.7);
        box-shadow: 0 0 0 4px rgba(184, 135, 70, 0.12);
      }

      .textarea {
        min-height: 280px;
        resize: vertical;
        line-height: 2;
        direction: rtl;
      }

      .textarea.small {
        min-height: 95px;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 20px;
      }

      .stat-card {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #6d0f14, #4a090d);
        border: 1px solid rgba(255, 248, 239, 0.14);
        border-radius: var(--radius-lg);
        padding: 20px;
        box-shadow: 0 18px 52px rgba(0, 0, 0, 0.14);
      }

      .stat-card i {
        position: absolute;
        top: 16px;
        left: 16px;
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        color: #fff8ef;
        background: rgba(255, 248, 239, 0.14);
        border: 1px solid rgba(255, 248, 239, 0.16);
        font-style: normal;
      }

      .stat-card strong {
        display: block;
        font-size: 34px;
        color: #fff8ef;
      }

      .stat-card span {
        display: block;
        margin-top: 6px;
        color: rgba(255, 248, 239, 0.76);
        font-size: 13px;
        font-weight: 700;
      }

      .stat-card-published { background: linear-gradient(135deg, #2f855a, #244f3a); }
      .stat-card-draft { background: linear-gradient(135deg, #b7791f, #6d4211); }
      .stat-card-deleted { background: linear-gradient(135deg, #b84242, #6d0f14); }
      .stat-card-media { background: linear-gradient(135deg, #2b6cb0, #1f3f68); }
      .stat-card-text { background: linear-gradient(135deg, #6d0f14, #2a1713); }
      .stat-card-latest { background: linear-gradient(135deg, #2a1713, #111827); }
      .stat-card-tags { background: linear-gradient(135deg, #8a632d, #4a090d); }

      .dashboard-insights,
      .admin-sections {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 18px;
      }

      .admin-sections {
        margin-top: 18px;
      }

      .compact-panel .panel-body {
        padding-top: 16px;
      }

      .activity-list,
      .section-list {
        display: grid;
        gap: 10px;
        max-height: min(720px, 70vh);
        overflow: auto;
        padding-left: 6px;
      }

      .activity-item,
      .section-item {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 12px;
        align-items: center;
        padding: 12px;
        border: 1px solid rgba(74, 9, 13, 0.08);
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.68);
        box-shadow: var(--shadow-row);
      }

      .admin-card {
        max-width: 100%;
        min-width: 0;
      }

      .media-card {
        min-height: 104px;
        grid-template-columns: 72px minmax(0, 1fr) auto;
        background: rgba(255, 255, 255, 0.72);
      }

      .media-card__thumb {
        width: 72px;
        height: 72px;
        display: grid;
        place-items: center;
        overflow: hidden;
        border-radius: 14px;
        background:
          linear-gradient(135deg, rgba(109, 15, 20, 0.1), rgba(184, 135, 70, 0.14)),
          #efe4d4;
        color: var(--accent-deep);
        font-size: 11px;
        font-weight: 800;
        text-align: center;
      }

      .media-card__thumb .thumb {
        width: 100%;
        height: 100%;
        border-radius: 16px;
      }

      .media-card__body,
      .seo-card__body {
        min-width: 0;
      }

      .seo-card {
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: start;
        background: rgba(255, 255, 255, 0.7);
      }

      .seo-preview {
        display: grid;
        gap: 5px;
        margin-top: 10px;
        padding: 12px;
        border: 1px solid rgba(43, 108, 176, 0.12);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.58);
      }

      .seo-preview b {
        color: #1a0dab;
        font-size: 14px;
        line-height: 1.6;
      }

      .seo-preview small {
        color: #006621;
        direction: ltr;
        text-align: left;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .seo-preview p {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.8;
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
      }

      .activity-item strong,
      .section-item strong {
        display: block;
        color: var(--dark);
        line-height: 1.7;
      }

      .activity-item span,
      .section-item span {
        display: block;
        margin-top: 3px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.8;
      }

      .progress-card,
      .api-card {
        display: grid;
        gap: 12px;
        padding: 14px;
        border: 1px solid var(--line);
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.78);
      }

      .progress-card strong {
        display: block;
        color: var(--accent);
        font-size: 30px;
      }

      .progress-card span,
      .api-card span {
        color: var(--muted);
        font-size: 13px;
        line-height: 1.8;
      }

      .progress-track {
        height: 10px;
        overflow: hidden;
        border-radius: 999px;
        background: rgba(42, 23, 19, 0.1);
      }

      .progress-track span {
        display: block;
        width: 0%;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, var(--accent), var(--gold));
        transition: width 0.25s ease;
      }

      .admin-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(360px, 500px);
        gap: 18px;
        align-items: start;
      }

      .admin-section {
        display: none;
        min-width: 0;
      }

      .admin-section[hidden] {
        display: none !important;
      }

      .admin-section.is-active {
        display: block;
      }

      .admin-sections {
        display: block;
        min-width: 0;
      }

      .panel {
        min-width: 0;
        background: rgba(255, 250, 242, 0.9);
        border: 1px solid rgba(74, 9, 13, 0.08);
        border-radius: 24px;
        box-shadow: var(--shadow);
        overflow: hidden;
        backdrop-filter: blur(14px);
      }

      .panel-head {
        padding: 18px 20px;
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .panel-head h2 {
        margin: 0;
        font-size: 22px;
      }

      .panel-body {
        padding: 18px 20px 20px;
        min-width: 0;
      }

      .filters {
        display: grid;
        grid-template-columns: 1fr 160px 160px 160px;
        gap: 12px;
        margin-bottom: 14px;
        padding: 12px;
        border: 1px solid rgba(74, 9, 13, 0.08);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.55);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);
      }

      .bulkbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 14px;
        background: rgba(42, 23, 19, 0.04);
        border: 1px solid rgba(42, 23, 19, 0.08);
        border-radius: 18px;
        margin-bottom: 16px;
      }

      .bulkbar strong {
        color: var(--dark);
        font-size: 14px;
      }

      .view-tabs {
        display: none;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 14px;
      }

      .view-tabs .btn.active {
        background: var(--dark);
        color: #fff;
      }

      .view-panel[hidden] {
        display: none;
      }

      .filters[hidden],
      .bulkbar[hidden],
      .posts-list[hidden] {
        display: none;
      }

      .posts-list {
        display: grid;
        gap: 10px;
        max-height: 830px;
        overflow: auto;
        padding: 2px 0 2px 6px;
      }

      .admin-data-list {
        display: grid;
        gap: 10px;
        min-width: 0;
        width: 100%;
      }

      .admin-data-row {
        min-height: 112px;
        width: 100%;
        min-width: 0;
        display: grid;
        grid-template-columns: 32px 84px minmax(0, 1fr) 190px 260px;
        gap: 12px;
        align-items: center;
        padding: 12px;
        border: 1px solid rgba(74, 9, 13, 0.09);
        border-radius: 18px;
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.82), rgba(255, 250, 242, 0.78)),
          var(--glass);
        box-shadow: var(--shadow-row);
        overflow: hidden;
      }

      .admin-post-row,
      .admin-media-row,
      .admin-seo-row,
      .admin-deleted-row {
        cursor: pointer;
      }

      .admin-data-row:hover,
      .admin-data-row.active {
        border-color: rgba(184, 135, 70, 0.58);
        box-shadow: 0 18px 44px rgba(74, 9, 13, 0.11);
        transform: translateY(-1px);
      }

      .admin-row-check {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
      }

      .admin-row-check input {
        width: 18px;
        height: 18px;
      }

      .admin-row-thumb {
        width: 76px;
        height: 76px;
        display: grid;
        place-items: center;
        overflow: hidden;
        border-radius: 15px;
        border: 1px solid rgba(74, 9, 13, 0.08);
        background:
          linear-gradient(135deg, rgba(109, 15, 20, 0.1), rgba(184, 135, 70, 0.16)),
          #efe4d4;
        color: var(--accent-deep);
        font-size: 11px;
        font-weight: 800;
        text-align: center;
      }

      .admin-row-thumb img,
      .admin-row-thumb video {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
      }

      .admin-row-placeholder {
        width: 100%;
        height: 100%;
        display: grid;
        place-items: center;
        padding: 8px;
        text-align: center;
      }

      .admin-row-main {
        min-width: 0;
        overflow: hidden;
        text-align: right;
      }

      .admin-row-title {
        margin: 0 0 6px;
        color: var(--dark);
        font-size: 15.5px;
        line-height: 1.65;
        font-weight: 900;
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
      }

      .admin-row-excerpt {
        margin: 0;
        color: var(--muted);
        font-size: 12.5px;
        line-height: 1.75;
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
      }

      .admin-row-tags {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
        margin-top: 8px;
        min-width: 0;
      }

      .admin-row-badge {
        display: inline-flex;
        align-items: center;
        max-width: 100%;
        border-radius: 999px;
        padding: 5px 8px;
        border: 1px solid rgba(74, 9, 13, 0.08);
        background: rgba(239, 224, 198, 0.68);
        color: #704915;
        font-size: 11px;
        font-weight: 800;
        line-height: 1.4;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .admin-row-badge.green {
        background: rgba(47, 133, 90, 0.1);
        color: var(--green);
      }

      .admin-row-badge.red {
        background: rgba(184, 66, 66, 0.1);
        color: var(--danger);
      }

      .admin-row-badge.blue {
        background: rgba(43, 108, 176, 0.1);
        color: var(--blue);
      }

      .admin-row-badge.gray {
        background: rgba(119, 107, 95, 0.1);
        color: var(--muted);
      }

      .admin-row-meta {
        min-width: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
        color: var(--muted);
        font-size: 11.5px;
        line-height: 1.7;
      }

      .admin-row-actions {
        min-width: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        justify-content: flex-end;
      }

      .admin-row-action,
      .admin-glass-btn {
        min-height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border: 1px solid rgba(74, 9, 13, 0.1);
        border-radius: 12px;
        padding: 7px 10px;
        background: rgba(255, 255, 255, 0.58);
        color: var(--dark);
        font-size: 11.5px;
        font-weight: 900;
        line-height: 1.4;
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
        backdrop-filter: blur(14px);
        box-shadow: 0 10px 24px rgba(74, 9, 13, 0.06);
        transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
      }

      .admin-glass-btn:hover {
        transform: translateY(-1px);
        border-color: rgba(184, 135, 70, 0.45);
        box-shadow: 0 14px 30px rgba(74, 9, 13, 0.1);
      }

      .admin-glass-btn.success {
        color: var(--green);
        background: rgba(47, 133, 90, 0.1);
        border-color: rgba(47, 133, 90, 0.16);
      }

      .admin-glass-btn.warning {
        color: #7a4d20;
        background: rgba(239, 224, 198, 0.72);
        border-color: rgba(184, 135, 70, 0.18);
      }

      .admin-glass-btn.danger {
        color: var(--danger);
        background: rgba(184, 66, 66, 0.1);
        border-color: rgba(184, 66, 66, 0.16);
      }

      .admin-seo-preview {
        display: grid;
        gap: 5px;
        min-width: 0;
        margin-top: 8px;
        padding: 10px;
        border: 1px solid rgba(43, 108, 176, 0.1);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.55);
      }

      .admin-seo-preview strong,
      .admin-seo-preview p {
        margin: 0;
        overflow: hidden;
        display: -webkit-box;
        -webkit-box-orient: vertical;
      }

      .admin-seo-preview strong {
        color: #1a0dab;
        font-size: 13px;
        line-height: 1.6;
        -webkit-line-clamp: 1;
      }

      .admin-seo-preview p {
        color: var(--muted);
        font-size: 11.5px;
        line-height: 1.7;
        -webkit-line-clamp: 2;
      }

      .post-row {
        min-height: 128px;
        border: 1px solid rgba(74, 9, 13, 0.08);
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.76), rgba(255, 250, 242, 0.74)),
          var(--glass);
        border-radius: 18px;
        padding: 12px;
        display: grid;
        grid-template-columns: 32px 88px minmax(250px, 1fr) minmax(142px, 170px) minmax(270px, auto);
        gap: 12px;
        align-items: center;
        cursor: pointer;
        transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
        box-shadow: var(--shadow-row);
      }

      .post-main {
        min-width: 0;
        overflow: hidden;
      }

      .post-row:hover,
      .post-row.active {
        border-color: rgba(184, 135, 70, 0.65);
        box-shadow: 0 18px 44px rgba(74, 9, 13, 0.11);
        transform: translateY(-1px);
        background: rgba(255, 255, 255, 0.86);
      }

      .post-check {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .post-check input {
        width: 18px;
        height: 18px;
      }

      .thumb {
        width: 88px;
        height: 88px;
        border-radius: 16px;
        background:
          linear-gradient(135deg, rgba(109, 15, 20, 0.12), rgba(184, 135, 70, 0.18)),
          #efe4d4;
        overflow: hidden;
        display: grid;
        place-items: center;
        color: var(--accent-deep);
        font-size: 11px;
        font-weight: 800;
        text-align: center;
        padding: 8px;
        border: 1px solid rgba(74, 9, 13, 0.08);
      }

      .thumb img,
      .thumb video {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .post-row h3 {
        margin: 0 0 6px;
        color: var(--dark);
        font-size: 16px;
        line-height: 1.65;
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
      }

      .post-row p {
        margin: 0;
        color: var(--muted);
        font-size: 12.5px;
        line-height: 1.8;
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
      }

      .row-meta {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin-top: 9px;
        min-width: 0;
      }

      .row-actions {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
        justify-content: flex-end;
        margin-top: 0;
      }

      .row-actions .btn {
        min-height: 32px;
        padding: 7px 10px;
        font-size: 11.5px;
        border-radius: 12px;
      }

      .row-actions a.btn {
        text-align: center;
      }

      .row-state {
        display: grid;
        gap: 7px;
        justify-items: start;
        color: var(--muted);
        font-size: 12px;
      }

      .row-date {
        color: var(--muted);
        font-size: 11.5px;
        line-height: 1.7;
      }

      .row-tags {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
        margin-top: 8px;
      }

      .row-tags .badge {
        padding: 4px 7px;
        font-size: 10.5px;
      }

      .post-title-line {
        min-width: 0;
      }

      .cms-row-deleted {
        border-color: rgba(184, 66, 66, 0.14);
      }

      .cms-row-deleted .post-check {
        min-width: 0;
      }

      .cms-row-deleted .post-check .badge {
        padding-inline: 7px;
        font-size: 10.5px;
      }

      .pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 14px;
      }

      .pagination button,
      .pagination span {
        min-width: 38px;
        min-height: 38px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: #fff;
        color: var(--dark);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 12px;
        font: inherit;
      }

      .pagination button {
        cursor: pointer;
      }

      .pagination button.active {
        background: var(--accent);
        color: #fff;
      }

      .pagination button:disabled {
        opacity: 0.48;
        cursor: not-allowed;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        width: fit-content;
        border-radius: 999px;
        padding: 6px 9px;
        font-size: 11.5px;
        font-weight: 800;
        background: var(--gold-soft);
        color: #7a4d20;
        border: 1px solid rgba(122, 77, 32, 0.08);
        white-space: nowrap;
      }

      .badge.green {
        background: rgba(47, 133, 90, 0.12);
        color: var(--green);
      }

      .badge.gray {
        background: rgba(119, 107, 95, 0.12);
        color: var(--muted);
      }

      .badge.red {
        background: rgba(184, 66, 66, 0.12);
        color: var(--danger);
      }

      .badge.blue {
        background: rgba(43, 108, 176, 0.12);
        color: var(--blue);
      }

      .editor-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 16px;
      }

      .editor-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 16px;
      }

      .editor-tabs button {
        border: 1px solid var(--line);
        cursor: pointer;
        border-radius: 999px;
        background: #fff;
        color: var(--dark);
        padding: 10px 13px;
        font: inherit;
        font-size: 13px;
      }

      .editor-tab-btn {
        appearance: none;
      }

      .editor-tabs button.active {
        background: var(--accent);
        border-color: var(--accent);
        color: #fff;
      }

      .editor-tab-panel {
        display: none;
      }

      .editor-tab-panel.active {
        display: block;
      }

      .slug-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 8px;
      }

      .switch-input {
        accent-color: var(--accent);
      }

      .switch-line {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 13px 14px;
        background: #fff;
        margin-bottom: 16px;
      }

      .switch-line span {
        color: var(--muted);
        font-size: 14px;
      }

      .switch-line input {
        width: 18px;
        height: 18px;
      }

      .message {
        display: none;
        margin-bottom: 16px;
        border-radius: 18px;
        padding: 13px 14px;
        font-size: 14px;
        line-height: 1.8;
      }

      .message.show {
        display: block;
      }

      .message {
        border: 1px solid transparent;
        box-shadow: 0 14px 34px rgba(34, 24, 15, 0.08);
      }

      .message.ok {
        background: rgba(47, 133, 90, 0.12);
        color: var(--green);
        border-color: rgba(47, 133, 90, 0.22);
      }

      .message.error {
        background: rgba(184, 66, 66, 0.12);
        color: var(--danger);
        border-color: rgba(184, 66, 66, 0.22);
      }

      .message.info {
        background: rgba(43, 108, 176, 0.12);
        color: var(--blue);
        border-color: rgba(43, 108, 176, 0.22);
      }

      .empty {
        padding: 30px;
        text-align: center;
        color: var(--muted);
        border: 1px dashed var(--line);
        border-radius: 22px;
      }

      .editor-meta {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px;
        margin-bottom: 16px;
      }

      .mini-stat {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 12px;
      }

      .mini-stat strong {
        display: block;
        font-size: 18px;
      }

      .mini-stat span {
        color: var(--muted);
        font-size: 12px;
      }

      .id-note {
        border: 1px solid rgba(184, 135, 70, 0.24);
        background: rgba(184, 135, 70, 0.1);
        color: #7a4d20;
        border-radius: 18px;
        padding: 12px 14px;
        margin-bottom: 16px;
        font-size: 13px;
        line-height: 1.9;
      }

      .id-note strong {
        color: var(--dark);
      }

      .deleted-note {
        margin-bottom: 14px;
      }

      .media-uploader {
        border: 1px solid var(--line);
        border-radius: 24px;
        padding: 16px;
        background: #fff;
        margin-bottom: 18px;
      }

      .media-uploader-row {
        display: grid;
        grid-template-columns: 1fr auto auto;
        gap: 8px;
        align-items: center;
      }

      .media-preview {
        margin-top: 14px;
        border-radius: 20px;
        background: #f7f0e6;
        border: 1px solid var(--line);
        overflow: hidden;
        min-height: 92px;
        display: grid;
        place-items: center;
        color: var(--muted);
        text-align: center;
        padding: 14px;
      }

      .media-preview img,
      .media-preview video {
        width: 100%;
        max-height: 280px;
        object-fit: contain;
        display: block;
        border-radius: 16px;
      }

      .media-preview audio {
        width: 100%;
      }

      .media-preview .file-preview {
        display: grid;
        gap: 8px;
      }

      .preview {
        margin-top: 18px;
        border: 1px solid var(--line);
        border-radius: 24px;
        overflow: hidden;
        background: #fffaf1;
      }

      .preview-head {
        padding: 16px;
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }

      .preview-body {
        padding: 18px;
      }

      .preview-title {
        margin: 0 0 12px;
        font-size: 22px;
        line-height: 1.7;
        color: var(--dark);
      }

      .preview-content {
        white-space: pre-wrap;
        color: #2b231b;
        line-height: 2.1;
        font-size: 15px;
      }

      .preview-tags {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 16px;
      }

      .tab-title {
        margin: 24px 0 12px;
        font-size: 16px;
        color: var(--dark);
      }

      .tool-panel {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .section-item,
      .activity-item,
      .api-card,
      .preview-content,
      .preview-title,
      .badge {
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .local-settings {
        display: grid;
        gap: 14px;
      }

      .admin-help {
        margin: 0 0 18px;
        color: var(--muted);
        line-height: 1.9;
        font-size: 14px;
      }

      .site-copy-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }

      .site-copy-grid .field-wide {
        grid-column: 1 / -1;
      }

      .site-copy-grid textarea {
        min-height: 170px;
        resize: vertical;
      }

      .toast-stack {
        position: fixed;
        left: 18px;
        bottom: 18px;
        z-index: 200;
        display: grid;
        gap: 10px;
        width: min(360px, calc(100vw - 36px));
      }

      .toast {
        padding: 14px 16px;
        border-radius: 18px;
        background: #fff8ef;
        color: var(--dark);
        border: 1px solid var(--line);
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.22);
        line-height: 1.8;
        animation: toast-in 0.18s ease-out;
      }

      .toast.error {
        border-color: rgba(184, 66, 66, 0.26);
        color: var(--danger);
      }

      @keyframes toast-in {
        from { transform: translateY(10px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
      }

      .confirm-dialog {
        width: min(440px, calc(100% - 32px));
        border: 1px solid var(--line);
        border-radius: 26px;
        background: var(--surface);
        color: var(--ink);
        padding: 0;
        box-shadow: 0 34px 100px rgba(0, 0, 0, 0.32);
      }

      .confirm-dialog::backdrop {
        background: rgba(17, 24, 39, 0.62);
        backdrop-filter: blur(4px);
      }

      .confirm-dialog form {
        padding: 24px;
      }

      .confirm-dialog h2 {
        margin: 0 0 10px;
        color: var(--dark);
      }

      .confirm-dialog p {
        margin: 0 0 18px;
        color: var(--muted);
        line-height: 2;
      }

      .sidebar-toggle {
        display: none;
      }

      .admin-drawer-backdrop {
        position: fixed;
        inset: 0;
        z-index: 110;
        display: none;
        background: rgba(17, 24, 39, 0.58);
        backdrop-filter: blur(3px);
      }

      .admin-drawer-backdrop.is-open {
        display: block;
      }

      @media (max-width: 1150px) {
        .admin-shell {
          grid-template-columns: 1fr;
        }

        .admin-sidebar {
          position: static;
          min-height: auto;
        }

        .admin-nav {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .admin-sidebar__logout {
          margin-top: 0;
        }

        .admin-grid {
          grid-template-columns: 1fr;
        }

        .stats {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .dashboard-insights,
        .admin-sections {
          grid-template-columns: 1fr;
        }

        .filters {
          grid-template-columns: 1fr 1fr;
        }

        .admin-data-row {
          grid-template-columns: 32px 80px minmax(0, 1fr);
        }

        .admin-row-meta,
        .admin-row-actions {
          grid-column: 3 / -1;
        }

        .admin-row-meta {
          align-items: center;
        }

        .post-row {
          grid-template-columns: 32px 88px minmax(0, 1fr);
        }

        .row-state,
        .post-row > .row-actions {
          grid-column: 3 / -1;
        }

        .row-state {
          display: flex;
          flex-wrap: wrap;
          align-items: center;
        }
      }

      @media (max-width: 900px) {
        .container {
          width: min(100% - 20px, 1420px);
        }

        .actions {
          width: 100%;
        }

        .btn {
          flex: 1;
        }

        .admin-sidebar {
          position: fixed;
          inset: 0 0 0 auto;
          z-index: 120;
          width: min(340px, calc(100vw - 28px));
          min-height: 100vh;
          padding: 14px;
          border-radius: 0;
          transform: translateX(110%);
          transition: transform 0.22s ease;
        }

        .admin-sidebar.is-open {
          transform: translateX(0);
        }

        .sidebar-toggle {
          display: inline-flex;
        }

        .admin-nav {
          grid-template-columns: 1fr;
        }

        .admin-topline {
          align-items: flex-start;
          flex-direction: column;
          border-radius: 24px;
          padding: 18px;
          position: sticky;
          top: 0;
        }

        .admin-topline__tools {
          width: 100%;
          justify-content: stretch;
        }

        .api-status,
        .admin-topline__tools .btn {
          flex: 1 1 auto;
          justify-content: center;
        }

        .stats {
          grid-template-columns: 1fr;
        }

        .filters {
          grid-template-columns: 1fr;
        }

        .bulkbar {
          align-items: flex-start;
          flex-direction: column;
        }

        .admin-data-row {
          min-height: 0;
          grid-template-columns: 32px 76px minmax(0, 1fr);
          align-items: start;
        }

        .admin-row-thumb {
          width: 76px;
          height: 76px;
        }

        .admin-row-main {
          grid-column: 3 / -1;
        }

        .admin-row-meta,
        .admin-row-actions {
          grid-column: 1 / -1;
        }

        .admin-row-actions {
          justify-content: stretch;
        }

        .admin-row-action {
          flex: 1 1 calc(50% - 8px);
        }

        .post-row {
          min-height: 0;
          grid-template-columns: 32px 76px minmax(0, 1fr);
          align-items: start;
        }

        .post-row .thumb {
          grid-column: auto;
          width: 76px;
          height: 76px;
        }

        .post-main {
          grid-column: 3 / -1;
        }

        .row-state,
        .post-row > .row-actions {
          grid-column: 1 / -1;
        }

        .post-row > .row-actions {
          justify-content: stretch;
        }

        .post-row > .row-actions .btn,
        .post-row > .row-actions a {
          flex: 1 1 calc(50% - 8px);
        }

        .media-card,
        .seo-card {
          grid-template-columns: 1fr;
        }

        .site-copy-grid {
          grid-template-columns: 1fr;
        }

        .media-card__thumb {
          width: 72px;
          height: 72px;
        }

        .thumb {
          grid-column: auto;
          width: 76px;
          height: 76px;
        }

        .media-card__thumb .thumb {
          grid-column: auto;
          height: 100%;
        }

        .editor-meta {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .media-uploader-row {
          grid-template-columns: 1fr;
        }

        .slug-row {
          grid-template-columns: 1fr;
        }

        .login-card {
          padding: 26px;
          border-radius: 26px;
        }
      }
    </style>
  </head>

  <body class="admin-page">
    <main class="page">
      <div class="container">
        <section class="login-wrap" id="loginView">
          <div class="login-card">
            <span class="badge">ورود مدیر</span>
            <h1>ورود به پنل مدیریت</h1>
            <p>ورود به پنل مدیریت ماهون</p>

            <div class="message" id="loginMessage"></div>

            <div class="field">
              <label for="tokenInput">رمز مدیریت</label>
              <input class="admin-input input" id="tokenInput" type="password" placeholder="ADMIN_TOKEN را وارد کن" />
            </div>

            <button class="admin-btn btn btn-primary" id="loginBtn" type="button">ورود به پنل</button>
          </div>
        </section>

        <section class="dashboard" id="dashboardView">
          <div class="admin-shell">
            <aside class="admin-sidebar" id="adminSidebar" aria-label="ناوبری مدیریت">
              <div class="admin-sidebar__brand">
                <img src={LOGO_URL} alt="" />
                <div>
                  <strong>ماهون</strong>
                  <span>پنل مدیریت محتوا</span>
                </div>
              </div>

