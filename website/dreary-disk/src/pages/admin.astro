      async function restoreDeletedPost(id, button) {
        if (!id || button?.disabled) return;

        const confirmed = await confirmAction({
          title: "بازگردانی مطلب",
          message: `پست حذف‌شده با کد ثبت #${id} بازیابی شود؟ با تأیید، اجازهٔ نمایش دوبارهٔ مطلب در سایت را می‌دهی.`,
          confirmText: "بازگردانی"
        });

        if (!confirmed) return;

        setButtonLoading(button, true, "در حال بازگردانی...");

        try {
          const restored = await api(`/admin/posts/${id}/restore`, {
            method: "POST",
            body: JSON.stringify({})
          });

          showMessage(editorMessage, restored.post?.is_published === 1
            ? `پست #${id} بازیابی و برای انتشار فعال شد.` : `پست #${id} بازیابی شد.`, "ok");
          await loadDeletedPosts();
          await loadPosts();
        } catch (error) {
          const message = error.status === 404
            ? "این قابلیت هنوز روی API آنلاین فعال نشده است یا پست قبلاً بازگردانی شده است."
            : userFriendlyError(error, "بازگردانی پست انجام نشد.");

          showMessage(editorMessage, message, "error");
        } finally {
          setButtonLoading(button, false);
        }
      }


      function formatAdminNumber(value) {
        return String(Number(value || 0).toLocaleString("fa-IR"));
      }

      function analyticsRows(payload, ...keys) {
        for (const key of keys) {
          if (Array.isArray(payload?.[key])) return payload[key];
        }

        return [];
      }

      function analyticsTotal(payload, key) {
        const totals = payload?.totals || {};
        return totals[key] ?? payload?.[key] ?? 0;
      }

      function analyticsLabel(row, ...keys) {
        for (const key of keys) {
          const value = row?.[key];
          if (value !== undefined && value !== null && String(value).trim()) return String(value);
        }

        return "نامشخص";
      }

      function analyticsValue(row, ...keys) {
        for (const key of keys) {
          const value = row?.[key];
          if (value !== undefined && value !== null && value !== "") return Number(value || 0);
        }

        return 0;
      }

      function setAnalyticsStatus(text, type = "ok") {
        if (!analyticsStatus) return;
        analyticsStatus.textContent = text;
        analyticsStatus.className = `message analytics-message show ${type === "error" ? "error" : "ok"}`;
      }

      async function loadAnalyticsReport(force = false) {
        if (!analyticsStatus) return;

        if (analyticsLoaded && !force) return;

        const days = analyticsRangeSelect?.value || "30";

        setAnalyticsStatus("در حال دریافت آمار بازدید...");

        try {
          const data = await api(`/analytics/report-v5?days=${encodeURIComponent(days)}`, {
            method: "GET",
            timeoutMs: 15000
          });

          if (!data?.ok) {
            throw new Error(data?.error || "Analytics report failed");
          }

          analyticsLoaded = true;
          renderAnalyticsReport(data);
          setAnalyticsStatus(`آمار بازدید بروزرسانی شد. بازه انتخابی: ${formatAdminNumber(days)} روز اخیر`);
        } catch (error) {
          console.error(error);
          setAnalyticsStatus(userFriendlyError(error, "دریافت آمار بازدید انجام نشد."), "error");
        }
      }

      function renderAnalyticsReport(data) {
        if (analyticsPageviews) analyticsPageviews.textContent = formatAdminNumber(analyticsTotal(data, "pageviews"));
        if (analyticsVisitors) analyticsVisitors.textContent = formatAdminNumber(analyticsTotal(data, "unique_visitors"));
        if (analyticsSessions) analyticsSessions.textContent = formatAdminNumber(analyticsTotal(data, "sessions"));
        if (analyticsToday) analyticsToday.textContent = formatAdminNumber(analyticsTotal(data, "today"));
        if (analyticsYesterday) analyticsYesterday.textContent = formatAdminNumber(analyticsTotal(data, "yesterday"));

        renderAnalyticsDaily(analyticsRows(data, "byDay", "daily", "days", "timeline"));
        renderAnalyticsList(analyticsTopPages, analyticsRows(data, "topPages", "top_pages", "pages"), {
          titleKeys: ["title", "path", "url"],
          subtitleKeys: ["path", "url"],
          valueKeys: ["views", "pageviews", "count"]
        });
        renderAnalyticsList(analyticsReferrers, analyticsRows(data, "referrers", "sources", "topReferrers"), {
          titleKeys: ["referrer_host", "source", "host", "referrer"],
          subtitleKeys: ["referrer", "url"],
          valueKeys: ["views", "pageviews", "count"]
        });
        renderAnalyticsList(analyticsDevices, analyticsRows(data, "devices", "byDevice"), {
          titleKeys: ["device", "name", "label"],
          subtitleKeys: ["device"],
          valueKeys: ["views", "pageviews", "count"]
        });
        renderAnalyticsList(analyticsCountries, analyticsRows(data, "countries", "byCountry"), {
          titleKeys: ["country", "name", "label"],
          subtitleKeys: ["city", "country"],
          valueKeys: ["views", "pageviews", "count"]
        });
        renderAnalyticsRecent(analyticsRows(data, "recent", "recentEvents", "latest"));
      }

      function renderAnalyticsDaily(rows) {
        if (!analyticsDailyChart) return;

        if (analyticsDailyCount) {
          analyticsDailyCount.textContent = rows.length ? `${formatAdminNumber(rows.length)} روز` : "بدون داده";
        }

        if (!rows.length) {
          analyticsDailyChart.innerHTML = '<div class="empty">هنوز داده‌ای برای نمایش وجود ندارد.</div>';
          return;
        }

        const normalized = rows.slice(-31).map((row) => ({
          label: analyticsLabel(row, "day", "date", "created_at"),
          value: analyticsValue(row, "views", "pageviews", "count")
        }));

        const max = Math.max(...normalized.map((row) => row.value), 1);

        analyticsDailyChart.innerHTML = normalized.map((row) => {
          const width = Math.max(4, Math.round((row.value / max) * 100));

          return `
            <div class="analytics-bar-row">
              <span>${escapeHtml(row.label)}</span>
              <div class="analytics-bar-track"><i style="width:${width}%"></i></div>
              <strong>${formatAdminNumber(row.value)}</strong>
            </div>
          `;
        }).join("");
      }

      function renderAnalyticsList(container, rows, config) {
        if (!container) return;

        if (!rows.length) {
          container.innerHTML = '<div class="empty">داده‌ای ثبت نشده است.</div>';
          return;
        }

        container.innerHTML = rows.slice(0, 10).map((row) => {
          const title = analyticsLabel(row, ...config.titleKeys);
          const subtitle = analyticsLabel(row, ...config.subtitleKeys);
          const value = analyticsValue(row, ...config.valueKeys);

          return `
            <div class="analytics-list-row">
              <div>
                <strong>${escapeHtml(title)}</strong>
                ${subtitle && subtitle !== title ? `<small>${escapeHtml(subtitle)}</small>` : ""}
              </div>
              <b>${formatAdminNumber(value)}</b>
            </div>
          `;
        }).join("");
      }

      function renderAnalyticsRecent(rows) {
        if (!analyticsRecent) return;

        if (!rows.length) {
          analyticsRecent.innerHTML = '<div class="empty">هنوز بازدیدی ثبت نشده است.</div>';
          return;
        }

        analyticsRecent.innerHTML = rows.slice(0, 12).map((row) => {
          const title = analyticsLabel(row, "title", "path", "url");
          const path = analyticsLabel(row, "path", "url");
          const meta = [
            analyticsLabel(row, "device"),
            analyticsLabel(row, "country"),
            analyticsLabel(row, "created_at")
          ].filter(Boolean).join(" · ");
          const referrer = analyticsLabel(row, "referrer_host", "source", "referrer");

          return `
            <div class="analytics-list-row">
              <div>
                <strong>${escapeHtml(title)}</strong>
                <small>${escapeHtml(path)}${meta ? " · " + escapeHtml(meta) : ""}</small>
              </div>
              <b>${escapeHtml(referrer || "Direct")}</b>
            </div>
          `;
        }).join("");
      }


      function renderStats() {
        const loadedPublished =
          posts.filter(post =>
            Number(post.is_published) === 1
          ).length;

        const loadedDrafts =
          posts.filter(post =>
            Number(post.is_published) !== 1
          ).length;

        const loadedWithMedia =
          posts.filter(post =>
            post.media_file_id ||
            post.photo_file_id
          ).length;

        const loadedWithoutMedia =
          Math.max(
            posts.length - loadedWithMedia,
            0
          );

        const loadedLatestId =
          posts.reduce(
            (max, post) =>
              Math.max(
                max,
                Number(post.id || 0)
              ),
            0
          );

        const uniqueTags = new Set(
          posts.flatMap(post =>
            parseContent(post.text).hashtags
          )
        );

        const total = Number(
          adminStats?.total_posts ??
          postsTotal ??
          posts.length
        );

        const published = Number(
          adminStats?.published_posts ??
          loadedPublished
        );

        const drafts = Number(
          adminStats?.draft_posts ??
          loadedDrafts
        );

        const deleted = Number(
          adminStats?.deleted_posts ??
          deletedPostsTotal ??
          deletedPosts.length
        );

        const withMedia = Number(
          adminStats?.media_posts ??
          loadedWithMedia
        );

        const withoutMedia = Number(
          adminStats?.text_posts ??
          loadedWithoutMedia
        );

        const latestId = Number(
          adminStats?.latest_id ??
          loadedLatestId
        );

        totalCount.textContent = total;
        topbarTotalCount.textContent = total;
        publishedCount.textContent = published;
        draftCount.textContent = drafts;
        deletedCount.textContent = deleted;
        mediaCount.textContent = withMedia;
        textCount.textContent = withoutMedia;
        latestIdCount.textContent = latestId || "-";

        tagsCount.textContent =
          `${uniqueTags.size} / صفحه`;

        tagsCount.title =
          "تعداد هشتگ‌های یکتای صفحه جاری";

        exportCount.textContent =
          total + " مطلب آماده خروجی کامل";

        const rate = total
          ? Math.round((published / total) * 100)
          : 0;

        publishRate.textContent = rate + "%";
        publishProgress.style.width = rate + "%";

        lastRefresh.textContent =
          "آخرین بروزرسانی: " +
          new Intl.DateTimeFormat("fa-IR", {
            hour: "2-digit",
            minute: "2-digit"
          }).format(new Date());

        renderActivity();

        mediaPanelCount.textContent =
          withMedia + " مورد";

        updateLocalState();
      }

      function renderActiveAuxiliarySection() {
        const activeSection = adminSections.find(section => !section.hidden && section.classList.contains("is-active"));
        const key = activeSection?.getAttribute("data-admin-section");

        if (key === "media") renderMediaLibrary();
        if (key === "seo") renderSeoChecklist();
      }

      function renderActivity() {
        const latest = [...posts]
          .sort((a, b) => Number(b.id || 0) - Number(a.id || 0))
          .slice(0, 5);

        if (!latest.length) {
          activityList.innerHTML = `<div class="empty">هنوز مطلبی لود نشده است.</div>`;
          return;
        }

        activityList.innerHTML = latest.map(post => `
          <div class="activity-item">
            <div>
              <strong>${escapeHtml(makeTitle(post.text))}</strong>
              <span>کد ثابت #${post.id} · ${escapeHtml(formatDate(post.created_at))}</span>
            </div>
            <span class="badge ${Number(post.is_published) === 1 ? "green" : "red"}">
              ${Number(post.is_published) === 1 ? "منتشرشده" : "پیش‌نویس"}
            </span>
          </div>
        `).join("");
      }

      async function loadMediaLibrary() {
        const requestId = ++mediaRequestSerial;

        mediaLibrary.innerHTML =
          `<div class="empty">در حال دریافت رسانه‌ها...</div>`;

        const offset =
          (Math.max(mediaCurrentPage, 1) - 1) *
          MEDIA_POSTS_PER_PAGE;

        try {
          const data = await api(
            buildAdminPostsPath({
              limit: MEDIA_POSTS_PER_PAGE,
              offset,
              media: "media",
              sort: "newest"
            })
          );

          if (requestId !== mediaRequestSerial) {
            return;
          }

          const nextPosts = Array.isArray(data?.posts)
            ? data.posts
            : [];

          const nextTotal = Number(
            data?.total ?? nextPosts.length
          );

          const totalPages = pageCount(
            nextTotal,
            MEDIA_POSTS_PER_PAGE
          );

          if (mediaCurrentPage > totalPages) {
            mediaCurrentPage = totalPages;
            await loadMediaLibrary();
            return;
          }

          mediaPosts = nextPosts;
          mediaPostsTotal = nextTotal;

          renderMediaLibrary();
        } catch (error) {
          if (requestId !== mediaRequestSerial) {
            return;
          }

          mediaLibrary.innerHTML =
            `<div class="empty">${escapeHtml(userFriendlyError(error, "دریافت رسانه‌ها انجام نشد."))}</div>`;

          mediaPagination.innerHTML = "";
        }
      }

