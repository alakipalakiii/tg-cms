      function readLocalDraft() {
        try {
          const draft = JSON.parse(sessionStorage.getItem(LOCAL_DRAFT_KEY) || 'null');
          if (draft?.version !== 1 || typeof draft.payload?.text !== 'string' || Date.now() - draft.savedAt > 86400000) return null;
          return draft;
        } catch { return null; }
      }

      function refreshDraftRecovery() {
        document.getElementById('draftRecovery').hidden = !readLocalDraft() || editorDirty;
      }

      function discardLocalDraft() {
        try { sessionStorage.removeItem(LOCAL_DRAFT_KEY); } catch {}
        refreshDraftRecovery();
      }

      function storeLocalDraft() {
        const state = document.getElementById('localDraftState');
        if (!editorDirty) { discardLocalDraft(); state.textContent = 'تغییر ذخیره‌نشده‌ای ندارید.'; return; }
        try {
          sessionStorage.setItem(LOCAL_DRAFT_KEY, JSON.stringify({ version: 1, id: postId.value, payload: editorPayload(), savedAt: Date.now() }));
          state.textContent = 'نسخه موقت در این تب ذخیره شد؛ هنوز در سایت ذخیره نشده است.';
          if (mediaFile.files?.length) state.textContent += ' فایل انتخاب‌شده را پیش از خروج بارگذاری کنید.';
        } catch { state.textContent = 'حفظ موقت در مرورگر ممکن نیست؛ پیش از خروج ذخیره کنید.'; }
        refreshDraftRecovery();
      }

      async function restoreLocalDraft() {
        const draft = readLocalDraft();
        if (!draft || !await allowEditorReset(true)) return;
        try {
          const fresh = draft.id ? (await api(`/admin/posts/${encodeURIComponent(draft.id)}`)).post : null;
          if (draft.id && (!fresh || fresh.deleted_at)) throw new Error('مطلب اصلی حذف شده یا در دسترس نیست. نسخه موقت روی آن اعمال نشد.');
          if (fresh) selectPost(fresh); else clearEditor();
          const baseline = editorBaseline;
          selectPost({ ...fresh, ...draft.payload, id: draft.id || '' });
          if (!draft.id) editorTitle.textContent = 'ادامه پیش‌نویس جدید';
          editorBaseline = baseline;
          markEditorDirty();
          await showAdminSection('create');
          setEditorTab('content');
          showMessage(editorMessage, 'نسخه موقت بازیابی شد. قبل از ذخیره نهایی، تغییرات را بررسی کنید.', 'ok');
        } catch (error) { showToast(userFriendlyError(error, 'بازیابی انجام نشد؛ نسخه موقت حفظ شده است.'), 'error'); }
      }

      function editorStateSnapshot() {
