      async function exportJson() {
        const buttons = Array.from(
          new Set(
            [
              exportBtn,
              document.querySelector(
                "[data-export-json]"
              )
            ].filter(Boolean)
          )
        );

        if (
          buttons.some(button =>
            button.disabled
          )
        ) {
          return;
        }

        const labels = buttons.map(
          button => button.textContent
        );

        buttons.forEach(button => {
          button.disabled = true;
          button.textContent =
            "در حال آماده‌سازی خروجی...";
        });

        try {
          const allPosts = [];
          const seenIds = new Set();

          let offset = 0;
          let total = null;

          while (
            total === null ||
            offset < total
          ) {
            const data = await api(
              buildAdminPostsPath({
                limit: EXPORT_PAGE_SIZE,
                offset,
                sort: "newest"
              }),
              {
                timeoutMs: 30000
              }
            );

            const batch =
              Array.isArray(data?.posts)
                ? data.posts
                : [];

            if (total === null) {
              total = Number(
                data?.total ??
                batch.length
              );
            }

            batch.forEach(post => {
              const id = Number(post.id);

              if (!seenIds.has(id)) {
                seenIds.add(id);
                allPosts.push(post);
              }
            });

            buttons.forEach(button => {
              button.textContent =
                `دریافت ${allPosts.length} از ${total}`;
            });

            const nextOffset = Number(
              data?.next_offset ??
              offset + batch.length
            );

            if (
              batch.length === 0 &&
              offset < total
            ) {
              throw new Error(
                "دریافت خروجی کامل پیش از پایان داده‌ها متوقف شد."
              );
            }

            if (
              nextOffset <= offset &&
              offset < total
            ) {
              throw new Error(
                "پیشروی صفحه‌بندی خروجی متوقف شد."
              );
            }

            offset = nextOffset;
          }

          if (
            total !== null &&
            allPosts.length !== total
          ) {
            throw new Error(
              `تعداد خروجی کامل نیست؛ ${allPosts.length} از ${total} مطلب دریافت شد.`
            );
          }

          const json = JSON.stringify(
            allPosts,
            null,
            2
          );

          const blob = new Blob(
            [json],
            {
              type:
                "application/json;charset=utf-8"
            }
          );

          const url =
            URL.createObjectURL(blob);

          const anchor =
            document.createElement("a");

          anchor.href = url;

          anchor.download =
            `mahoon-posts-all-${Date.now()}.json`;

          anchor.click();

          URL.revokeObjectURL(url);

          showToast(
            `${allPosts.length} مطلب در خروجی کامل JSON ذخیره شد.`,
            "ok"
          );
        } catch (error) {
          showToast(
            userFriendlyError(
              error,
              "ساخت خروجی کامل انجام نشد."
            ),
            "error"
          );
        } finally {
          buttons.forEach(
            (button, index) => {
              button.disabled = false;
              button.textContent =
                labels[index] ||
                "خروجی JSON";
            }
          );
        }
      }

