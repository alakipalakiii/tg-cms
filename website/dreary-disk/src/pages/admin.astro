      function normalizeText(value) {
        return String(value || "")
          .replace(/\r\n/g, "\n")
          .replace(/\r/g, "\n")
          .trim();
      }

      function parseContent(text) {
        const original = normalizeText(text);
        const hashtags = Array.from(new Set((original.match(/#[\p{L}\p{N}_]+/gu) || []).map(tag => tag.replace("#", ""))));
        const urls = Array.from(new Set(original.match(/(https?:\/\/[^\s]+)/g) || []));
        const cleanLines = [];

        original.split("\n").forEach(rawLine => {
          const line = rawLine.trim();

          if (!line) {
            if (cleanLines.length && cleanLines[cleanLines.length - 1] !== "") cleanLines.push("");
            return;
          }

          const cleaned = line
            .replace(/(https?:\/\/[^\s]+)/g, "")
            .replace(/#[\p{L}\p{N}_]+/gu, "")
            .replace(/@[\w.]+/g, "")
            .replace(/[\u25c6\u25c7\u{1F539}\u{1F538}\u25aa\ufe0f•]+/gu, "")
            .replace(/\s+/g, " ")
            .trim();

          if (cleaned) cleanLines.push(cleaned);
        });

        while (cleanLines[cleanLines.length - 1] === "") cleanLines.pop();

        const content = cleanLines.join("\n").trim();
        const rawTitle = cleanLines.find(Boolean) || "پست بدون عنوان";
        const rawExcerpt = content.replace(/\n/g, " ").replace(/\s+/g, " ");
        const title = rawTitle.length > 80 ? `${rawTitle.slice(0, 79).trim()}…` : rawTitle;
        const excerpt = rawExcerpt.length > 120 ? `${rawExcerpt.slice(0, 119).trim()}…` : rawExcerpt;

        return { title, content, excerpt, hashtags, urls };
      }

      function makeSlugFromText(text) {
        const parsed = parseContent(text);
        const base = parsed.title
          .toLowerCase()
          .replace(/[^a-z0-9\u0600-\u06FF\s-]/g, "")
          .replace(/\s+/g, "-")
          .replace(/-+/g, "-")
          .replace(/^-|-$/g, "")
          .slice(0, 70);

        return `${base || "post"}-${Date.now()}`;
      }

      function makeTitle(text) {
        return parseContent(text).title || "پست بدون عنوان";
      }

      function makeExcerpt(text) {
        return parseContent(text).excerpt || "";
      }

      function cleanTextForSeo(text) {
        return normalizeText(text)
          .replace(/\u{1F539}?\s*@mahoonartmagazine/giu, "")
          .replace(/@mahoonartmagazine/giu, "")
          .replace(/https?:\/\/(?:t\.me|telegram\.me|telegram\.dog)\/[^\s]+/giu, "")
          .replace(/https?:\/\/[^\s]+/giu, "")
          .replace(/#[\p{L}\p{N}_]+/gu, " ")
          .replace(/[\u25c6\u25c7\u{1F539}\u{1F538}\u25aa\ufe0f•]+/gu, " ")
          .replace(/\s+/g, " ")
          .trim();
      }

      function trimSeoText(value, limit) {
        const text = String(value || "").replace(/\s+/g, " ").trim();
        if (text.length <= limit) return text;
        return `${text.slice(0, Math.max(limit - 1, 0)).trim()}…`;
      }

      function makePostTitle(post) {
        if (post?.seo_title) return trimSeoText(post.seo_title, 70);

        const clean = cleanTextForSeo(post?.text || "");
        const firstLine = clean.split(/[.!؟\n]/).find(Boolean) || clean;

        return trimSeoText(firstLine, 70) || "مطلب ماهون";
      }

      function makeSeoDescription(post) {
        if (post?.seo_description) return trimSeoText(post.seo_description, 160);

        const clean = cleanTextForSeo(post?.text || "");

        return trimSeoText(clean, 155) || "روایتی از مجله هنری ماهون درباره هنر، تصویر، صدا و نوشتار.";
      }

      function ensureSeoForPost(post) {
        return {
          seo_title: makePostTitle(post),
          seo_description: makeSeoDescription(post)
        };
      }

      function formatDate(value) {
        if (!value) return "";

        try {
          const date = new Date(value.replace(" ", "T") + "Z");

          return new Intl.DateTimeFormat("fa-IR", {
            year: "numeric",
            month: "short",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit"
          }).format(date);
        } catch {
          return value;
        }
      }

      function escapeHtml(value) {
        return String(value || "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      function escapeAttr(value) {
        return escapeHtml(value).replaceAll("`", "&#096;");
      }

      function mediaLabel(type) {
        if (type === "photo") return "عکس";
        if (type === "video") return "ویدیو";
        if (type === "audio") return "صوت";
        if (type === "voice") return "ویس";
        if (type === "document") return "فایل";
        return "فایل";
      }

      function mediaFromPost(post) {
        if (!post) return null;

        const fileId = post.media_file_id || post.photo_file_id || null;
        const mediaType = post.media_type || (post.photo_file_id ? "photo" : null);

        if (!fileId || !mediaType) return null;

        return {
          media_type: mediaType,
          media_file_id: fileId,
          media_unique_id: post.media_unique_id || post.photo_unique_id || null,
          media_mime_type: post.media_mime_type || null,
          media_file_name: post.media_file_name || null,
          media_duration: post.media_duration || null,
          media_width: post.media_width || post.photo_width || null,
          media_height: post.media_height || post.photo_height || null,
          media_size: post.media_size || null,
          media_url: post.media_url || post.photo_url || null,
          photo_url: mediaType === "photo" ? post.media_url || post.photo_url : null
        };
      }

      function editorStateSnapshot() {
        const media = currentMedia || {};

        return JSON.stringify({
          id: postId.value || "",
          slug: postSlug.value || "",
          isPublished: Boolean(isPublished.checked),
          text: postText.value || "",
          seoTitle: seoTitle.value || "",
          seoDescription: seoDescription.value || "",
          adminNote: adminNote.value || "",
          mediaFileId: media.media_file_id || "",
          mediaType: media.media_type || ""
        });
      }

      function resetEditorDirty() {
        editorBaseline = editorStateSnapshot();
        editorDirty = false;
      }

      function markEditorDirty() {
        editorDirty = editorStateSnapshot() !== editorBaseline;
      }

      function updateStableIdDisplay(id) {
        const value = id ? `#${id}` : "-";
        stablePostId.textContent = value;
        stableIdNote.innerHTML = id
          ? `<strong>کد ثابت پست ${value}:</strong> این ID همان کدی است که در ربات استفاده می‌شود و بعد از حذف پست‌های دیگر تغییر نمی‌کند.`
          : `<strong>کد ثابت پست:</strong> بعد از ساخت پست، ID ثابت اینجا نمایش داده می‌شود. این ID همان کد ربات است.`;
      }

      function renderMediaPreview() {
        if (!currentMedia || !currentMedia.media_file_id) {
          mediaPreview.innerHTML = "هنوز فایلی برای این پست انتخاب نشده است.";
          return;
        }

        const url = currentMedia.media_url;
        const type = currentMedia.media_type;

        if (type === "photo" && url) {
          mediaPreview.innerHTML = `<img src="${escapeAttr(url)}" alt="">`;
          return;
        }

        if (type === "video" && url) {
          mediaPreview.innerHTML = `<video src="${escapeAttr(url)}" controls playsinline preload="metadata"></video>`;
          return;
        }

        if ((type === "audio" || type === "voice") && url) {
          mediaPreview.innerHTML = `
            <div class="file-preview">
              <strong>${mediaLabel(type)}</strong>
              <audio src="${escapeAttr(url)}" controls preload="metadata"></audio>
            </div>
          `;
          return;
        }

        if (url) {
          mediaPreview.innerHTML = `
            <div class="file-preview">
              <strong>${escapeHtml(currentMedia.media_file_name || "فایل پیوست")}</strong>
              <span>${escapeHtml(currentMedia.media_mime_type || mediaLabel(type))}</span>
              <a class="admin-btn btn btn-primary" href="${escapeAttr(url)}" target="_blank" rel="noopener">مشاهده فایل</a>
            </div>
          `;
          return;
        }

        mediaPreview.innerHTML = `${mediaLabel(type)} انتخاب شده است.`;
      }

      async function testLogin() {
        try {
          await api("/admin/health");
          showDashboard();
          await loadPosts();
        } catch {
          clearToken();
          showLogin();
          showMessage(loginMessage, "رمز مدیریت اشتباه است یا سرویس مدیریت آماده نیست.", "error");
        }
      }

      async function loadPosts() {
        postsList.innerHTML = `<div class="empty">در حال دریافت پست‌ها...</div>`;
        apiStatus.textContent = "در حال اتصال...";

        try {
          const data = await api("/admin/posts");
          posts = data.posts || [];
          selectedIds = new Set();

        renderStats();
        renderPosts();
        renderActiveAuxiliarySection();
        updateSelectedCount();
          apiStatus.textContent = "API متصل است";
          apiDetailText.textContent = "اتصال برقرار است و داده‌ها از مسیرهای مدیریت موجود دریافت شدند.";
          updateLocalState();
        } catch (error) {
          postsList.innerHTML = `<div class="empty">${escapeHtml(error.message)}</div>`;
          apiStatus.textContent = "خطا در اتصال API";
          apiDetailText.textContent = userFriendlyError(error, "اتصال برقرار نشد.");
        }
      }

      async function loadDeletedPosts() {
        deletedPostsList.hidden = false;
        deletedPostsList.innerHTML = `<div class="empty">در حال دریافت پست‌های حذف‌شده...</div>`;

        try {
          const data = await api("/admin/posts/deleted");
          deletedPosts = data.posts || [];
          renderDeletedPosts();
          renderStats();
        } catch (error) {
          const message = error.status === 404
            ? "این قابلیت هنوز روی API آنلاین فعال نشده است."
            : userFriendlyError(error, "دریافت پست‌های حذف‌شده انجام نشد.");

          deletedPostsList.innerHTML = `<div class="empty">${escapeHtml(message)}</div>`;
        }
      }

      function showActivePostsView() {
        currentView = "active";
        activePostsTabBtn.classList.add("active");
        deletedPostsTabBtn.classList.remove("active");
        filtersBar.hidden = false;
        bulkbar.hidden = false;
        postsList.hidden = false;
        deletedPostsList.hidden = true;
      }

      async function showDeletedPostsView() {
        currentView = "deleted";
        deletedPostsTabBtn.classList.add("active");
        activePostsTabBtn.classList.remove("active");
        filtersBar.hidden = true;
        bulkbar.hidden = true;
        postsList.hidden = true;
        deletedPostsList.hidden = false;
        selectedIds = new Set();
        updateSelectedCount();
        await loadDeletedPosts();
      }

      function renderDeletedPosts() {
        if (deletedPosts.length === 0) {
          deletedPostsList.innerHTML = `
            <div class="id-note deleted-note">
              <strong>پست‌های حذف‌شده:</strong>
              بازگردانی فقط با ID ثابت دیتابیس انجام می‌شود؛ این ID همان کد ربات است.
            </div>
            <div class="empty">پست حذف‌شده‌ای پیدا نشد.</div>
          `;
          return;
        }

        deletedPostsList.innerHTML = `
          <div class="id-note deleted-note">
            <strong>پست‌های حذف‌شده:</strong>
            بازگردانی فقط با ID ثابت دیتابیس انجام می‌شود؛ این ID همان کد ربات است و بعد از حذف تغییر نمی‌کند.
          </div>
          <div class="admin-data-list">
          ${deletedPosts.slice(0, DELETED_RENDER_LIMIT).map(post => {
            const title = makeTitle(post.text);
            const excerpt = makeExcerpt(post.text);
            const statusText = Number(post.is_published) === 1 ? "منتشر شده" : "منتشر نشده";
            const kind = contentKind(post);
            const publicHref = post.slug ? `/post/${encodeURIComponent(post.slug)}` : "";

            return `
              <article class="admin-data-row admin-deleted-row" data-deleted-id="${post.id}">
                <div class="admin-row-check">
                  <span class="admin-row-badge red">حذف</span>
                </div>

                <div class="admin-row-thumb">
                  ${renderThumb(post)}
                </div>

                <div class="admin-row-main">
                  <h3 class="admin-row-title">${escapeHtml(title)}</h3>
                  <p class="admin-row-excerpt">${escapeHtml(excerpt)}</p>
                  ${renderAdminTags(post)}
                </div>

                <div class="admin-row-meta">
                  <span class="admin-row-badge blue">ID ${escapeHtml(post.id)}</span>
                  <span class="admin-row-badge red">حذف‌شده</span>
                  <span class="admin-row-badge gray">${escapeHtml(statusText)}</span>
                  <span class="admin-row-badge">${escapeHtml(kind)}</span>
                </div>

                <div class="admin-row-actions">
                  ${adminRowButton("بازگردانی", `data-restore-id="${post.id}"`, "success")}
                  ${publicHref ? adminRowButton("کپی URL", `data-copy-value="${escapeAttr(window.location.origin + publicHref)}"`) : ""}
                </div>
              </article>
            `;
          }).join("")}
          </div>
          ${deletedPosts.length > DELETED_RENDER_LIMIT ? `<div class="empty">برای سبک ماندن پنل، ${DELETED_RENDER_LIMIT} مورد نخست نمایش داده شد.</div>` : ""}
        `;
      }

      async function restoreDeletedPost(id, button) {
        if (!id || button?.disabled) return;

        const confirmed = await confirmAction({
          title: "بازگردانی مطلب",
          message: `پست حذف‌شده با کد ثابت #${id} بازگردانی شود؟ این عملیات پست را دوباره منتشر می‌کند و ID ثابت تغییر نمی‌کند.`,
          confirmText: "بازگردانی"
        });

        if (!confirmed) return;

        setButtonLoading(button, true, "در حال بازگردانی...");

        try {
          await api(`/admin/posts/${id}/restore`, {
            method: "POST",
            body: JSON.stringify({})
          });

          showMessage(editorMessage, `پست #${id} با موفقیت بازگردانی شد.`, "ok");
          await loadDeletedPosts();
          await loadPosts();
        } catch (error) {
          const message = error.status === 404
            ? "این قابلیت هنوز روی API آنلاین فعال نشده است یا پست قبلاً بازگردانی شده است."
            : userFriendlyError(error, "بازگردانی پست انجام نشد.");

          showMessage(editorMessage, message, "error");
        } finally {
          setButtonLoading(button, false);
        }
      }

      function renderStats() {
        const published = posts.filter(post => Number(post.is_published) === 1).length;
        const drafts = posts.filter(post => Number(post.is_published) !== 1).length;
        const withMedia = posts.filter(post => post.media_file_id || post.photo_file_id).length;
        const withoutMedia = Math.max(posts.length - withMedia, 0);
        const latestId = posts.reduce((max, post) => Math.max(max, Number(post.id || 0)), 0);
        const uniqueTags = new Set(posts.flatMap(post => parseContent(post.text).hashtags));

        totalCount.textContent = posts.length;
        topbarTotalCount.textContent = posts.length;
        publishedCount.textContent = published;
        draftCount.textContent = drafts;
        deletedCount.textContent = deletedPosts.length;
        mediaCount.textContent = withMedia;
        textCount.textContent = withoutMedia;
        latestIdCount.textContent = latestId || "-";
        tagsCount.textContent = uniqueTags.size;
        exportCount.textContent = `${posts.length} مطلب آماده خروجی`;

        const rate = posts.length ? Math.round((published / posts.length) * 100) : 0;
        publishRate.textContent = `${rate}%`;
        publishProgress.style.width = `${rate}%`;
        lastRefresh.textContent = `آخرین بروزرسانی: ${new Intl.DateTimeFormat("fa-IR", {
          hour: "2-digit",
          minute: "2-digit"
        }).format(new Date())}`;

        renderActivity();
        mediaPanelCount.textContent = `${withMedia} مورد`;
        seoPanelCount.textContent = `${posts.filter(post => !post.seo_title || !post.seo_description).length} مورد نیازمند بررسی`;
        updateLocalState();
      }

      function renderActiveAuxiliarySection() {
        const activeSection = adminSections.find(section => !section.hidden && section.classList.contains("is-active"));
        const key = activeSection?.getAttribute("data-admin-section");

        if (key === "media") renderMediaLibrary();
        if (key === "seo") renderSeoChecklist();
      }

      function renderActivity() {
        const latest = [...posts]
          .sort((a, b) => Number(b.id || 0) - Number(a.id || 0))
          .slice(0, 5);

        if (!latest.length) {
          activityList.innerHTML = `<div class="empty">هنوز مطلبی لود نشده است.</div>`;
          return;
        }

        activityList.innerHTML = latest.map(post => `
          <div class="activity-item">
            <div>
              <strong>${escapeHtml(makeTitle(post.text))}</strong>
              <span>کد ثابت #${post.id} · ${escapeHtml(formatDate(post.created_at))}</span>
            </div>
            <span class="badge ${Number(post.is_published) === 1 ? "green" : "red"}">
              ${Number(post.is_published) === 1 ? "منتشرشده" : "پیش‌نویس"}
            </span>
          </div>
        `).join("");
      }

      function renderMediaLibrary() {
        const withMedia = posts.filter(post => mediaFromPost(post));
        mediaPanelCount.textContent = `${withMedia.length} مورد`;

        if (!withMedia.length) {
          mediaLibrary.innerHTML = `<div class="empty">مطلب دارای رسانه پیدا نشد.</div>`;
          return;
        }

        mediaLibrary.innerHTML = `
          <div class="admin-data-list">
          ${withMedia.slice(0, MEDIA_RENDER_LIMIT).map(post => {
          const media = mediaFromPost(post);
          const url = media?.media_url || media?.photo_url || "";
          const publicHref = post.slug ? `/post/${encodeURIComponent(post.slug)}` : "";
          const title = makeTitle(post.text);

          return `
            <article class="admin-data-row admin-media-row">
              <div class="admin-row-check">
                <span class="admin-row-badge blue">رسانه</span>
              </div>
              <div class="admin-row-thumb">${renderThumb(post)}</div>
              <div class="admin-row-main">
                <h3 class="admin-row-title">${escapeHtml(title)}</h3>
                <p class="admin-row-excerpt">${escapeHtml(makeExcerpt(post.text))}</p>
                ${renderAdminTags(post)}
              </div>
              <div class="admin-row-meta">
                <span class="admin-row-badge blue">ID ${escapeHtml(post.id)}</span>
                <span class="admin-row-badge">${escapeHtml(mediaLabel(media.media_type))}</span>
                <span class="admin-row-badge gray">${escapeHtml(formatDate(post.created_at))}</span>
              </div>
              <div class="admin-row-actions">
                ${adminRowButton("ویرایش", `data-edit-id="${post.id}"`)}
                ${publicHref ? adminRowLink("مشاهده", publicHref, "data-row-action") : ""}
                ${url ? adminRowButton("کپی URL", `data-copy-value="${escapeAttr(url)}"`) : ""}
              </div>
            </article>
          `;
        }).join("")}
          </div>
        ` + (
          withMedia.length > MEDIA_RENDER_LIMIT
            ? `<div class="empty">برای سبک ماندن پنل، ${MEDIA_RENDER_LIMIT} رسانه نخست نمایش داده شد.</div>`
            : ""
        );
      }

      function renderSeoChecklist() {
        const missingCount = posts.filter(post => !post.seo_title || !post.seo_description).length;
        const items = [...posts].sort((a, b) => Number(b.id || 0) - Number(a.id || 0)).slice(0, SEO_RENDER_LIMIT);
        seoPanelCount.textContent = `${missingCount} مورد نیازمند بررسی`;

        if (!items.length) {
          seoChecklist.innerHTML = `<div class="empty">تمام مطالب لودشده حداقل عنوان و توضیح SEO دارند.</div>`;
          return;
        }

        seoChecklist.innerHTML = `
          <div class="admin-data-list">
          ${items.map(post => {
          const publicHref = post.slug ? `/post/${encodeURIComponent(post.slug)}` : "";
          const publicUrl = publicHref ? `${window.location.origin}${publicHref}` : "";
          const generatedSeo = ensureSeoForPost(post);
          const titleStatus = post.seo_title ? "عنوان ثبت‌شده" : "عنوان پیشنهادی";
          const descStatus = post.seo_description ? "توضیح ثبت‌شده" : "توضیح پیشنهادی";

          return `
          <article class="admin-data-row admin-seo-row">
            <div class="admin-row-check">
              <span class="admin-row-badge blue">SEO</span>
            </div>
            <div class="admin-row-thumb">
              ${renderThumb(post)}
            </div>
            <div class="admin-row-main">
              <h3 class="admin-row-title">${escapeHtml(makeTitle(post.text))}</h3>
              <div class="admin-seo-preview">
                <strong>${escapeHtml(generatedSeo.seo_title)}</strong>
                <p>${escapeHtml(generatedSeo.seo_description)}</p>
              </div>
            </div>

            <div class="admin-row-meta">
              <span class="admin-row-badge blue">ID ${escapeHtml(post.id)}</span>
              <span class="admin-row-badge ${post.seo_title ? "green" : "gray"}">${escapeHtml(titleStatus)}</span>
              <span class="admin-row-badge ${post.seo_description ? "green" : "gray"}">${escapeHtml(descStatus)}</span>
            </div>

            <div class="admin-row-actions">
              ${adminRowButton("ویرایش SEO", `data-edit-id="${post.id}" data-editor-target="seo"`, "warning")}
              ${publicHref ? adminRowLink("مشاهده", publicHref, "data-row-action") : ""}
              ${publicUrl ? adminRowButton("کپی لینک", `data-copy-value="${escapeAttr(publicUrl)}"`) : ""}
            </div>
          </article>
        `;
        }).join("")}
          </div>
        ` + (
          posts.length > SEO_RENDER_LIMIT
            ? `<div class="empty">برای سرعت بهتر، ${SEO_RENDER_LIMIT} مورد اخیر SEO نمایش داده شد.</div>`
            : ""
        );
      }

      function updateLocalState() {
        tokenState.textContent = getToken() ? "در مرورگر ذخیره شده است" : "ذخیره نشده است";
      }

      function getFilteredPosts() {
        const query = (searchInput.value || "").trim().toLowerCase();
        const status = statusFilter.value;
        const media = mediaFilter.value;
        const sort = sortFilter.value;

        let filtered = posts.filter(post => {
          const parsed = parseContent(post.text);
          const mediaType = post.media_type || (post.photo_file_id ? "photo" : null);
          const hasMedia = Boolean(post.media_file_id || post.photo_file_id);

          const searchText = `${post.id} ${post.slug} ${post.text} ${post.seo_title || ""} ${post.seo_description || ""} ${parsed.hashtags.join(" ")}`.toLowerCase();

          const matchesQuery = !query || searchText.includes(query);
          const matchesStatus =
            status === "all" ||
            (status === "published" && Number(post.is_published) === 1) ||
            (status === "draft" && Number(post.is_published) !== 1);

          const matchesMedia =
            media === "all" ||
            (media === "media" && hasMedia) ||
            (media === "photo" && mediaType === "photo") ||
            (media === "video" && mediaType === "video") ||
            (media === "audio" && (mediaType === "audio" || mediaType === "voice")) ||
            (media === "text" && !hasMedia);

          return matchesQuery && matchesStatus && matchesMedia;
        });

        if (sort === "oldest") {
          filtered.sort((a, b) => Number(a.id) - Number(b.id));
        } else if (sort === "id") {
          filtered.sort((a, b) => Number(b.id || 0) - Number(a.id || 0));
        } else if (sort === "title") {
          filtered.sort((a, b) => makeTitle(a.text).localeCompare(makeTitle(b.text), "fa"));
        } else {
          filtered.sort((a, b) => Number(b.id) - Number(a.id));
        }

        return filtered;
      }

      function contentKind(post) {
        const media = mediaFromPost(post);
        const tags = parseContent(post.text).hashtags.map(tag => tag.trim());
        const hasTag = (...names) => tags.some(tag => names.includes(tag));

        if (media?.media_type === "photo") return "تصویر";
        if (media?.media_type === "video" || media?.media_type === "animation") return "ویدیو";
        if (media?.media_type === "audio" || media?.media_type === "voice") return "صوت";
        if (media?.media_type === "document") return "فایل";
        if (hasTag("شعر", "اشعار", "متن", "متن‌ها", "متن_ها")) return "شعر و متن";
        if (hasTag("کتاب")) return "کتاب";
        if (hasTag("نقاشی")) return "نقاشی";
        if (hasTag("دیالوگ", "دیالوگ‌ها", "دیالوگ_ها")) return "دیالوگ";
        return "متن";
      }

      function renderAdminTags(post, limit = 3) {
        const tags = parseContent(post.text).hashtags.slice(0, limit);
        if (!tags.length) return "";

        return `
          <div class="admin-row-tags">
            ${tags.map(tag => `<span class="admin-row-badge gray">#${escapeHtml(tag)}</span>`).join("")}
          </div>
        `;
      }

      function renderThumb(post) {
        const media = mediaFromPost(post);

        if (!media) return `<span class="admin-row-placeholder">متن</span>`;

        if (media.media_type === "photo" && media.media_url) {
          return `<img src="${escapeAttr(media.media_url)}" alt="" loading="lazy" decoding="async" width="76" height="76">`;
        }

        if (media.media_type === "video" && media.media_url) {
          return `<video src="${escapeAttr(media.media_url)}" muted preload="metadata" width="76" height="76"></video>`;
        }

        return `<span class="admin-row-placeholder">${escapeHtml(mediaLabel(media.media_type))}</span>`;
      }

      function adminRowButton(label, attrs = "", tone = "") {
        return `<button class="admin-btn admin-row-action admin-glass-btn ${tone}" type="button" ${attrs}>${escapeHtml(label)}</button>`;
      }

      function adminRowLink(label, href, attrs = "") {
        return `<a class="admin-btn admin-row-action admin-glass-btn" href="${escapeAttr(href)}" target="_blank" rel="noopener" ${attrs}>${escapeHtml(label)}</a>`;
      }

      function renderPosts() {
        const filtered = getFilteredPosts();

        if (filtered.length === 0) {
          postsList.innerHTML = `<div class="empty">پستی پیدا نشد.</div>`;
          postsPagination.innerHTML = "";
          return;
        }

        const totalPages = Math.max(Math.ceil(filtered.length / POSTS_PER_PAGE), 1);
        currentPage = Math.min(Math.max(currentPage, 1), totalPages);
        const start = (currentPage - 1) * POSTS_PER_PAGE;
        const visiblePosts = filtered.slice(start, start + POSTS_PER_PAGE);

        postsList.innerHTML = `
          <div class="admin-data-list">
            ${visiblePosts.map(post => {
          const active = selectedPost && Number(selectedPost.id) === Number(post.id) ? "active" : "";
          const checked = selectedIds.has(Number(post.id)) ? "checked" : "";
          const statusClass = Number(post.is_published) === 1 ? "green" : "red";
          const statusText = Number(post.is_published) === 1 ? "منتشر شده" : "منتشر نشده";
          const title = makeTitle(post.text);
          const excerpt = makeExcerpt(post.text);
          const media = mediaFromPost(post);
          const kind = contentKind(post);
          const publicHref = post.slug ? `/post/${encodeURIComponent(post.slug)}` : "";

          return `
            <article class="admin-data-row admin-post-row ${active}" data-row-id="${post.id}">
              <div class="admin-row-check">
                <input class="admin-checkbox switch-input" type="checkbox" data-check-id="${post.id}" ${checked} />
              </div>

              <div class="admin-row-thumb">
                ${renderThumb(post)}
              </div>

              <div class="admin-row-main">
                <h3 class="admin-row-title">${escapeHtml(title)}</h3>
                <p class="admin-row-excerpt">${escapeHtml(excerpt)}</p>
                ${renderAdminTags(post)}
              </div>

              <div class="admin-row-meta">
                <span class="admin-row-badge blue">ID ${escapeHtml(post.id)}</span>
                <span class="admin-row-badge ${statusClass}">${escapeHtml(statusText)}</span>
                <span class="admin-row-badge">${escapeHtml(kind)}</span>
                ${media ? `<span class="admin-row-badge gray">${escapeHtml(mediaLabel(media.media_type))}</span>` : ""}
                <span class="admin-row-badge gray">${escapeHtml(formatDate(post.created_at))}</span>
              </div>

              <div class="admin-row-actions">
                ${adminRowButton("ویرایش", `data-edit-id="${post.id}"`)}
                ${publicHref ? adminRowLink("مشاهده", publicHref, "data-row-action") : ""}
                ${publicHref ? adminRowButton("کپی لینک", `data-copy-value="${escapeAttr(window.location.origin + publicHref)}"`) : ""}
                ${adminRowButton("کپی ID", `data-copy-value="${post.id}"`)}
                ${adminRowButton(Number(post.is_published) === 1 ? "عدم انتشار" : "انتشار", `data-toggle-publish="${post.id}"`, Number(post.is_published) === 1 ? "warning" : "success")}
                ${adminRowButton("حذف نرم", `data-soft-delete-id="${post.id}"`, "danger")}
              </div>
            </article>
          `;
        }).join("")}
          </div>
        `;

        renderPagination(totalPages, filtered.length);
      }

      function renderPagination(totalPages, totalItems) {
        if (totalPages <= 1) {
          postsPagination.innerHTML = `<span>${totalItems} مطلب</span>`;
          return;
        }

        const pageButtons = Array.from({ length: totalPages }, (_, index) => {
          const page = index + 1;
          return `<button class="admin-btn admin-glass-btn page-btn ${page === currentPage ? "active" : ""}" type="button" data-page="${page}">${page}</button>`;
        }).join("");

        postsPagination.innerHTML = `
          <button class="admin-btn admin-glass-btn page-btn" type="button" data-page-prev ${currentPage === 1 ? "disabled" : ""}>قبلی</button>
          ${pageButtons}
          <button class="admin-btn admin-glass-btn page-btn" type="button" data-page-next ${currentPage === totalPages ? "disabled" : ""}>بعدی</button>
          <span>${totalItems} مطلب</span>
        `;
      }

      function updateSelectedCount() {
        selectedCount.textContent = `${selectedIds.size} پست انتخاب شده`;
      }

      function setEditorTab(name) {
        document.querySelectorAll("[data-editor-tab]").forEach(tab => {
          tab.classList.toggle("active", tab.getAttribute("data-editor-tab") === name);
        });

        document.querySelectorAll("[data-editor-panel]").forEach(panel => {
          panel.classList.toggle("active", panel.getAttribute("data-editor-panel") === name);
        });
      }

      function selectPost(post) {
        selectedPost = post;
        currentMedia = mediaFromPost(post);

        editorTitle.textContent = `ویرایش پست با کد ثابت #${post.id}`;
        postId.value = post.id;
        updateStableIdDisplay(post.id);
        postSlug.value = post.slug || "";
        isPublished.checked = Number(post.is_published) === 1;
        postText.value = post.text || "";
        seoTitle.value = post.seo_title || "";
        seoDescription.value = post.seo_description || "";
        adminNote.value = post.admin_note || "";
        viewCount.textContent = currentMedia ? mediaLabel(currentMedia.media_type) : "بدون";

        renderMediaPreview();
        updateEditorStats();
        updatePreview();
        resetEditorDirty();
        renderPosts();
      }

      function clearEditor() {
        selectedPost = null;
        currentMedia = null;

        editorTitle.textContent = "ساخت پست جدید";
        postId.value = "";
        updateStableIdDisplay("");
        postSlug.value = "";
        isPublished.checked = true;
        postText.value = "";
        seoTitle.value = "";
        seoDescription.value = "";
        adminNote.value = "";
        viewCount.textContent = "-";
        mediaFile.value = "";

        renderMediaPreview();
        updateEditorStats();
        updatePreview();
        resetEditorDirty();
        renderPosts();
      }

      function updateEditorStats() {
        const text = postText.value || "";
        const parsed = parseContent(text);
        const words = text.trim() ? text.trim().split(/\s+/).length : 0;

        charCount.textContent = text.length;
        wordCount.textContent = words;
        tagCount.textContent = parsed.hashtags.length;
      }

      function updatePreview() {
        const parsed = parseContent(postText.value || "");

        previewTitle.textContent = parsed.title || "عنوان پست";
        previewContent.textContent = parsed.content || "متن پست اینجا نمایش داده می‌شود.";
        previewStatus.textContent = isPublished.checked ? "منتشر شده" : "منتشر نشده";
        previewStatus.className = isPublished.checked ? "badge green" : "badge red";

        previewTags.innerHTML = parsed.hashtags.length
          ? parsed.hashtags.map(tag => `<span class="badge">#${escapeHtml(tag)}</span>`).join("")
          : `<span class="badge gray">بدون هشتگ</span>`;
      }

      function editorPayload() {
        const media = currentMedia || {};

        return {
          text: postText.value.trim(),
          slug: postSlug.value.trim(),
          is_published: isPublished.checked ? 1 : 0,
          seo_title: seoTitle.value.trim(),
          seo_description: seoDescription.value.trim(),
          admin_note: adminNote.value.trim(),

          media_type: media.media_type || null,
          media_file_id: media.media_file_id || null,
          media_unique_id: media.media_unique_id || null,
          media_mime_type: media.media_mime_type || null,
          media_file_name: media.media_file_name || null,
          media_duration: media.media_duration || null,
          media_width: media.media_width || null,
          media_height: media.media_height || null,
          media_size: media.media_size || null
        };
      }

      function postPatchPayload(post, overrides = {}) {
        return {
          text: post.text || "",
          slug: post.slug || "",
          is_published: Number(post.is_published) === 1 ? 1 : 0,
          seo_title: post.seo_title || "",
          seo_description: post.seo_description || "",
          admin_note: post.admin_note || "",
          media_type: post.media_type || (post.photo_file_id ? "photo" : null),
          media_file_id: post.media_file_id || post.photo_file_id || null,
          media_unique_id: post.media_unique_id || post.photo_unique_id || null,
          media_mime_type: post.media_mime_type || null,
          media_file_name: post.media_file_name || null,
          media_duration: post.media_duration || null,
          media_width: post.media_width || post.photo_width || null,
          media_height: post.media_height || post.photo_height || null,
          media_size: post.media_size || null,
          ...overrides
        };
      }

      async function uploadMedia() {
        const file = mediaFile.files && mediaFile.files[0];

        if (!file) {
          showMessage(editorMessage, "اول یک فایل انتخاب کن.", "error");
          return;
        }

        if (uploadMediaBtn.disabled) return;

        const formData = new FormData();
        formData.append("file", file);

        setButtonLoading(uploadMediaBtn, true, "در حال آپلود...");

        try {
          const res = await fetch(`${WORKER_URL}/admin/upload`, {
            method: "POST",
            headers: authOnlyHeaders(),
            body: formData
          });

          const data = await res.json().catch(() => null);

          if (!res.ok || !data?.ok) {
            throw new Error(data?.error || "آپلود فایل ناموفق بود.");
          }

          currentMedia = data.media;
          renderMediaPreview();
          markEditorDirty();
          showMessage(editorMessage, "فایل با موفقیت ذخیره شد. برای اتصال آن به پست، ذخیره را بزن.", "ok");
        } catch (error) {
          showMessage(editorMessage, userFriendlyError(error, "آپلود فایل انجام نشد."), "error");
        } finally {
          setButtonLoading(uploadMediaBtn, false);
        }
      }

      function removeMedia() {
        currentMedia = null;
        mediaFile.value = "";
        renderMediaPreview();
        markEditorDirty();
        showMessage(editorMessage, "فایل از این پست حذف شد. برای اعمال تغییر، ذخیره را بزن.", "ok");
      }

      async function savePost() {
        if (saveBtn.disabled) return;

        const id = postId.value;
        const payload = editorPayload();

        if (!payload.text) {
          showMessage(editorMessage, "متن پست نمی‌تواند خالی باشد.", "error");
          return;
        }

        setButtonLoading(saveBtn, true, id ? "در حال ذخیره..." : "در حال ساخت...");

        try {
          if (id) {
            await api(`/admin/posts/${id}`, {
              method: "PATCH",
              body: JSON.stringify(payload)
            });

            showMessage(editorMessage, `پست با کد ثابت #${id} با موفقیت ذخیره شد.`, "ok");
          } else {
            const data = await api("/admin/posts", {
              method: "POST",
              body: JSON.stringify(payload)
            });

            showMessage(editorMessage, `پست جدید ساخته شد. کد ثابت آن #${data.id || "-"} است.`, "ok");

            postId.value = data.id || "";
            updateStableIdDisplay(data.id || "");
            postSlug.value = data.slug || payload.slug;
          }

          await loadPosts();

          const fresh = posts.find(item => Number(item.id) === Number(postId.value));

          if (fresh) {
            selectPost(fresh);
          } else {
            resetEditorDirty();
          }
        } catch (error) {
          showMessage(editorMessage, userFriendlyError(error, "ذخیره پست انجام نشد."), "error");
        } finally {
          setButtonLoading(saveBtn, false);
        }
      }

      async function deletePost() {
        if (deleteBtn.disabled) return;

        const id = postId.value;

        if (!id) {
          showMessage(editorMessage, "برای حذف، اول یک پست را انتخاب کن.", "error");
          return;
        }

        const confirmed = await confirmAction({
          title: "حذف نرم مطلب",
          message: `این مطلب از سایت حذف می‌شود، اما شماره ثابت آن تغییر نمی‌کند و hard delete انجام نمی‌شود. برای تأیید، کد ${id} را وارد کنید.`,
          confirmText: "حذف نرم",
          requireValue: id
        });

        if (!confirmed) return;

        setButtonLoading(deleteBtn, true, "در حال حذف...");

        try {
          await api(`/admin/posts/${id}`, {
            method: "DELETE"
          });

          showMessage(editorMessage, `پست #${id} به‌صورت نرم حذف شد. شماره ثابت آن تغییر نکرد.`, "ok");
          clearEditor();
          await loadPosts();
        } catch (error) {
          showMessage(editorMessage, userFriendlyError(error, "حذف پست انجام نشد."), "error");
        } finally {
          setButtonLoading(deleteBtn, false);
        }
      }

      async function duplicatePost() {
        if (duplicateBtn.disabled) return;

        const payload = editorPayload();

        if (!payload.text) {
          showMessage(editorMessage, "متن پست خالی است.", "error");
          return;
        }

        payload.slug = "";
        payload.is_published = 0;
        payload.admin_note = payload.admin_note ? payload.admin_note + "\nکپی شده از پست قبلی" : "کپی شده از پست قبلی";

        setButtonLoading(duplicateBtn, true, "در حال کپی...");

        try {
          const data = await api("/admin/posts", {
            method: "POST",
            body: JSON.stringify(payload)
          });

          showMessage(editorMessage, `کپی پست ساخته شد و با کد ثابت #${data.id || "-"} در حالت منتشر نشده قرار گرفت.`, "ok");

          await loadPosts();

          const fresh = posts.find(item => Number(item.id) === Number(data.id));

          if (fresh) {
            selectPost(fresh);
          }
        } catch (error) {
          showMessage(editorMessage, userFriendlyError(error, "کپی پست انجام نشد."), "error");
        } finally {
          setButtonLoading(duplicateBtn, false);
        }
      }

      async function completeMissingSeo() {
        const targets = posts.filter(post => !post.seo_title || !post.seo_description);

        if (!targets.length) {
          showToast("همه مطالب لودشده سئوی کامل دارند.", "ok");
          return;
        }

        const confirmed = await confirmAction({
          title: "تکمیل سئوی خالی‌ها",
          message: `برای ${targets.length} مطلب، عنوان و توضیح SEO پیشنهادی ساخته و ذخیره شود؟`,
          confirmText: "تکمیل سئو"
        });

        if (!confirmed || completeSeoBtn.disabled) return;

        setButtonLoading(completeSeoBtn, true, "در حال تکمیل...");

        let completed = 0;

        try {
          for (const post of targets) {
            const generatedSeo = ensureSeoForPost(post);

            await api(`/admin/posts/${post.id}`, {
              method: "PATCH",
              body: JSON.stringify(postPatchPayload(post, {
                seo_title: post.seo_title || generatedSeo.seo_title,
                seo_description: post.seo_description || generatedSeo.seo_description
              }))
            });

            completed += 1;
          }

          showToast(`${completed} مطلب با سئوی خودکار تکمیل شد.`, "ok");
          await loadPosts();
        } catch (error) {
          showMessage(editorMessage, userFriendlyError(error, `تکمیل SEO بعد از ${completed} مطلب متوقف شد.`), "error");
        } finally {
          setButtonLoading(completeSeoBtn, false);
        }
      }

      async function bulkAction(action) {
        if (selectedIds.size === 0) {
          showMessage(editorMessage, "هیچ پستی انتخاب نشده است.", "error");
          return;
        }

        if (action === "delete") {
          const confirmed = await confirmAction({
            title: "حذف نرم گروهی",
            message: `حذف نرم ${selectedIds.size} پست انتخاب‌شده انجام شود؟ شماره ثابت پست‌ها تغییر نمی‌کند و hard delete انجام نمی‌شود.`,
            confirmText: "حذف نرم"
          });
          if (!confirmed) return;
        }

        const buttonByAction = {
          publish: bulkPublishBtn,
          unpublish: bulkUnpublishBtn,
          delete: bulkDeleteBtn
        };
        const loadingTextByAction = {
          publish: "در حال انتشار...",
          unpublish: "در حال عدم انتشار...",
          delete: "در حال حذف..."
        };
        const doneTextByAction = {
          publish: "پست‌های انتخاب‌شده منتشر شدند.",
          unpublish: "پست‌های انتخاب‌شده از انتشار خارج شدند.",
          delete: "پست‌های انتخاب‌شده به‌صورت نرم حذف شدند."
        };
        const actionButton = buttonByAction[action];

        if (actionButton?.disabled) return;
        setButtonLoading(actionButton, true, loadingTextByAction[action] || "در حال انجام...");

        try {
          await api("/admin/posts/bulk", {
            method: "POST",
            body: JSON.stringify({
              action,
              ids: Array.from(selectedIds)
            })
          });

          selectedIds = new Set();
          await loadPosts();
          showMessage(editorMessage, doneTextByAction[action] || "عملیات گروهی انجام شد.", "ok");
        } catch (error) {
          showMessage(editorMessage, userFriendlyError(error, "عملیات گروهی انجام نشد."), "error");
        } finally {
          setButtonLoading(actionButton, false);
        }
      }

      function openPost() {
        const slug = postSlug.value.trim();

        if (!slug) {
          showMessage(editorMessage, "این پست slug ندارد.", "error");
          return;
        }

        window.open(`/post/${encodeURIComponent(slug)}`, "_blank");
      }

      async function copyLink() {
        const slug = postSlug.value.trim();

        if (!slug) {
          showMessage(editorMessage, "این پست slug ندارد.", "error");
          return;
        }

        const link = `${window.location.origin}/post/${encodeURIComponent(slug)}`;

        try {
          await navigator.clipboard.writeText(link);
          showMessage(editorMessage, "لینک پست کپی شد.", "ok");
        } catch {
          showMessage(editorMessage, link, "ok");
        }
      }

      async function copyValue(value, successText = "کپی شد.") {
        const text = String(value || "");

        if (!text) {
          showMessage(editorMessage, "چیزی برای کپی وجود ندارد.", "error");
          return;
        }

        try {
          await navigator.clipboard.writeText(text);
          showToast(successText, "ok");
        } catch {
          showMessage(editorMessage, text, "ok");
        }
      }

      async function togglePublishPost(id, button) {
        const post = posts.find(item => Number(item.id) === Number(id));
        if (!post || button?.disabled) return;

        const nextStatus = Number(post.is_published) === 1 ? 0 : 1;
        const actionText = nextStatus === 1 ? "منتشر" : "پیش‌نویس";
        const confirmed = await confirmAction({
          title: "تغییر وضعیت انتشار",
          message: `مطلب با کد ثابت #${id} ${actionText} شود؟`,
          confirmText: actionText
        });

        if (!confirmed) return;

        setButtonLoading(button, true, "در حال انجام...");

        try {
          await api(`/admin/posts/${id}`, {
            method: "PATCH",
            body: JSON.stringify(postPatchPayload(post, { is_published: nextStatus }))
          });

          showMessage(editorMessage, `وضعیت مطلب #${id} بروزرسانی شد.`, "ok");
          await loadPosts();
        } catch (error) {
          showMessage(editorMessage, userFriendlyError(error, "تغییر وضعیت انجام نشد."), "error");
        } finally {
          setButtonLoading(button, false);
        }
      }

      async function softDeletePostById(id, button) {
        if (!id || button?.disabled) return;

        const confirmed = await confirmAction({
          title: "حذف نرم مطلب",
          message: `مطلب با کد ثابت #${id} حذف نرم شود؟ برای تأیید، همین کد را وارد کنید.`,
          confirmText: "حذف نرم",
          requireValue: id
        });

        if (!confirmed) return;

        setButtonLoading(button, true, "در حال حذف...");

        try {
          await api(`/admin/posts/${id}`, {
            method: "DELETE"
          });

          showMessage(editorMessage, `مطلب #${id} به‌صورت نرم حذف شد.`, "ok");
          if (Number(postId.value) === Number(id)) clearEditor();
          await loadPosts();
        } catch (error) {
          showMessage(editorMessage, userFriendlyError(error, "حذف نرم انجام نشد."), "error");
        } finally {
          setButtonLoading(button, false);
        }
      }

      function exportJson() {
        const data = JSON.stringify(posts, null, 2);
        const blob = new Blob([data], { type: "application/json;charset=utf-8" });
        const url = URL.createObjectURL(blob);

        const a = document.createElement("a");
        a.href = url;
        a.download = `mahoon-posts-${Date.now()}.json`;
        a.click();

        URL.revokeObjectURL(url);
      }

      postsList.addEventListener("click", event => {
        const editButton = event.target.closest("[data-edit-id]");
        if (editButton) {
          event.stopPropagation();
          const id = Number(editButton.getAttribute("data-edit-id"));
          const post = posts.find(item => Number(item.id) === id);
          if (post) {
            selectPost(post);
            showAdminSection("create", { skipModeChange: true });
          }
          return;
        }

        const copyButton = event.target.closest("[data-copy-value]");
        if (copyButton) {
          event.stopPropagation();
          copyValue(copyButton.getAttribute("data-copy-value"), "مقدار کپی شد.");
          return;
        }

        const toggleButton = event.target.closest("[data-toggle-publish]");
        if (toggleButton) {
          event.stopPropagation();
          togglePublishPost(Number(toggleButton.getAttribute("data-toggle-publish")), toggleButton);
          return;
        }

        const softDeleteButton = event.target.closest("[data-soft-delete-id]");
        if (softDeleteButton) {
          event.stopPropagation();
          softDeletePostById(Number(softDeleteButton.getAttribute("data-soft-delete-id")), softDeleteButton);
          return;
        }

        if (event.target.closest("[data-row-action]")) {
          event.stopPropagation();
          return;
        }

        const checkbox = event.target.closest("[data-check-id]");

        if (checkbox) {
          const id = Number(checkbox.getAttribute("data-check-id"));

          if (checkbox.checked) {
            selectedIds.add(id);
          } else {
            selectedIds.delete(id);
          }

          updateSelectedCount();
          return;
        }

        const row = event.target.closest("[data-row-id]");
        if (!row) return;

        const id = Number(row.getAttribute("data-row-id"));
        const post = posts.find(item => Number(item.id) === id);

        if (post) {
          selectPost(post);
        }
      });

      postsPagination.addEventListener("click", event => {
        const pageButton = event.target.closest("[data-page]");
        const prevButton = event.target.closest("[data-page-prev]");
        const nextButton = event.target.closest("[data-page-next]");

        if (pageButton) {
          currentPage = Number(pageButton.getAttribute("data-page"));
        } else if (prevButton) {
          currentPage = Math.max(currentPage - 1, 1);
        } else if (nextButton) {
          currentPage += 1;
        } else {
          return;
        }

        renderPosts();
      });

      deletedPostsList.addEventListener("click", event => {
        const copyButton = event.target.closest("[data-copy-value]");
        if (copyButton) {
          copyValue(copyButton.getAttribute("data-copy-value"), "مقدار کپی شد.");
          return;
        }

        const restoreButton = event.target.closest("[data-restore-id]");
        if (!restoreButton) return;

        const id = Number(restoreButton.getAttribute("data-restore-id"));
        restoreDeletedPost(id, restoreButton);
      });

      document.querySelectorAll(".section-list").forEach(list => {
        list.addEventListener("click", event => {
          const editButton = event.target.closest("[data-edit-id]");
          const copyButton = event.target.closest("[data-copy-value]");

          if (editButton) {
            const id = Number(editButton.getAttribute("data-edit-id"));
            const post = posts.find(item => Number(item.id) === id);
            if (post) {
              selectPost(post);
              const target = editButton.getAttribute("data-editor-target");
              if (target) setEditorTab(target);
              showAdminSection("create", { skipModeChange: true });
              document.getElementById("editorTitle")?.scrollIntoView({ behavior: "smooth", block: "start" });
            }
            return;
          }

          if (copyButton) {
            copyValue(copyButton.getAttribute("data-copy-value"), "مقدار کپی شد.");
          }
        });
      });

      loginBtn.addEventListener("click", async () => {
        const token = tokenInput.value.trim();

        if (!token) {
          showMessage(loginMessage, "رمز مدیریت را وارد کن.", "error");
          return;
        }

        setToken(token);
        await testLogin();
      });

      tokenInput.addEventListener("keydown", event => {
        if (event.key === "Enter") {
          loginBtn.click();
        }
      });

      logoutBtn.addEventListener("click", () => {
        clearToken();
        showLogin();
      });

      document.querySelector("[data-sidebar-logout]")?.addEventListener("click", () => {
        logoutBtn.click();
      });

      document.querySelector("[data-focus-search]")?.addEventListener("click", () => {
        showAdminSection("posts").then(() => {
          activePostsTabBtn.click();
          searchInput.focus();
        });
      });

      sectionLinks.forEach(link => {
        link.addEventListener("click", event => {
          event.preventDefault();
          showAdminSection(link.getAttribute("data-section-link"));
        });
      });

      refreshBtn.addEventListener("click", () => {
        if (currentView === "deleted") {
          loadDeletedPosts();
          return;
        }

        loadPosts();
      });
      activePostsTabBtn.addEventListener("click", () => showAdminSection("posts"));
      deletedPostsTabBtn.addEventListener("click", () => showAdminSection("deleted"));
      [searchInput, statusFilter, mediaFilter, sortFilter].forEach(control => {
        control.addEventListener(control === searchInput ? "input" : "change", () => {
          currentPage = 1;
          renderPosts();
        });
      });

      document.querySelectorAll("[data-editor-tab]").forEach(tab => {
        tab.addEventListener("click", () => setEditorTab(tab.getAttribute("data-editor-tab")));
      });

      newPostBtn.addEventListener("click", () => showAdminSection("create"));
      clearBtn.addEventListener("click", clearEditor);
      saveBtn.addEventListener("click", savePost);
      deleteBtn.addEventListener("click", deletePost);
      duplicateBtn.addEventListener("click", duplicatePost);
      completeSeoBtn.addEventListener("click", completeMissingSeo);
      saveSiteCopyBtn.addEventListener("click", saveSiteCopy);
      reloadSiteCopyBtn.addEventListener("click", loadSiteCopy);
      openPostBtn.addEventListener("click", openPost);
      copyLinkBtn.addEventListener("click", copyLink);
      exportBtn.addEventListener("click", exportJson);
      document.querySelector("[data-export-json]")?.addEventListener("click", exportJson);
      document.querySelector("[data-copy-site-url]")?.addEventListener("click", () => copyValue(window.location.origin, "آدرس سایت کپی شد."));
      document.querySelector("[data-copy-selected-id]")?.addEventListener("click", () => copyValue(postId.value, "ID انتخاب‌شده کپی شد."));
      document.querySelector("[data-copy-selected-slug]")?.addEventListener("click", () => copyValue(postSlug.value, "slug انتخاب‌شده کپی شد."));
      document.querySelector("[data-refresh-local]")?.addEventListener("click", loadPosts);
      document.querySelector("[data-clear-token]")?.addEventListener("click", () => {
        clearToken();
        updateLocalState();
        showLogin();
        showToast("Token از مرورگر حذف شد.", "ok");
      });

      sidebarToggle?.addEventListener("click", () => {
        const expanded = sidebarToggle.getAttribute("aria-expanded") === "true";
        sidebarToggle.setAttribute("aria-expanded", String(!expanded));
        adminSidebar.classList.toggle("is-open", !expanded);
        adminDrawerBackdrop?.classList.toggle("is-open", !expanded);
      });

      adminSidebar?.addEventListener("click", event => {
        if (!event.target.closest("a")) return;
        adminSidebar.classList.remove("is-open");
        adminDrawerBackdrop?.classList.remove("is-open");
        sidebarToggle?.setAttribute("aria-expanded", "false");
      });

      adminDrawerBackdrop?.addEventListener("click", () => {
        adminSidebar?.classList.remove("is-open");
        adminDrawerBackdrop.classList.remove("is-open");
        sidebarToggle?.setAttribute("aria-expanded", "false");
      });

      uploadMediaBtn.addEventListener("click", uploadMedia);
      removeMediaBtn.addEventListener("click", removeMedia);

      bulkPublishBtn.addEventListener("click", () => bulkAction("publish"));
      bulkUnpublishBtn.addEventListener("click", () => bulkAction("unpublish"));
      bulkDeleteBtn.addEventListener("click", () => bulkAction("delete"));

      selectAllBtn.addEventListener("click", () => {
        const filtered = getFilteredPosts();

        if (selectedIds.size === filtered.length) {
          selectedIds = new Set();
        } else {
          selectedIds = new Set(filtered.map(post => Number(post.id)));
        }

        updateSelectedCount();
        renderPosts();
      });

      generateSlugBtn.addEventListener("click", () => {
        postSlug.value = makeSlugFromText(postText.value);
        markEditorDirty();
      });

      postText.addEventListener("input", () => {
        markEditorDirty();
        updateEditorStats();
        updatePreview();
      });

      postSlug.addEventListener("input", markEditorDirty);
      isPublished.addEventListener("change", () => {
        markEditorDirty();
        updatePreview();
      });
      seoTitle.addEventListener("input", () => {
        markEditorDirty();
        updatePreview();
      });
      seoDescription.addEventListener("input", () => {
        markEditorDirty();
        updatePreview();
      });
      adminNote.addEventListener("input", markEditorDirty);
      mediaFile.addEventListener("change", markEditorDirty);

      window.addEventListener("beforeunload", event => {
        if (!editorDirty) return;

        event.preventDefault();
        event.returnValue = "";
      });

      window.addEventListener("hashchange", () => {
        if (!dashboardView.classList.contains("active")) return;
        showAdminSection(sectionFromHash(), { skipHash: true });
      });

      clearEditor();

      if (getToken()) {
        testLogin();
      } else {
        showLogin();
      }
    </script>
  </body>
</html>
