---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config";

export const prerender = false;


const CATEGORY_DEFINITIONS = [
  { title: "کتاب", tags: ["کتاب"] },
  { title: "دیالوگ ها", tags: ["دیالوگ", "دیالوگ‌ها", "دیالوگ_ها"] },
  { title: "صوتی", tags: ["صوتی", "صدا", "موسیقی"] },
  { title: "شعر و متن", tags: ["متن", "متن‌ها", "متن_ها", "شعر", "اشعار", "شعرها", "شعر_ها"] },
  { title: "نقاشی", tags: ["نقاشی"] }
];

function safeDecode(value) {
  try {
    return decodeURIComponent(String(value || ""));
  } catch {
    return String(value || "");
  }
}

function normalizeTag(tag) {
  return String(tag || "")
    .replace(/^#/, "")
    .replace(/[يى]/g, "ی")
    .replace(/ك/g, "ک")
    .replace(/\u200c/g, "")
    .replace(/\s+/g, " ")
    .trim()
    .toLowerCase();
}

function findCategory(value) {
  const normalized = normalizeTag(value);

  return CATEGORY_DEFINITIONS.find((category) => {
    if (normalizeTag(category.title) === normalized) return true;
    return category.tags.some((tag) => normalizeTag(tag) === normalized);
  }) || null;
}

const requestedCategory = safeDecode(Astro.params.category).replace(/^#/, "").replace(/_/g, " ").trim();
const categoryDefinition = findCategory(requestedCategory);
const displayCategory = categoryDefinition?.title || requestedCategory || "دسته‌بندی";
const pageTitle = displayCategory + " | دسته‌بندی مطالب " + SITE.name;
const pageDescription = "همه مطالب دسته‌بندی " + displayCategory + " در مجله هنری ماهون";
const canonicalUrl = SITE.url + "/category/" + encodeURIComponent(displayCategory);

const pageConfig = {
  apiBase: SITE.workerUrl || "https://api.mahoonartmagazine.ir",
  title: displayCategory,
  description: pageDescription,
  mode: "category",
  category: displayCategory,
  pageSize: 20
};

function safeJson(value) {
  return JSON.stringify(value).replace(/</g, "\\u003c");
}
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonicalUrl}>
  <main class="mahoon-archive" data-archive-mode="category">
    <section class="mahoon-archive-hero">
      <a class="mahoon-archive-back" href="/">بازگشت به صفحه اصلی</a>
      <span>دسته‌بندی ماهون</span>
      <h1>{displayCategory}</h1>
      <p>{pageDescription}</p>
      <strong id="archiveTotal">در حال دریافت مطالب...</strong>
    </section>

    <section class="mahoon-archive-search">
      <label>
        <span>جستجو در {displayCategory}</span>
        <input id="archiveSearch" type="search" placeholder="عنوان، متن، کد مطلب یا کلیدواژه را جستجو کن..." autocomplete="off" />
      </label>
    </section>

    <section class="mahoon-archive-tabs" aria-label="دسته‌بندی‌های ماهون">
      <a data-archive-link="همه مطالب" href="/posts">همه مطالب</a>
      <a data-archive-link="کتاب" href="/category/%DA%A9%D8%AA%D8%A7%D8%A8">کتاب</a>
      <a data-archive-link="دیالوگ ها" href="/category/%D8%AF%DB%8C%D8%A7%D9%84%D9%88%DA%AF%20%D9%87%D8%A7">دیالوگ ها</a>
      <a data-archive-link="صوتی" href="/category/%D8%B5%D9%88%D8%AA%DB%8C">صوتی</a>
      <a data-archive-link="شعر و متن" href="/category/%D8%B4%D8%B9%D8%B1%20%D9%88%20%D9%85%D8%AA%D9%86">شعر و متن</a>
      <a data-archive-link="نقاشی" href="/category/%D9%86%D9%82%D8%A7%D8%B4%DB%8C">نقاشی</a>
    </section>

    <section class="mahoon-archive-results" aria-live="polite">
      <div class="mahoon-archive-count" id="archiveCount">در حال آماده‌سازی...</div>
      <div class="mahoon-archive-list" id="archiveGrid"></div>
      <div class="mahoon-archive-empty" id="archiveEmpty" hidden>نتیجه‌ای پیدا نشد.</div>
      <button class="mahoon-archive-more" id="archiveMore" type="button" hidden>نمایش ۲۰ مطلب دیگر</button>
    </section>

    <script id="archiveConfig" type="application/json" set:html={safeJson(pageConfig)}></script>
  </main>

  <script is:inline>
    (() => {
      const config = JSON.parse(document.getElementById("archiveConfig")?.textContent || "{}");
      const API_BASE = String(config.apiBase || "https://api.mahoonartmagazine.ir").replace(/\/+$/, "");
      const PAGE_SIZE = Number(config.pageSize || 20);
      const grid = document.getElementById("archiveGrid");
      const count = document.getElementById("archiveCount");
      const total = document.getElementById("archiveTotal");
      const empty = document.getElementById("archiveEmpty");
      const more = document.getElementById("archiveMore");
      const search = document.getElementById("archiveSearch");
      // mahoon-archive-safe-v3-active-tabs
      document.querySelectorAll("[data-archive-link]").forEach((link) => {
        const value = link.getAttribute("data-archive-link") || "";
        const isActive = (config.mode === "posts" && value === "همه مطالب") || (config.mode === "category" && value === config.category);

        if (isActive) {
          link.classList.add("is-active");
          link.setAttribute("aria-current", "page");
        }
      });


      let q = "";
      let offset = 0;
      let totalCount = 0;
      let hasMore = false;
      let loading = false;

      function escapeHtml(value) {
        return String(value || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
      }

      function escapeAttr(value) {
        return escapeHtml(value).replace(/'/g, "&#039;");
      }

      function toPersianNumber(value) {
        return String(value ?? "").replace(/0/g, "۰").replace(/1/g, "۱").replace(/2/g, "۲").replace(/3/g, "۳").replace(/4/g, "۴").replace(/5/g, "۵").replace(/6/g, "۶").replace(/7/g, "۷").replace(/8/g, "۸").replace(/9/g, "۹");
      }

      function formatDate(value) {
        if (!value) return "";
        try {
          return new Intl.DateTimeFormat("fa-IR", { year: "numeric", month: "long", day: "numeric" }).format(new Date(String(value).replace(" ", "T")));
        } catch {
          return "";
        }
      }

      function stripMovieCreditLines(value) {
        return String(value || "").split(/\r?\n/).filter((line) => {
          const trimmed = line.trim();
          if (!trimmed) return true;

          if (/^(?:\u{1F3A5}|\u{1F3AC}|فیلم\s*:?)\s*#?\s*.+$/iu.test(trimmed)) return false;
          if (/^(?:Queen to Play|Dogville|The Walking Dead|House\s*M\.?D\.?|The Tourist|Indecent Proposal|Funny Face)$/iu.test(trimmed)) return false;

          return true;
        }).join("\n");
      }

      function removeKnownMovieNames(value) {
        return String(value || "")
          .replace(/[\u{1F3A5}\u{1F3AC}]/gu, " ")
          .replace(/دیالوگی?\s+از\s+فیلم\s+[^،؛.!؟\n]+/giu, " ")
          .replace(/فیلم\s*:?[\s‌]+[^،؛.!؟\n]+/giu, " ")
          .replace(/Queen to Play/gi, " ")
          .replace(/Dogville/gi, " ")
          .replace(/The Walking Dead/gi, " ")
          .replace(/House\s*M\.?D\.?/gi, " ")
          .replace(/The Tourist/gi, " ")
          .replace(/Indecent Proposal/gi, " ")
          .replace(/Funny Face/gi, " ")
          .replace(/#\S+/gu, " ")
          .replace(/@mahoonartmagazine/gi, " ")
          .replace(/\s+/g, " ")
          .trim();
      }

      function cleanPublicText(value) {
        return removeKnownMovieNames(stripMovieCreditLines(value))
          .replace(/#\S+/gu, " ")
          .replace(/[\u{1F3A5}\u{1F3AC}]/gu, " ")
          .replace(/@mahoonartmagazine/gi, " ")
          .replace(/\s+/g, " ")
          .trim();
      }

      function limitWords(value, maxWords) {
        const words = String(value || "").replace(/\s+/g, " ").trim().split(" ").filter(Boolean);
        if (!words.length) return "";
        if (words.length <= maxWords) return words.join(" ");
        return words.slice(0, maxWords).join(" ") + "…";
      }

      function truncateText(value, max) {
        const source = String(value || "").replace(/\s+/g, " ").trim();
        if (!source) return "";
        return source.length <= max ? source : source.slice(0, max).trim() + "…";
      }

      function firstWords(value, maxWords) {
        return String(value || "").replace(/\s+/g, " ").trim().split(" ").filter(Boolean).slice(0, maxWords).join(" ");
      }

      function extractMovieTitle(value) {
        const lines = String(value || "").split(/\r?\n/);
        for (const line of lines) {
          const match = line.trim().match(/^(?:🎥|🎬|فیلم\s*:?)\s*#?\s*(.+)$/iu);
          if (match?.[1]) return match[1].replace(/^#/, "").trim();
        }
        return "";
      }

      function isDialoguePost(post) {
        const tagKind = primaryKindFromTags(post);
        return String(config.category || "") === "دیالوگ ها" || tagKind === "dialogue";
      }

      function normalizeMovieTitleCandidate(value) {
        return String(value || "")
          .replace(/[\u{1F3A5}\u{1F3AC}]/gu, " ")
          .replace(/^\s*دیالوگی?\s+از\s+فیلم\s*/iu, " ")
          .replace(/^\s*فیلم\s*[:：-]?\s*/iu, " ")
          .replace(/^\s*#/, "")
          .replace(/#\S+/gu, " ")
          .replace(/@mahoonartmagazine/gi, " ")
          .replace(/[،؛.!؟]+$/g, "")
          .replace(/\s+/g, " ")
          .trim();
      }

      function isValidMovieTitleCandidate(value) {
        const clean = String(value || "").trim();

        if (!clean) return false;
        if (clean.length < 2) return false;
        if (clean.length > 48) return false;
        if (/^(دیالوگ|دیالوگی|فیلم|متن|کتاب|صوتی)$/iu.test(clean)) return false;

        return true;
      }

      function extractMovieTitle(post) {
        const raw = String(post.text || "");
        const lines = raw.split(/\r?\n/).map((line) => line.trim()).filter(Boolean);

        for (const line of lines) {
          if (/[\u{1F3A5}\u{1F3AC}]/u.test(line) || /فیلم\s*[:：-]?/iu.test(line) || /دیالوگی?\s+از\s+فیلم/iu.test(line)) {
            const candidate = normalizeMovieTitleCandidate(line);

            if (isValidMovieTitleCandidate(candidate)) {
              return candidate;
            }
          }
        }

        const knownMovies = [
          "Queen to Play",
          "Dogville",
          "The Walking Dead",
          "House M.D",
          "The Tourist",
          "Indecent Proposal",
          "Funny Face"
        ];

        const lower = raw.toLowerCase();

        for (const movie of knownMovies) {
          if (lower.includes(movie.toLowerCase())) {
            return movie;
          }
        }

        return "";
      }

      function makeTitle(post) {
        const source = cleanPublicText(post.text);
        const seo = cleanPublicText(post.seo_title);

        if (isDialoguePost(post)) {
          const movieTitle = extractMovieTitle(post);

          if (movieTitle) {
            return "دیالوگی از فیلم " + limitWords(movieTitle, 6);
          }

          return "دیالوگی از ماهون";
        }

        if (seo) return limitWords(seo, 5);

        return limitWords(source, 5) || "مطلبی از ماهون";
      }

      function makeExcerpt(post) {
        const source = cleanPublicText(post.seo_description) || cleanPublicText(post.text);
        return limitWords(source, 14);
      }

      function href(post) {
        const slug = String(post.slug || post.id || "").trim();
        return "/post/" + encodeURIComponent(slug);
      }

      function normalizeArchiveToken(value) {
        return String(value || "")
          .replace(/^#/, "")
          .replace(/[يى]/g, "ی")
          .replace(/ك/g, "ک")
          .replace(/[\u200c\u200f]/g, "")
          .replace(/_/g, " ")
          .replace(/\s+/g, " ")
          .trim()
          .toLowerCase();
      }

      function postTags(post) {
        const matches = String(post.text || "").matchAll(/(^|\s)#([^\s#@]+)/gu);
        return Array.from(matches).map((match) => normalizeArchiveToken(match[2]));
      }

      function hasExactArchiveTag(post, names) {
        const tags = postTags(post);
        return names.some((name) => tags.includes(normalizeArchiveToken(name)));
      }

      function primaryKindFromTags(post) {
        if (hasExactArchiveTag(post, ["کتاب", "کتاب گویا", "کتاب_گویا", "کتابگویا"])) return "book";

        if (hasExactArchiveTag(post, [
          "دیالوگ",
          "دیالوگ ها",
          "دیالوگ_ها",
          "دیالوگ‌ها",
          "دیالوگها"
        ])) return "dialogue";

        if (hasExactArchiveTag(post, ["صوتی", "صدا", "موسیقی"])) return "audio";

        if (hasExactArchiveTag(post, ["نقاشی"])) return "art";

        if (hasExactArchiveTag(post, [
          "شعر و متن",
          "شعر_و_متن",
          "شعر",
          "اشعار",
          "شعرها",
          "شعر ها",
          "شعر_ها",
          "متن",
          "متن ها",
          "متن_ها",
          "متن‌ها"
        ])) return "text";

        return "";
      }

      function mediaKind(post) {
        const type = String(post.media_type || "").toLowerCase();
        const category = String(config.category || "");

        if (category === "کتاب") return "book";
        if (category === "دیالوگ ها") return "dialogue";
        if (category === "صوتی") return "audio";
        if (category === "شعر و متن") return "text";
        if (category === "نقاشی") return "art";

        const tagKind = primaryKindFromTags(post);

        if (tagKind) return tagKind;

        if (type === "audio" || type === "voice") return "audio";
        if (type === "video" || type === "animation") return "video";
        if (type === "photo" || type === "image") return "photo";

        return "text";
      }

      function mediaLabel(kind) {
        if (kind === "audio") return "صوتی";
        if (kind === "video") return "ویدیو";
        if (kind === "book") return "کتاب";
        if (kind === "dialogue") return "دیالوگ";
        if (kind === "art") return "نقاشی";
        if (kind === "photo") return "تصویری";
        return "متن";
      }

      function mediaIcon(kind) {
        if (kind === "audio") return "♪";
        if (kind === "video") return "▶";
        if (kind === "book") return "▤";
        if (kind === "dialogue") return "❞";
        if (kind === "art") return "◐";
        if (kind === "photo") return "◇";
        return "✎";
      }

      function mediaSrc(post) {
        const type = String(post.media_type || "").toLowerCase();
        const direct = post.photo_url || post.image_url || post.thumbnail_url || "";

        if (direct) return direct;

        const photoId = post.photo_file_id || post.thumbnail_file_id || post.thumb_file_id;

        if (photoId) {
          return API_BASE + "/media/" + encodeURIComponent(photoId);
        }

        if ((type === "photo" || type === "image") && post.media_file_id) {
          return API_BASE + "/media/" + encodeURIComponent(post.media_file_id);
        }

        return "";
      }

      function renderCard(post) {
        const title = makeTitle(post);
        const excerpt = makeExcerpt(post);
        const kind = mediaKind(post);
        const label = mediaLabel(kind);
        const image = mediaSrc(post);
        const postHref = href(post);

        const mediaInner = image
          ? '<img src="' + escapeAttr(image) + '" alt="' + escapeAttr(title) + '" loading="lazy" decoding="async" />'
          : '<span class="mahoon-archive-card__icon" aria-hidden="true">' + escapeHtml(mediaIcon(kind)) + '</span>';

        return '<article class="mahoon-archive-card mahoon-archive-card--' + escapeAttr(kind) + '">' +
          '<a class="mahoon-archive-card__media ' + (!image ? 'mahoon-archive-card__media--placeholder' : '') + '" data-kind="' + escapeAttr(kind) + '" href="' + escapeAttr(postHref) + '">' +
            mediaInner +
            '<span class="mahoon-archive-card__badge">' + escapeHtml(label) + '</span>' +
          '</a>' +
          '<div class="mahoon-archive-card__body">' +
            '<div class="mahoon-archive-card__meta">' +
              '<span class="mahoon-archive-date">' + escapeHtml(formatDate(post.created_at)) + '</span>' +
              '<span class="mahoon-archive-kind">' + escapeHtml(label) + '</span>' +
            '</div>' +
            '<h2><a href="' + escapeAttr(postHref) + '">' + escapeHtml(title) + '</a></h2>' +
            '<p>' + escapeHtml(excerpt) + '</p>' +
            '<a class="mahoon-archive-cta" href="' + escapeAttr(postHref) + '">ادامه مطلب</a>' +
          '</div>' +
        '</article>';
      }

      async function load(reset = false) {
        if (loading) return;
        loading = true;

        if (reset) {
          offset = 0;
          grid.innerHTML = "";
          more.hidden = true;
        }

        count.textContent = "در حال دریافت مطالب...";

        const url = new URL(API_BASE + "/public/posts-v1");
        url.searchParams.set("limit", String(PAGE_SIZE));
        if (config.category) url.searchParams.set("category", config.category);
        url.searchParams.set("offset", String(offset));
        if (q) url.searchParams.set("q", q);

        try {
          const res = await fetch(url.toString(), { headers: { Accept: "application/json" }, cache: "no-store" });
          if (!res.ok) throw new Error("HTTP " + res.status);
          const data = await res.json();
          const posts = Array.isArray(data.posts) ? data.posts : [];

          totalCount = Number(data.total || 0);
          hasMore = Boolean(data.has_more);
          offset = Number(data.next_offset || offset + posts.length);

          grid.insertAdjacentHTML("beforeend", posts.map(renderCard).join(""));
          empty.hidden = totalCount > 0;
          more.hidden = !hasMore;
          count.textContent = "نمایش " + toPersianNumber(Math.min(offset, totalCount)) + " مطلب از " + toPersianNumber(totalCount);
          total.textContent = toPersianNumber(totalCount) + " مطلب";
        } catch (error) {
          console.error(error);
          count.textContent = "خطا در دریافت مطالب";
          empty.hidden = false;
          empty.textContent = "دریافت مطالب انجام نشد.";
          more.hidden = true;
        } finally {
          loading = false;
        }
      }

      let timer = null;
      search.addEventListener("input", () => {
        clearTimeout(timer);
        timer = setTimeout(() => {
          q = search.value.trim();
          load(true);
        }, 300);
      });

      more.addEventListener("click", () => load(false));
      load(true);
    })();
  </script>

  <style is:global>
    .mahoon-archive {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
      padding: 28px 0 72px;
      direction: rtl;
    }

    .mahoon-archive-hero {
      position: relative;
      overflow: hidden;
      isolation: isolate;
      border-radius: 34px;
      padding: 42px;
      background:
        radial-gradient(circle at 15% 18%, rgba(255, 248, 239, 0.16), transparent 28%),
        radial-gradient(circle at 88% 78%, rgba(255, 219, 176, 0.12), transparent 30%),
        linear-gradient(rgba(255, 253, 248, 0.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 253, 248, 0.04) 1px, transparent 1px),
        linear-gradient(145deg, #5a0f0f, #2a1713);
      background-size: auto, auto, 42px 42px, 42px 42px, auto;
      color: #fff8ef;
      box-shadow: 0 24px 64px rgba(75, 13, 13, 0.18);
    }

    .mahoon-archive-hero::after {
      content: "";
      position: absolute;
      left: -70px;
      bottom: -120px;
      width: 270px;
      height: 270px;
      border-radius: 999px;
      border: 1px solid rgba(255, 248, 239, 0.13);
      background: rgba(255, 248, 239, 0.035);
      pointer-events: none;
      z-index: -1;
    }

    .mahoon-archive-back,
    .mahoon-archive-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: #fff8ef;
      color: #4b0d0d;
      min-height: 40px;
      padding: 8px 14px;
      text-decoration: none;
      font-weight: 900;
    }

    .mahoon-archive-hero span {
      display: block;
      margin-top: 24px;
      color: rgba(255, 248, 239, 0.64);
      font-weight: 900;
    }

    .mahoon-archive-hero h1 {
      margin: 4px 0 10px;
      font-size: clamp(42px, 7vw, 76px);
      line-height: 1.22;
      letter-spacing: -0.035em;
    }

    .mahoon-archive-hero p {
      max-width: 680px;
      margin: 0;
      color: rgba(255, 248, 239, 0.78);
      line-height: 2;
    }

    .mahoon-archive-hero strong {
      display: inline-flex;
      margin-top: 20px;
      border-radius: 999px;
      border: 1px solid rgba(255, 248, 239, 0.16);
      background: rgba(255, 248, 239, 0.1);
      padding: 8px 16px;
    }

    .mahoon-archive-search,
    .mahoon-archive-tabs {
      margin: 18px 0;
      border-radius: 26px;
      background: rgba(255, 253, 248, 0.86);
      border: 1px solid rgba(75, 13, 13, 0.12);
      box-shadow: 0 18px 44px rgba(75, 13, 13, 0.07);
      backdrop-filter: blur(14px);
    }

    .mahoon-archive-search {
      padding: 20px;
    }

    .mahoon-archive-search label {
      display: grid;
      gap: 10px;
    }

    .mahoon-archive-search span {
      color: #4b0d0d;
      font-weight: 900;
    }

    .mahoon-archive-search input {
      width: 100%;
      min-height: 58px;
      border: 1px solid rgba(75, 13, 13, 0.18);
      border-radius: 18px;
      background: #fffdf8;
      color: #331313;
      padding: 0 18px;
      font: inherit;
      font-size: 16px;
      outline: none;
    }

    .mahoon-archive-tabs {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      padding: 12px;
      scrollbar-width: none;
    }

    .mahoon-archive-tabs::-webkit-scrollbar {
      display: none;
    }

    .mahoon-archive-tabs a {
      flex: 0 0 auto;
      min-height: 42px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      padding: 8px 15px;
      color: rgba(75, 13, 13, 0.72);
      background: rgba(245, 236, 224, 0.7);
      text-decoration: none;
      font-weight: 900;
      white-space: nowrap;
      border: 1px solid rgba(75, 13, 13, 0.08);
    }

    .mahoon-archive-tabs a.is-active {
      color: #fff8ef;
      background: #5a0f0f;
      box-shadow: 0 14px 28px rgba(75, 13, 13, 0.16);
