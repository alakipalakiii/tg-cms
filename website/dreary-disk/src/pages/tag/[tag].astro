---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config";
import {
  fetchPublicTagPage,
  normalizeTagValue,
  renderTagCardsHtml,
  safeDecodeTagValue,
  toPersianTagNumber
} from "../../lib/tag";

export const prerender = false;

// mahoon-tag-server-pagination-seo-v1
const PAGE_SIZE = 20;
const apiBase = (SITE.workerUrl || "https://api.mahoonartmagazine.ir").replace(/\/+$/, "");
const siteUrl = SITE.url.replace(/\/+$/, "");
const requestedTag = safeDecodeTagValue(Astro.params.tag)
  .replace(/^#/, "")
  .replace(/_/g, " ")
  .trim();
const normalizedTag = normalizeTagValue(requestedTag);
const validTagValue = Boolean(normalizedTag);
const displayTag = requestedTag || "برچسب";

const initialTagPage = validTagValue
  ? await fetchPublicTagPage({
      apiBase,
      tag: displayTag,
      limit: PAGE_SIZE,
      offset: 0,
      timeoutMs: 6000
    })
  : {
      ok: true,
      status: 404,
      posts: [],
      total: 0,
      limit: PAGE_SIZE,
      offset: 0,
      nextOffset: 0,
      hasMore: false,
      error: ""
    };

const temporaryFailure = validTagValue && !initialTagPage.ok;
const tagExists = validTagValue && initialTagPage.ok && initialTagPage.total > 0;

if (temporaryFailure) {
  Astro.response.status = 503;
  Astro.response.statusText = "Service Unavailable";
  Astro.response.headers.set("Retry-After", "60");
} else if (!tagExists) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}

const pageTitle = temporaryFailure
  ? "دریافت برچسب موقتاً ناموفق"
  : tagExists
    ? "#" + displayTag
    : "برچسب پیدا نشد";
const pageDescription = temporaryFailure
  ? "دریافت مطالب این برچسب موقتاً امکان‌پذیر نیست."
  : tagExists
    ? "مطالب منتشرشده با برچسب " + displayTag + " در مجله هنری ماهون"
    : "برچسب " + displayTag + " در مجله هنری ماهون پیدا نشد.";
const canonicalUrl = tagExists
  ? siteUrl + "/tag/" + encodeURIComponent(displayTag)
  : siteUrl + Astro.url.pathname;
const initialCardsHtml = tagExists
  ? renderTagCardsHtml(initialTagPage.posts, apiBase)
  : "";
const initialShown = Math.min(initialTagPage.nextOffset, initialTagPage.total);
const initialCountText = tagExists
  ? "نمایش " + toPersianTagNumber(initialShown) + " مطلب از " + toPersianTagNumber(initialTagPage.total)
  : "۰ مطلب";

const tagConfig = {
  apiBase,
  tag: displayTag,
  pageSize: PAGE_SIZE,
  validTag: tagExists,
  initialTotal: initialTagPage.total,
  initialNextOffset: initialTagPage.nextOffset,
  initialHasMore: initialTagPage.hasMore
};

function safeJson(value: unknown) {
  return JSON.stringify(value).replace(/</g, "\\u003c");
}
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonicalUrl}>
  {!tagExists && <meta slot="head" name="robots" content="noindex,follow" />}

  <main class="mahoon-tag-archive">
    <section class="mahoon-tag-hero">
      <a class="mahoon-tag-back" href="/">بازگشت به صفحه اصلی</a>
      <span>آرشیو برچسب‌های ماهون</span>
      <h1 dir="auto">#{displayTag}</h1>
      <p>
        {temporaryFailure
          ? "دریافت مطالب این برچسب موقتاً امکان‌پذیر نیست."
          : tagExists
            ? "همه روایت‌های مرتبط با این برچسب در مجله هنری ماهون."
            : "هنوز مطلبی برای این برچسب پیدا نشده است."}
      </p>
      <strong>{toPersianTagNumber(initialTagPage.total)} مطلب</strong>
    </section>

    {tagExists ? (
      <>
        <section class="mahoon-tag-search">
          <label for="tagSearchInput">
            <span>جستجو در مطالب این برچسب</span>
            <input
              id="tagSearchInput"
              type="search"
              placeholder="عنوان، متن یا کلمه مورد نظر را جستجو کن..."
              autocomplete="off"
            />
          </label>
        </section>

        <nav class="mahoon-tag-navigation" aria-label="دسته‌بندی‌های ماهون">
          <a href="/posts">همه مطالب</a>
          <a href="/category/کتاب">کتاب</a>
          <a href="/category/دیالوگ ها">دیالوگ ها</a>
          <a href="/category/صوتی">صوتی</a>
          <a href="/category/شعر و متن">شعر و متن</a>
          <a href="/category/نقاشی">نقاشی</a>
        </nav>

        <section class="mahoon-tag-results" aria-live="polite">
          <div class="mahoon-tag-count" id="tagVisibleCount">{initialCountText}</div>
          <div class="mahoon-tag-grid" id="tagGrid" set:html={initialCardsHtml}></div>
          <div
            class="mahoon-tag-empty"
            id="tagEmpty"
            hidden={initialTagPage.total > 0}
            data-empty-title="مطلبی پیدا نشد"
            data-empty-description="عبارت دیگری را جستجو کن."
          ></div>
          <button class="mahoon-tag-more" id="tagMore" type="button" hidden={!initialTagPage.hasMore}>
            نمایش ۲۰ مطلب دیگر
          </button>
        </section>
      </>
    ) : (
      <section class="mahoon-tag-not-found">
        <span>{temporaryFailure ? "اختلال موقت" : "نتیجه‌ای پیدا نشد"}</span>
        <h2>{temporaryFailure ? "دریافت مطالب انجام نشد" : "مطلبی برای این برچسب وجود ندارد"}</h2>
        <p>
          {temporaryFailure
            ? "لطفاً کمی بعد دوباره این صفحه را باز کن."
            : "از آرشیو کامل ماهون می‌توانی روایت‌های دیگر را دنبال کنی."}
        </p>
        <a href={temporaryFailure ? Astro.url.pathname : "/posts"}>
          {temporaryFailure ? "تلاش دوباره" : "مشاهده همه مطالب"}
        </a>
      </section>
    )}

    <script id="tagArchiveConfig" type="application/json" set:html={safeJson(tagConfig)}></script>
  </main>

  <script is:inline>
    (() => {
      const config = JSON.parse(document.getElementById("tagArchiveConfig")?.textContent || "{}");
      if (config.validTag === false) return;

      const API_BASE = String(config.apiBase || "https://api.mahoonartmagazine.ir").replace(/\/+$/, "");
      const PAGE_SIZE = Number(config.pageSize || 20);
      const input = document.getElementById("tagSearchInput");
      const count = document.getElementById("tagVisibleCount");
      const grid = document.getElementById("tagGrid");
      const empty = document.getElementById("tagEmpty");
      const more = document.getElementById("tagMore");

      let q = "";
      let offset = Number(config.initialNextOffset || 0);
      let totalCount = Number(config.initialTotal || 0);
      let hasMore = Boolean(config.initialHasMore);
      let loading = false;
      let timer = 0;

      function escapeHtml(value) {
        return String(value || "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      function normalize(value) {
        return String(value || "")
          .replace(/^#/, "")
          .replace(/[يى]/g, "ی")
          .replace(/ك/g, "ک")
          .replace(/[\u200c\u200f]/g, "")
          .replace(/_/g, " ")
          .replace(/\s+/g, " ")
          .trim()
          .toLowerCase();
      }

      function persianNumber(value) {
        return new Intl.NumberFormat("fa-IR").format(Number(value || 0));
      }

      function removeEmoji(value) {
        return String(value || "").replace(/[\p{Extended_Pictographic}\uFE0F]/gu, " ").replace(/\s+/g, " ").trim();
      }

      function movieTitle(value) {
        for (const rawLine of String(value || "").split(/\r?\n/)) {
          const match = rawLine.trim().match(/^(?:🎥|🎬|فیلم\s*:?)\s*#?\s*(.+)$/iu);
          if (!match?.[1]) continue;
          const title = match[1].replace(/[🔹•●▪▫◦]+/gu, "").replace(/@mahoonartmagazine/giu, "").replace(/^#/, "").replace(/_/g, " ").replace(/\s+/g, " ").trim();
          if (title) return title;
        }
        return "";
      }

      function rawTags(text) {
        return Array.from(String(text || "").matchAll(/(^|\s)#([^\s#]+)/gu)).map((match) => match[2]).filter(Boolean);
      }

      function hasTag(text, variants) {
        const expected = new Set(variants.map(normalize));
        return rawTags(text).some((tag) => expected.has(normalize(tag)));
      }

      function dialogue(post) {
        return hasTag(post.text, ["دیالوگ", "دیالوگ‌ها", "دیالوگ_ها", "دیالوگ ها", "دیالوگها"]);
      }

      function clean(value) {
        return removeEmoji(String(value || "")
          .replace(/\u{1F539}?\s*@mahoonartmagazine/giu, "")
          .replace(/\u{1F539}/gu, "")
          .replace(/(^|\n)\s*(?:🎥|🎬|فیلم\s*:?)\s*#?\s*[^\n]+/giu, "\n")
          .replace(/https?:\/\/[^\s]+/giu, "")
          .replace(/@[a-zA-Z0-9_]+/g, "")
          .replace(/(^|\s)#([^\s#]+)/gu, " ")
          .replace(/[•●▪▫◦]/g, "")
          .replace(/_/g, " ")
          .replace(/\s+/g, " ")
          .trim());
      }

      function words(value, maximum) {
        const list = String(value || "").replace(/\s+/g, " ").trim().split(" ").filter(Boolean);
        return list.length <= maximum ? list.join(" ") : list.slice(0, maximum).join(" ") + "…";
      }

      function title(post) {
        const movie = movieTitle(post.text);
        if (movie && dialogue(post)) return "دیالوگی از فیلم " + words(movie, 6);
        return words(clean(post.seo_title), 5) || words(clean(post.text), 5) || "مطلبی از ماهون";
      }

      function excerpt(post) {
        const movie = movieTitle(post.text);
        let source = clean(post.seo_description || post.text || "");
        if (movie) source = source.replace(new RegExp(movie.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "giu"), " ");
        return words(source.replace(/\s+/g, " ").trim(), 14) || "روایتی تازه از مجله هنری ماهون";
      }

      function date(value) {
        try {
          return new Intl.DateTimeFormat("fa-IR", { year: "numeric", month: "long", day: "numeric" }).format(new Date(String(value || "").replace(" ", "T")));
        } catch { return String(value || ""); }
      }

      function kind(post) {
        if (hasTag(post.text, ["کتاب", "کتاب گویا", "کتاب_گویا", "کتابگویا"])) return "book";
        if (dialogue(post)) return "dialogue";
        if (hasTag(post.text, ["صوتی", "صدا", "موسیقی"])) return "audio";
        if (hasTag(post.text, ["نقاشی"])) return "art";
        if (hasTag(post.text, ["شعر و متن", "شعر_و_متن", "شعر", "اشعار", "شعرها", "شعر ها", "شعر_ها", "متن", "متن‌ها", "متن ها", "متن_ها"])) return "text";
        const type = String(post.media_type || "").toLowerCase();
        if (["audio", "voice"].includes(type)) return "audio";
        if (["video", "animation"].includes(type)) return "video";
        if (["photo", "image"].includes(type)) return "photo";
        return "text";
      }

      function label(value) {
        return ({ book: "کتاب", dialogue: "دیالوگ", audio: "صوتی", art: "نقاشی", video: "ویدیو", photo: "تصویری", text: "متن" })[value] || "متن";
      }

      function icon(value) {
        return ({ book: "▤", dialogue: "❞", audio: "♪", art: "◐", video: "▶", photo: "◇", text: "✎" })[value] || "✎";
      }

      function href(post) {
        return "/post/" + encodeURIComponent(String(post.slug || post.id || ""));
      }

      function media(post) {
        const direct = post.media_url || post.photo_url || post.image_url || post.thumbnail_url || post.file_url;
        if (direct) return String(direct);
        const id = post.photo_file_id || post.media_file_id || post.file_id || post.telegram_file_id;
        return id ? API_BASE + "/media/" + encodeURIComponent(String(id)) : "";
      }

      function renderCard(post) {
        const cardKind = kind(post);
        const cardLabel = label(cardKind);
        const cardTitle = title(post);
        const cardExcerpt = excerpt(post);
        const cardHref = href(post);
        const image = media(post);
        const mediaInner = image
          ? '<img src="' + escapeHtml(image) + '" alt="' + escapeHtml(cardTitle) + '" width="720" height="430" loading="lazy" decoding="async">'
          : '<span class="mahoon-tag-card__icon" aria-hidden="true">' + escapeHtml(icon(cardKind)) + '</span>';

        return '<article class="mahoon-tag-card mahoon-tag-card--' + escapeHtml(cardKind) + '" data-tag-card>' +
          '<a class="mahoon-tag-card__media ' + (image ? "" : "mahoon-tag-card__media--placeholder") + '" href="' + escapeHtml(cardHref) + '">' +
            mediaInner + '<span class="mahoon-tag-card__badge">' + escapeHtml(cardLabel) + '</span>' +
          '</a>' +
          '<div class="mahoon-tag-card__body">' +
            '<div class="mahoon-tag-card__meta"><span>' + escapeHtml(date(post.created_at)) + '</span><span>' + escapeHtml(cardLabel) + '</span></div>' +
            '<h2><a href="' + escapeHtml(cardHref) + '">' + escapeHtml(cardTitle) + '</a></h2>' +
            '<p>' + escapeHtml(cardExcerpt) + '</p>' +
            '<a class="mahoon-tag-card__cta" href="' + escapeHtml(cardHref) + '">ادامه مطلب</a>' +
          '</div>' +
        '</article>';
      }

      function updateState() {
        if (count) count.textContent = "نمایش " + persianNumber(Math.min(offset, totalCount)) + " مطلب از " + persianNumber(totalCount);
        if (empty) {
          empty.hidden = totalCount !== 0;
          empty.replaceChildren();

          if (totalCount === 0) {
            const title = document.createElement("strong");
            title.textContent = String(empty.dataset.emptyTitle || "مطلبی پیدا نشد");

            const description = document.createElement("span");
            description.textContent = String(empty.dataset.emptyDescription || "عبارت دیگری را جستجو کن.");

            empty.append(title, description);
          }
        }
        if (more) {
          more.hidden = !hasMore;
          more.disabled = loading;
          more.textContent = loading ? "در حال دریافت..." : "نمایش ۲۰ مطلب دیگر";
        }
      }

      async function request(reset) {
        if (loading) return;
        loading = true;
        let failed = false;
        updateState();

        try {
          const url = new URL(API_BASE + "/public/tag-posts-v1");
          url.searchParams.set("tag", String(config.tag || ""));
          url.searchParams.set("limit", String(PAGE_SIZE));
          url.searchParams.set("offset", String(reset ? 0 : offset));
          if (q) url.searchParams.set("q", q);

          const response = await fetch(url, { headers: { Accept: "application/json" }, cache: "no-store" });
          const payload = await response.json();
          if (!response.ok || payload?.ok === false) throw new Error(payload?.error || "HTTP " + response.status);

          const posts = Array.isArray(payload.posts) ? payload.posts : [];
          if (grid) {
            const html = posts.map(renderCard).join("");
            if (reset) grid.innerHTML = html;
            else grid.insertAdjacentHTML("beforeend", html);
          }

          totalCount = Number(payload.total || 0);
          offset = Number(payload.next_offset ?? (reset ? posts.length : offset + posts.length));
          hasMore = Boolean(payload.has_more);
        } catch (error) {
          failed = true;
          console.error(error);
          if (count) count.textContent = "دریافت مطالب انجام نشد.";
        } finally {
          loading = false;

          if (failed) {
            if (more) {
              more.disabled = false;
              more.textContent = "تلاش دوباره";
            }
          } else {
            updateState();
          }
        }
      }

      input?.addEventListener("input", () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          q = String(input.value || "").trim();
          request(true);
        }, 300);
      });

      more?.addEventListener("click", () => request(false));
      updateState();
    })();
  </script>

  <style is:global>
    .mahoon-tag-archive {
      direction: rtl;
      width: min(1180px, calc(100% - 32px));
      min-height: 70vh;
      margin: 0 auto;
      padding: 30px 0 84px;
    }

    .mahoon-tag-hero {
      position: relative;
      min-height: 310px;
      overflow: hidden;
      border-radius: 32px;
      padding: 34px;
      color: #fff8ef;
      background:
        linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
        radial-gradient(circle at 15% 85%, rgba(255, 248, 239, 0.08), transparent 28%),
        linear-gradient(135deg, #73191c, #32100e);
      background-size: 54px 54px, 54px 54px, auto, auto;
      box-shadow: 0 28px 78px rgba(75, 13, 13, 0.2);
    }

    .mahoon-tag-hero::after {
      content: "";
      position: absolute;
      left: -90px;
      bottom: -110px;
      width: 250px;
      height: 250px;
      border-radius: 50%;
      border: 1px solid rgba(255, 248, 239, 0.13);
    }

    .mahoon-tag-back {
      position: relative;
      z-index: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      border-radius: 999px;
      padding: 8px 15px;
      color: #4b0d0d;
      background: #fff8ef;
      text-decoration: none;
      font-size: 13px;
      font-weight: 900;
    }

    .mahoon-tag-hero > span {
      position: relative;
      z-index: 1;
      display: block;
      margin-top: 26px;
      color: rgba(255, 248, 239, 0.72);
      font-size: 13px;
      font-weight: 900;
    }

    .mahoon-tag-hero h1 {
      position: relative;
      z-index: 1;
      max-width: 820px;
      margin: 6px 0 12px;
      color: #fff8ef;
      font-size: clamp(38px, 6vw, 68px);
      line-height: 1.35;
      overflow-wrap: anywhere;
    }

    .mahoon-tag-hero p {
      position: relative;
      z-index: 1;
      max-width: 700px;
      margin: 0;
      color: rgba(255, 248, 239, 0.84);
      font-size: 15px;
      line-height: 2;
    }

    .mahoon-tag-hero strong {
      position: relative;
      z-index: 1;
      display: inline-flex;
      margin-top: 20px;
      border-radius: 999px;
      padding: 8px 14px;
      color: #fff8ef;
      background: rgba(255, 248, 239, 0.11);
      border: 1px solid rgba(255, 248, 239, 0.16);
      font-size: 14px;
    }

    .mahoon-tag-search {
      margin-top: 16px;
      border-radius: 28px;
      padding: 18px;
      background: rgba(255, 253, 248, 0.94);
      box-shadow: 0 18px 48px rgba(75, 13, 13, 0.07);
    }

    .mahoon-tag-search label {
      display: grid;
      gap: 10px;
      color: #4b0d0d;
      font-size: 14px;
      font-weight: 900;
    }

    .mahoon-tag-search input {
      width: 100%;
      min-height: 54px;
      border: 1px solid rgba(75, 13, 13, 0.15);
      border-radius: 17px;
      padding: 0 16px;
      color: #2a1713;
      background: #fffdf8;
      font: inherit;
      outline: none;
    }

    .mahoon-tag-search input:focus {
      border-color: rgba(90, 15, 15, 0.42);
      box-shadow: 0 0 0 4px rgba(90, 15, 15, 0.06);
    }

    .mahoon-tag-navigation {
      display: flex;
      gap: 9px;
      margin: 14px 0 18px;
      overflow-x: auto;
      border-radius: 26px;
      padding: 10px;
      background: rgba(255, 253, 248, 0.94);
      box-shadow: 0 16px 38px rgba(75, 13, 13, 0.05);
      scrollbar-width: none;
    }

    .mahoon-tag-navigation::-webkit-scrollbar {
      display: none;
    }

    .mahoon-tag-navigation a {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
      border: 1px solid rgba(75, 13, 13, 0.1);
      border-radius: 999px;
      padding: 7px 14px;
      color: #6d3f39;
      background: #fbf3e8;
      text-decoration: none;
      font-size: 13px;
      font-weight: 900;
    }

    .mahoon-tag-navigation a:first-child {
      color: #fff8ef;
      background: #6d0f14;
      border-color: transparent;
    }

    .mahoon-tag-count {
      margin: 0 0 17px;
      color: #8a625a;
      font-size: 14px;
      font-weight: 800;
    }

    .mahoon-tag-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      align-items: stretch;
    }

    .mahoon-tag-card {
      position: relative;
      min-width: 0;
      height: 100%;
      overflow: hidden;
      border: 1px solid rgba(75, 13, 13, 0.105);
      border-radius: 26px;
      background:
        radial-gradient(circle at 92% 92%, rgba(90, 15, 15, 0.045), transparent 30%),
        linear-gradient(180deg, #fffdf8, #faf1e8);
      box-shadow: 0 18px 48px rgba(75, 13, 13, 0.085);
      display: flex;
      flex-direction: column;
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        border-color 0.2s ease;
    }

    .mahoon-tag-card[hidden] {
      display: none !important;
    }

    .mahoon-tag-card:hover {
      transform: translateY(-3px);
      border-color: rgba(75, 13, 13, 0.2);
      box-shadow: 0 24px 62px rgba(75, 13, 13, 0.12);
    }

    .mahoon-tag-card::after {
      content: "";
      position: absolute;
      left: -74px;
      bottom: -82px;
      width: 148px;
      height: 148px;
      border-radius: 999px;
      border: 1px solid rgba(75, 13, 13, 0.075);
      pointer-events: none;
    }

    .mahoon-tag-card__media {
      position: relative;
      display: block;
      overflow: hidden;
      aspect-ratio: 16 / 9.6;
      line-height: 0;
      background:
        radial-gradient(circle at 20% 18%, rgba(255, 248, 239, 0.86), transparent 25%),
        linear-gradient(145deg, #f5ece0, #e2c9bf);
      border-bottom: 1px solid rgba(75, 13, 13, 0.075);
      text-decoration: none;
    }

    .mahoon-tag-card__media img {
