---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config";
import { getPosts, parsePostContent, formatDate, makeExcerpt, makeTitle } from "../../lib/posts";

const SYSTEM_TAGS = new Set(
  [
    "کتاب",
    "دیالوگ",
    "دیالوگ‌ها",
    "دیالوگ_ها",
    "صوتی",
    "صدا",
    "موسیقی",
    "متن",
    "متن‌ها",
    "متن_ها",
    "شعر",
    "اشعار",
    "شعرها",
    "شعر_ها",
    "نقاشی"
  ].map(normalizeTag)
);

function safeDecode(value: string) {
  try {
    return decodeURIComponent(value || "");
  } catch {
    return value || "";
  }
}

function normalizeTag(value: string) {
  return String(value || "")
    .replace(/^#/, "")
    .replace(/[يى]/g, "ی")
    .replace(/ك/g, "ک")
    .replace(/\u200c/g, "")
    .replace(/\s+/g, " ")
    .trim()
    .toLowerCase();
}

function cleanUiText(value: string | null | undefined) {
  return String(value || "")
    .replace(/\u{1F539}?\s*@mahoonartmagazine/giu, "")
    .replace(/\u{1F539}/gu, "")
    .replace(/https?:\/\/[^\s]+/giu, "")
    .replace(/@[a-zA-Z0-9_]+/g, "")
    .replace(/(^|\s)#([^\s#]+)/gu, " ")
    .replace(/[•●▪▫◦]/g, "")
    .replace(/\n{3,}/g, "\n\n")
    .replace(/[ \t]{2,}/g, " ")
    .trim();
}

const rawTag = Astro.params.tag || "";
const tag = safeDecode(rawTag).replace(/^#/, "").trim();
const normalizedCurrentTag = normalizeTag(tag);

const rawPosts = await getPosts();

function makeTagPostTitle(post: (typeof rawPosts)[number], parsed: ReturnType<typeof parsePostContent>) {
  const seoTitle = String(post.seo_title || "").trim();
  if (seoTitle) return seoTitle;

  const parsedTitle = cleanUiText(makeTitle(post.text));
  if (parsedTitle) return parsedTitle;

  const firstLine = cleanUiText(parsed.cleanText)
    .split("\n")
    .map((line) => line.trim())
    .find(Boolean);
  if (firstLine) return firstLine.length > 74 ? `${firstLine.slice(0, 74).trim()}...` : firstLine;

  const excerpt = cleanUiText(makeExcerpt(post.text, 74));
  return excerpt || "مطلب ماهون";
}

const posts = rawPosts
  .map((post) => {
    const parsed = parsePostContent(post.text);
    const publicHashtags = parsed.hashtags.filter((item) => !SYSTEM_TAGS.has(normalizeTag(item)));

    return {
      ...post,
      title: makeTagPostTitle(post, parsed),
      excerpt: cleanUiText(makeExcerpt(post.text, 150)),
      content: cleanUiText(parsed.cleanText),
      hashtags: publicHashtags,
      allHashtags: parsed.hashtags,
      searchText: [post.seo_title, post.text, post.slug].filter(Boolean).join(" "),
      date: formatDate(post.created_at)
    };
  })
  .filter((post) =>
    post.allHashtags.some((item) => normalizeTag(item) === normalizedCurrentTag)
  );

const title = tag ? `#${tag}` : "برچسب";
const description = tag
  ? `مطالب مرتبط با برچسب ${tag} در مجله هنری ماهون`
  : SITE.description;
---

<BaseLayout title={title} description={description}>
  <main class="page-section">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">خانه</a>
        <span> / </span>
        <span>برچسب</span>
      </div>

      <section class="page-card" style="margin-bottom: 28px;">
        <span class="tag">برچسب ماهون</span>

        <h1>{title}</h1>

        <p>
          {posts.length > 0
            ? `${posts.length} مطلب مرتبط با این برچسب در مجله هنری ماهون منتشر شده است.`
            : "هنوز مطلبی برای این برچسب پیدا نشد."
          }
        </p>
      </section>

      {posts.length > 0 ? (
        <div class="public-list">
          {posts.map((post) => (
            <a
              class="public-list-row"
              href={`/post/${encodeURIComponent(post.slug)}`}
              data-post-card
              data-search={post.searchText}
            >
              <div class="public-list-row__text">
                <strong class="public-list-row__title">{post.title}</strong>
                <span class="public-list-row__excerpt">{post.excerpt}</span>
                <span class="public-list-row__meta">{post.date}</span>
              </div>

              {post.photo_url && (
                <img class="public-list-row__thumb" src={post.photo_url} alt={post.title} loading="lazy" />
              )}

              <span class="public-list-row__arrow" aria-hidden="true">‹</span>
            </a>
          ))}
        </div>
      ) : (
        <section class="not-found">
          <h1>مطلبی پیدا نشد</h1>
          <p>برای این برچسب هنوز مطلبی در سایت ثبت نشده است.</p>
          <a class="btn btn-primary" href="/">بازگشت به خانه</a>
        </section>
      )}
    </div>
  </main>
</BaseLayout>
