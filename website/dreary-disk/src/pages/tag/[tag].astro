---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config";

export const prerender = false;

type RawPost = {
  id?: number | string;
  text?: string | null;
  slug?: string | null;
  created_at?: string | null;
  media_type?: string | null;
  media_url?: string | null;
  photo_url?: string | null;
  photo_file_id?: string | null;
  media_file_id?: string | null;
  file_id?: string | null;
  telegram_file_id?: string | null;
  image_url?: string | null;
  thumbnail_url?: string | null;
  file_url?: string | null;
  seo_title?: string | null;
  seo_description?: string | null;
};

type Post = Required<Pick<RawPost, "text" | "slug" | "created_at">> &
  RawPost & {
    id: number;
  };

type CardKind =
  | "book"
  | "dialogue"
  | "audio"
  | "art"
  | "text"
  | "video"
  | "photo";

const rawTag = Astro.params.tag || "";
const workerUrl = SITE.workerUrl.replace(/\/+$/, "");
const siteUrl = SITE.url.replace(/\/+$/, "");

function safeDecode(value: string): string {
  try {
    return decodeURIComponent(value || "");
  } catch {
    return value || "";
  }
}

function normalizeTag(tag: string | null | undefined): string {
  return String(tag || "")
    .replace(/^#/, "")
    .replace(/[يى]/g, "ی")
    .replace(/ك/g, "ک")
    .replace(/[\u200c\u200f]/g, "")
    .replace(/_/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .toLowerCase();
}

function removeEmoji(value: string | null | undefined): string {
  return String(value || "")
    .replace(/[\p{Extended_Pictographic}\uFE0F]/gu, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function extractMovieTitle(value: string | null | undefined): string {
  const lines = String(value || "").split(/\r?\n/);

  for (const rawLine of lines) {
    const line = rawLine.trim();
    const match = line.match(/^(?:🎥|🎬|فیلم\s*:?)\s*#?\s*(.+)$/iu);

    if (!match) continue;

    const title = match[1]
      .replace(/[🔹•●▪▫◦]+/gu, "")
      .replace(/@mahoonartmagazine/giu, "")
      .replace(/^#/, "")
      .replace(/_/g, " ")
      .replace(/\s+/g, " ")
      .trim();

    if (title) return title;
  }

  return "";
}

function getRawHashTags(text: string | null | undefined): string[] {
  return Array.from(String(text || "").matchAll(/(^|\s)#([^\s#]+)/gu))
    .map((match) => match[2])
    .filter(Boolean);
}

function getTags(text: string | null | undefined): string[] {
  const tags = getRawHashTags(text);
  const movieTitle = extractMovieTitle(text);

  if (movieTitle) tags.push(movieTitle);

  return Array.from(new Set(tags.filter(Boolean)));
}

function hasExactTag(
  text: string | null | undefined,
  variants: string[]
): boolean {
  const expected = new Set(variants.map(normalizeTag));

  return getRawHashTags(text).some((tag) =>
    expected.has(normalizeTag(tag))
  );
}

function hasDialogueTag(text: string | null | undefined): boolean {
  return hasExactTag(text, [
    "دیالوگ",
    "دیالوگ‌ها",
    "دیالوگ_ها",
    "دیالوگ ها",
    "دیالوگها"
  ]);
}

function cleanPublicText(value: string | null | undefined): string {
  return removeEmoji(
    String(value || "")
      .replace(/\u{1F539}?\s*@mahoonartmagazine/giu, "")
      .replace(/\u{1F539}/gu, "")
      .replace(
        /(^|\n)\s*(?:🎥|🎬|فیلم\s*:?)\s*#?\s*[^\n]+/giu,
        "\n"
      )
      .replace(
        /https?:\/\/(?:t\.me|telegram\.me|telegram\.dog)\/[^\s]+/giu,
        ""
      )
      .replace(/https?:\/\/[^\s]+/giu, "")
      .replace(/@[a-zA-Z0-9_]+/g, "")
      .replace(/(^|\s)#([^\s#]+)/gu, " ")
      .replace(/[•●▪▫◦]/g, "")
      .replace(/_/g, " ")
      .replace(/\n{3,}/g, "\n\n")
      .replace(/[ \t]{2,}/g, " ")
      .trim()
  );
}

function limitWords(
  value: string | null | undefined,
  maximum: number
): string {
  const words = String(value || "")
    .replace(/\s+/g, " ")
    .trim()
    .split(" ")
    .filter(Boolean);

  if (!words.length) return "";
  if (words.length <= maximum) return words.join(" ");

  return words.slice(0, maximum).join(" ") + "…";
}

function makeDisplayTitle(post: Post): string {
  const movieTitle = extractMovieTitle(post.text);

  if (movieTitle && hasDialogueTag(post.text)) {
    return "دیالوگی از فیلم " + limitWords(movieTitle, 6);
  }

  const seoTitle = cleanPublicText(post.seo_title);

  if (seoTitle) {
    return limitWords(seoTitle, 5);
  }

  return limitWords(cleanPublicText(post.text), 5) || "مطلبی از ماهون";
}

function removeInsensitiveTagText(source, token) {
  let result = String(source || "");
  const target = String(token || "");
  if (!target) return result;

  let lowerResult = result.toLowerCase();
  const lowerTarget = target.toLowerCase();
  let index = lowerResult.indexOf(lowerTarget);

  while (index >= 0) {
    result = result.slice(0, index) + " " + result.slice(index + target.length);
    lowerResult = result.toLowerCase();
    index = lowerResult.indexOf(lowerTarget);
  }

  return result;
}

function cleanTagExcerpt(value, movieTitle) {
  return removeInsensitiveTagText(value, movieTitle)
    .replace(/[\p{Extended_Pictographic}\uFE0F]/gu, " ")
    .replace(/#\S+/gu, " ")
    .replace(/@mahoonartmagazine/giu, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function makeExcerpt(post) {
  const movieTitle = extractMovieTitle(post.text);
  const raw = post.seo_description || post.text || "";
  const source = cleanTagExcerpt(cleanPublicText(raw), movieTitle);
  return limitWords(source, 14) || "روایتی تازه از مجله هنری ماهون";
}

function formatDate(value: string | null | undefined): string {
  if (!value) return "";

  try {
    return new Intl.DateTimeFormat("fa-IR", {
      year: "numeric",
      month: "long",
      day: "numeric"
    }).format(new Date(String(value).replace(" ", "T")));
  } catch {
    return String(value || "");
  }
}

function validMediaValue(
  value: string | null | undefined
): string | null {
  const source = String(value || "").trim();

  if (
    !source ||
    source.toLowerCase() === "about:blank" ||
    /^javascript:/i.test(source)
  ) {
    return null;
  }

  return source;
}

function looksLikeImageUrl(value: string | null | undefined): boolean {
  return /\.(avif|webp|png|jpe?g|gif|bmp)(\?|#|$)/i.test(
    String(value || "")
  );
}

function getMediaSrc(post: Post): string | null {
  const directImage = [
    post.photo_url,
    post.image_url,
    post.thumbnail_url
  ]
    .map(validMediaValue)
    .find(Boolean);

  if (directImage) return directImage;

  const fileUrl = validMediaValue(post.file_url);

  if (fileUrl && looksLikeImageUrl(fileUrl)) {
    return fileUrl;
  }

  const mediaUrl = validMediaValue(post.media_url);

  if (
    mediaUrl &&
    (post.media_type === "photo" ||
      post.media_type === "image" ||
      looksLikeImageUrl(mediaUrl))
  ) {
    return mediaUrl;
  }

  const photoFileId = String(post.photo_file_id || "").trim();

  if (photoFileId) {
    return workerUrl + "/media/" + encodeURIComponent(photoFileId);
  }

  const mediaFileId = String(
    post.media_file_id ||
      post.telegram_file_id ||
      post.file_id ||
      ""
  ).trim();

  if (
    mediaFileId &&
    (post.media_type === "photo" || post.media_type === "image")
  ) {
    return workerUrl + "/media/" + encodeURIComponent(mediaFileId);
  }

  return null;
}

function getPostHref(post: Post): string {
  const slug = String(post.slug || "").trim();

  if (slug) {
    return "/post/" + encodeURIComponent(slug);
  }

  return "/post/" + encodeURIComponent(String(post.id));
}

function normalizePost(raw: RawPost): Post | null {
  const id = Number(raw.id || 0);

  if (!id) return null;

  return {
    ...raw,
    id,
    text: String(raw.text || ""),
    slug: String(raw.slug || ""),
    created_at: String(raw.created_at || "")
  };
}

function extractPosts(payload: any): Post[] {
  const source = Array.isArray(payload)
    ? payload
    : Array.isArray(payload?.posts)
      ? payload.posts
      : Array.isArray(payload?.data)
        ? payload.data
        : [];

  return source
    .map(normalizePost)
    .filter(Boolean) as Post[];
}

async function loadPosts(): Promise<Post[]> {
  try {
    const response = await fetch(workerUrl + "/", {
      method: "GET",
      headers: {
        Accept: "application/json"
      }
    });

    if (!response.ok) return [];

    return extractPosts(await response.json());
  } catch {
    return [];
  }
}

function primaryKind(post: Post): CardKind {
  if (
    hasExactTag(post.text, [
      "کتاب",
      "کتاب گویا",
      "کتاب_گویا",
      "کتابگویا"
    ])
  ) {
    return "book";
  }

  if (hasDialogueTag(post.text)) {
    return "dialogue";
  }

  if (hasExactTag(post.text, ["صوتی", "صدا", "موسیقی"])) {
    return "audio";
  }

  if (hasExactTag(post.text, ["نقاشی"])) {
    return "art";
  }

  if (
    hasExactTag(post.text, [
      "شعر و متن",
      "شعر_و_متن",
      "شعر",
      "اشعار",
      "شعرها",
      "شعر ها",
      "شعر_ها",
      "متن",
      "متن‌ها",
      "متن ها",
      "متن_ها"
    ])
  ) {
    return "text";
  }

  const mediaType = String(post.media_type || "").toLowerCase();

  if (mediaType === "audio" || mediaType === "voice") {
    return "audio";
  }

  if (mediaType === "video" || mediaType === "animation") {
    return "video";
  }

  if (mediaType === "photo" || mediaType === "image") {
    return "photo";
  }

  return "text";
}

function kindLabel(kind: CardKind): string {
  if (kind === "book") return "کتاب";
  if (kind === "dialogue") return "دیالوگ";
  if (kind === "audio") return "صوتی";
  if (kind === "art") return "نقاشی";
  if (kind === "video") return "ویدیو";
  if (kind === "photo") return "تصویری";

  return "متن";
}

function kindIcon(kind: CardKind): string {
  if (kind === "book") return "▤";
  if (kind === "dialogue") return "❞";
  if (kind === "audio") return "♪";
  if (kind === "art") return "◐";
  if (kind === "video") return "▶";
  if (kind === "photo") return "◇";

  return "✎";
}

function searchText(post: Post): string {
  return normalizeTag(
    [
      post.text,
      post.seo_title,
      post.seo_description,
      post.slug,
      makeDisplayTitle(post),
      makeExcerpt(post)
    ].join(" ")
  );
}

function postTimestamp(post: Post): number {
  const timestamp = new Date(
    String(post.created_at).replace(" ", "T")
  ).getTime();

  return Number.isFinite(timestamp) ? timestamp : 0;
}

const currentTag = safeDecode(rawTag)
  .replace(/^#/, "")
  .replace(/_/g, " ")
  .trim();

const normalizedCurrentTag = normalizeTag(currentTag);
const allPosts = await loadPosts();

const matchingPosts = allPosts
  .filter((post) =>
    getTags(post.text).some(
      (tag) => normalizeTag(tag) === normalizedCurrentTag
    )
  )
  .sort((a, b) => {
    const dateDifference = postTimestamp(b) - postTimestamp(a);

    if (dateDifference) return dateDifference;

    return Number(b.id || 0) - Number(a.id || 0);
  });

const displayTag = currentTag || "برچسب";
const pageTitle = "#" + displayTag + " | " + SITE.name;

const pageDescription = matchingPosts.length
  ? "مطالب منتشرشده با برچسب " +
    displayTag +
    " در مجله هنری ماهون"
  : "برچسب " + displayTag + " در مجله هنری ماهون";

const canonicalUrl =
  siteUrl + "/tag/" + encodeURIComponent(displayTag);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
>
  <main class="mahoon-tag-archive">
    <section class="mahoon-tag-hero">
      <a class="mahoon-tag-back" href="/">بازگشت به صفحه اصلی</a>

      <span>آرشیو برچسب‌های ماهون</span>

      <h1 dir="auto">#{displayTag}</h1>

      <p>
        {matchingPosts.length
          ? "همه روایت‌های مرتبط با این برچسب در مجله هنری ماهون."
          : "هنوز مطلبی برای این برچسب پیدا نشده است."}
      </p>

      <strong>
        {new Intl.NumberFormat("fa-IR").format(matchingPosts.length)}
        {" "}
        مطلب
      </strong>
    </section>

    {
      matchingPosts.length ? (
        <>
          <section class="mahoon-tag-search">
            <label for="tagSearchInput">
              <span>جستجو در مطالب این برچسب</span>

              <input
                id="tagSearchInput"
                type="search"
                placeholder="عنوان، متن یا کلمه مورد نظر را جستجو کن..."
                autocomplete="off"
              />
            </label>
          </section>

          <nav
            class="mahoon-tag-navigation"
            aria-label="دسته‌بندی‌های ماهون"
          >
            <a href="/posts">همه مطالب</a>
            <a href="/category/کتاب">کتاب</a>
            <a href="/category/دیالوگ ها">دیالوگ ها</a>
            <a href="/category/صوتی">صوتی</a>
            <a href="/category/شعر و متن">شعر و متن</a>
            <a href="/category/نقاشی">نقاشی</a>
          </nav>

          <section class="mahoon-tag-results">
            <div class="mahoon-tag-count" id="tagVisibleCount">
              در حال آماده‌سازی مطالب...
            </div>

            <div class="mahoon-tag-grid" id="tagGrid">
              {
                matchingPosts.map((post) => {
                  const kind = primaryKind(post);
                  const label = kindLabel(kind);
                  const title = makeDisplayTitle(post);
                  const excerpt = makeExcerpt(post);
                  const image = getMediaSrc(post);
                  const href = getPostHref(post);

                  return (
                    <article
                      class={"mahoon-tag-card mahoon-tag-card--" + kind}
                      data-tag-card
                      data-search={searchText(post)}
                    >
                      <a
                        class:list={[
                          "mahoon-tag-card__media",
                          !image &&
                            "mahoon-tag-card__media--placeholder"
                        ]}
                        href={href}
                      >
                        {
                          image ? (
                            <img
                              src={image}
                              alt={title}
                              width="720"
                              height="430"
                              loading="lazy"
                              decoding="async"
                            />
                          ) : (
                            <span
                              class="mahoon-tag-card__icon"
                              aria-hidden="true"
                            >
                              {kindIcon(kind)}
                            </span>
                          )
                        }

                        <span class="mahoon-tag-card__badge">
                          {label}
                        </span>
                      </a>

                      <div class="mahoon-tag-card__body">
                        <div class="mahoon-tag-card__meta">
                          <span>{formatDate(post.created_at)}</span>
                          <span>{label}</span>
                        </div>

                        <h2>
                          <a href={href}>{title}</a>
                        </h2>

                        <p>{excerpt}</p>

                        <a class="mahoon-tag-card__cta" href={href}>
                          ادامه مطلب
                        </a>
                      </div>
                    </article>
                  );
                })
              }
            </div>

            <div class="mahoon-tag-empty" id="tagEmpty" hidden>
              <strong>مطلبی پیدا نشد</strong>
              <span>عبارت دیگری را جستجو کن.</span>
            </div>

            <button
              class="mahoon-tag-more"
              id="tagMore"
              type="button"
              hidden
            >
              نمایش ۲۰ مطلب دیگر
            </button>
          </section>
        </>
      ) : (
        <section class="mahoon-tag-not-found">
          <span>نتیجه‌ای پیدا نشد</span>
          <h2>مطلبی برای این برچسب وجود ندارد</h2>
          <p>
            از آرشیو کامل ماهون می‌توانی روایت‌های دیگر را دنبال کنی.
          </p>
          <a href="/posts">مشاهده همه مطالب</a>
        </section>
      )
    }
  </main>

  <script is:inline>
    (function () {
      const cards = Array.from(
        document.querySelectorAll("[data-tag-card]")
      );

      if (!cards.length) return;

      const input = document.getElementById("tagSearchInput");
      const count = document.getElementById("tagVisibleCount");
      const empty = document.getElementById("tagEmpty");
      const more = document.getElementById("tagMore");

      const pageSize = 20;
      let visibleLimit = pageSize;
      let timer = 0;

      function normalize(value) {
        return String(value || "")
          .replace(/[يى]/g, "ی")
          .replace(/ك/g, "ک")
          .replace(/[\u200c\u200f]/g, "")
          .replace(/_/g, " ")
          .replace(/\s+/g, " ")
          .trim()
          .toLowerCase();
      }

      function persianNumber(value) {
        return new Intl.NumberFormat("fa-IR").format(value);
      }

      function apply(reset) {
        if (reset) visibleLimit = pageSize;

        const query = normalize(input ? input.value : "");

        const matched = cards.filter(function (card) {
          return !query || normalize(card.dataset.search).includes(query);
        });

        cards.forEach(function (card) {
          card.hidden = true;
        });

        matched.slice(0, visibleLimit).forEach(function (card) {
          card.hidden = false;
        });

        if (count) {
          count.textContent =
            "نمایش " +
            persianNumber(Math.min(matched.length, visibleLimit)) +
            " مطلب از " +
            persianNumber(matched.length);
        }

        if (empty) {
          empty.hidden = matched.length !== 0;
        }

        if (more) {
          more.hidden = matched.length <= visibleLimit;
        }
      }

      if (input) {
        input.addEventListener("input", function () {
          window.clearTimeout(timer);
          timer = window.setTimeout(function () {
            apply(true);
          }, 180);
        });
      }

      if (more) {
        more.addEventListener("click", function () {
          visibleLimit += pageSize;
          apply(false);
        });
      }

      apply(true);
    })();
  </script>

  <style is:global>
    .mahoon-tag-archive {
      direction: rtl;
      width: min(1180px, calc(100% - 32px));
      min-height: 70vh;
      margin: 0 auto;
      padding: 30px 0 84px;
    }

    .mahoon-tag-hero {
      position: relative;
      min-height: 310px;
      overflow: hidden;
      border-radius: 32px;
      padding: 34px;
      color: #fff8ef;
      background:
        linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
        radial-gradient(circle at 15% 85%, rgba(255, 248, 239, 0.08), transparent 28%),
        linear-gradient(135deg, #73191c, #32100e);
      background-size: 54px 54px, 54px 54px, auto, auto;
      box-shadow: 0 28px 78px rgba(75, 13, 13, 0.2);
    }

    .mahoon-tag-hero::after {
      content: "";
      position: absolute;
      left: -90px;
      bottom: -110px;
      width: 250px;
      height: 250px;
      border-radius: 50%;
      border: 1px solid rgba(255, 248, 239, 0.13);
    }

    .mahoon-tag-back {
      position: relative;
      z-index: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      border-radius: 999px;
      padding: 8px 15px;
      color: #4b0d0d;
      background: #fff8ef;
      text-decoration: none;
      font-size: 13px;
      font-weight: 900;
    }

    .mahoon-tag-hero > span {
      position: relative;
      z-index: 1;
      display: block;
      margin-top: 26px;
      color: rgba(255, 248, 239, 0.72);
      font-size: 13px;
      font-weight: 900;
    }

    .mahoon-tag-hero h1 {
      position: relative;
      z-index: 1;
      max-width: 820px;
      margin: 6px 0 12px;
      color: #fff8ef;
      font-size: clamp(38px, 6vw, 68px);
      line-height: 1.35;
      overflow-wrap: anywhere;
    }

    .mahoon-tag-hero p {
      position: relative;
      z-index: 1;
      max-width: 700px;
      margin: 0;
      color: rgba(255, 248, 239, 0.84);
      font-size: 15px;
      line-height: 2;
    }

    .mahoon-tag-hero strong {
      position: relative;
      z-index: 1;
      display: inline-flex;
      margin-top: 20px;
      border-radius: 999px;
      padding: 8px 14px;
      color: #fff8ef;
      background: rgba(255, 248, 239, 0.11);
      border: 1px solid rgba(255, 248, 239, 0.16);
      font-size: 14px;
    }

    .mahoon-tag-search {
      margin-top: 16px;
      border-radius: 28px;
      padding: 18px;
      background: rgba(255, 253, 248, 0.94);
      box-shadow: 0 18px 48px rgba(75, 13, 13, 0.07);
    }

    .mahoon-tag-search label {
      display: grid;
      gap: 10px;
      color: #4b0d0d;
      font-size: 14px;
      font-weight: 900;
    }

    .mahoon-tag-search input {
      width: 100%;
      min-height: 54px;
      border: 1px solid rgba(75, 13, 13, 0.15);
      border-radius: 17px;
      padding: 0 16px;
      color: #2a1713;
      background: #fffdf8;
      font: inherit;
      outline: none;
    }

    .mahoon-tag-search input:focus {
      border-color: rgba(90, 15, 15, 0.42);
      box-shadow: 0 0 0 4px rgba(90, 15, 15, 0.06);
    }

    .mahoon-tag-navigation {
      display: flex;
      gap: 9px;
      margin: 14px 0 18px;
      overflow-x: auto;
      border-radius: 26px;
      padding: 10px;
      background: rgba(255, 253, 248, 0.94);
      box-shadow: 0 16px 38px rgba(75, 13, 13, 0.05);
      scrollbar-width: none;
    }

    .mahoon-tag-navigation::-webkit-scrollbar {
