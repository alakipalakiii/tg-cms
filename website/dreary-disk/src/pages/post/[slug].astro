---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config";

export const prerender = false;

const slug = Astro.params.slug || "";
---

<BaseLayout title={`روایت ماهون | ${SITE.name}`} description={SITE.description}>
  <main
    class="client-single"
    data-worker-url={SITE.workerUrl}
    data-slug={slug}
  >
    <div class="client-single-shell">
      <a class="client-back-link" href="/">بازگشت به صفحه اصلی</a>

      <article id="postArticle" class="client-single-card">
        <div id="postStatus" class="client-single-status">
          در حال دریافت پست...
        </div>
      </article>
    </div>
  </main>

  <script is:inline>
    (function () {
      const root = document.querySelector(".client-single");
      const article = document.getElementById("postArticle");
      const statusEl = document.getElementById("postStatus");

      const API_BASE = (
        root?.dataset?.workerUrl ||
        "https://tg-cms-api.morentoofficial.workers.dev"
      ).replace(/\/+$/, "");

      function toPersianNumber(value) {
        return String(value || "")
          .replace(/0/g, "۰")
          .replace(/1/g, "۱")
          .replace(/2/g, "۲")
          .replace(/3/g, "۳")
          .replace(/4/g, "۴")
          .replace(/5/g, "۵")
          .replace(/6/g, "۶")
          .replace(/7/g, "۷")
          .replace(/8/g, "۸")
          .replace(/9/g, "۹");
      }

      function safeDecode(value) {
        try {
          return decodeURIComponent(value || "");
        } catch {
          return value || "";
        }
      }

      const currentSlug =
        root?.dataset?.slug ||
        safeDecode(window.location.pathname.split("/post/")[1] || "");

      function escapeHtml(value) {
        return String(value || "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      function escapeAttr(value) {
        return escapeHtml(value).replace(/`/g, "&#096;");
      }

      function cleanText(value) {
        return String(value || "")
          .replace(/https?:\/\/[^\s]+/giu, "")
          .replace(/@[a-zA-Z0-9_]+/g, "")
          .replace(/(^|\s)#([^\s#]+)/gu, " ")
          .replace(/[•●▪▫◦]/g, "")
          .replace(/\n{3,}/g, "\n\n")
          .replace(/[ \t]{2,}/g, " ")
          .trim();
      }

      function makeTitle(text) {
        const source = cleanText(text) || "روایت ماهون";
        const firstLine =
          source
            .split("\n")
            .map((line) => line.trim())
            .find(Boolean) || "روایت ماهون";

        if (firstLine.length <= 82) return firstLine;
        return firstLine.slice(0, 82).trim() + "...";
      }

      function getTags(text) {
        return Array.from(
          new Set(
            Array.from(String(text || "").matchAll(/(^|\s)#([^\s#]+)/gu))
              .map((match) => match[2])
              .filter(Boolean)
          )
        );
      }

      function formatDate(value) {
        if (!value) return "";
        try {
          const date = new Date(String(value).replace(" ", "T"));
          return new Intl.DateTimeFormat("fa-IR", {
            year: "numeric",
            month: "long",
            day: "numeric"
          }).format(date);
        } catch {
          return String(value);
        }
      }

      function formatFileSize(bytes) {
        const size = Number(bytes || 0);
        if (!size) return "";
        if (size < 1024) return `${toPersianNumber(size)} بایت`;
        if (size < 1024 * 1024) return `${toPersianNumber(Math.round(size / 1024))} کیلوبایت`;
        return `${toPersianNumber((size / 1024 / 1024).toFixed(1))} مگابایت`;
      }

      function formatDuration(seconds) {
        const total = Number(seconds || 0);
        if (!total) return "";
        const minutes = Math.floor(total / 60);
        const rest = Math.floor(total % 60);
        return toPersianNumber(`${minutes}:${String(rest).padStart(2, "0")}`);
      }

      function normalizePost(raw) {
        const mediaFileId = raw?.media_file_id || raw?.photo_file_id || null;
        const mediaType = raw?.media_type || (raw?.photo_file_id ? "photo" : null);
        const mediaUrl =
          raw?.media_url ||
          (mediaFileId ? `${API_BASE}/media/${encodeURIComponent(mediaFileId)}` : null);
        const photoUrl =
          raw?.photo_url ||
          (mediaType === "photo" ? mediaUrl : null) ||
          null;

        return {
          id: Number(raw?.id || 0),
          text: String(raw?.text || ""),
          slug: String(raw?.slug || `post-${raw?.id || Date.now()}`),
          created_at: String(raw?.created_at || ""),
          media_type: mediaType,
          media_file_id: mediaFileId,
          media_mime_type: raw?.media_mime_type || null,
          media_file_name: raw?.media_file_name || null,
          media_duration: raw?.media_duration || null,
          media_size: raw?.media_size || null,
          media_url: mediaUrl,
          photo_url: photoUrl,
          seo_title: raw?.seo_title || null,
          seo_description: raw?.seo_description || null,
          view_count: raw?.view_count || 0
        };
      }

      function extractPosts(payload) {
        if (Array.isArray(payload)) return payload.map(normalizePost).filter((post) => post.id);
        if (Array.isArray(payload?.posts)) return payload.posts.map(normalizePost).filter((post) => post.id);
        if (Array.isArray(payload?.data)) return payload.data.map(normalizePost).filter((post) => post.id);
        if (payload?.id) return [normalizePost(payload)];
        return [];
      }

      function mediaLabel(type) {
        switch (type) {
          case "photo":
            return "تصویر";
          case "video":
            return "ویدیو";
          case "audio":
            return "صوت";
          case "voice":
            return "ویس";
          case "document":
            return "فایل";
          case "animation":
            return "انیمیشن";
          default:
            return "رسانه";
        }
      }

      function renderText(text) {
        const cleaned = cleanText(text);

        if (!cleaned) {
          return `<p>روایتی تازه از مجله هنری ماهون</p>`;
        }

        return cleaned
          .split(/\n+/)
          .map((line) => line.trim())
          .filter(Boolean)
          .map((line) => `<p>${escapeHtml(line)}</p>`)
          .join("");
      }

      function renderTags(post) {
        const tags = getTags(post.text);
        if (!tags.length) return "";

        return `
          <div class="client-single-tags">
            ${tags.map((tag) => `<span>#${escapeHtml(tag)}</span>`).join("")}
          </div>
        `;
      }

      function renderMedia(post) {
        const url = post.media_url || post.photo_url;

        if (post.photo_url) {
          return `
            <figure class="client-single-media">
              <img src="${escapeAttr(post.photo_url)}" alt="${escapeAttr(makeTitle(post.text))}" />
            </figure>
          `;
        }

        if (!url) return "";

        if (post.media_type === "video" || post.media_type === "animation") {
          return `
            <div class="client-single-media client-single-video">
              <video controls preload="metadata" src="${escapeAttr(url)}"></video>
            </div>
          `;
        }

        if (post.media_type === "audio" || post.media_type === "voice") {
          return `
            <div class="client-audio-box">
              <div class="client-audio-icon">♪</div>
              <div class="client-audio-info">
                <strong>${escapeHtml(post.media_file_name || mediaLabel(post.media_type))}</strong>
                <span>
                  ${escapeHtml(formatDuration(post.media_duration))}
                  ${post.media_size ? " · " + escapeHtml(formatFileSize(post.media_size)) : ""}
                </span>
              </div>
              <audio controls preload="metadata" src="${escapeAttr(url)}"></audio>
            </div>
          `;
        }

        if (post.media_type === "document") {
          return `
            <a class="client-file-box" href="${escapeAttr(url)}" target="_blank" rel="noopener">
              <span>□</span>
              <div>
                <strong>${escapeHtml(post.media_file_name || "دانلود فایل")}</strong>
                <small>${escapeHtml(formatFileSize(post.media_size))}</small>
              </div>
            </a>
          `;
        }

        return `
          <a class="client-file-box" href="${escapeAttr(url)}" target="_blank" rel="noopener">
            <span>◆</span>
            <div>
              <strong>${escapeHtml(mediaLabel(post.media_type))}</strong>
              <small>مشاهده فایل</small>
            </div>
          </a>
        `;
      }

      function renderPost(post) {
        const title = post.seo_title || makeTitle(post.text);

        document.title = `${title} | مجله هنری ماهون`;

        article.innerHTML = `
          ${renderMedia(post)}

          <div class="client-single-body">
            <div class="client-single-code-box">
              <strong>کد ثابت مطلب</strong>
              <span>#${escapeHtml(toPersianNumber(post.id))}</span>
              <small>برای مدیریت این مطلب در ربات، همین شماره را وارد کنید.</small>
            </div>

            <div class="client-single-meta">
              <span>کد مطلب #${escapeHtml(toPersianNumber(post.id))}</span>
              <span>${escapeHtml(formatDate(post.created_at))}</span>
              ${post.media_type ? `<span>${escapeHtml(mediaLabel(post.media_type))}</span>` : ""}
              ${post.view_count ? `<span>${escapeHtml(toPersianNumber(post.view_count))} بازدید</span>` : ""}
            </div>

            <h1>${escapeHtml(title)}</h1>

            <div class="client-single-text">
              ${renderText(post.text)}
            </div>

            ${renderTags(post)}

            <div class="client-single-actions">
              <a href="/">بازگشت به مطالب</a>
              ${
                post.media_url
                  ? `<a href="${escapeAttr(post.media_url)}" target="_blank" rel="noopener">باز کردن رسانه</a>`
                  : ""
              }
            </div>
          </div>
        `;
      }

      async function fetchJson(url) {
        const response = await fetch(url, {
          method: "GET",
          headers: {
            Accept: "application/json"
          }
        });

        if (!response.ok) {
          throw new Error(`API error ${response.status}`);
        }

        return response.json();
      }

      async function loadPost() {
        try {
          statusEl.textContent = "در حال دریافت پست...";

          let post = null;

          try {
            const directPayload = await fetchJson(`${API_BASE}/post/${encodeURIComponent(currentSlug)}`);
            post = extractPosts(directPayload)[0] || null;
          } catch {
            post = null;
          }

          if (!post) {
            const listPayload = await fetchJson(`${API_BASE}/`);
            const posts = extractPosts(listPayload);
            post = posts.find((item) => item.slug === currentSlug) || null;
          }

          if (!post) {
            article.innerHTML = `
              <div class="client-single-status">
                پست مورد نظر پیدا نشد.
              </div>
            `;
            return;
          }

          renderPost(post);
        } catch (error) {
          console.error("Mahoon single post error:", error);
          article.innerHTML = `
            <div class="client-single-status">
              خطا در دریافت پست. لطفاً صفحه را Refresh کنید.
            </div>
          `;
        }
      }

      loadPost();
    })();
  </script>

  <style is:global>
    .client-single {
      direction: rtl;
      min-height: 70vh;
      padding: 54px 16px 90px;
    }

    .client-single-shell {
      width: min(920px, 100%);
      margin: 0 auto;
    }

    .client-back-link {
      display: inline-flex;
      margin-bottom: 22px;
      color: #4b0d0d;
      background: #fffdf8;
      border: 1px solid rgba(75, 13, 13, 0.12);
      border-radius: 999px;
      padding: 12px 18px;
      text-decoration: none;
      font-weight: 800;
      box-shadow: 0 14px 40px rgba(75, 13, 13, 0.06);
    }

    .client-single-card {
      background: #fffdf8;
      border: 1px solid rgba(75, 13, 13, 0.1);
      border-radius: 34px;
      overflow: hidden;
      box-shadow: 0 28px 90px rgba(75, 13, 13, 0.1);
    }

    .client-single-status {
      padding: 42px;
      text-align: center;
      color: #5f504e;
    }

    .client-single-media {
      margin: 0;
      background: #efe4d7;
      overflow: hidden;
    }

    .client-single-media img {
      width: 100%;
      max-height: 720px;
      object-fit: cover;
      display: block;
    }

    .client-single-video {
      padding: 18px;
      background:
        radial-gradient(circle at 20% 15%, rgba(255, 255, 255, 0.12), transparent 30%),
        linear-gradient(135deg, #6b1515, #2d0606);
    }

    .client-single-video video {
      width: 100%;
      display: block;
      border-radius: 22px;
      background: #000;
    }

    .client-single-body {
      padding: clamp(26px, 5vw, 54px);
    }

    .client-single-code-box {
      background:
        radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.14), transparent 30%),
        linear-gradient(135deg, #6b1515, #2d0606);
      color: #fffdf8;
      border-radius: 24px;
      padding: 22px;
      margin-bottom: 24px;
      display: grid;
      gap: 8px;
      box-shadow: 0 18px 55px rgba(75, 13, 13, 0.14);
    }

    .client-single-code-box strong {
      font-size: 14px;
      color: rgba(255, 253, 248, 0.78);
    }

    .client-single-code-box span {
      font-size: 34px;
      font-weight: 900;
      line-height: 1;
    }

    .client-single-code-box small {
      color: rgba(255, 253, 248, 0.72);
      line-height: 1.9;
    }

    .client-single-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 20px;
      color: #8a6a62;
      font-size: 13px;
    }

    .client-single-meta span {
      background: #f5ece0;
      border-radius: 999px;
      padding: 8px 13px;
    }

    .client-single-meta span:first-child {
      background: #4b0d0d;
      color: #fffdf8;
      font-weight: 800;
    }

    .client-single-body h1 {
      margin: 0 0 28px;
      color: #4b0d0d;
      line-height: 1.65;
      font-size: clamp(28px, 5vw, 48px);
      letter-spacing: -0.04em;
    }

    .client-single-text {
      color: #3c2d2a;
      font-size: 18px;
      line-height: 2.35;
    }

    .client-single-text p {
      margin: 0 0 18px;
    }

    .client-single-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 30px;
    }

    .client-single-tags span {
      color: #6b1515;
      background: #f6efe5;
      border: 1px solid rgba(75, 13, 13, 0.08);
      border-radius: 999px;
      padding: 8px 12px;
      font-size: 13px;
      font-weight: 700;
    }

    .client-single-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 38px;
      padding-top: 28px;
      border-top: 1px solid rgba(75, 13, 13, 0.1);
    }

    .client-single-actions a {
      color: #fffdf8;
      background: #4b0d0d;
      border-radius: 999px;
      padding: 12px 18px;
      text-decoration: none;
      font-weight: 800;
    }

    .client-audio-box {
      margin: 0;
      padding: 34px;
      background:
        radial-gradient(circle at 20% 15%, rgba(255, 255, 255, 0.12), transparent 30%),
        linear-gradient(135deg, #6b1515, #2d0606);
      color: #fffdf8;
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 18px;
      align-items: center;
    }

    .client-audio-icon {
      width: 74px;
      height: 74px;
      border-radius: 999px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(255, 253, 248, 0.22);
      background: rgba(255, 255, 255, 0.1);
      font-size: 30px;
    }

    .client-audio-info {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .client-audio-info strong {
      font-size: 20px;
    }

    .client-audio-info span {
      color: rgba(255, 253, 248, 0.72);
      font-size: 13px;
    }

    .client-audio-box audio {
      grid-column: 1 / -1;
      width: 100%;
    }

    .client-file-box {
      margin: 0;
      padding: 34px;
      background:
        radial-gradient(circle at 20% 15%, rgba(255, 255, 255, 0.12), transparent 30%),
        linear-gradient(135deg, #6b1515, #2d0606);
      color: #fffdf8;
      text-decoration: none;
      display: flex;
      gap: 18px;
      align-items: center;
    }

    .client-file-box > span {
      width: 68px;
      height: 68px;
      border-radius: 18px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(255, 253, 248, 0.22);
      background: rgba(255, 255, 255, 0.1);
      font-size: 28px;
      flex: 0 0 auto;
    }

    .client-file-box div {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .client-file-box strong {
      font-size: 18px;
    }

    .client-file-box small {
      color: rgba(255, 253, 248, 0.72);
    }

    @media (max-width: 720px) {
      .client-single {
        padding-top: 28px;
      }

      .client-single-body {
        padding: 24px;
      }

      .client-single-text {
        font-size: 16px;
      }

      .client-audio-box,
      .client-file-box {
        padding: 24px;
      }
    }
  </style>
</BaseLayout>