    background: rgba(255,255,255,.52) !important;
    border-color: rgba(91,16,20,.14) !important;
  }

  /* Reserve real layout space so the fixed dock never hides cards/text. */
@media (max-width:620px) {
    .mahoon-frozen-global-scope .modalTop .close {
      left: 7px !important;
      top: 5px !important;
    }

    .mahoon-frozen-global-scope .modalTop .modalType {
      top: 11px !important;
    }
}
</style>

<script is:inline>
  (() => {
    /* MAHOON_STAGE19B_F_R4_R3_THEME_AND_DOCK_RUNTIME_REPAIR */

    const original = new WeakMap();
    const repaired = new Set();

    function parseRgb(value) {
      const m=String(value||"").match(
        /rgba?\(\s*([\d.]+)[,\s]+([\d.]+)[,\s]+([\d.]+)(?:[,\s\/]+([\d.]+))?\s*\)/i
      );
      if (!m) return null;
      return {
        r:Number(m[1])/255,
        g:Number(m[2])/255,
        b:Number(m[3])/255,
        a:m[4]==null?1:Number(m[4])
      };
    }

    function parseHex(value) {
      const m=String(value||"").trim().match(/^#([0-9a-f]{6})$/i);
      if (!m) return null;
      const n=parseInt(m[1],16);
      return {r:((n>>16)&255)/255,g:((n>>8)&255)/255,b:(n&255)/255,a:1};
    }

    function lum(c) {
      if (!c) return 0;
      const f=v=>v<=.03928?v/12.92:Math.pow((v+.055)/1.055,2.4);
      return .2126*f(c.r)+.7152*f(c.g)+.0722*f(c.b);
    }

    function gradientLum(value) {
      const s=String(value||"");
      if (!s || s==="none" || /url\(/i.test(s)) return 0;
      const ls=[];

      for (const token of s.match(/rgba?\([^)]+\)/ig)||[]) {
        const c=parseRgb(token);
        if (c && c.a>.10) ls.push(lum(c));
      }
      for (const token of s.match(/#(?:[0-9a-f]{6})\b/ig)||[]) {
        const c=parseHex(token);
        if (c) ls.push(lum(c));
      }

      if (!ls.length) return 0;
      const avg=ls.reduce((a,b)=>a+b,0)/ls.length;
      return Math.max(avg,Math.max(...ls)*.82);
    }

    function excluded(el) {
      return (
        !(el instanceof HTMLElement) ||
        el.matches("img,picture,video,canvas,svg,path,source,script,style,link,meta") ||
        el.closest(".mahoon-frozen-global-scope,[data-mahoon-native-player],.mahoon-r4-theme-control")
      );
    }

    function remember(el) {
      if (original.has(el)) return;
      original.set(el,el.getAttribute("style"));
      repaired.add(el);
      el.setAttribute("data-mahoon-r4-r3-dark-repair","1");
    }

    function setImp(el,prop,value) {
      remember(el);
      el.style.setProperty(prop,value,"important");
    }

    function repairDark(root=document.body) {
      if (document.documentElement.dataset.mahoonTheme!=="dark" || !root) return;

      const nodes=[];
      if (root instanceof HTMLElement) nodes.push(root);
      if (root.querySelectorAll) nodes.push(...root.querySelectorAll("*"));

      for (const el of nodes) {
        if (excluded(el)) continue;

        const cs=getComputedStyle(el);
        const rect=el.getBoundingClientRect();
        const area=Math.max(0,rect.width)*Math.max(0,rect.height);
        if (area<=0 && cs.position!=="fixed" && cs.position!=="sticky") continue;

        const bg=parseRgb(cs.backgroundColor);
        const bgL=bg && bg.a>.10 ? lum(bg) : 0;
        const gradL=gradientLum(cs.backgroundImage);

        if (area>1800 && (bgL>.67 || gradL>.60)) {
          setImp(el,"background","#181214");
          setImp(el,"background-image","none");
          setImp(el,"border-color","rgba(255,255,255,.09)");
          setImp(el,"box-shadow","0 18px 52px rgba(0,0,0,.16)");
        }

        const tc=parseRgb(cs.color);
        if (tc && tc.a>.35 && lum(tc)<.30) {
          const tag=el.tagName;
          const txt=String(el.textContent||"").trim();
          const accent=/^(A|BUTTON)$/.test(tag) || /#|ادامه|مشاهده|خانه|درباره|ارتباط/.test(txt);
          setImp(el,"color",accent?"#d75a50":"#f5ece6");
        }
      }
    }

    function restoreOwn() {
      for (const el of repaired) {
        if (!(el instanceof HTMLElement)) continue;
        const before=original.get(el);
        if (before==null) el.removeAttribute("style");
        else el.setAttribute("style",before);
        el.removeAttribute("data-mahoon-r4-r3-dark-repair");
      }
      repaired.clear();
    }

    function clearStaleR4() {
      /*
        Clear only exact inline values written by the older R4 darkifier.
        This fixes black Suggested cards that survived after switching back to LIGHT.
      */
      const exact=new Set(["#181214","#211719","#0d090a","#f5ece6","#d75a50","#c7b8b1","none"]);
      for (const el of document.querySelectorAll("[data-mahoon-r4-darkified]")) {
        if (!(el instanceof HTMLElement)) continue;
        if (el.closest(".mahoon-frozen-global-scope,[data-mahoon-native-player]")) continue;

        for (const prop of [
          "background","background-image","background-color",
          "border-color","box-shadow","color"
        ]) {
          const v=String(el.style.getPropertyValue(prop)||"").trim().toLowerCase();
          if (exact.has(v)) el.style.removeProperty(prop);
        }
        el.removeAttribute("data-mahoon-r4-darkified");
      }
    }

    function syncTheme() {
      if (document.documentElement.dataset.mahoonTheme!=="dark") {
        restoreOwn();
        clearStaleR4();
        return;
      }

      repairDark(document.body);
      setTimeout(()=>repairDark(document.body),150);
      setTimeout(()=>repairDark(document.body),800);
    }

    function syncDock() {
      const sticky=document.querySelector(".mahoon-frozen-global-scope #sticky");
      document.body?.classList.toggle(
        "mahoon-r4-r3-dock-active",
        Boolean(sticky?.classList.contains("show"))
      );
    }

    function start() {
      syncTheme();
      syncDock();

      const sticky=document.querySelector(".mahoon-frozen-global-scope #sticky");
      if (sticky) {
        new MutationObserver(syncDock).observe(sticky,{
          attributes:true,
          attributeFilter:["class"]
        });
      }

      if (document.body) {
        new MutationObserver(records=>{
          syncDock();
          if (document.documentElement.dataset.mahoonTheme!=="dark") return;
          for (const r of records) {
            for (const n of r.addedNodes) {
              if (n instanceof HTMLElement) repairDark(n);
            }
          }
        }).observe(document.body,{childList:true,subtree:true});
      }
    }

    window.addEventListener("mahoon:theme-change",syncTheme);
    window.addEventListener("pageshow",()=>setTimeout(syncTheme,0));
    document.addEventListener("astro:page-load",()=>setTimeout(syncTheme,0));

    if (document.readyState==="loading") {
      document.addEventListener("DOMContentLoaded",start,{once:true});
    } else {
      start();
    }
  })();
</script>

<style is:global>
  /* MAHOON_STAGE19B_F_R4_R5_R1_ZERO_FLOW_PORTAL_AND_FOOTER */

  /*
    The global audio UI is a viewport portal, never a document-flow block.
    This removes the black/blank tail that appeared after the real footer.
  */
  body > .mahoon-frozen-global-scope,
  .mahoon-frozen-global-scope {
    position: fixed !important;
    inset: 0 0 auto 0 !important;
    width: 100vw !important;
    height: 0 !important;
    min-height: 0 !important;
    max-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    overflow: visible !important;
    pointer-events: none !important;
  }

  .mahoon-frozen-global-scope #sticky,
  .mahoon-frozen-global-scope #modal,
  .mahoon-frozen-global-scope .mahoon-r4-toast,
  .mahoon-frozen-global-scope button,
  .mahoon-frozen-global-scope a,
  .mahoon-frozen-global-scope canvas {
    pointer-events: auto !important;
  }

  /*
    Theme switch stays viewport-fixed. It no longer follows the footer upward
    and therefore cannot manufacture or visually suggest extra page height.
  */
  .mahoon-r4-theme-control {
    position: fixed !important;
    left: max(16px, env(safe-area-inset-left)) !important;
    right: auto !important;
    bottom: max(16px, env(safe-area-inset-bottom)) !important;
    margin: 0 !important;
    z-index: 2147482500 !important;
    transform: none !important;
  }

  body.mahoon-r4-r3-dock-active .mahoon-r4-theme-control {
    bottom: calc(max(16px, env(safe-area-inset-bottom)) + 88px) !important;
  }

  /*
    Only the dock is allowed to lift above the real footer.
    No body padding, spacer, pseudo-element or fake reserve is used.
  */
  .mahoon-frozen-global-scope #sticky {
    bottom:
      calc(
        max(12px, env(safe-area-inset-bottom)) +
        var(--mahoon-r5-footer-lift, 0px)
      ) !important;
  }

  @media (max-width:620px) {
    .mahoon-r4-theme-control {
      left: max(10px, env(safe-area-inset-left)) !important;
      bottom: max(10px, env(safe-area-inset-bottom)) !important;
    }

    body.mahoon-r4-r3-dock-active .mahoon-r4-theme-control {
      bottom: calc(max(10px, env(safe-area-inset-bottom)) + 72px) !important;
    }

    .mahoon-frozen-global-scope #sticky {
      bottom:
        calc(
          max(8px, env(safe-area-inset-bottom)) +
          var(--mahoon-r5-footer-lift, 0px)
        ) !important;
    }
  }
</style>

<script is:inline>
  (() => {
    /* MAHOON_STAGE19B_F_R4_R5_R1_SINGLE_AUTHORITATIVE_AUDIO_OWNER */

    if (window.__MAHOON_R4_R5_SINGLE_AUDIO_OWNER__) return;
    window.__MAHOON_R4_R5_SINGLE_AUDIO_OWNER__ = true;

    const KEY = "mahoon-global-audio-state-v1";
    const ROOT_SELECTOR = ".mahoon-frozen-global-scope";
    const GLOBAL_SELECTOR = ".mahoon-r4-global-audio";
    const NATIVE_SELECTOR =
      '[data-mahoon-native-player] audio.mahoon-native-player__audio';

    let navigating = false;
    let suppressNativePlay = false;
    let suppressNativePause = false;
    let suppressNativeSeek = 0;
    let nativeUserIntentUntil = 0;
    let boundNative = null;
    let boundGlobal = null;

    function gAudio() {
      const el = document.querySelector(
        ROOT_SELECTOR + " " + GLOBAL_SELECTOR
      );
      return el instanceof HTMLAudioElement ? el : null;
    }

    function nAudio() {
      const el = document.querySelector(NATIVE_SELECTOR);
      return el instanceof HTMLAudioElement ? el : null;
    }

    function sameSrc(a,b) {
      try {
        if (!a || !b) return false;
        return new URL(a,location.href).href === new URL(b,location.href).href;
      } catch {
        return String(a||"") === String(b||"");
      }
    }

    function readState() {
      try { return JSON.parse(localStorage.getItem(KEY)||"null"); }
      catch { return null; }
    }

    function writeState(next) {
      try {
        if (next?.src) localStorage.setItem(KEY,JSON.stringify(next));
      } catch {}
    }

    function nativeMeta(n) {
      const root=n?.closest?.("[data-mahoon-native-player]");
      const old=readState()||{};
      if (!root) return old;

      const title=String(
        root.querySelector(".mahoon-native-player__title")?.textContent||""
      ).trim();

      const description=String(
        root.querySelector(".mahoon-native-player__description")?.textContent||""
      ).trim();

      const imageEl=root.querySelector(".mahoon-native-player__cover img");
      const image=imageEl?.currentSrc||imageEl?.src||old.image||"";

      const category=String(
        root.querySelector(".mahoon-native-player__kind")?.textContent||"صوتی"
      ).trim();

      const meta=[...root.querySelectorAll(".mahoon-native-player__meta > span")]
        .map(el=>String(el.textContent||"").trim())
        .filter(Boolean);

      return {
        ...old,
        src:n.currentSrc||n.src||old.src||"",
        title:title||old.title||"پخش صوتی ماهون",
        description:description||old.description||"",
        image,
        category:category||old.category||"صوتی",
        date:meta[0]||old.date||"",
        fileName:root.dataset.fileName||old.fileName||"mahoon-audio",
        shareUrl:root.dataset.shareUrl||old.shareUrl||location.href,
        duration:
          Number.isFinite(n.duration) && n.duration>0
            ? n.duration
            : Number(root.dataset.duration||old.duration||0),
        engaged:true
      };
    }

    function ownerState(extra={}) {
      const g=gAudio();
      const old=readState()||{};
      if (!g) return {...old,...extra};

      return {
        ...old,
        ...extra,
        src:g.currentSrc||g.src||extra.src||old.src||"",
        currentTime:Number(g.currentTime||0),
        duration:
          Number.isFinite(g.duration) && g.duration>0
            ? g.duration
            : Number(extra.duration||old.duration||0),
        rate:Number(g.playbackRate||old.rate||1),
        wasPlaying:!g.paused,
        engaged:Boolean(old.engaged || extra.engaged || !g.paused || g.currentTime>0)
      };
    }

    function publish(extra={}) {
      const state=ownerState(extra);
      writeState(state);
      window.dispatchEvent(
        new CustomEvent("mahoon:audio-state",{detail:state})
      );
    }

    function setTime(audio,time) {
      if (!(audio instanceof HTMLAudioElement)) return;
      const target=Math.max(0,Number(time||0)||0);

      const apply=()=>{
        try {
          const max=
            Number.isFinite(audio.duration) && audio.duration>0
              ? audio.duration
              : target;
          audio.currentTime=Math.min(max,target);
        } catch {}
      };

      if (audio.readyState>=1) apply();
      else audio.addEventListener("loadedmetadata",apply,{once:true});
    }

    function prepareGlobalFromNative(n,{forceTime=false}={}) {
      const g=gAudio();
      if (!g || !n) return null;

      const meta=nativeMeta(n);
      const src=meta.src;
      if (!src) return null;

      const changed=!sameSrc(g.currentSrc||g.src,src);

      if (changed) {
        g.src=src;
        try { g.load(); } catch {}
      }

      const rate=Number(n.playbackRate||meta.rate||1);
      if (Number.isFinite(rate) && rate>0) g.playbackRate=rate;

      if (forceTime || changed || g.paused) {
        setTime(g,n.currentTime||0);
      }

      publish(meta);
      return g;
    }

    async function startOwnerFromNative(n) {
      nativeUserIntentUntil=performance.now()+1800;
      const g=prepareGlobalFromNative(n,{forceTime:true});
      if (!g) return false;

      try {
        /*
          Native player is only a muted UI clock.
          The persistent global audio is audible from the FIRST play.
        */
        await g.play();
        publish(nativeMeta(n));
        return true;
      } catch {
        publish(nativeMeta(n));
        return false;
      } finally {
        setTimeout(()=>{
          if (performance.now()>=nativeUserIntentUntil) nativeUserIntentUntil=0;
        },1900);
      }
    }

    async function toggleOwnerFromNative(n) {
      /* MAHOON_STAGE19B_F_R4_R5_R3_INLINE_OWNER_BRIDGE */
      nativeUserIntentUntil=performance.now()+1800;

      const g=prepareGlobalFromNative(n,{forceTime:false});
      if (!g) return false;

      try {
        if (g.paused) await g.play();
        else g.pause();

        publish(nativeMeta(n));
        syncNativeFromOwner();
        return !g.paused;
      } catch {
        publish(nativeMeta(n));
        return false;
      } finally {
        setTimeout(()=>{
          if (performance.now()>=nativeUserIntentUntil) nativeUserIntentUntil=0;
        },1900);
      }
    }

    window.__MAHOON_AUDIO_OWNER_API__={
      toggleFromNative:toggleOwnerFromNative
    };

    function syncNativeFromOwner() {
      const g=gAudio();
      const n=nAudio();
      if (!g || !n) return;
      if (!sameSrc(g.currentSrc||g.src,n.currentSrc||n.src)) return;

      n.muted=true;
      try { n.volume=0; } catch {}

      const rate=Number(g.playbackRate||1);
      if (Number.isFinite(rate) && rate>0 && Math.abs(n.playbackRate-rate)>.001) {
        n.playbackRate=rate;
      }

      if (Math.abs(Number(n.currentTime||0)-Number(g.currentTime||0))>.85) {
        /*
          Owner -> native UI mirroring must not bounce a programmatic seek
          back into the audible global owner.
        */
        suppressNativeSeek++;
        setTime(n,g.currentTime);
        setTimeout(()=>{
          suppressNativeSeek=Math.max(0,suppressNativeSeek-1);
        },220);
      }

      if (g.paused) {
        /*
          Do not race a user's inline Play click.
          The native UI may emit play a few milliseconds before the persistent
          owner has completed g.play().
        */
        if (performance.now()<nativeUserIntentUntil) return;

        if (!n.paused) {
          suppressNativePause=true;
          try { n.pause(); } catch {}
          queueMicrotask(()=>{suppressNativePause=false;});
        }
      } else if (n.paused) {
        suppressNativePlay=true;
        n.play().catch(()=>{}).finally(()=>{
          queueMicrotask(()=>{suppressNativePlay=false;});
        });
      }
    }

    function bindNative() {
      const n=nAudio();
      if (!n || n===boundNative || n.dataset.mahoonR5OwnerBound==="1") {
        if (n) syncNativeFromOwner();
        return;
      }

      boundNative=n;
n.dataset.mahoonR5OwnerBound="1";
      n.muted=true;
      try { n.volume=0; } catch {}

      n.addEventListener("play",()=>{
        if (suppressNativePlay) return;
        startOwnerFromNative(n);
      });

      n.addEventListener("pause",()=>{
        if (suppressNativePause || navigating) return;
        const g=gAudio();
        if (!g) return;
        if (!sameSrc(g.currentSrc||g.src,n.currentSrc||n.src)) return;
        try { g.pause(); } catch {}
        publish(nativeMeta(n));
      });

      const seek=()=>{
        if (suppressNativeSeek>0) return;
        const g=gAudio();
        if (!g) return;
        if (!sameSrc(g.currentSrc||g.src,n.currentSrc||n.src)) return;
        setTime(g,n.currentTime);
        publish(nativeMeta(n));
      };

      n.addEventListener("seeking",seek);
      n.addEventListener("seeked",seek);

      n.addEventListener("ratechange",()=>{
        const g=gAudio();
        if (!g) return;
        if (!sameSrc(g.currentSrc||g.src,n.currentSrc||n.src)) return;
        const rate=Number(n.playbackRate||1);
        if (Number.isFinite(rate) && rate>0) g.playbackRate=rate;
        publish(nativeMeta(n));
      });

      /*
        Returning to the same audio page: the muted native UI clock joins
        the already-playing persistent owner without pausing the owner.
      */
      const g=gAudio();
      if (g && sameSrc(g.currentSrc||g.src,n.currentSrc||n.src)) {
        setTime(n,g.currentTime);
        n.playbackRate=g.playbackRate||1;
        syncNativeFromOwner();
      }
    }

    function bindGlobal() {
      const g=gAudio();
      if (!g || g===boundGlobal || g.dataset.mahoonR5OwnerBound==="1") return;

      boundGlobal=g;
      g.dataset.mahoonR5OwnerBound="1";

      for (const name of [
        "play","pause","timeupdate","loadedmetadata",
        "durationchange","ratechange","ended"
      ]) {
        g.addEventListener(name,()=>{
          publish();
          syncNativeFromOwner();
        });
      }
    }

    /* MAHOON_STAGE19B_F_R4_R5_R2_FEEDBACK_LOOP_AND_DOCK_VISIBILITY_FIX */
    function updateInlineVisibility() {
      const surface=document.querySelector(
        '[data-mahoon-native-player] .mahoon-native-player__surface'
      );

      let visible=false;

      if (surface instanceof HTMLElement) {
        const r=surface.getBoundingClientRect();
        const visiblePx=Math.max(
          0,
          Math.min(r.bottom,innerHeight)-Math.max(r.top,0)
        );
        const threshold=Math.min(
          120,
          Math.max(48,Math.max(1,r.height)*0.12)
        );
        visible=visiblePx>=threshold;
      }

      document.body?.classList.toggle(
        "mahoon-r5-r2-inline-surface-visible",
        visible
      );

      /*
        Apply immediately, not 500ms later: the frozen dock must disappear
        while the real inline player is meaningfully visible and reappear
        as soon as the user scrolls away or navigates to a non-audio page.
      */
      const sticky=document.querySelector(ROOT_SELECTOR+" #sticky");
      const stored=readState();
      if (sticky instanceof HTMLElement) {
        const showDock=Boolean(stored?.engaged && !visible);
        sticky.classList.toggle("show",showDock);
        document.body?.classList.toggle(
          "mahoon-r5-r3-dock-visible",
          showDock
        );
      }
    }

    function footerLift() {
      const sticky=document.querySelector(ROOT_SELECTOR+" #sticky");
      const footer=document.querySelector("footer");

      let lift=0;

      if (
        sticky instanceof HTMLElement &&
        footer instanceof HTMLElement &&
        sticky.classList.contains("show")
      ) {
        const r=footer.getBoundingClientRect();

        if (r.top<innerHeight && r.bottom>0) {
          /*
            CSS already supplies the frozen 12px/8px base gap.
            Do not add a second gap here: that lifted the dock high enough
            to overlap the last category/cards before the footer.
          */
          lift=Math.max(0,innerHeight-r.top);
        }
      }

      document.documentElement.style.setProperty(
        "--mahoon-r5-footer-lift",
        Math.round(lift)+"px"
      );
    }

    function zeroFlowRepair() {
      /*
        Explicitly clear only historical audio-dock layout reservations.
        The real footer must be the final flow content again.
      */
      document.body?.style.removeProperty("padding-bottom");
      document.documentElement.style.removeProperty("--mahoon-r4-footer-lift");

      const root=document.querySelector(ROOT_SELECTOR);
      if (root instanceof HTMLElement) {
        root.style.setProperty("position","fixed","important");
        root.style.setProperty("height","0px","important");
        root.style.setProperty("min-height","0px","important");
        root.style.setProperty("max-height","0px","important");
        root.style.setProperty("margin","0","important");
        root.style.setProperty("padding","0","important");
      }
    }

    function bootPage() {
      zeroFlowRepair();
      bindGlobal();
      bindNative();
      syncNativeFromOwner();
      updateInlineVisibility();
      footerLift();

      setTimeout(()=>{
        bindNative();
        syncNativeFromOwner();
        updateInlineVisibility();
        footerLift();
      },120);

      setTimeout(()=>{
        bindNative();
        syncNativeFromOwner();
        updateInlineVisibility();
        footerLift();
      },650);
    }

    /*
      There is NO native->global navigation handoff anymore.
      The global owner has already been playing audibly since first Play.
    */
    document.addEventListener("astro:before-preparation",()=>{
      navigating=true;
      publish();
    });

    document.addEventListener("astro:before-swap",(event)=>{
      const theme=document.documentElement.dataset.mahoonTheme;
      const mode=document.documentElement.dataset.mahoonThemeMode;

      if (event?.newDocument?.documentElement) {
        if (theme) event.newDocument.documentElement.dataset.mahoonTheme=theme;
        if (mode) event.newDocument.documentElement.dataset.mahoonThemeMode=mode;
      }
    });

    document.addEventListener("astro:page-load",()=>{
      navigating=false;
      requestAnimationFrame(bootPage);
    });

    const syncViewport=()=>{
      updateInlineVisibility();
      footerLift();
    };
    window.addEventListener("resize",syncViewport,{passive:true});
    window.addEventListener("scroll",syncViewport,{passive:true});

    const mo=new MutationObserver(()=>{
      zeroFlowRepair();
      bindNative();
      updateInlineVisibility();
      footerLift();
    });

    function boot() {
      bindGlobal();
      bootPage();

      if (document.body) {
        mo.observe(document.body,{
          childList:true,
          subtree:true,
          attributes:true,
          attributeFilter:["class"]
        });
      }

      setInterval(()=>{
        bindGlobal();
        bindNative();
        updateInlineVisibility();
        footerLift();
      },750);
    }

    if (document.readyState==="loading") {
      document.addEventListener("DOMContentLoaded",boot,{once:true});
    } else {
      boot();
    }
  })();
</script>

<style is:global>
  /* MAHOON_STAGE19B_F_R4_R5_R3_FOOTER_CONTROL_GEOMETRY */

  /*
    The legacy dock-active class described engagement, not actual dock visibility.
    It therefore pushed the theme control upward even when the dock was hidden.
    Neutralize that behavior and key placement to the real visible dock instead.
  */
  body.mahoon-r4-r3-dock-active .mahoon-r4-theme-control {
    bottom: max(16px, env(safe-area-inset-bottom)) !important;
  }

  /*
    Desktop: the theme control has enough horizontal room at far left.
    Align its bottom edge with the frozen dock instead of floating 88px above it.
    Both controls use the SAME footer-lift variable and neither changes page flow.
  */
  body.mahoon-r5-r3-dock-visible .mahoon-r4-theme-control {
    bottom:
      calc(
        max(12px, env(safe-area-inset-bottom)) +
        var(--mahoon-r5-footer-lift, 0px)
      ) !important;
  }

  @media (max-width:620px) {
    body.mahoon-r4-r3-dock-active .mahoon-r4-theme-control {
      bottom: max(10px, env(safe-area-inset-bottom)) !important;
    }

    /*
      Mobile has no safe horizontal lane beside the full-width dock,
      so the theme control stays above it, but still follows footer lift.
    */
    body.mahoon-r5-r3-dock-visible .mahoon-r4-theme-control {
      bottom:
        calc(
          max(8px, env(safe-area-inset-bottom)) +
          var(--mahoon-r5-footer-lift, 0px) +
          72px
        ) !important;
    }
  }
</style>

