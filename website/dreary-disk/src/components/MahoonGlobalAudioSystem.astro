.mahoon-frozen-global-scope, .mahoon-frozen-global-scope{max-width:100%;overflow-x:hidden!important}
.mahoon-frozen-global-scope .inlinePlayer, .mahoon-frozen-global-scope .hero, .mahoon-frozen-global-scope .core, .mahoon-frozen-global-scope .actions, .mahoon-frozen-global-scope .sticky, .mahoon-frozen-global-scope .modal, .mahoon-frozen-global-scope .modalPanel, .mahoon-frozen-global-scope .modalTop, .mahoon-frozen-global-scope .modalMid, .mahoon-frozen-global-scope .modalBottom, .mahoon-frozen-global-scope .coverRow{min-width:0!important;box-sizing:border-box}
