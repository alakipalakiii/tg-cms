    const FROZEN_STICKY = "<div class=\"sticky\" id=\"sticky\"><button class=\"stickCtrl stickExpand\" id=\"expandBtn\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"m7 14 5-5 5 5\"/></svg></button><button class=\"stickCtrl stickForward js-forward\">۱۰+</button><button class=\"stickCtrl play stickPlay js-play\"><svg class=\"playIcon\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M6.5 4.2v15.6L19.5 12z\"/></svg></button><button class=\"stickCtrl stickBack js-back\">۱۰−</button><button class=\"stickCtrl stickSpeed js-speed\">۱٫۲۵×</button><div class=\"stickyWave\"><div class=\"stickyTime\">۰۲:۳۳ / ۱۶:۲۴</div><canvas class=\"stickyCanvas js-wave\"></canvas></div><div class=\"stickyInfo\"><strong>الان سال ۱۵۰۴، تو کجایی؟</strong><span>در حال پخش</span></div><div class=\"stickyCover\"><img src=\"\" alt=\"\"></div></div>";
    const FROZEN_MODAL = "<div class=\"modal\" id=\"modal\"><section class=\"modalPanel\"><div class=\"modalBg\"></div><div class=\"modalShade\"></div><div class=\"modalTop\"><button class=\"close\" id=\"closeBtn\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"m6 6 12 12M18 6 6 18\"/></svg></button><span class=\"modalType\">پادکست / گفتار</span></div><div class=\"modalMid\"><h2 class=\"modalTitle\">الان سال ۱۵۰۴، تو کجایی؟</h2><div class=\"coverRow\"><div class=\"skipFloat\"><button class=\"skipCircle js-back\">۱۰−</button><span>۱۰ ثانیه عقب</span></div><div><div class=\"modalCover\"><img src=\"\" alt=\"کاور\"></div><div class=\"coverLabel\">صوت ماهون</div></div><div class=\"skipFloat\"><button class=\"skipCircle js-forward\">۱۰+</button><span>۱۰ ثانیه جلو</span></div></div><div class=\"modalMeta\"><span>◉ ۱۲٬۳۴۳</span><span>▣ ۲۶ اردیبهشت ۱۴۰۳</span><span>◷ ۱۶:۲۴</span></div><div class=\"modalWaveBox\"><canvas class=\"modalCanvas js-wave\"></canvas><div class=\"time\"><span class=\"elapsed\">۰:۰۰</span><span class=\"duration\">۰:۱۸</span></div></div></div><div class=\"modalBottom\"><div class=\"modalActions\"><div class=\"modalGroup\"><div class=\"modalControl\"><button class=\"controlBtn js-speed\">۱٫۲۵×</button><label>سرعت پخش</label></div><div class=\"modalControl\"><button class=\"controlBtn icon downloadBtn\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M12 3v12m0 0 4.5-4.5M12 15l-4.5-4.5M5 21h14\"/></svg></button><label>دانلود</label></div></div><button class=\"modalPlay js-play\"><svg class=\"playIcon\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M6.5 4.2v15.6L19.5 12z\"/></svg></button><div class=\"modalGroup end\"><div class=\"modalControl\"><button class=\"controlBtn icon shareBtn\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"18\" cy=\"5\" r=\"2.4\"/><circle cx=\"6\" cy=\"12\" r=\"2.4\"/><circle cx=\"18\" cy=\"19\" r=\"2.4\"/><path d=\"m8.2 10.8 7.6-4.4M8.2 13.2l7.6 4.4\"/></svg></button><label>اشتراک‌گذاری</label></div><div class=\"modalControl mobileSkip\"><button class=\"controlBtn js-forward\">۱۰+</button><label>جلو</label></div><div class=\"modalControl mobileSkip\"><button class=\"controlBtn js-back\">۱۰−</button><label>عقب</label></div></div></div><div class=\"modalPremium\"><button class=\"cta accessBtn\">مشاهده بیشتر</button><div class=\"premiumInfo\"><div><strong>دسترسی پریمیوم</strong><small>به تمامی آثار با مطالعه و دانلود اختصاصی دسترسی داشته باشید.</small></div><div class=\"diamond\"><svg viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.7\"><path d=\"M10 11h28l7 10-21 23L3 21z\"/><path d=\"m10 11 14 33 14-33M3 21h42M17 11l-5 10M31 11l5 10\"/></svg></div></div></div></div></section></div>";
    const AMPS = [0.281,0.413,0.531,0.626,0.687,0.71,0.692,0.634,0.542,0.426,0.294,0.383,0.495,0.585,0.643,0.663,0.642,0.582,0.488,0.367,0.231,0.28,0.39,0.479,0.551,0.595,0.599,0.564,0.493,0.395,0.28,0.314,0.445,0.556,0.637,0.682,0.687,0.651,0.579,0.478,0.357,0.349,0.474,0.58,0.658,0.699,0.701,0.662,0.585,0.478,0.351,0.3,0.418,0.52,0.594,0.633,0.633,0.593,0.515,0.407,0.277,0.188,0.32,0.443,0.541,0.605,0.63,0.614,0.561,0.476,0.367,0.262,0.397,0.518,0.615,0.678,0.702,0.686,0.63,0.541,0.427,0.299,0.407,0.523,0.614,0.674,0.695,0.675,0.616,0.522,0.403,0.268,0.334,0.445,0.533,0.591,0.611,0.592,0.533,0.44,0.339,0.225,0.276,0.408,0.52,0.602,0.647,0.652,0.618,0.547,0.448,0.33,0.342,0.47,0.579,0.659,0.702,0.705,0.668,0.594,0.489,0.365,0.334,0.454,0.558,0.633,0.673,0.673,0.633,0.555,0.447,0.318,0.245,0.361,0.462,0.536,0.577,0.58,0.563,0.509,0.424,0.316,0.229,0.366,0.489,0.586,0.651,0.676,0.661,0.607,0.52,0.409,0.285,0.413,0.531,0.625,0.687,0.709,0.691,0.633,0.542,0.425,0.293,0.378,0.49,0.579,0.637,0.657,0.637,0.577,0.483,0.363,0.226,0.272,0.382,0.476,0.557,0.601,0.606,0.571];

    const THEME_KEY = "mahoon-theme-mode-v1";
    const AUDIO_KEY = "mahoon-global-audio-state-v1";
    const MODES = ["auto","light","dark"];
    const FA = "۰۱۲۳۴۵۶۷۸۹";

    const touched = new Set();
    const originals = new WeakMap();
    let darkTimer = 0;

    function toFa(v) {
      return String(v).replace(/\d/g, d => FA[Number(d)]);
    }

    function fmt(value) {
      const s = Math.max(0,Number(value || 0) || 0);
      return toFa(Math.floor(s/60) + ":" + String(Math.floor(s%60)).padStart(2,"0"));
    }

    function parseColor(value) {
      const m = String(value || "").match(
        /rgba?\(([\d.]+)[,\s]+([\d.]+)[,\s]+([\d.]+)(?:[,\s\/]+([\d.]+))?\)/i
      );
      if (!m) return null;
      return {
        r:Number(m[1])/255,
        g:Number(m[2])/255,
        b:Number(m[3])/255,
        a:m[4] == null ? 1 : Number(m[4])
      };
    }

    function lum(c) {
      if (!c) return 0;
      const f = v => v <= .03928 ? v/12.92 : Math.pow((v+.055)/1.055,2.4);
      return .2126*f(c.r) + .7152*f(c.g) + .0722*f(c.b);
    }

    function hsl(c) {
      if (!c) return {h:0,s:0,l:0};
      const max=Math.max(c.r,c.g,c.b), min=Math.min(c.r,c.g,c.b);
      const d=max-min, l=(max+min)/2;
      const s=d===0?0:d/(1-Math.abs(2*l-1));
      let h=0;
      if (d) {
        if (max===c.r) h=60*(((c.g-c.b)/d)%6);
        else if (max===c.g) h=60*(((c.b-c.r)/d)+2);
        else h=60*(((c.r-c.g)/d)+4);
      }
      if (h<0) h+=360;
      return {h,s,l};
    }

    function saveOriginal(el) {
      if (originals.has(el)) return;
      const props = ["background","background-image","background-color","color","border-color","box-shadow"];
      const state = {};
      for (const p of props) {
        state[p] = {
          value: el.style.getPropertyValue(p),
          priority: el.style.getPropertyPriority(p)
        };
      }
      originals.set(el,state);
      touched.add(el);
    }

    function setImp(el, prop, value) {
      saveOriginal(el);
      el.style.setProperty(prop,value,"important");
    }

    function restoreDarkOverrides() {
      for (const el of touched) {
        const state = originals.get(el);
        if (!state || !el?.style) continue;
        for (const [prop, item] of Object.entries(state)) {
          if (item.value) el.style.setProperty(prop,item.value,item.priority || "");
          else el.style.removeProperty(prop);
        }
        el.removeAttribute("data-mahoon-r4-darkified");
      }
      touched.clear();
    }

    function excluded(el) {
      return (
        !(el instanceof HTMLElement) ||
        el.matches("img,picture,video,canvas,svg,path,source,script,style,link,meta") ||
        el.closest(".mahoon-frozen-global-scope,[data-mahoon-native-player],.mahoon-r4-theme-control")
      );
    }

    function darkifyElement(el) {
      if (excluded(el)) return;

      const cs = getComputedStyle(el);
      const rect = el.getBoundingClientRect();

      if (
        rect.width <= 0 &&
        rect.height <= 0 &&
        cs.position !== "fixed" &&
        cs.position !== "sticky"
      ) return;

      const bg = parseColor(cs.backgroundColor);
      const bgLum = lum(bg);
      const bgImage = String(cs.backgroundImage || "none");
      const hasUrl = /url\(/i.test(bgImage);
      const area = Math.max(0,rect.width) * Math.max(0,rect.height);

      if (!hasUrl) {
        if (bg && bg.a > .12 && bgLum > .78) {
          setImp(el,"background","#181214");
          setImp(el,"background-image","none");
          setImp(el,"border-color","rgba(255,255,255,.085)");
          if (area > 2400) setImp(el,"box-shadow","0 18px 52px rgba(0,0,0,.18)");
          el.dataset.mahoonR4Darkified = "surface1";
        } else if (bg && bg.a > .12 && bgLum > .46) {
          setImp(el,"background","#211719");
          setImp(el,"background-image","none");
          setImp(el,"border-color","rgba(255,255,255,.09)");
          el.dataset.mahoonR4Darkified = "surface2";
        } else if (
          bgImage !== "none" &&
          area > 1800 &&
          !/radial-gradient\([^)]*#[0-4]/i.test(bgImage)
        ) {
          /*
            Non-image gradients are a frequent reason a large light shell survives
            dark mode. The computed text/background test below will still preserve
            intentionally dark maroon banners.
          */
          const tc = parseColor(cs.color);
          if (!tc || lum(tc) < .68) {
            setImp(el,"background","#181214");
            setImp(el,"background-image","none");
            setImp(el,"border-color","rgba(255,255,255,.085)");
            el.dataset.mahoonR4Darkified = "gradient";
          }
        }
      }

      const c = parseColor(cs.color);
      if (!c || c.a < .35) return;

      const L = lum(c);
      const hh = hsl(c);
      const tag = el.tagName;
      const fontSize = parseFloat(cs.fontSize || "0") || 0;
      const weight = parseInt(cs.fontWeight || "400",10) || 400;
      const isHeading = /^H[1-6]$/.test(tag) || fontSize >= 20 || weight >= 750;
      const isLink = tag === "A" || el.closest("a") === el;
      const redFamily = (hh.h <= 30 || hh.h >= 335) && hh.s > .22;

      if (L < .68) {
        if (isHeading) {
          setImp(el,"color","#f5ece6");
        } else if (redFamily || isLink) {
          setImp(el,"color","#d75a50");
        } else if (L < .30) {
          setImp(el,"color","#f5ece6");
        } else {
          setImp(el,"color","#c7b8b1");
        }
      }
    }

    function darkify(root=document.body) {
      if (document.documentElement.dataset.mahoonTheme !== "dark") return;
      clearTimeout(darkTimer);
      darkTimer = setTimeout(() => {
        if (!root) return;
        if (root instanceof HTMLElement) darkifyElement(root);
        for (const el of root.querySelectorAll ? root.querySelectorAll("*") : []) {
          darkifyElement(el);
        }
        document.documentElement.style.setProperty("background","#0d090a","important");
        document.body.style.setProperty("background","#0d090a","important");
        document.body.style.setProperty("color","#f5ece6","important");
      },0);
    }

    function resolvedTheme(mode) {
      if (mode==="light" || mode==="dark") return mode;
      return matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }

    function label(mode) {
      return mode==="light" ? "روشن" : mode==="dark" ? "تیره" : "خودکار";
    }

    function applyTheme(mode,persist=true) {
      const clean = MODES.includes(mode) ? mode : "auto";
      const resolved = resolvedTheme(clean);

      if (resolved !== "dark") {
        restoreDarkOverrides();
        document.documentElement.style.removeProperty("background");
        document.body.style.removeProperty("background");
        document.body.style.removeProperty("color");
      }

      document.documentElement.dataset.mahoonThemeMode = clean;
      document.documentElement.dataset.mahoonTheme = resolved;

      document.querySelectorAll("[data-mahoon-r4-theme-label]").forEach(el => {
        el.textContent = label(clean);
      });

      if (persist) {
        try { localStorage.setItem(THEME_KEY,clean); } catch {}
      }

      window.dispatchEvent(new CustomEvent("mahoon:theme-change",{
        detail:{mode:clean,resolved}
      }));

      if (resolved==="dark") {
        darkify(document.body);
        setTimeout(() => darkify(document.body),120);
        setTimeout(() => darkify(document.body),650);
      }
    }

    function cycleTheme() {
      const current = document.documentElement.dataset.mahoonThemeMode || "auto";
      const i = MODES.indexOf(current);
      applyTheme(MODES[(i+1)%MODES.length]);
    }

    window.MahoonTheme = {
      set: applyTheme,
      cycle: cycleTheme,
      getMode: () => document.documentElement.dataset.mahoonThemeMode || "auto",
      getResolved: () => document.documentElement.dataset.mahoonTheme || resolvedTheme("auto"),
      refresh: () => darkify(document.body)
    };

    let initial="auto";
    try { initial=localStorage.getItem(THEME_KEY)||"auto"; } catch {}
    applyTheme(initial,false);

    const mq=matchMedia("(prefers-color-scheme: dark)");
    const sys=()=> {
      if ((document.documentElement.dataset.mahoonThemeMode||"auto")==="auto") {
        applyTheme("auto",false);
      }
    };
    if (mq.addEventListener) mq.addEventListener("change",sys);
    else if (mq.addListener) mq.addListener(sys);

    document.addEventListener("click",event=>{
      if (event.target.closest("[data-mahoon-r4-theme-toggle]")) cycleTheme();
    });

    const mo = new MutationObserver(records=>{
      if (document.documentElement.dataset.mahoonTheme!=="dark") return;
      for (const r of records) {
        for (const n of r.addedNodes) {
          if (n instanceof HTMLElement) darkify(n);
        }
      }
    });

    function readState() {
      try { return JSON.parse(localStorage.getItem(AUDIO_KEY)||"null"); }
      catch { return null; }
    }

    function writeState(state) {
      try {
        if (state?.src) localStorage.setItem(AUDIO_KEY,JSON.stringify(state));
      } catch {}
    }

    function init() {
      const scope=document.querySelector(".mahoon-frozen-global-scope");
      if (!scope || scope.dataset.r4Init==="1") return;
      scope.dataset.r4Init="1";

      const stickyHost=scope.querySelector("[data-mahoon-r4-frozen-sticky-host]");
      const modalHost=scope.querySelector("[data-mahoon-r4-frozen-modal-host]");
      stickyHost.innerHTML=FROZEN_STICKY;
      modalHost.innerHTML=FROZEN_MODAL;

      const sticky=scope.querySelector("#sticky");
      const modal=scope.querySelector("#modal");
      const audio=scope.querySelector(".mahoon-r4-global-audio");
      const toast=scope.querySelector(".mahoon-r4-toast");

      if (!sticky || !modal || !audio) {
        console.error("MAHOON R4 exact frozen global bootstrap missing nodes.");
        return;
      }

      let state=readState();
      let toastTimer=0;
      let inlineVisible=false;
      let nativeAudio=null;
      let nativeIO=null;

      function tip(text) {
        toast.textContent=text;
        toast.classList.add("show");
        clearTimeout(toastTimer);
        toastTimer=setTimeout(()=>toast.classList.remove("show"),1600);
      }

      function durationValue(a) {
        if (a && Number.isFinite(a.duration) && a.duration>0) return a.duration;
        return Math.max(0,Number(state?.duration||0)||0);
      }

      function currentAudio() {
        /* R4-R5: persistent global audio is the single authoritative owner. */
        return audio;
      }

      function setArtwork(image,title) {
        scope.querySelectorAll(".artwork img,.modalCover img,.stickyCover img").forEach(img=>{
          if (image) {
            img.src=image;
            img.alt=title||"";
            img.removeAttribute("srcset");
          } else {
            img.removeAttribute("src");
            img.alt="";
          }
        });

        scope.querySelectorAll(".heroBlur,.modalBg").forEach(el=>{
          el.style.backgroundImage=image
            ? 'url("' + String(image).replace(/"/g,"%22") + '")'
            : "";
        });
      }

      function renderMeta() {
        const title=state?.title||"پخش صوتی ماهون";
        const description=state?.description||"روایت صوتی مجله هنری ماهون";
        const category=state?.category||"صوتی";
        const date=state?.date||"";

        scope.querySelectorAll(".title,.modalTitle,.stickyInfo strong").forEach(el=>{
          el.textContent=title;
        });
        scope.querySelectorAll(".desc").forEach(el=>{
          el.textContent=description;
        });
        scope.querySelectorAll(".type,.modalType").forEach(el=>{
          el.textContent=category;
        });

        const total=durationValue(currentAudio());
        const meta=[date,category,total>0?fmt(total):""].filter(Boolean);

        scope.querySelectorAll(".meta,.modalMeta").forEach(box=>{
          box.innerHTML="";
          for (const value of meta) {
            const span=document.createElement("span");
            span.textContent=value;
            box.append(span);
          }
        });

        setArtwork(state?.image||"",title);
      }

      function draw(canvas,progress) {
        if (!(canvas instanceof HTMLCanvasElement)) return;
        const rect=canvas.getBoundingClientRect();
        if (!rect.width || !rect.height) return;

        const dpr=Math.min(2,devicePixelRatio||1);
        canvas.width=Math.max(1,Math.floor(rect.width*dpr));
        canvas.height=Math.max(1,Math.floor(rect.height*dpr));

        const c=canvas.getContext("2d");
        if (!c) return;

        c.setTransform(dpr,0,0,dpr,0,0);
        c.clearRect(0,0,rect.width,rect.height);

        const count=Math.max(1,Math.floor(rect.width/3));
        const step=rect.width/count;
        const mid=rect.height/2;

        for (let i=0;i<count;i++) {
          const a=AMPS[Math.floor((i/count)*AMPS.length)%AMPS.length]||.25;
          const bh=Math.max(2,a*rect.height*1.65);
          c.fillStyle=(i/count)<=progress
            ? "#e64f5f"
            : document.documentElement.dataset.mahoonTheme==="light"
              ? "rgba(112,91,87,.42)"
              : "rgba(84,76,76,.72)";
          c.fillRect(i*step,mid-bh/2,Math.max(1,step*.55),bh);
        }

        const x=progress*rect.width;
        c.fillStyle=document.documentElement.dataset.mahoonTheme==="light"
          ? "rgba(73,27,28,.76)"
          : "rgba(244,235,226,.92)";
        c.fillRect(Math.max(0,x-.5),8,1,Math.max(0,rect.height-16));
      }

      function redraw() {
        if (!state?.src || !state.engaged) {
          sticky.classList.remove("show");
          document.body?.classList.remove("mahoon-r5-r3-dock-visible");
          return;
        }

        const a=currentAudio();
        const total=durationValue(a);
        const current=Math.max(0,Number(a?.currentTime||state.currentTime||0)||0);
        const progress=total>0?Math.max(0,Math.min(1,current/total)):0;

        scope.querySelectorAll(".js-wave").forEach(canvas=>draw(canvas,progress));
        scope.querySelectorAll(".elapsed").forEach(el=>el.textContent=fmt(current));
        scope.querySelectorAll(".duration").forEach(el=>el.textContent=total>0?fmt(total):"۰:۰۰");
        scope.querySelectorAll(".playIcon").forEach(svg=>{
          svg.innerHTML=a?.paused
            ? '<path d="M6.5 4.2v15.6L19.5 12z"/>'
            : '<path d="M7 4.5h4v15H7zM13 4.5h4v15h-4z"/>';
        });

        const r5InlineVisible=
          Boolean(document.body?.classList.contains("mahoon-r5-r2-inline-surface-visible"));
        const r5DockVisible=
          Boolean(state.engaged && !inlineVisible && !r5InlineVisible);

        sticky.classList.toggle("show",r5DockVisible);
        document.body?.classList.toggle(
          "mahoon-r5-r3-dock-visible",
          r5DockVisible
        );

        state.currentTime=current;
        state.duration=total;
        state.rate=a?.playbackRate||state.rate||1;
        state.wasPlaying=Boolean(a && !a.paused);
        writeState(state);
      }

      function ensureGlobalSource() {
        if (!state?.src) return;

        /*
          R4-R5-R2: NEVER seek the audible owner merely because a state event fired.
          R5-R1 re-applied state.currentTime on every global timeupdate/custom event,
          which caused the audible 100-250ms chopping visible in the user's video.
          Restore position only when the source itself is actually being installed.
        */
        const current=audio.currentSrc||audio.src||"";
        let sourceChanged=true;
        try {
          sourceChanged=
            new URL(current||"about:blank",location.href).href !==
            new URL(state.src,location.href).href;
        } catch {
          sourceChanged=String(current||"")!==String(state.src||"");
        }

        if (sourceChanged) {
          audio.src=state.src;
          try { audio.load(); } catch {}
        }

        if (Number.isFinite(state.rate)&&state.rate>0) {
          audio.playbackRate=state.rate;
        }

        if (!sourceChanged) return;

        const restore=()=>{
          try {
            if (Number.isFinite(state.currentTime) && state.currentTime>0) {
              const limit=Number.isFinite(audio.duration)&&audio.duration>0
                ? audio.duration
                : state.currentTime;
              audio.currentTime=Math.min(limit,state.currentTime);
            }
          } catch {}
        };

        if (audio.readyState>=1) restore();
        else audio.addEventListener("loadedmetadata",restore,{once:true});
      }

      async function toggle() {
        ensureGlobalSource();
        const a=currentAudio();
        if (!a || !state?.src) return;

        try {
          if (a.paused) await a.play();
          else a.pause();
        } catch {
          tip("برای ادامه پخش دوباره لمس کنید.");
        }

        state.engaged=true;
        redraw();
      }

      function seek(delta) {
        ensureGlobalSource();
        const a=currentAudio();
        if (!a) return;
        const total=durationValue(a)||Infinity;
        try { a.currentTime=Math.max(0,Math.min(total,a.currentTime+delta)); } catch {}
        redraw();
      }

      const speeds=[.75,1,1.25,1.5,2];
      function speedLabel(v) {
        return v===.75?"۰٫۷۵×":v===1?"۱×":v===1.25?"۱٫۲۵×":v===1.5?"۱٫۵×":"۲×";
      }

      function cycleSpeed() {
        ensureGlobalSource();
        const a=currentAudio();
        if (!a) return;
        const now=a.playbackRate||1;
        const i=speeds.findIndex(v=>Math.abs(v-now)<.01);
        const next=speeds[(i+1)%speeds.length];
        a.playbackRate=next;
        state.rate=next;
        scope.querySelectorAll(".js-speed").forEach(el=>el.textContent=speedLabel(next));
        redraw();
      }

      function openModal() {
        renderMeta();
        modal.classList.add("show");
        modal.scrollTop=0;
        const panel=modal.querySelector(".modalPanel");
        if (panel) panel.scrollTop=0;
        document.body.style.overflow="hidden";
        requestAnimationFrame(redraw);
      }

      function closeModal() {
        modal.classList.remove("show");
        document.body.style.overflow="";
      }

      scope.querySelectorAll(".js-play").forEach(el=>el.addEventListener("click",toggle));
      scope.querySelectorAll(".js-back").forEach(el=>el.addEventListener("click",()=>seek(-10)));
      scope.querySelectorAll(".js-forward").forEach(el=>el.addEventListener("click",()=>seek(10)));
      scope.querySelectorAll(".js-speed").forEach(el=>el.addEventListener("click",cycleSpeed));

      scope.querySelectorAll(".js-wave").forEach(canvas=>{
        canvas.addEventListener("click",event=>{
          ensureGlobalSource();
          const a=currentAudio();
          const total=durationValue(a);
          if (!a || total<=0) return;
          const rect=canvas.getBoundingClientRect();
          const ratio=Math.max(0,Math.min(1,(event.clientX-rect.left)/Math.max(1,rect.width)));
          a.currentTime=total*ratio;
          redraw();
        });
      });

      scope.querySelectorAll(".shareBtn").forEach(button=>{
        button.addEventListener("click",async()=>{
          const url=state?.shareUrl||location.href;
          try {
            if (navigator.share) {
              await navigator.share({title:state?.title||"مجله هنری ماهون",url});
              return;
            }
            await navigator.clipboard.writeText(url);
            tip("لینک مطلب کپی شد.");
          } catch {}
        });
      });

      scope.querySelectorAll(".downloadBtn").forEach(button=>{
        button.addEventListener("click",()=>{
          if (!state?.src) return tip("فایل صوتی در دسترس نیست.");
          const a=document.createElement("a");
          a.href=state.src;
          a.download=state.fileName||"mahoon-audio";
          a.target="_blank";
          a.rel="noopener";
          document.body.append(a);
          a.click();
          a.remove();
        });
      });

      scope.querySelectorAll(".accessBtn").forEach(button=>{
        button.addEventListener("click",()=>{
          tip("دسترسی پریمیوم در مرحله بعد به سیستم عضویت متصل می‌شود.");
        });
      });

      const expandBtn=scope.querySelector("#expandBtn");
      const closeBtn=scope.querySelector("#closeBtn");
      if (expandBtn) expandBtn.addEventListener("click",openModal);
      if (closeBtn) closeBtn.addEventListener("click",closeModal);

      modal.addEventListener("click",event=>{
        if (event.target===modal) closeModal();
      });

      document.addEventListener("keydown",event=>{
        if (event.key==="Escape") closeModal();
      });

      function stateFromNative(root,a) {
        const title=String(root.querySelector(".mahoon-native-player__title")?.textContent||"").trim();
        const description=String(root.querySelector(".mahoon-native-player__description")?.textContent||"").trim();
        const image=root.querySelector(".mahoon-native-player__cover img")?.currentSrc ||
                    root.querySelector(".mahoon-native-player__cover img")?.src || "";
        const category=String(root.querySelector(".mahoon-native-player__kind")?.textContent||"صوتی").trim();
        const meta=[...root.querySelectorAll(".mahoon-native-player__meta > span")]
          .map(el=>String(el.textContent||"").trim())
          .filter(Boolean);

        return {
          ...(state||{}),
          src:a.currentSrc||a.src,
          title:title||"پخش صوتی ماهون",
          description,
          image,
          category,
          date:meta[0]||state?.date||"",
          fileName:root.dataset.fileName||state?.fileName||"mahoon-audio",
          shareUrl:root.dataset.shareUrl||state?.shareUrl||location.href,
          currentTime:Number(a.currentTime||0),
          duration:Number.isFinite(a.duration)&&a.duration>0?a.duration:Number(root.dataset.duration||0),
          rate:a.playbackRate||1,
          wasPlaying:!a.paused,
          engaged:true
        };
      }

  
    
    /*
      MAHOON_STAGE19B_F_R4_R5_R4_R2_DIRECT_INLINE_INPUT_BRIDGE

      IMPORTANT:
      The previous R4 bridge listened to "seeking"/"ratechange" on boundNative.
      Runtime QA proved those listeners were not attached to the exact inline
      player instance receiving the user's +10/-10/speed/waveform input.

      R4-R5-R4-R2 therefore binds to the USER INPUT itself at document capture
      level, resolves the exact inline player under that click/pointer event,
      then forwards the resulting transport state to the persistent owner.

      Visual DOM/CSS is not changed.
    */

    /*
      MAHOON_STAGE19B_F_R4_R5_R4_R4_EXACT_NATIVE_SELECTOR_FIX

      Runtime-proven DOM contract:
      root  = [data-mahoon-native-player]
      audio = audio.mahoon-native-player__audio
      wave  = canvas.mahoon-native-player__wave.js-wave
      controls use .js-forward / .js-back / .js-speed inside that root.
    */
    function mahoonInlineContextFromTarget(target) {
      const el=target instanceof Element ? target : null;
      if(!el) return null;

      const root=el.matches?.("[data-mahoon-native-player]")
        ? el
        : el.closest?.("[data-mahoon-native-player]");

      if(!root) return null;

      const audio=root.querySelector("audio.mahoon-native-player__audio");
      const wave=root.querySelector("canvas.mahoon-native-player__wave.js-wave");

      if(!(audio instanceof HTMLAudioElement) || !(wave instanceof HTMLCanvasElement)) return null;
      return {root,wave,audio};
    }

    function mahoonNormalizeControlText(text) {
      return String(text||"")
        .replace(/[۰-۹]/g,ch=>String("۰۱۲۳۴۵۶۷۸۹".indexOf(ch)))
        .replace(/[٠-٩]/g,ch=>String("٠١٢٣٤٥٦٧٨٩".indexOf(ch)))
        .replace(/\s+/g," ")
        .trim()
        .toLowerCase();
    }

    /*
      MAHOON_STAGE19B_F_R4_R5_R4_R6_DIRECT_OWNER_CAPTURE_FIX

      Self-contained transport bridge. It intentionally does not depend on
      R3 private lexical helpers such as prepareGlobalFromNative().
    */
    function mahoonOwnerForInline(n) {
      if (!(n instanceof HTMLAudioElement)) return null;

      const g=document.querySelector("audio.mahoon-r4-global-audio");
      if (!(g instanceof HTMLAudioElement)) return null;

      const ns=n.currentSrc||n.src||"";
      const gs=g.currentSrc||g.src||"";
      if (!gs && ns) {
        try { g.src=ns; } catch {}
      }
      return g;
    }

    function mahoonClampTime(g,value) {
      const t=Number(value);
      if(!Number.isFinite(t)) return Number(g.currentTime||0);
      const d=Number(g.duration);
      if(Number.isFinite(d)&&d>0) return Math.max(0,Math.min(t,d));
      return Math.max(0,t);
    }

    function mahoonOwnerSeekTo(n,value) {
      const g=mahoonOwnerForInline(n);
      if(!g) return false;

      const target=mahoonClampTime(g,value);
      try { g.currentTime=target; } catch { return false; }
      try { n.currentTime=target; } catch {}
      return true;
    }

    function mahoonOwnerSeekBy(n,delta) {
      const g=mahoonOwnerForInline(n);
      if(!g) return false;
      return mahoonOwnerSeekTo(n,Number(g.currentTime||0)+Number(delta||0));
    }

    /*
      MAHOON_STAGE19B_F_R4_R5_R4_R6_R2_SPEED_LABEL_SYNC

      R6-R1 deliberately owns the speed click in capture phase, so the original
      native click handler no longer updates .js-speed-value visually.
      Keep the transport architecture unchanged and update only that frozen UI
      value after the audible owner/native rate is changed.
    */
    function mahoonOwnerSetRate(n,rate) {
      const g=mahoonOwnerForInline(n);
      if(!g) return false;

      const r=Number(rate);
      if(!Number.isFinite(r)||r<=0) return false;

      try { g.playbackRate=r; } catch { return false; }
      try { n.playbackRate=r; } catch {}

      try {
        const root=n.closest("[data-mahoon-native-player]");
        const value=root?.querySelector(".js-speed-value");
        if(value){
          const fa="۰۱۲۳۴۵۶۷۸۹";
          const label=String(r)
            .replace(".", "٫")
            .replace(/[0-9]/g,d=>fa[Number(d)]) + "×";
          value.textContent=label;
        }
      } catch {}

      return true;
    }

    function mahoonNextRate(current) {
      const rates=[1,1.25,1.5,2];
      const r=Number(current)||1;
      let best=0;
      let dist=Infinity;
      for(let i=0;i<rates.length;i++){
        const d=Math.abs(rates[i]-r);
        if(d<dist){dist=d;best=i;}
      }
      return rates[(best+1)%rates.length];
    }

    function mahoonSyncInlineButtonAfterNative(ev) {
      const btn=ev.target instanceof Element
        ? ev.target.closest("button.js-forward,button.js-back,button.js-speed")
        : null;

      if(!btn) {
        const waveClick=ev.target instanceof Element
          ? ev.target.closest("canvas.mahoon-native-player__wave.js-wave")
          : null;
        if(waveClick){
          ev.preventDefault();
          ev.stopImmediatePropagation();
        }
        return;
      }

      const ctx=mahoonInlineContextFromTarget(btn);
      if(!ctx) return;

      ev.preventDefault();
      ev.stopImmediatePropagation();

      const g=mahoonOwnerForInline(ctx.audio);
      if(!g) return;

      if(btn.classList.contains("js-forward")){
        mahoonOwnerSeekBy(ctx.audio,10);
        return;
      }
      if(btn.classList.contains("js-back")){
        mahoonOwnerSeekBy(ctx.audio,-10);
        return;
      }
      if(btn.classList.contains("js-speed")){
        mahoonOwnerSetRate(ctx.audio,mahoonNextRate(Number(g.playbackRate||1)));
      }
    }

    function mahoonWavePointerToOwner(ev) {
      const canvas=ev.target instanceof Element
        ? ev.target.closest("canvas.mahoon-native-player__wave.js-wave")
        : null;
      if(!canvas) return;

      const ctx=mahoonInlineContextFromTarget(canvas);
      if(!ctx) return;

      const g=mahoonOwnerForInline(ctx.audio);
      if(!g) return;

      const clientX=Number(ev.clientX);
      if(!Number.isFinite(clientX)) return;

      ev.preventDefault();
      ev.stopImmediatePropagation();

      const rect=canvas.getBoundingClientRect();
      if(!(rect.width>0)) return;

      const fraction=Math.max(0,Math.min(1,(clientX-rect.left)/rect.width));
      const gd=Number(g.duration);
      const nd=Number(ctx.audio.duration);
      const duration=Number.isFinite(gd)&&gd>0 ? gd :
        (Number.isFinite(nd)&&nd>0 ? nd : 0);

      if(duration>0) mahoonOwnerSeekTo(ctx.audio,fraction*duration);
    }

    if(!globalThis.__MAHOON_R4_R5_R4_R2_INPUT_BOUND__){
      globalThis.__MAHOON_R4_R5_R4_R2_INPUT_BOUND__=true;

      // Capture phase guarantees we see the real user action even if the component
      // later stops propagation.
      document.addEventListener("click",mahoonSyncInlineButtonAfterNative,true);
      document.addEventListener("pointerdown",mahoonWavePointerToOwner,true);
    }

    globalThis.__MAHOON_INLINE_TRANSPORT_DEBUG__={
      version:"R4-R5-R4-R6-R2",
      ownerForInline:mahoonOwnerForInline,
      seekTo:mahoonOwnerSeekTo,
      seekBy:mahoonOwnerSeekBy,
      setRate:mahoonOwnerSetRate
    };

    function bindNative() {
        const root=document.querySelector("[data-mahoon-native-player]");
        const a=root?.querySelector("audio.mahoon-native-player__audio");
        const surface=root?.querySelector(".mahoon-native-player__surface");

        if (!(a instanceof HTMLAudioElement) || a.dataset.mahoonR4Bound==="1") {
          if (!a) {
            nativeAudio=null;
            inlineVisible=false;
            ensureGlobalSource();
            redraw();
          }
          return;
        }

        a.dataset.mahoonR4Bound="1";
        nativeAudio=a;

        const sync=()=>{
          state=stateFromNative(root,a);
          writeState(state);
          renderMeta();
          redraw();
        };

        for (const eventName of [
          "play","pause","timeupdate","loadedmetadata","durationchange","ratechange","ended"
        ]) {
          a.addEventListener(eventName,sync);
        }

        if (surface && "IntersectionObserver" in window) {
          if (nativeIO) nativeIO.disconnect();
          nativeIO=new IntersectionObserver(entries=>{
            inlineVisible=Boolean(entries[0]?.isIntersecting);
            redraw();
          },{threshold:.2});
          nativeIO.observe(surface);
        }

        if (!a.paused || a.currentTime>0) sync();
      }

      window.addEventListener("mahoon:audio-state",event=>{
        const detail=event.detail||{};
        if (!detail.src) return;
        state={...(state||{}),...detail,engaged:true};
        writeState(state);
        renderMeta();
        ensureGlobalSource();
        redraw();
      });

      for (const eventName of [
        "play","pause","timeupdate","loadedmetadata","durationchange","ratechange","ended"
      ]) {
        audio.addEventListener(eventName,()=>{
          /* R4-R5: global owner remains authoritative even on the audio page. */
          if (!state?.src) return;
          state.currentTime=Number(audio.currentTime||0);
          state.duration=Number.isFinite(audio.duration)?audio.duration:state.duration||0;
          state.rate=audio.playbackRate||1;
          state.wasPlaying=!audio.paused;
          state.engaged=true;
          writeState(state);
          redraw();
        });
      }

      window.addEventListener("mahoon:theme-change",()=>{
        redraw();
      });

      if (state?.src && state.engaged) {
        renderMeta();
        ensureGlobalSource();
        redraw();

        if (state.wasPlaying) {
          audio.play().catch(()=>{
            state.wasPlaying=false;
            writeState(state);
            redraw();
          });
        }
      }

      bindNative();
      setTimeout(bindNative,150);
      setTimeout(bindNative,800);
      document.addEventListener("astro:page-load",()=>{
        nativeAudio=null;
        inlineVisible=false;
        bindNative();
        ensureGlobalSource();
        redraw();
      });

      window.addEventListener("resize",redraw);
      if ("ResizeObserver" in window) {
        const ro=new ResizeObserver(redraw);
        scope.querySelectorAll(".js-wave").forEach(canvas=>ro.observe(canvas));
      }

      mo.observe(document.body,{childList:true,subtree:true});
      if (document.documentElement.dataset.mahoonTheme==="dark") darkify(document.body);

      setInterval(()=>{
        bindNative();
        redraw();
      },500);
    }

    if (document.readyState==="loading") {
      document.addEventListener("DOMContentLoaded",init,{once:true});
    } else {
      init();
    }
  })();
</script>

<style is:global>
  /* MAHOON_STAGE19B_F_R4_R3_VISIBLE_BUGFIX_LAYER */

  /* Restore approved modal top geometry. */
  .mahoon-frozen-global-scope .modalTop {
    position: relative !important;
    direction: ltr !important;
    justify-content: center !important;
  }

  .mahoon-frozen-global-scope .modalTop .close {
    position: absolute !important;
