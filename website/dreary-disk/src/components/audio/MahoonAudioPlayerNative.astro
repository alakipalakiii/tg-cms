---
interface Props {
  audioSrc: string;
  imageSrc?: string;
  title: string;
  description?: string;
  dateText?: string;
  categoryText?: string;
  durationSeconds?: number;
  fileName?: string;
  shareUrl?: string;
}

const {
  audioSrc,
  imageSrc = "",
  title,
  description = "",
  dateText = "",
  categoryText = "صوتی",
  durationSeconds = 0,
  fileName = "",
  shareUrl = ""
} = Astro.props;

const instanceId = "mahoon-audio-" + Math.random().toString(36).slice(2, 10);
---

<section
  id={instanceId}
  class="mahoon-native-player"
  data-mahoon-native-player
  data-duration={String(durationSeconds || 0)}
  data-file-name={fileName}
  data-share-url={shareUrl}
  dir="rtl"
>
  <div
    class="mahoon-native-player__blur"
    style={imageSrc ? `background-image:url("${imageSrc.replace(/"/g, "%22")}")` : undefined}
    aria-hidden="true"
  ></div>

  <div class="mahoon-native-player__surface">
    <div class="mahoon-native-player__topbar">
      <div class="mahoon-native-player__labels">
        <span class="mahoon-native-player__badge">صوت ماهون</span>
        <span class="mahoon-native-player__kind">{categoryText || "صوتی"}</span>
      </div>

    </div>

    <div class="mahoon-native-player__hero">
      <div class="mahoon-native-player__copy">
        <h1 class="mahoon-native-player__title">{title}</h1>

        {description && (
          <p class="mahoon-native-player__description">{description}</p>
        )}

        <div class="mahoon-native-player__meta" aria-label="اطلاعات فایل صوتی">
          {dateText && <span>{dateText}</span>}
          {categoryText && <span>{categoryText}</span>}
          <span class="js-duration-label">۰:۰۰</span>
        </div>
      </div>

      <figure class="mahoon-native-player__cover">
        {imageSrc ? (
          <img src={imageSrc} alt={title} width="520" height="520" loading="eager" decoding="async" />
        ) : (
          <span class="mahoon-native-player__cover-fallback" aria-hidden="true">م</span>
        )}
      </figure>
    </div>

    <div class="mahoon-native-player__timeline">
      <canvas class="mahoon-native-player__wave js-wave" height="100" aria-label="نوار زمانی فایل صوتی"></canvas>
      <div class="mahoon-native-player__times">
        <span class="js-elapsed">۰:۰۰</span>
        <span class="js-duration">۰:۰۰</span>
      </div>
    </div>

    <div class="mahoon-native-player__controls">
      <div class="mahoon-native-player__control-group mahoon-native-player__control-group--utility">
        <button class="mahoon-native-control js-download" type="button" aria-label="دانلود">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4h2v9l3-3 1.4 1.4L12 16.8l-5.4-5.4L8 10l3 3V4Zm-5 14h12v2H6v-2Z"/></svg>
          <span>دانلود</span>
        </button>
        <button class="mahoon-native-control js-share" type="button" aria-label="اشتراک‌گذاری">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 16a3 3 0 0 0-2.4 1.2L8.9 13.6a3.3 3.3 0 0 0 0-3.2l6.7-3.6A3 3 0 1 0 15 5c0 .2 0 .4.1.6L8.4 9.2a3 3 0 1 0 0 5.6l6.7 3.6A3 3 0 1 0 18 16Z"/></svg>
          <span>اشتراک‌گذاری</span>
        </button>
        <button class="mahoon-native-control js-forward" type="button" aria-label="ده ثانیه جلو">
          <b>+۱۰</b>
          <span>۱۰ ثانیه جلو</span>
        </button>
      </div>

      <button class="mahoon-native-play js-play" type="button" aria-label="پخش">
        <svg class="js-play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15L19 12 7 4.5Z"/></svg>
      </button>

      <div class="mahoon-native-player__control-group">
        <button class="mahoon-native-control js-back" type="button" aria-label="ده ثانیه عقب">
          <b>−۱۰</b>
          <span>۱۰ ثانیه عقب</span>
        </button>
        <button class="mahoon-native-control js-speed" type="button" aria-label="سرعت پخش">
          <b class="js-speed-value">۱×</b>
          <span>سرعت</span>
        </button>
      </div>
    </div>

    <div class="mahoon-native-premium">
      <div class="mahoon-native-premium__info">
        <span class="mahoon-native-premium__diamond" aria-hidden="true">
          <svg viewBox="0 0 32 32"><path d="m5 10 5-5h12l5 5-11 17L5 10Zm5.8-3-2.7 3h5.4l-2.7-3Zm4.8 0-1.9 3h4.6l-1.9-3h-.8Zm5.6 0-2.7 3h5.4l-2.7-3ZM9 12l6 10.2L13.1 12H9Zm6.1 0L16 19l.9-7h-1.8Zm3.8 0L17 22.2 23 12h-4.1Z"/></svg>
        </span>
        <span class="mahoon-native-premium__copy">
          <strong>دسترسی پریمیوم</strong>
          <small>به تمامی آثار با مطالعه و دانلود اختصاصی دسترسی داشته باشید.</small>
        </span>
      </div>
      <button class="mahoon-native-premium__cta js-premium" type="button">مشاهده بیشتر</button>
    </div>
  </div>

  <audio class="mahoon-native-player__audio" preload="metadata" src={audioSrc}></audio>
  <div class="mahoon-native-toast js-toast" role="status" aria-live="polite"></div>

  <div class="mahoon-native-modal js-modal" aria-hidden="true">
    <button class="mahoon-native-modal__backdrop js-close" type="button" aria-label="بستن"></button>
    <div
      class="mahoon-native-modal__blur"
      style={imageSrc ? `background-image:url("${imageSrc.replace(/"/g, "%22")}")` : undefined}
      aria-hidden="true"
    ></div>

    <section class="mahoon-native-modal__panel" role="dialog" aria-modal="true" aria-label={`پخش ${title}`}>
      <button class="mahoon-native-modal__close js-close" type="button" aria-label="بستن">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6.7 5.3 5.3 5.3 5.3-5.3 1.4 1.4-5.3 5.3 5.3 5.3-1.4 1.4-5.3-5.3-5.3 5.3-1.4-1.4 5.3-5.3-5.3-5.3 1.4-1.4Z"/></svg>
      </button>

      <span class="mahoon-native-modal__kind">{categoryText || "صوتی"}</span>
      <h2 class="mahoon-native-modal__title">{title}</h2>

      <figure class="mahoon-native-modal__cover">
        {imageSrc ? (
          <img src={imageSrc} alt="" width="460" height="460" loading="eager" decoding="async" />
        ) : (
          <span aria-hidden="true">م</span>
        )}
      </figure>

      <div class="mahoon-native-modal__meta">
        {dateText && <span>{dateText}</span>}
        {categoryText && <span>{categoryText}</span>}
        <span class="js-duration-label">۰:۰۰</span>
      </div>

      <div class="mahoon-native-modal__timeline">
        <canvas class="mahoon-native-player__wave js-wave" height="90"></canvas>
        <div class="mahoon-native-player__times">
          <span class="js-elapsed">۰:۰۰</span>
          <span class="js-duration">۰:۰۰</span>
        </div>
      </div>

      <div class="mahoon-native-modal__controls">
        <button class="mahoon-native-control js-back" type="button"><b>−۱۰</b><span>عقب</span></button>
        <button class="mahoon-native-control js-forward" type="button"><b>+۱۰</b><span>جلو</span></button>
        <button class="mahoon-native-control js-share" type="button">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 16a3 3 0 0 0-2.4 1.2L8.9 13.6a3.3 3.3 0 0 0 0-3.2l6.7-3.6A3 3 0 1 0 15 5c0 .2 0 .4.1.6L8.4 9.2a3 3 0 1 0 0 5.6l6.7 3.6A3 3 0 1 0 18 16Z"/></svg>
          <span>اشتراک</span>
        </button>
        <button class="mahoon-native-play js-play" type="button" aria-label="پخش">
          <svg class="js-play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15L19 12 7 4.5Z"/></svg>
        </button>
        <button class="mahoon-native-control js-download" type="button">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4h2v9l3-3 1.4 1.4L12 16.8l-5.4-5.4L8 10l3 3V4Zm-5 14h12v2H6v-2Z"/></svg>
          <span>دانلود</span>
        </button>
        <button class="mahoon-native-control js-speed" type="button"><b class="js-speed-value">۱×</b><span>سرعت پخش</span></button>
      </div>

      <div class="mahoon-native-premium mahoon-native-premium--modal">
        <div class="mahoon-native-premium__info">
          <span class="mahoon-native-premium__diamond" aria-hidden="true">
            <svg viewBox="0 0 32 32"><path d="m5 10 5-5h12l5 5-11 17L5 10Zm5.8-3-2.7 3h5.4l-2.7-3Zm4.8 0-1.9 3h4.6l-1.9-3h-.8Zm5.6 0-2.7 3h5.4l-2.7-3ZM9 12l6 10.2L13.1 12H9Zm6.1 0L16 19l.9-7h-1.8Zm3.8 0L17 22.2 23 12h-4.1Z"/></svg>
          </span>
          <span class="mahoon-native-premium__copy">
            <strong>دسترسی پریمیوم</strong>
            <small>به تمامی آثار با مطالعه و دانلود اختصاصی دسترسی داشته باشید.</small>
          </span>
        </div>
        <button class="mahoon-native-premium__cta js-premium" type="button">مشاهده بیشتر</button>
      </div>
    </section>
  </div>

  <div class="mahoon-native-sticky js-sticky" aria-hidden="true">
    <div class="mahoon-native-sticky__cover">
      {imageSrc ? <img src={imageSrc} alt="" width="52" height="52" /> : <span>م</span>}
    </div>
    <div class="mahoon-native-sticky__copy">
      <strong>{title}</strong>
      <span><span class="js-elapsed">۰:۰۰</span> / <span class="js-duration">۰:۰۰</span></span>
    </div>
    <button class="mahoon-native-sticky__play js-play" type="button" aria-label="پخش">
      <svg class="js-play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15L19 12 7 4.5Z"/></svg>
    </button>
  </div>
</section>

<style>
  .mahoon-native-player,
  .mahoon-native-player * { box-sizing: border-box; }

  .mahoon-native-player {
    --audio-mahoon: var(--mahoon, #4b0d0d);
    --audio-accent: #f14e5e;
    --audio-cream: #f5eee7;
    --audio-muted: #c4b7ae;
    --audio-line: rgba(255,255,255,.12);
    position: relative;
    isolation: isolate;
    width: 100%;
    color: var(--audio-cream);
    font-family: inherit;
    direction: rtl;
  }

  .mahoon-native-player button { font: inherit; }

  .mahoon-native-player__blur {
    position: absolute;
    inset: -20px;
    z-index: -2;
    background-position: center;
    background-size: cover;
    filter: blur(42px) saturate(.75);
    opacity: .18;
    border-radius: 42px;
  }

  .mahoon-native-player__surface {
    position: relative;
    overflow: hidden;
    border-radius: 30px;
    background:
      radial-gradient(circle at 25% 15%, rgba(113,27,34,.3), transparent 34%),
      linear-gradient(145deg, #1c1012 0%, #0b0809 60%, #090708 100%);
    border: 1px solid rgba(255,255,255,.09);
    box-shadow: 0 34px 80px rgba(34,11,12,.2);
  }

  .mahoon-native-player__surface::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(120deg, rgba(255,255,255,.025), transparent 26%),
      radial-gradient(circle at 82% 10%, rgba(255,255,255,.035), transparent 28%);
  }

  .mahoon-native-player__topbar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 26px 30px 0;
  }

  .mahoon-native-player__labels {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .mahoon-native-player__badge,
  .mahoon-native-player__kind {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 5px 13px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
  }

  .mahoon-native-player__badge {
    color: #ff7a86;
    border: 1px solid rgba(241,78,94,.42);
    background: rgba(96,13,23,.22);
  }

  .mahoon-native-player__kind {
    padding-inline: 2px;
    color: var(--audio-muted);
    background: transparent;
  }

  .mahoon-native-icon-button,
  .mahoon-native-control,
  .mahoon-native-play,
  .mahoon-native-modal__close,
  .mahoon-native-sticky__play {
    appearance: none;
    border: 0;
    cursor: pointer;
    color: inherit;
    background: transparent;
  }

  .mahoon-native-icon-button {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    border: 1px solid var(--audio-line);
    background: rgba(255,255,255,.025);
  }

  .mahoon-native-icon-button svg,
  .mahoon-native-control svg,
  .mahoon-native-modal__close svg,
  .mahoon-native-sticky__play svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .mahoon-native-player__hero {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(230px, .75fr);
    align-items: center;
    gap: clamp(28px, 5vw, 68px);
    padding: 28px 34px 38px;
  }

  .mahoon-native-player__copy { min-width: 0; text-align: right; }

  .mahoon-native-player__title {
    margin: 0;
    max-width: 700px;
    color: var(--audio-cream);
    font-size: clamp(34px, 4.4vw, 64px);
    font-weight: 800;
    line-height: 1.48;
    letter-spacing: -.025em;
    text-wrap: balance;
  }

  .mahoon-native-player__description {
    margin: 14px 0 0;
    max-width: 640px;
    color: var(--audio-muted);
    font-size: 15px;
    line-height: 2;
  }

  .mahoon-native-player__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin-top: 20px;
    color: #b6a9a2;
    font-size: 12px;
  }

  .mahoon-native-player__cover {
    width: min(100%, 310px);
    aspect-ratio: 1;
    margin: 0;
    justify-self: end;
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid rgba(255,255,255,.18);
    background: var(--audio-mahoon);
    box-shadow: 0 24px 55px rgba(0,0,0,.32);
  }

  .mahoon-native-player__cover img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .mahoon-native-player__cover-fallback {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 90px;
    font-weight: 800;
  }

  .mahoon-native-player__timeline {
    position: relative;
    z-index: 1;
    padding: 24px 32px 0;
    border-top: 1px solid rgba(255,255,255,.055);
    background: rgba(0,0,0,.24);
  }

  .mahoon-native-player__wave {
    width: 100%;
    height: 94px;
    display: block;
    cursor: pointer;
    touch-action: manipulation;
  }

  .mahoon-native-player__times {
    display: flex;
    direction: ltr;
    justify-content: space-between;
    min-height: 26px;
    color: #978a83;
    font-size: 10px;
  }

  .mahoon-native-player__controls {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 18px;
    padding: 8px 32px 24px;
    background: rgba(0,0,0,.24);
  }

  .mahoon-native-player__control-group {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 14px;
  }

  .mahoon-native-player__control-group--utility { justify-content: flex-end; }

  .mahoon-native-control {
    min-width: 62px;
    min-height: 58px;
    padding: 7px 8px;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border-radius: 14px;
    border: 1px solid var(--audio-line);
    color: #f0e9e3;
    background: rgba(255,255,255,.015);
  }

  .mahoon-native-control b { font-size: 13px; font-weight: 800; }
  .mahoon-native-control span { color: #aaa09a; font-size: 10px; white-space: nowrap; }

  .mahoon-native-play {
    width: 82px;
    height: 82px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--audio-cream);
    border: 1px solid rgba(241,78,94,.82);
    background: #171113;
    box-shadow: 0 0 0 8px rgba(241,78,94,.045), 0 14px 38px rgba(0,0,0,.3);
  }

  .mahoon-native-play svg {
    width: 34px;
    height: 34px;
    fill: currentColor;
  }

  .mahoon-native-premium {
    position: relative;
    z-index: 1;
    margin: 0 32px 28px;
    min-height: 72px;
    padding: 12px 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    border-radius: 14px;
    border: 1px solid rgba(241,78,94,.28);
    background: linear-gradient(90deg, rgba(67,13,18,.72), rgba(91,16,24,.54));
  }

  .mahoon-native-premium__info {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    direction: rtl;
    text-align: right;
    min-width: 0;
    margin-right: 0;
    margin-left: auto;
  }

  .mahoon-native-premium__diamond {
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    color: var(--audio-accent);
  }

  .mahoon-native-premium__diamond svg { width: 32px; height: 32px; fill: currentColor; }
  .mahoon-native-premium__copy { min-width: 0; }
  .mahoon-native-premium__copy strong,
  .mahoon-native-premium__copy small { display: block; }

  .mahoon-native-premium__copy strong {
    color: #fff4ed;
    font-size: 15px;
    font-weight: 800;
  }

  .mahoon-native-premium__copy small {
    margin-top: 3px;
    color: #bca9a4;
    font-size: 10px;
    line-height: 1.7;
  }

  .mahoon-native-premium__cta {
    order: -1;
    flex: 0 0 auto;
    min-width: 116px;
    min-height: 42px;
    padding: 8px 18px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,.16);
    color: #fff;
    background: rgba(255,255,255,.02);
    cursor: pointer;
    font-weight: 800;
    font-size: 12px;
  }

  .mahoon-native-player__audio { display: none; }

  .mahoon-native-toast {
    position: fixed;
    z-index: 2147483647;
    left: 50%;
    top: max(18px, env(safe-area-inset-top));
    max-width: min(90vw, 520px);
    padding: 10px 16px;
    border-radius: 12px;
    color: #fff;
    background: rgba(15,10,11,.96);
    border: 1px solid rgba(255,255,255,.12);
    box-shadow: 0 18px 50px rgba(0,0,0,.35);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -18px);
    transition: opacity .18s ease, transform .18s ease;
    font-size: 12px;
  }

  .mahoon-native-toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .mahoon-native-modal {
    position: fixed;
    z-index: 10000;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 28px;
    opacity: 0;
    visibility: hidden;
    transition: opacity .2s ease, visibility .2s ease;
  }

  .mahoon-native-modal.is-open { opacity: 1; visibility: visible; }

  .mahoon-native-modal__backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(5,4,4,.78);
    backdrop-filter: blur(9px);
  }

  .mahoon-native-modal__blur {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-position: center;
    background-size: cover;
    filter: blur(78px) saturate(.65);
    opacity: .22;
    transform: scale(1.15);
  }

  .mahoon-native-modal__panel {
    position: relative;
    width: min(880px, 100%);
    max-height: min(90vh, 920px);
    overflow: auto;
    padding: 28px 30px 24px;
    border-radius: 28px;
    color: var(--audio-cream);
    background:
      radial-gradient(circle at 35% 5%, rgba(112,29,34,.28), transparent 35%),
      linear-gradient(150deg, #1a1011, #090708 72%);
    border: 1px solid rgba(255,255,255,.13);
    box-shadow: 0 34px 90px rgba(0,0,0,.55);
    text-align: center;
  }

  .mahoon-native-modal__close {
    position: absolute;
    top: 18px;
    left: 18px;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.16);
    background: rgba(255,255,255,.025);
  }

  .mahoon-native-modal__kind {
    display: block;
    margin: 2px auto 8px;
    color: #d2c7c1;
    font-size: 12px;
  }

  .mahoon-native-modal__title {
    width: min(680px, 88%);
