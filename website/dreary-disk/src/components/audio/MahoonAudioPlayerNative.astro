<script is:inline>
  (() => {
    const KEY = "mahoon-global-audio-state-v1";

    function readStored() {
      try { return JSON.parse(localStorage.getItem(KEY) || "null"); }
      catch { return null; }
    }

    function bindNativeState(root) {
      if (!root || root.dataset.globalStateBound === "1") return;
      root.dataset.globalStateBound = "1";

      const audio = root.querySelector("audio.mahoon-native-player__audio");
      if (!(audio instanceof HTMLAudioElement)) return;

      const title = root.querySelector(".mahoon-native-player__title")?.textContent?.trim() || document.title;
      const image = root.querySelector(".mahoon-native-player__cover img")?.src || "";
      let engaged = false;
      let lastEmit = 0;

      function emit(force = false) {
        if (!engaged && !force) return;
        const now = performance.now();
        if (!force && now - lastEmit < 450) return;
        lastEmit = now;

        const detail = {
          src: audio.currentSrc || audio.src || "",
          title,
          image,
          shareUrl: root.dataset.shareUrl || location.href,
          currentTime: Number(audio.currentTime || 0),
          duration: Number.isFinite(audio.duration)
            ? audio.duration
            : Number(root.dataset.duration || 0),
          rate: Number(audio.playbackRate || 1),
          wasPlaying: !audio.paused,
          engaged: true
        };

        if (!detail.src) return;

        try { localStorage.setItem(KEY, JSON.stringify(detail)); } catch {}
        window.dispatchEvent(new CustomEvent("mahoon:audio-state", { detail }));
      }

      const stored = readStored();
      const src = audio.currentSrc || audio.src;

      if (stored?.src && stored.src === src && stored.engaged) {
        engaged = true;

        const restore = () => {
          try {
            if (Number.isFinite(stored.currentTime)) {
              audio.currentTime = Math.min(
                Number.isFinite(audio.duration) && audio.duration > 0
                  ? audio.duration
                  : stored.currentTime,
                stored.currentTime
              );
            }
            if (Number.isFinite(stored.rate) && stored.rate > 0) {
              audio.playbackRate = stored.rate;
            }
          } catch {}
          emit(true);
        };

        if (audio.readyState >= 1) restore();
        else audio.addEventListener("loadedmetadata", restore, { once: true });
      }

      audio.addEventListener("play", () => {
        engaged = true;
        emit(true);
      });

      audio.addEventListener("pause", () => emit(true));
      audio.addEventListener("timeupdate", () => emit(false));
      audio.addEventListener("ratechange", () => emit(true));
      audio.addEventListener("loadedmetadata", () => {
        if (engaged) emit(true);
      });
      audio.addEventListener("ended", () => emit(true));

      window.addEventListener("mahoon:theme-change", () => {
        window.dispatchEvent(new Event("resize"));
      });
    }

    function boot() {
      document.querySelectorAll("[data-mahoon-native-player]").forEach(bindNativeState);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot, { once: true });
    } else {
      boot();
    }

    document.addEventListener("astro:page-load", boot);
  })();
</script>



