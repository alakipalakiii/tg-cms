<script is:inline>
  (() => {
    const FA = "۰۱۲۳۴۵۶۷۸۹";
    const SPEEDS = [0.75, 1, 1.25, 1.5, 2];

    function toFa(value) {
      return String(value).replace(/\d/g, (d) => FA[Number(d)]);
    }

    function formatTime(value) {
      const seconds = Math.max(0, Number(value || 0) || 0);
      const minutes = Math.floor(seconds / 60);
      const rest = Math.floor(seconds % 60);
      return toFa(minutes + ":" + String(rest).padStart(2, "0"));
    }

    function speedLabel(value) {
      if (value === 0.75) return "۰٫۷۵×";
      if (value === 1) return "۱×";
      if (value === 1.25) return "۱٫۲۵×";
      if (value === 1.5) return "۱٫۵×";
      return "۲×";
    }

    function amplitude(index) {
      const a = Math.abs(Math.sin(index * 0.49));
      const b = Math.abs(Math.sin(index * 0.113 + 1.8));
      const c = Math.abs(Math.sin(index * 0.071 + .2));
      return Math.min(.92, .18 + a * .37 + b * .19 + c * .11);
    }

    function initialize(root) {
      if (!(root instanceof HTMLElement) || root.dataset.initialized === "1") return;
      root.dataset.initialized = "1";
      /* MAHOON_STAGE19B_E_R1_EMPTY_WRAPPER_CLEANUP */
      const audioArticle = root.closest('article[data-audio-native="1"]');
      if (audioArticle) {
        audioArticle
          .querySelectorAll(".client-single-text, .client-single-tags")
          .forEach((el) => {
            const meaningfulText = String(el.textContent || "").trim();
            const meaningfulElement = el.querySelector(
              "img,video,audio,iframe,canvas,svg,a[href],button,input,textarea"
            );
            if (!meaningfulText && !meaningfulElement) {
              el.setAttribute("data-mahoon-empty", "1");
            }
          });
      }


      const audio = root.querySelector(".mahoon-native-player__audio");
      if (!(audio instanceof HTMLAudioElement)) return;

      const modal = root.querySelector(".js-modal");
      const sticky = root.querySelector(".js-sticky");
      const toast = root.querySelector(".js-toast");
      const surface = root.querySelector(".mahoon-native-player__surface");
      const declaredDuration = Math.max(0, Number(root.dataset.duration || 0) || 0);
      const title = root.querySelector(".mahoon-native-player__title")?.textContent?.trim() || document.title;
      const shareUrl = root.dataset.shareUrl || window.location.href;
      const fileName = root.dataset.fileName || "mahoon-audio";

      let speedIndex = 1;
      let surfaceVisible = true;
      let toastTimer = 0;

      const totalDuration = () =>
        Number.isFinite(audio.duration) && audio.duration > 0
          ? audio.duration
          : declaredDuration;

      function notify(message) {
        if (!toast) return;
        toast.textContent = message;
        toast.classList.add("is-visible");
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toast.classList.remove("is-visible"), 1800);
      }

      function drawWave(canvas) {
        if (!(canvas instanceof HTMLCanvasElement)) return;
        const rect = canvas.getBoundingClientRect();
        if (rect.width < 2 || rect.height < 2) return;

        const dpr = Math.min(2, window.devicePixelRatio || 1);
        canvas.width = Math.floor(rect.width * dpr);
        canvas.height = Math.floor(rect.height * dpr);

        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, rect.width, rect.height);

        const total = totalDuration();
        const progress = total > 0 ? Math.min(1, Math.max(0, audio.currentTime / total)) : 0;
        const count = Math.max(48, Math.floor(rect.width / 4));
        const gap = rect.width / count;
        const mid = rect.height / 2;

        for (let i = 0; i < count; i++) {
          const amp = amplitude(i);
          const height = Math.max(3, amp * rect.height * .82);
          const played = i / Math.max(1, count - 1) <= progress;
          ctx.fillStyle = played ? "#f14e5e" : "rgba(104,92,92,.52)";
          ctx.fillRect(i * gap, mid - height / 2, Math.max(1.35, gap * .46), height);
        }
      }

      function sync() {
        /*
          MAHOON_STAGE19B_F_R4_R5_R4_R8_NATIVE_RATE_STATE_RECONCILIATION

          R6-R2 already changes audio.playbackRate correctly.
          The visible speed label is rendered only from private speedIndex.
          Reconcile speedIndex from the actual native playbackRate before
          every render so owner->native rate sync and the UI cannot diverge.
        */
        const actualRate = Number(audio.playbackRate || 1);
        const actualRateIndex = SPEEDS.findIndex(
          (value) => Math.abs(value - actualRate) < .001
        );
        if (actualRateIndex >= 0) speedIndex = actualRateIndex;

        const duration = totalDuration();
        root.querySelectorAll(".js-elapsed").forEach((el) => {
          el.textContent = formatTime(audio.currentTime);
        });
        root.querySelectorAll(".js-duration,.js-duration-label").forEach((el) => {
          el.textContent = formatTime(duration);
        });
        root.querySelectorAll(".js-speed-value").forEach((el) => {
          el.textContent = speedLabel(SPEEDS[speedIndex]);
        });
        root.querySelectorAll(".js-play-icon").forEach((svg) => {
          svg.innerHTML = audio.paused
            ? '<path d="M7 4.5v15L19 12 7 4.5Z"/>'
            : '<path d="M7 4.5h4v15H7v-15Zm6 0h4v15h-4v-15Z"/>';
        });
        root.querySelectorAll(".js-wave").forEach(drawWave);

        if (sticky) {
          const visible = !audio.paused && !surfaceVisible;
          sticky.classList.toggle("is-visible", visible);
          sticky.setAttribute("aria-hidden", visible ? "false" : "true");
        }
      }

      async function togglePlay() {
        /* MAHOON_STAGE19B_F_R4_R5_R3_NATIVE_OWNER_TOGGLE */
        const owner=window.__MAHOON_AUDIO_OWNER_API__;

        if (owner && typeof owner.toggleFromNative==="function") {
          try {
            await owner.toggleFromNative(audio);
          } catch {
            notify("پخش فایل صوتی در مرورگر انجام نشد.");
          }
          sync();
          return;
        }

        /*
          Safe fallback only if the persistent owner is unavailable.
        */
        try {
          if (audio.paused) await audio.play();
          else audio.pause();
        } catch {
          notify("پخش فایل صوتی در مرورگر انجام نشد.");
        }
        sync();
      }

      root.querySelectorAll(".js-play").forEach((button) => button.addEventListener("click", togglePlay));

      root.querySelectorAll(".js-back").forEach((button) => {
        button.addEventListener("click", () => {
          audio.currentTime = Math.max(0, audio.currentTime - 10);
          sync();
        });
      });

      root.querySelectorAll(".js-forward").forEach((button) => {
        button.addEventListener("click", () => {
          const duration = totalDuration();
          audio.currentTime = duration > 0 ? Math.min(duration, audio.currentTime + 10) : audio.currentTime + 10;
          sync();
        });
      });

      root.querySelectorAll(".js-speed").forEach((button) => {
        button.addEventListener("click", () => {
          speedIndex = (speedIndex + 1) % SPEEDS.length;
          audio.playbackRate = SPEEDS[speedIndex];
          sync();
        });
      });

      root.querySelectorAll(".js-wave").forEach((canvas) => {
        canvas.addEventListener("click", (event) => {
          const duration = totalDuration();
          if (duration <= 0) return;
          const rect = canvas.getBoundingClientRect();
          const ratio = Math.min(1, Math.max(0, (event.clientX - rect.left) / Math.max(1, rect.width)));
          audio.currentTime = duration * ratio;
          sync();
        });
      });

      root.querySelectorAll(".js-download").forEach((button) => {
        button.addEventListener("click", () => {
          const url = audio.currentSrc || audio.src;
          if (!url) return notify("فایل صوتی برای دانلود در دسترس نیست.");
          const a = document.createElement("a");
          a.href = url;
          a.download = fileName;
          a.target = "_blank";
          a.rel = "noopener";
          document.body.appendChild(a);
          a.click();
          a.remove();
        });
      });

      root.querySelectorAll(".js-share").forEach((button) => {
        button.addEventListener("click", async () => {
          try {
            if (navigator.share) {
              await navigator.share({ title, url: shareUrl });
              return;
            }
            if (navigator.clipboard?.writeText) {
              await navigator.clipboard.writeText(shareUrl);
              notify("لینک مطلب کپی شد.");
              return;
            }
          } catch (error) {
            if (error && error.name === "AbortError") return;
          }
          notify("اشتراک‌گذاری در این مرورگر در دسترس نیست.");
        });
      });

      root.querySelectorAll(".js-premium").forEach((button) => {
        button.addEventListener("click", () => notify("دسترسی پریمیوم در مرحله بعد به سیستم عضویت متصل می‌شود."));
      });

      function openModal() {
        if (!modal) return;
        const modalPanel = modal.querySelector(".mahoon-native-modal__panel");
        if (modalPanel) modalPanel.scrollTop = 0;
        modal.classList.add("is-open");
        modal.setAttribute("aria-hidden", "false");
        document.documentElement.style.overflow = "hidden";
        window.setTimeout(sync, 50);
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.remove("is-open");
        modal.setAttribute("aria-hidden", "true");
        document.documentElement.style.overflow = "";
      }

      root.querySelectorAll(".js-expand").forEach((button) => button.addEventListener("click", openModal));
      root.querySelectorAll(".js-close").forEach((button) => button.addEventListener("click", closeModal));

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && modal?.classList.contains("is-open")) closeModal();
      });

      audio.addEventListener("play", sync);
      audio.addEventListener("pause", sync);
      audio.addEventListener("ended", sync);
      audio.addEventListener("timeupdate", sync);
      audio.addEventListener("loadedmetadata", sync);
      audio.addEventListener("durationchange", sync);

      /*
        MAHOON_STAGE19B_F_R4_R5_R4_R8_NATIVE_RATECHANGE_RENDER_SYNC
        Refresh the private speed state immediately whenever R6-R2 changes
        the muted native clock playbackRate.
      */
      audio.addEventListener("ratechange", sync);

      audio.addEventListener("error", () => notify("بارگذاری فایل صوتی انجام نشد."));

      if ("IntersectionObserver" in window && surface) {
        const observer = new IntersectionObserver((entries) => {
          surfaceVisible = Boolean(entries[0]?.isIntersecting);
          sync();
        }, { threshold: .16 });
        observer.observe(surface);
      }

      if ("ResizeObserver" in window) {
        const observer = new ResizeObserver(sync);
        root.querySelectorAll(".js-wave").forEach((canvas) => observer.observe(canvas));
      } else {
        window.addEventListener("resize", sync, { passive: true });
      }

      audio.playbackRate = SPEEDS[speedIndex];
      window.setTimeout(sync, 50);
      window.setTimeout(sync, 260);
    }

    function boot() {
      document.querySelectorAll("[data-mahoon-native-player]").forEach(initialize);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot, { once: true });
    } else {
      boot();
    }

    document.addEventListener("astro:page-load", boot);
  })();
</script>


