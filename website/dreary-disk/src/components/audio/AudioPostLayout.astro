<script is:inline>
  (() => {
    /* MAHOON_STAGE19B_F_R3_STRUCTURAL_SHELL_BINDER */

    function branchBelow(common, node) {
      let x = node;
      while (x && x.parentElement !== common) x = x.parentElement;
      return x && x.parentElement === common ? x : null;
    }

    function lca(a, b) {
      if (!a || !b) return null;
      const seen = new Set();
      let x = a;
      while (x) {
        seen.add(x);
        x = x.parentElement;
      }
      x = b;
      while (x) {
        if (seen.has(x)) return x;
        x = x.parentElement;
      }
      return null;
    }

    function findSuggestedHeading() {
      const all = [...document.querySelectorAll("body *")];
      return (
        all.find(el =>
          String(el.textContent || "").replace(/\s+/g, " ").trim() === "مطالب پیشنهادی"
        ) ||
        all.find(el =>
          String(el.textContent || "").includes("مطالب پیشنهادی")
        ) ||
        null
      );
    }

    function findSuggestionBox(heading) {
      if (!heading) return null;
      const aside = heading.closest("aside");
      if (aside) return aside;

      let node = heading;
      while (node && node !== document.body) {
        const rect = node.getBoundingClientRect();
        const text = String(node.textContent || "").replace(/\s+/g, " ").trim();
        const postLinks = node.querySelectorAll('a[href*="/post/"]').length;
        if (
          rect.width > 180 &&
          rect.height > 150 &&
          text.includes("مطالب پیشنهادی") &&
          postLinks >= 2
        ) {
          return node;
        }
        node = node.parentElement;
      }
      return heading.parentElement;
    }

    function markSuggestionList(box) {
      if (!box) return;
      const candidates = [box, ...box.querySelectorAll("*")];
      let best = null;
      let score = 0;

      for (const el of candidates) {
        const direct = [...el.children].filter(child =>
          child.matches('a[href*="/post/"]') ||
          child.querySelector('a[href*="/post/"]')
        ).length;

        if (direct >= 2 && direct > score) {
          best = el;
          score = direct;
        }
      }

      if (best) best.setAttribute("data-mahoon-r3-suggestion-list", "1");
    }

    function flattenPath(article, primary, common) {
      let x = article;
      while (x && x !== common) {
        x.setAttribute("data-mahoon-r3-audio-flatten", "1");
        if (x === primary) break;
        x = x.parentElement;
      }
    }

    function enforce() {
      const article = document.querySelector('article[data-audio-native="1"]');
      if (!article) return;

      const heading = findSuggestedHeading();
      const suggestionBox = findSuggestionBox(heading);

      if (!suggestionBox) {
        article.setAttribute("data-mahoon-r3-audio-flatten", "1");
        return;
      }

      let common = lca(article, suggestionBox);
      while (common && common !== document.body) {
        const p = branchBelow(common, article);
        const s = branchBelow(common, suggestionBox);
        if (p && s && p !== s) break;
        common = common.parentElement;
      }

      if (!common || common === document.body) return;

      const primary = branchBelow(common, article);
      const secondary = branchBelow(common, suggestionBox);
      if (!primary || !secondary || primary === secondary) return;

      common.setAttribute("data-mahoon-r3-audio-shell", "1");
      primary.setAttribute("data-mahoon-r3-audio-primary", "1");
      secondary.setAttribute("data-mahoon-r3-audio-secondary", "1");
      suggestionBox.setAttribute("data-mahoon-r3-suggestions", "1");
      markSuggestionList(suggestionBox);
      flattenPath(article, primary, common);

      /*
        Physically place the secondary editorial branch after the audio branch.
        This avoids relying on the old desktop Grid source order.
      */
      if (primary.nextElementSibling !== secondary) {
        primary.after(secondary);
      }

      for (const [el, props] of [
        [common, {
          display: "flex",
          flexDirection: "column",
          width: "min(1320px, calc(100% - 36px))",
          maxWidth: "1320px",
          minHeight: "0",
          height: "auto",
          padding: "0",
          background: "transparent",
          border: "0",
          boxShadow: "none",
          overflow: "visible"
        }],
        [primary, {
          width: "100%",
          maxWidth: "none",
          minHeight: "0",
          height: "auto",
          margin: "0",
          padding: "0",
          position: "static",
          background: "transparent",
          border: "0",
          boxShadow: "none"
        }],
        [secondary, {
          width: "100%",
          maxWidth: "none",
          minHeight: "0",
          height: "auto",
          marginTop: "30px",
          padding: "0",
          position: "static",
          background: "transparent",
          border: "0",
          boxShadow: "none"
        }]
      ]) {
        if (!el) continue;
        for (const [name, value] of Object.entries(props)) {
          el.style.setProperty(
            name.replace(/[A-Z]/g, c => "-" + c.toLowerCase()),
            value,
            "important"
          );
        }
      }

      let ancestor = article;
      while (ancestor && ancestor !== common) {
        ancestor.style.setProperty("min-height", "0", "important");
        ancestor.style.setProperty("height", "auto", "important");
        ancestor.style.setProperty("background", "transparent", "important");
        ancestor.style.setProperty("border", "0", "important");
        ancestor.style.setProperty("box-shadow", "none", "important");
        if (ancestor !== article.querySelector(".mahoon-audio-page__nav")) {
          ancestor.style.setProperty("max-width", "none", "important");
        }
        if (ancestor === primary) break;
        ancestor = ancestor.parentElement;
      }

      document.documentElement.dataset.mahoonAudioShellR3 = "bound";
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", enforce, { once: true });
    } else {
      enforce();
    }

    setTimeout(enforce, 120);
    setTimeout(enforce, 550);
    setTimeout(enforce, 1200);
    document.addEventListener("astro:page-load", enforce);
  })();
</script>

