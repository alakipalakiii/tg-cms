<script is:inline>
  (() => {
    /* MAHOON_STAGE19B_F_R4_R3_AUDIO_DOM_TRANSPLANT */

    function lca(a, b) {
      if (!a || !b) return null;
      const seen = new Set();
      let x = a;
      while (x) { seen.add(x); x = x.parentElement; }
      x = b;
      while (x) {
        if (seen.has(x)) return x;
        x = x.parentElement;
      }
      return null;
    }

    function branchBelow(common, node) {
      let x = node;
      while (x && x.parentElement !== common) x = x.parentElement;
      return x && x.parentElement === common ? x : null;
    }

    function findSuggestedHeading() {
      const nodes = [...document.querySelectorAll("body *")];
      return (
        nodes.find(el =>
          String(el.textContent || "").replace(/\s+/g, " ").trim() === "مطالب پیشنهادی"
        ) ||
        nodes.find(el => String(el.textContent || "").includes("مطالب پیشنهادی")) ||
        null
      );
    }

    function findSuggestionBox(heading) {
      if (!heading) return null;
      const aside = heading.closest("aside");
      if (aside) return aside;

      let x = heading;
      while (x && x !== document.body) {
        const rect = x.getBoundingClientRect();
        const text = String(x.textContent || "").replace(/\s+/g, " ").trim();
        const links = x.querySelectorAll('a[href*="/post/"]').length;
        if (
          rect.width > 170 &&
          rect.height > 140 &&
          text.includes("مطالب پیشنهادی") &&
          links >= 2
        ) {
          return x;
        }
        x = x.parentElement;
      }
      return heading.parentElement;
    }

    function markSuggestionList(box) {
      if (!box) return;
      const candidates = [box, ...box.querySelectorAll("*")];
      let best = null;
      let bestScore = 0;

      for (const el of candidates) {
        const direct = [...el.children].filter(child =>
          child.matches('a[href*="/post/"]') ||
          child.querySelector('a[href*="/post/"]')
        ).length;

        if (direct >= 2 && direct > bestScore) {
          best = el;
          bestScore = direct;
        }
      }

      if (best) best.setAttribute("data-mahoon-r4-suggestion-list", "1");
    }

    function useful(node) {
      if (!(node instanceof HTMLElement)) return false;
      if (node.matches("script,style,link")) return false;
      if (node.matches(".mahoon-audio-page__nav,[data-mahoon-native-player]")) return false;
      if (node.querySelector("[data-mahoon-native-player]")) return false;

      const text = String(node.textContent || "").replace(/\s+/g, " ").trim();
      return Boolean(text || node.querySelector("img,video,figure,a[href]"));
    }

    function transplant() {
      const article = document.querySelector('article[data-audio-native="1"]');
      const player = article?.querySelector("[data-mahoon-native-player]");
      if (!article || !player) return;

      if (document.querySelector(".mahoon-r4-audio-experience")) return;

      const main = article.closest("main") || document.querySelector("main") || document.body;
      const audioPage = article.querySelector(".mahoon-audio-page") || article;
      const nav =
        article.querySelector(".mahoon-audio-page__nav") ||
        document.querySelector("body .mahoon-audio-page__nav");

      const heading = findSuggestedHeading();
      const suggestions = findSuggestionBox(heading);

      let oldRoot =
        document.querySelector('[data-mahoon-r3-audio-shell="1"]') ||
        document.querySelector('[data-mahoon-audio-shell-r2="1"]') ||
        (suggestions ? lca(article, suggestions) : null);

      if (!oldRoot || oldRoot === document.body || oldRoot === main) {
        oldRoot = null;
      }

      const shell = document.createElement("section");
      shell.className = "mahoon-r4-audio-experience";
      shell.setAttribute("data-mahoon-r4-audio-experience", "1");

      const navSlot = document.createElement("div");
      navSlot.className = "mahoon-r4-audio-nav";

      const stage = document.createElement("div");
      stage.className = "mahoon-r4-audio-stage";

      const extras = document.createElement("div");
      extras.className = "mahoon-r4-audio-extras";

      const suggestionSlot = document.createElement("section");
      suggestionSlot.className = "mahoon-r4-audio-suggestions";

      const anchor = oldRoot || (() => {
        let x = article;
        while (x.parentElement && x.parentElement !== main) x = x.parentElement;
        return x;
      })();

      if (anchor?.parentElement) {
        anchor.parentElement.insertBefore(shell, anchor);
      } else {
        main.prepend(shell);
      }

      shell.append(navSlot, stage, extras);

      if (nav) navSlot.append(nav);
      stage.append(player);


      /*
        R4-R3: remove the generic post-media action that survived the transplant
        as the floating "بازکردن رسانه" button.
      */
      const cleanupRoot = oldRoot || article.parentElement || article;
      for (const el of [...cleanupRoot.querySelectorAll("a,button")]) {
        const txt = String(el.textContent || "").replace(/\s+/g, " ").trim();
        if (txt === "بازکردن رسانه") {
          const wrap =
            el.closest(".client-single-actions") ||
            el.closest("[data-media-actions]") ||
            el.parentElement;
          if (wrap && wrap !== cleanupRoot && wrap.children.length <= 3) wrap.remove();
          else el.remove();
        }
      }

      const possibleExtras = [
        ...article.querySelectorAll(
          ".client-single-text,.client-single-tags,.post-tags,.mahoon-audio-page__body"
        )
      ];

      for (const el of possibleExtras) {
        if (useful(el) && !extras.contains(el)) extras.append(el);
      }

      if (suggestions) {
        markSuggestionList(suggestions);
        suggestionSlot.append(suggestions);
        shell.append(suggestionSlot);

        suggestions.style.setProperty("width", "100%", "important");
        suggestions.style.setProperty("max-width", "none", "important");
        suggestions.style.setProperty("margin", "0", "important");
        suggestions.style.setProperty("position", "static", "important");
      }

      /*
        Hide the old generic post/grid scaffolding only after the real audio/nav/
        suggestions nodes have been moved into the dedicated experience.
      */
      if (oldRoot && oldRoot !== shell && !oldRoot.contains(shell)) {
        oldRoot.classList.add("mahoon-r4-old-audio-shell-hidden");
      } else {
        let articleBranch = article;
        while (articleBranch.parentElement && articleBranch.parentElement !== main) {
          articleBranch = articleBranch.parentElement;
        }
        if (articleBranch && articleBranch !== shell && !articleBranch.contains(shell)) {
          articleBranch.classList.add("mahoon-r4-old-audio-shell-hidden");
        }

        if (suggestions) {
          let suggestionBranch = suggestions;
          while (suggestionBranch.parentElement &&
                 suggestionBranch.parentElement !== shell &&
                 suggestionBranch.parentElement !== main) {
            suggestionBranch = suggestionBranch.parentElement;
          }
          if (
            suggestionBranch &&
            suggestionBranch !== shell &&
            !shell.contains(suggestionBranch)
          ) {
            suggestionBranch.classList.add("mahoon-r4-old-audio-shell-hidden");
          }
        }
      }

      article.style.setProperty("display", "none", "important");

      document.documentElement.dataset.mahoonAudioShellR4 = "transplanted";

      if (window.MahoonTheme?.refresh) {
        window.MahoonTheme.refresh();
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", transplant, { once: true });
    } else {
      transplant();
    }

    setTimeout(transplant, 120);
    setTimeout(transplant, 600);
    setTimeout(transplant, 1400);
    document.addEventListener("astro:page-load", transplant);
  })();
</script>

