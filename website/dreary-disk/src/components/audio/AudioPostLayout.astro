<script is:inline>
  (() => {
    function branchBelow(common, node) {
      let current = node;
      while (current && current.parentElement !== common) {
        current = current.parentElement;
      }
      return current && current.parentElement === common ? current : null;
    }

    function lowestCommonAncestor(a, b) {
      if (!a || !b) return null;
      const seen = new Set();
      let x = a;
      while (x) {
        seen.add(x);
        x = x.parentElement;
      }
      x = b;
      while (x) {
        if (seen.has(x)) return x;
        x = x.parentElement;
      }
      return null;
    }

    function findSuggestionContainer(heading) {
      if (!heading) return null;

      const aside = heading.closest("aside");
      if (aside) return aside;

      let node = heading;
      while (node && node !== document.body) {
        const rect = node.getBoundingClientRect();
        const text = String(node.textContent || "").replace(/\s+/g, " ").trim();
        const links = node.querySelectorAll('a[href*="/post/"]').length;

        if (
          rect.width > 200 &&
          rect.height > 160 &&
          text.includes("مطالب پیشنهادی") &&
          links >= 2
        ) {
          return node;
        }

        node = node.parentElement;
      }

      return heading.parentElement;
    }

    function markSuggestionList(container) {
      if (!container) return;

      const candidates = [container, ...container.querySelectorAll("*")];
      let best = null;
      let score = 0;

      for (const el of candidates) {
        const direct = [...el.children].filter(child =>
          child.matches('a[href*="/post/"]') ||
          child.querySelector('a[href*="/post/"]')
        ).length;

        if (direct >= 2 && direct > score) {
          best = el;
          score = direct;
        }
      }

      if (best) best.setAttribute("data-mahoon-suggestion-list-r2", "1");
    }

    function bindDedicatedShell() {
      const article = document.querySelector('article[data-audio-native="1"]');
      if (!article || article.dataset.mahoonR2ShellBound === "1") return;

      const candidates = [...document.querySelectorAll("body *")];
      const heading =
        candidates.find(el =>
          String(el.textContent || "").replace(/\s+/g, " ").trim() === "مطالب پیشنهادی"
        ) ||
        candidates.find(el =>
          String(el.textContent || "").includes("مطالب پیشنهادی")
        );

      const suggestions = findSuggestionContainer(heading);
      if (!suggestions) return;

      let common = lowestCommonAncestor(article, suggestions);

      while (
        common &&
        common !== document.body &&
        (
          !branchBelow(common, article) ||
          !branchBelow(common, suggestions) ||
          branchBelow(common, article) === branchBelow(common, suggestions)
        )
      ) {
        common = common.parentElement;
      }

      if (!common || common === document.body) return;

      const primary = branchBelow(common, article);
      const secondary = branchBelow(common, suggestions);

      if (!primary || !secondary || primary === secondary) return;

      article.dataset.mahoonR2ShellBound = "1";
      common.setAttribute("data-mahoon-audio-shell-r2", "1");
      primary.setAttribute("data-mahoon-audio-primary-r2", "1");
      secondary.setAttribute("data-mahoon-audio-secondary-r2", "1");

      markSuggestionList(suggestions);

      document.documentElement.dataset.mahoonAudioShellR2 = "bound";
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bindDedicatedShell, { once: true });
    } else {
      bindDedicatedShell();
    }

    window.setTimeout(bindDedicatedShell, 250);
    window.setTimeout(bindDedicatedShell, 900);
    document.addEventListener("astro:page-load", bindDedicatedShell);
  })();
</script>



