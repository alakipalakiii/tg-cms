---
import MahoonAudioPlayerNative from "./MahoonAudioPlayerNative.astro";

interface Props {
  audioSrc: string;
  imageSrc?: string;
  title: string;
  description?: string;
  dateText?: string;
  categoryText?: string;
  durationSeconds?: number;
  fileName?: string;
  shareUrl?: string;
}

const {
  audioSrc,
  imageSrc = "",
  title,
  description = "",
  dateText = "",
  categoryText = "صوتی",
  durationSeconds = 0,
  fileName = "",
  shareUrl = ""
} = Astro.props;
---

<section class="mahoon-audio-page" data-mahoon-audio-page>
  <nav class="mahoon-audio-page__nav" aria-label="مسیر صفحه صوتی">
    <a href="/">صفحه اصلی</a>
    <span aria-hidden="true">/</span>
    <a href="/category/%D8%B5%D9%88%D8%AA%DB%8C">آرشیو صوتی</a>
  </nav>

  <MahoonAudioPlayerNative
    audioSrc={audioSrc}
    imageSrc={imageSrc}
    title={title}
    description={description}
    dateText={dateText}
    categoryText={categoryText}
    durationSeconds={durationSeconds}
    fileName={fileName}
    shareUrl={shareUrl}
  />
</section>

