<script is:inline>
  (() => {
    function initDedicatedAudioShell() {
      const article = document.querySelector('article[data-audio-native="1"]');
      if (!article || article.dataset.audioShellBound === "1") return;

      let shell = article.parentElement;
      let hops = 0;

      while (shell && shell !== document.body && hops < 5) {
        const directChildren = [...shell.children];
        const articleChild = directChildren.find(el => el === article || el.contains(article));
        const secondary = directChildren.filter(el => el !== articleChild);

        if (articleChild && secondary.length > 0) break;

        shell = shell.parentElement;
        hops += 1;
      }

      if (!shell || shell === document.body) return;

      article.dataset.audioShellBound = "1";
      shell.setAttribute("data-mahoon-audio-shell", "1");

      const articleBranch = [...shell.children].find(el => el === article || el.contains(article));

      for (const child of [...shell.children]) {
        if (child === articleBranch) continue;
        child.setAttribute("data-mahoon-audio-secondary", "1");
      }

      const secondaryRoots = [...shell.querySelectorAll('[data-mahoon-audio-secondary="1"]')];
      const all = secondaryRoots.flatMap(root => [root, ...root.querySelectorAll("*")]);

      const heading = all.find(el =>
        String(el.textContent || "").replace(/\s+/g, " ").trim() === "مطالب پیشنهادی"
      ) || all.find(el => String(el.textContent || "").includes("مطالب پیشنهادی"));

      if (heading) {
        const suggestions =
          heading.closest('[data-mahoon-audio-secondary="1"]') ||
          heading.parentElement;

        suggestions?.setAttribute("data-mahoon-audio-suggestions", "1");

        const candidates = suggestions ? [suggestions, ...suggestions.querySelectorAll("*")] : [];
        let best = null;
        let bestScore = 0;

        for (const el of candidates) {
          const children = [...el.children];
          const score = children.filter(child =>
            child.matches('a[href*="/post/"]') ||
            child.querySelector('a[href*="/post/"]')
          ).length;

          if (score >= 2 && score > bestScore) {
            best = el;
            bestScore = score;
          }
        }

        if (best) {
          best.setAttribute("data-mahoon-audio-suggestion-list", "1");
        }
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initDedicatedAudioShell, { once: true });
    } else {
      initDedicatedAudioShell();
    }

    document.addEventListener("astro:page-load", initDedicatedAudioShell);
  })();
</script>



