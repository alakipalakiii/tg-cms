{
  "preview_urls": false,
  "workers_dev": false,
	"name": "mahoon-art-magazine",
	"main": "./src/worker.js",
	"compatibility_date": "2026-06-30",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"not_found_handling": "404-page",
		"run_worker_first": [
			"/",
			"/posts*",
			"/post/*",
			"/category/*",
			"/tag/*",
			"/admin*",
			"/about",
			"/about/",
			"/contact",
			"/contact/",
			"/robots.txt",
			"/rss.xml",
			"/sitemap.xml",
            "/search*",
            "/__mahoon-proof/media/*"
		]
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"observability": {
		"enabled": true
	}
}
